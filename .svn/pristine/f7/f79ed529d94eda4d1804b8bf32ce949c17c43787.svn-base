@model CLA_Administration_Web.ViewModels.Reports.ModuleReportFilterViewModel

@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.ViewModels.Modules.Components.Form

@{
    var moduleName = Model.ReportName.GetDisplayName(); 
}


<!-- Card for Filters -->
<div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
    <div class="card-body pt-0 pb-0">
        <div class="row fs-12 mt-1">
            <p class="custom-p text-center hidden">Filter @moduleName Reports Types</p>
            <div class="row col-12 d-flex flex-wrap module-overview-filters">
                <div class="w-fit-content me-auto ms-4">
                    <p class="theme-txt-clr fw-bold text-center mb-0">Status</p>
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Active</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-success slider-large" type="checkbox" id="ShowHideSurveyTitle" checked>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Inactive</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-warning slider-large" type="checkbox" id="ShowHideSurveyTitle" checked>
                            </div>
                        </div>
                    </div> 
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Not Installed</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-danger slider-large" type="checkbox" id="ShowHideSurveyTitle" checked>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-auto mx-auto mb-1">
                    <div class="row mb-0 mt-1">
                        @{
                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/DateRangePicker.cshtml", 
                            new DateTimeRangePicker 
                            { 
                                ShowDatesTitle = true,
                                ShowFullTitles = false,
                                TitlesBold = true,
                                VerticalAlign = false,
                                WidthCss = "w-225p",
                                ExternalCssControl = "report-filter-datepicker"
                            });
                        }
                    </div>
                    <div class="row mt-2">
                        <p class="custom-p w-fit-content fw-bold align-content-center">@moduleName</p>
                        <select class="custom-input-text w-350p" id="ReportModuleSelect">
                            <option value="0">Please select @moduleName</option>
                            <option value="1">@moduleName 1</option>
                            <option value="2">@moduleName 2</option>
                            <option value="3">@moduleName 3</option>
                        </select>
                    </div>
                </div>
                <div class="w-auto mx-auto mb-1">
                    <div class="d-flex mt-1">
                        <div class="align-content-center">
                            <p class="custom-p fw-bold">Show Raw Data Only</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input slider-large" type="checkbox" id="ShowHideSurveyTitle">
                            </div>
                        </div>
                    </div>
                    <div class="d-flex mt-1">
                        <button class="btn btn-sm btn-success" onclick="GenerateReportDataForExport()">Generate for Export</button>
                        <button class="btn custom-btn-default btn-sm ms-2 px-3" onclick="window.location='@Url.Action("ExportFile", "Reports")?reportType=@Model.ReportName'">Generate Report</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function GenerateReportDataForExport()
    {
        ReloadFilteredReport("@Model.ReportName", ReportDataTypes.EXPORT_ONLY, 8);
    }

</script>