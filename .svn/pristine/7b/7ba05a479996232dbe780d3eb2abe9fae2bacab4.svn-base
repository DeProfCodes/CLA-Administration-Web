@model CLA_Administration_Web.ViewModels.Reports.ReportBreadcrumbViewModel

@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages

@{
    var pageType = Model.LinkedModulePage;
    var moduleName = pageType.GetDisplayShortName();
    var navPageId = $"{pageType.GetDisplayName()}Link";
}

<div class="row mb-2">
    <div class="w-auto">
        <h2 class="theme-txt-clr breadcrumb-title">@Model.ReportCurrentPage.GetDisplayDescription()</h2>
        <p class="breadcrumb-nav-body">
            <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
            <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Reports', null, '@ReportsPages.AllReports', 'AllAllReportsLink', true)">Reports</span> /
            <span class="breadcrumb-item">@Model.ReportCurrentPage.GetDisplayShortName()</span>
        </p>
    </div>
    @if (Model.HasLinkedModulePage)
    {
        var btnText = $"View {Model.ReportCurrentPage.GetDisplayDescription()}s"; 

        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenBreadcrumbLinkedModule()">
                <i class="ri-menu-search-fill custom-btn-icons breadcrumb-btn-icon"></i> @btnText
            </button>
        </div>
    }
</div>

<script>

    function OpenBreadcrumbLinkedModule()
    {
        OpenPageWithAnimations('Modules', '@moduleName', '@pageType', '@navPageId');
    }

</script>