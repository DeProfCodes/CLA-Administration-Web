@model int

@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.ViewModels.Modules.Components.Form

<div class="container-fluid">

    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Survey Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Survey</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Overview</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.SurveyDetails', '@Model');">@Model</span> /
                <span class="breadcrumb-item">Add New Survey Question</span>
            </p>
        </div>
    </div>

    <!-- Card for Filters -->
    <div class="card mb-4 mt-5 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Add New Survey Question for Survey Id: @Model</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;">
        <div class="card-body">
            <div class="row theme-txt-clr">
                <!-- Question Title Title input-->
                <div class="row mt-4">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Question Title:</label>
                    </div>
                    <div class="w-fit-content">
                        @{
                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                            new HtmlEditorModel
                            {
                                EditorId = "SurveyQuestionTitle",
                                HeightPx = "55px",
                                WidthPx = "500px",
                                WriteToDesitnationOnInput = false,
                                MaxCharacterCount = 25,
                            });
                        }
                    </div>
                </div>
                <!-- Introduction input-->
                <div class="row mt-2">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Question</label>
                    </div>
                    <div class="w-fit-content">
                        @{
                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                            new HtmlEditorModel
                            {
                                EditorId = "SurveyQuestionDetails",
                                HeightPx = "120px",
                                WidthPx = "500px",
                                WriteToDesitnationOnInput = false
                            });
                        }
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="w-fit-content" style="margin-left:100px">
                        <div class="form-check form-switch w-fit-content mb-0">
                            <label class="form-check-label fs-14" for="ShowHideSurveyTitle">Is Anonymous ?</label>
                            <input class="form-check-input" type="checkbox" id="ShowHideSurveyTitle">
                        </div>
                    </div>
                    
                </div>
                <div class="row mt-2">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Response Type</label>
                    </div>
                    <div class="w-fit-content">
                        <select class="form-control ml-3 w-50 ms-3 w-200p fs-14 " id="SurveySkinImageSelect" onchange="UpdateSurveySkinPreview()" style="appearance:menulist">
                            <option value="0" selected>Please select response type...</option>
                            <option value="1">YES_NO</option>
                            <option value="2">YES_NO_NA</option>
                            <option value="3">AGREE_DISAGREE</option>
                            <option value="3">AGREE_DISAGREE_NA</option>
                            <option value="3">Text</option>
                            <option value="3">Re-Arrange</option>
                            <option value="3">Single Select</option>
                            <option value="3">Multi Select</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-2" id="Scoring">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Survey Scoring</label>
                    </div>
                    <div class="w-fit-content">
                        <div id="YesNoAnswer">
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="SurveyScoringYesNo" value="option2">
                                <label class="form-check-label" for="SurveyCustomSkinOption">Yes</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="SurveyScoringYesNo" value="option2">
                                <label class="form-check-label" for="SurveyCustomSkinOption">No</label>
                            </div>
                        </div>
                        <div id="YesNoNaAnswer" class="hidden">
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" value="option2">
                                <label class="form-check-label" for="SurveyCustomSkinOption">Yes</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" value="option2">
                                <label class="form-check-label" for="SurveyCustomSkinOption">No</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" value="option2">
                                <label class="form-check-label" for="SurveyCustomSkinOption">NA</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-2"  id="Dependency">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Survey Dependency</label>
                    </div>
                    <div class="w-fit-content">
                        <select class="form-control ml-3 w-50 ms-3 w-200p fs-14" id="SurveySkinImageSelect" onchange="UpdateSurveySkinPreview()" style="appearance:menulist">
                            <option value="0" selected>Please select question dependent...</option>
                            <option value="1">Q1</option>
                            <option value="2">Q2</option>
                        </select>
                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                            <input class="form-check-input" type="radio" name="SurveDependancyYesNo" value="option2">
                            <label class="form-check-label" for="SurveyCustomSkinOption">Yes</label>
                        </div>
                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                            <input class="form-check-input" type="radio" name="SurveDependancyYesNo" value="option2">
                            <label class="form-check-label" for="SurveyCustomSkinOption">No</label>
                        </div>
                    </div>
                </div>
                <div class="row mt-2"  id="CalendarItem">
                    <div class="col-sm-2">
                        <label class="fw-bold text-center fl-right">Calendar Item</label>
                    </div>
                    <div class="w-fit-content">
                    </div>
                </div>
            </div>
            <div style="margin-top: 30px;margin-left: 180px;">
                <button class="btn btn-sm btn-success">Save Survey Question</button>
            </div>
        </div>
    </div>
</div>