@model TickerReportsRaw


<div class="report-outter-container">
    <div class="card-body p-1">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container px-5">
                <!-- 1. Ticker Summary Tab -->
                <div id="TickerSummaryTab-1" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Summary)
                    </div>
                </div>
                <!-- 2. Ticker Completed Tab -->
                <div id="TickerCompletedTab-2" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Completed)
                    </div>
                </div>
                <!-- 3. Ticker Outstanding Tab -->
                <div id="TickerOutstandingTab-3" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Outstanding)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function()
    {
        NavigateToPopupReportTab(1);
    });

</script>