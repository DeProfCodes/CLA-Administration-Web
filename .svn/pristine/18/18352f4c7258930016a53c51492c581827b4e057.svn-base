@model CLA_Administration_Web.ViewModels.Targeting.TargetingExposureViewModel

<div id="TargetingExposureTablesContainer">
    <h3 class="w-100 text-center theme-txt-clr overview-table-caption" id="ModuleOverviewTableCaption">Targeted Groups</h3>
    <table id="TargetingExposureGroupsTable" class="table table-striped table-hover align-middle theme-border" style="font-size:12px;">
        <thead>
            <tr>
                <th>Domain</th>
                <th>GroupId</th>
                <th>Display Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.TargetedGroups)
            {
                <tr>
                    <td>@group.DomainName</td>
                    <td>@group.GroupId</td>
                    <td>@group.DisplayName</td>
                </tr>
            }
        </tbody>
    </table>
    <h3 class="w-100 text-center theme-txt-clr overview-table-caption mt-5" id="ModuleOverviewTableCaption">Targeted Users</h3>
    <table id="TargetingExposureGroupsTable" class="table table-striped table-hover align-middle theme-border" style="font-size:12px;">
        <thead>
            <tr>
                <th>Domain</th>
                <th>NT Username</th>
                <th>Display Name</th>
                <th>Last Sync DT</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.TargetedUsers)
            {
                <tr>
                    <td>@user.DomainName</td>
                    <td>@user.NTUsername</td>
                    <td>@user.DisplayName</td>
                    <td>@user.LastSyncDT</td>
                    <td><span class="@user.Status.CssClass fs-14">@user.Status.CustomStatusText</span></td>
                </tr>
            }
        </tbody>
    </table>
    <h3 class="w-100 text-center theme-txt-clr overview-table-caption mt-5" id="ModuleOverviewTableCaption">Targeted Machines</h3>
    <table id="TargetingExposureGroupsTable" class="table table-striped table-hover align-middle theme-border" style="font-size:12px;">
        <thead>
            <tr>
                <th>Domain</th>
                <th>NT Username</th>
                <th>Display Name</th>
                <th>Last Sync DT</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var machine in Model.TargetedMachines)
            {
                <tr>
                    <td>@machine.DomainName</td>
                    <td>@machine.NTUsername</td>
                    <td>@machine.DisplayName</td>
                    <td>@machine.LastSyncDT</td>
                    <td><span class="@machine.Status.CssClass fs-14">@machine.Status.CustomStatusText</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
