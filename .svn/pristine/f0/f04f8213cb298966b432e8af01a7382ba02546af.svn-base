@model CLA_Administration_Web.ViewModels.Modules.LDS.AddNewContentLibraryCategory
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Modules.Components.Form

@{
    var treeParents = !string.IsNullOrEmpty(Model.ContentLibraryParents) ? $"{Model.ContentLibraryParents} > " : "";
    var isLDSModule = Model.ModuleName == ModuleNamesType.Screensaver || Model.ModuleName == ModuleNamesType.LockedDesktop || Model.ModuleName == ModuleNamesType.Desktop;

    var pageTitle = (Model.AddOrEdit == AddOrEditType.Add) ? "Add Content" : $"Edit Content: {Model.ContentLibraryModel.ContentId}";
    var lastBreadcrumbItem = Model.AddOrEdit == AddOrEditType.Add ? " Add New Content" : $" Edit Content / {Model.ContentLibraryModel.ContentId}";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Content Library Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.ContentLibraryCategories', 'ContentLibraryCategoriesLink')">Content Library </span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.ContentLibraryCategories', 'ContentLibraryCategoriesLink')">Categories</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.ContentLibraryCategoryDetails', '@Model.CategoryId');">@Model.CategoryId</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.ContentLibraryContent', '@Model.CategoryId')">Contents Overview</span> /
                <span class="breadcrumb-item">@lastBreadcrumbItem</span>
            </p>
        </div>
    </div>

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">@pageTitle</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;min-height:500px">
        <div class="card-body">
            <div class="row theme-txt-clr">
                <h5 class="fw-bold mt-3 text-center">Content Details</h5>
                <div class="form-border-inputs-content-library" style="width:900px">
                    <div class="row mt-3 mb-4">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Category</p>
                        </div>
                        <div class="common-titles-value-col">
                            @if (!isLDSModule && Model.AddOrEdit != AddOrEditType.Edit)
                            {   
                                <p class="fs-14 mb-0">
                                    <span class="fst-italic theme-txt-clr">@treeParents</span>
                                    <span class="fw-bold text-success">@Model.CategoryName</span>
                                </p>
                            }
                            else
                            {
                                <select class="custom-input-text" id="NewContentCategorySelect" onchange="ToggleNewCategoryFields(this.id)">
                                    <option value="0">Please select category</option>
                                    <option value="-142" class="text-success fw-bold" onclick="CreateNewCategory()">Create New Category.....</option>
                                    @foreach (var category in Model.ContentCategories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>   
                                    }
                                </select>
                            }
                        </div>
                    </div>
                    <div class="row mt-3 new-category hidden">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right fw-bold">New Category Name</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewContentLibCategoryName" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3 mb-3 new-category hidden">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right fw-bold">New Category Description</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewContentLibCategoryDescription" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryDescriptionError"></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Content Description</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewContentLibContentDescription" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibContentDescriptionError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">User Last Modified</p>
                        </div>
                        <div class="common-titles-value-col">
                            <p class="custom-p fw-bold">NDHUVAZIM</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Machine Last Modified</p>
                        </div>
                        <div class="common-titles-value-col">
                            <p class="custom-p fw-bold">Proficient-PC</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Content Type</p>
                        </div>
                        <div class="common-titles-value-col">
                            <select class="custom-input-text w-250p" id="NewContentLibCategoryDescription">
                                <option value="Image">Image</option>
                                <option value="Video">Video</option>
                                <option value="Audio">Audio</option>
                                <option value="URL">URL</option>
                            </select>
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryDescriptionError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col" style="align-content: flex-start;">
                            <p class="custom-p fl-right">Content</p>
                        </div>
                        <div class="common-titles-value-col">
                            <!-- Uploader Component -->
                            @{
                                await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml",
                                new FileUploaderModel 
                                { 
                                    ComponentId = "ContentLibraryContent", 
                                    InputId = "NewContentInput", 
                                    ShowPreviewButton = true, 
                                    InitialHidden = false, 
                                    WidthPx = "275px", 
                                    OnFileUploadCallback = null 
                                });
                            }
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col" style="align-content: flex-start;">
                            <p class="custom-p fl-right">Effective Dates</p>
                        </div>
                        <div class="common-titles-value-col" style="margin-left:-20px">
                            @{
                                await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/DateRangePicker.cshtml", new DateTimeRangePicker { ShowDatesTitle = false });
                             }
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Targeted Modules</p>
                        </div>
                        <div class="common-titles-value-col">
                            <div class="d-flex">
                                <div class="form-check form-switch w-fit-content mb-0">
                                    <label class="form-check-label fs-12 fw-bold" for="ContentModuleScreensaver">Screensaver</label>
                                    <input class="form-check-input" type="checkbox" id="ContentModuleScreensaver">
                                </div>
                                <div class="form-check form-switch w-fit-content mb-0 ms-2">
                                    <label class="form-check-label fs-12 fw-bold" for="ContentModuleDesktop">Desktop</label>
                                    <input class="form-check-input" type="checkbox" id="ContentModuleDesktop">
                                </div>
                                <div class="form-check form-switch w-fit-content mb-0 ms-2">
                                    <label class="form-check-label fs-12 fw-bold" for="ContentModuleLockedDesktop">Locked Desktop</label>
                                    <input class="form-check-input" type="checkbox" id="ContentModuleLockedDesktop">
                                </div>
                            </div>
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Default Duration</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-50p" type="number" step="1" min="1" value="1" id="NewContentDefaultDuration" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Targeting</p>
                        </div>
                        <div class="common-titles-value-col">
                            <button class="btn btn-warning btn-sm" onclick="OpenTargetedEntityPreviewModal('@ModuleNamesType.ContentLibrary', false)">Set Content Targeting</button>
                            <button class="btn btn-info btn-sm ms-2" onclick="OpenTargetingExposurePreviewModal('@ModuleNamesType.ContentLibrary')">Open Targeting</button>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-sm btn-success px-5" onclick="SubmitNewContentLibraryContents()">Save Content</button>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
}

<script>

    $(document).ready(function ()
    {
        if("@Model.AddOrEdit" == "@AddOrEditType.Edit")
        {
            PrePopulateContentDataForEdit();
        }
    });

    function ValidateContentLibraryCategory()
    {
        $("#NewContentLibCategoryNameError").text("");
        $("#NewContentLibCategoryDescriptionError").text("");

        var valid = true;

        if (IsEmptyInput("NewContentLibCategoryName"))
        {
            $("#NewContentLibCategoryNameError").text("please enter category name");
            valid = false;
        }
        if (IsEmptyInput("NewContentLibCategoryDescription"))
        {
            $("#NewContentLibCategoryDescriptionError").text("please enter category description");
            valid = false;
        }

        if (!valid)
        {
            swal("New Category Success", "Please enter all required fields", "error");
        }
        return valid;
    }

    function SubmitNewContentLibraryContents()
    {
        var valid = true;//SubmitNewContentLibraryCategory();

        if (valid)
        {
            swal("New Category Success", "Content Library Category (will be) Added Successfully.", "success");
        }

        var redirectPage = "@ModulesPages.ContentLibraryContent";
        if ('@Model.ModuleName' == '@ModuleNamesType.Screensaver') redirectPage = '@ModulesPages.ScreensaverAddNew';
        if ('@Model.ModuleName' == '@ModuleNamesType.LockedDesktop') redirectPage = '@ModulesPages.LockedDesktopAddNew';
        if ('@Model.ModuleName' == '@ModuleNamesType.Desktop') redirectPage = '@ModulesPages.DesktopAddNew';

        OpenPage(redirectPage);
    }

    function ToggleNewCategoryFields(id)
    {
        var val = $(`#${id}`).val();

        if(val == -142)
        {
            HideShowElement(".new-category", HideShow.SHOW);
        }
        else
        {
            HideShowElement(".new-category", HideShow.HIDE);
        }
    }

    function PrePopulateContentDataForEdit()
    {
        SelectAnOptionWithValue("NewContentCategorySelect", "@Model.CategoryId");
        $("#NewContentLibContentDescription").val("@Model.ContentLibraryModel.AdvertDescription");
        $("#NewContentDefaultDuration").val("@Model.ContentLibraryModel.Duration");

        CheckOrUncheckInput("ContentModuleDesktop", true);

        SetDateRangePickerDate("@Model.ContentLibraryModel.EffectiveFrom", "DatePickerStartDate");
        SetDateRangePickerDate("@Model.ContentLibraryModel.EffectiveTo", "DatePickerEndDate");
    }

</script>