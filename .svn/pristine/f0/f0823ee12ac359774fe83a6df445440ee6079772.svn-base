@model PolicyReportsRaw

<div class="card-body p-1 pb-0">
    <!-- Report Type -->
    <div class="row mt-1">
        <div class="btn-group w-auto overview-filter-btn-group mx-auto">
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-1" id="SummaryLink-1" onclick="NavigateToPopupReportTab(1)">Response Summary</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-2" id="ResponseSummaryLink-2" onclick="NavigateToPopupReportTab(2)">Outstanding Response</button>
        </div>
    </div>
</div>

<div class="report-outter-container">
    <div class="card-body p-1">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container px-5">
                <button class="btn btn-success btn-sm" onclick="ExportReportToExcel('@ReportsNamesType.Policy')" id="ExportReportToExcelBtn">
                    <i class="fa fa-spinner fa-spin mr-2 hidden" id="ActionBtnLoader"></i>Export To Excel
                </button>
                <!-- 1. Policy Response Summary Tab -->
                <div id="PolicyResponseSummaryTab-1" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseSummary)
                    </div>
                </div>
                <!-- 2. Ticker Completed Tab -->
                <div id="TickerCompletedTab-2" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Outstanding)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function()
    {
        NavigateToPopupReportTab(1);
    });

</script>