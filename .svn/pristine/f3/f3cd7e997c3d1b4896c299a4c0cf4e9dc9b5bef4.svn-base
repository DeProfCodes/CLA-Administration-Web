@model CLA_Administration_Web.ViewModels.Modules.PST.AddNewSurveyViewModel

@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Modules.Components.Form
@using CLA_Administration_Web.ViewModels.Modules.PST

@{
    var surveySkin = $"{LaunchSettingsHelper.GetBaseAddressForImages()}/images/others/modules/skins/SurveyBackground.bmp";
}

<div class="container-fluid">
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.SurveyAddNew })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">Add New Survey</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link T-1 active" id="TextsTabLink-1" onclick="NavigateToSurveyTab(this.id, 1)">
                            Texts<i class="bi bi-dot module-nav-link-dot T-1 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-2" id="SkinTabLink-2" onclick="NavigateToSurveyTab(this.id, 2)">
                            Skin <i class="bi bi-dot module-nav-link-dot T-2 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-3" id="TimesTabLink-3" onclick="NavigateToSurveyTab(this.id, 3)">
                            Times<i class="bi bi-dot module-nav-link-dot T-3 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-4" id="DisplaysTabLink-4" onclick="NavigateToSurveyTab(this.id, 4)">
                            Response Urgency<i class="bi bi-dot module-nav-link-dot T-4 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-5" id="RepeatTabLink-5" onclick="NavigateToSurveyTab(this.id, 5)">
                            Add-on Features<i class="bi bi-dot module-nav-link-dot T-5 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-6" id="DeliveryMethodTabLink-6" onclick="NavigateToSurveyTab(this.id, 6)">
                            Delivery Method<i class="bi bi-dot module-nav-link-dot T-6 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-7" id="TargetUsersTabLink-7" onclick="NavigateToSurveyTab(this.id, 7)">
                            Target Users<i class="bi bi-dot module-nav-link-dot T-7 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-8" id="ExposureSummaryTabLink-8" onclick="NavigateToSurveyTab(this.id, 8)">
                            Exposure Summary<i class="bi bi-dot module-nav-link-dot T-8 hidden"></i>
                        </a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap" id="ModuleWizardMain">
                    <div class="form-horizontal theme-txt-clr" id="popupForm">
                        <!-- Texts Tab -->
                        <div id="TextsTab-1" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mt-4">1. Survey Title, Introduction & Conclusion</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Enter survey texts.</p>
                            <!-- Title input-->
                            <div class="row mt-4">
                                <div class="col-sm-2">
                                    <label class="fw-bold text-center fl-right">Title:</label>
                                </div>
                                <div class="w-fit-content">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyTitleText",
                                            HeightPx = "55px",
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = true,
                                            DestinationTextDivId = "SurveyPreviewTitle",
                                            MaxCharacterCount = 25,
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="NewSurveyTextsTitleError"></p>
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-12" for="ShowHideSurveyTitle">No Survey Title</label>
                                        <input class="form-check-input" type="checkbox" id="ShowHideSurveyTitle" onchange="SurveyTextShowHide(this.id)">
                                    </div>

                                </div>
                            </div>
                            <!-- Introduction input-->
                            <div class="row mt-2">
                                <div class="col-sm-2">
                                    <label class="fw-bold text-center fl-right">Introduction:</label>
                                </div>
                                <div class="w-fit-content">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel 
                                        { 
                                            EditorId = "SurveyIntroductionText", 
                                            HeightPx = "120px", 
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = false    
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="NewSurveyTextsIntroError"></p>
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-12" for="ShowHideSurveyIntro">No Introduction Message</label>
                                        <input class="form-check-input" type="checkbox" id="ShowHideSurveyIntro" onchange="SurveyTextShowHide(this.id)" >
                                    </div>
                                </div>
                            </div>
                            <!-- Conclusion input-->
                            <div class="row mt-2 mb-5">
                                <div class="col-sm-2">
                                    <label class="fw-bold text-center fl-right">Conclusion:</label>
                                </div>
                                <div class="w-fit-content">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyConclusionText",
                                            HeightPx = "120px", 
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = false
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="NewSurveyTextsConclusionError"></p>
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-12" for="ShowHidePopupBody">No Introduction Message</label>
                                        <input class="form-check-input" type="checkbox" id="ShowHideSurveyConclusion" onchange="SurveyTextShowHide(this.id)">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Skins Tab -->
                        <div id="SkinsTab-2" class="survey-wizard-tabs flex-wrap justify-content-center mb-5 ps-2 hidden">
                            <h5 class="fw-bold mt-4 text-center">2. Survey Skin </h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select the skin for this survey</p>
                            <div class="mt-3" id="PopupSkinContainer">
                                <p class="custom-p fs-12 w-fit-content mt-2">
                                    If you import your own custom skin, please note that the image must be saved as a *.BMP file and must be 485x600 pixels in dimension.
                                </p>
                                <div class="mt-2 p-2">
                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                        <input class="form-check-input" type="radio" name="SurveySkinOption" id="SurveyDefaultSkinOption" value="option2" onchange="SurveySkinTypeSelect(this.id)">
                                        <label class="form-check-label" for="SurveyDefaultSkinOption">Use Default Skin</label>
                                    </div>
                                    <div class="form-group mt-3">
                                        <div class="col-sm-10 d-inline-flex align-items-center">
                                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                <input class="form-check-input" type="radio" name="SurveySkinOption" id="SurveyCustomSkinOption" value="option2" onchange="SurveySkinTypeSelect(this.id)">
                                                <label class="form-check-label" for="SurveyCustomSkinOption">Use Custom Skin</label>
                                            </div>
                                            <select class="form-control ml-3 w-50 ms-3 w-200p fs-14 hidden" id="SurveySkinImageSelect" onchange="UpdateSurveySkinPreview()" style="appearance:menulist">
                                                <option value="0" selected>Please select skin</option>
                                                @foreach (var surveySkin2 in Model.SurveySkins)
                                                {
                                                    <option value="@surveySkin2.FileURL">@surveySkin2.Filename</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="border border-light-1 mt-4 p-2">
                                <p class="custom-p fw-bold fs-16 text-center">Survey Skin Preview</p>
                            </div>
                            <div id="SurveySkinPreview" class="mt-4 w-fit-content mx-auto mb-4 hidden">
                                <div class="mb-3 w-fit-content p-0">
                                    <p class="custom-p mt-3">Survey Skin <span class="custom-p-bold text-decoration-underline" id="SurveySkinTitleText"></span></p>
                                    <div class="mt-1 me-4" id="SurveyPreviewSkin">
                                        <div id="SurveyQuestionPreview">
                                            <div class="row">
                                                <p class="text-center fw-bold pt-2" id="SurveyPreviewTitle">survey</p>
                                                <p class="text-center fw-bold">Question 1</p>
                                            </div>
                                            <div style="border:1px solid black; height:75px">
                                                <p>Have you used C.L.A before?</p>
                                            </div>
                                            <div style="border:1px solid black;height: 150px;overflow-y: scroll;padding:10px">
                                                <p>Just a quick question!</p>
                                            </div>
                                            <div class="d-flex pt-3" style="border: 1px solid gray;border-top: 2px solid gray;margin: 1px;margin-top: 5px;">
                                                <div class="col-md-6">
                                                    <div class="d-flex ms-3">
                                                        <input type="checkbox" disabled /> <p class="ms-1 mb-0">Snooze</p>
                                                    </div>
                                                    <div class="d-flex ms-3">
                                                        <input type="checkbox" disabled /> <p class="ms-1 mb-0">Never Remind Me...</p>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <p class="mb-0 ms-5">Duration: 00:00:01</p>
                                                    <p class="ms-5">Question: 1/6</p>
                                                </div>
                                            </div>
                                            <div class="row text-center mt-3 pb-2">
                                                <button class="btn btn-sm btn-secondary ms-auto survey-preview-btns">PREVIOUS</button>
                                                <button class="btn btn-sm btn-secondary me-auto ms-5 survey-preview-btns">NEXT</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Times Tab -->
                        <div id="TimesTab-3" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Survey Effective Dates & Timeslots</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please define the date and time range that the Survey must display</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                Tip:In order to maximize exposure, we recommend that the date range span over multiple calendar weeks (Thursday to Thursday) and setting the time
                                to be as long as possible (e.g 07h00 to 19h00).
                            </p>
                            <div class="row mt-5 p-4 mb-5">
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Effective Dates</p>
                                    <div class="mt-4">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/DateRangePicker.cshtml", new DateTimeRangePicker { ShowDatesTitle = true });
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Timeslots</p>
                                    <div class="mt-4">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/TimeRangePicker.cshtml");
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <p class="w-600p mx-auto p-2 theme-border">
                                    This survey will attempt to show everyday startting from <span id="SurveyStartEffDate"></span>, until <span id="SurveyEndEffDate"></span>.
                                    It will only appear between the time range of <span id="SurveyStartTimeSlot"></span> and <span id="SurveyEndTimeSlot"></span>. Once 
                                    this survey has been completed/opted out. it will not display again
                                </p>
                            </div>
                        </div>
                        <!-- ResponseUrgency Tab -->
                        <div id="ResponseUrgencyTab-4" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold mt-4">4. Response Urgency</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please define how much flexibilitythe user is allowed when the Popup arrives.</p>
                            <div class="row mt-3">
                                <div class="survey-response-urgency-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14 cursor-pointer" for="SurveyResponseCritical">Critical</label>
                                        <input class="form-check-input" type="radio" name="SurveyResponseUrgency" id="SurveyResponseCritical" onchange="SurveyResponseUgencySelect(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">
                                        Select this option if you want the survey to be MANDATORY, the user has no option but to complete it when it arrives on their screen.
                                    </p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="survey-response-urgency-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14 cursor-pointer" for="SurveyResponseSnoozeOnly">Allow Snooze Only</label>
                                        <input class="form-check-input" type="radio" name="SurveyResponseUrgency" id="SurveyResponseSnoozeOnly" onchange="SurveyResponseUgencySelect(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">Please select this option if you want to allow the user SNOOZE the survey for later viewing.</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="survey-response-urgency-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14 cursor-pointer" for="SurveyResponseSnoozeOptOut">Allow Snooze & Opt Out</label>
                                        <input class="form-check-input" type="radio" name="SurveyResponseUrgency" id="SurveyResponseSnoozeOptOut" onchange="SurveyResponseUgencySelect(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">
                                        Select this option if you want the user to SNOOZE the Popup for later viewing or OPT OUT of the survey completely
                                    </p>
                                </div>
                            </div>
                            <div class="row mt-5 hidden" id="SurveySnoozeSettingsContainer">
                                <p class="custom-p fw-bold fs-15 w-fit-content pb-3 ps-0">Snooze Settings</p>
                                <div class="theme-border p-2 w-100" id="SurveySnoozeSettingsText">
                                    <p class="mb-0">
                                        You have given the user the opportunity to SNOOZE the survey. if you would like the survey to become mandory at some point, 
                                        please specify below
                                    </p>
                                </div>
                                <div class="mt-4">
                                    <div class="row">
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                            <label class="form-check-label fs-14 cursor-pointer" for="SnoozeCriticalCountCheck">Auto-critical after Snooze</label>
                                            <input class="form-check-input" type="checkbox" id="SnoozeCriticalCountCheck" onchange="SurveySnoozeSettingsSelect(this.id)">
                                        </div>
                                        <div class="w-fit-content" style="margin-left:20px">
                                            <input class="custom-input-text hidden" type="number" step="1" min="0" value="1" style="width:70px" id="SurveyCriticalSnoozeCount" />
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                            <label class="form-check-label fs-14 cursor-pointer" for="SurveyCriticalSnoozeDateCheck">Auto-critical at Date/Time</label>
                                            <input class="form-check-input" type="checkbox" id="SurveyCriticalSnoozeDateCheck" onchange="SurveySnoozeSettingsSelect(this.id)">
                                        </div>
                                        <div class="w-fit-content d-flex hidden" id="SurveyCriticalSnoozeDateContainer">
                                            <i class="fas fa-calendar-alt calendar-icon-date-box" onclick="OpenDatePicker()"></i>
                                            <input type="date" class="custom-input-text fs-14 cursor-pointer date-time-picker" id="SurveyCriticalSnoozeDate" onchange="OnPopupRepeatExpiryDateChange(this.id)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Add-on Features Tab -->
                        <div id="AddOnFeaturesTab-5" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold mt-4">5. Add-on Features</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please define which of the optional add-on features are enabled in this survey.</p>
                            <p class="fw-bold mt-4 fs-13 text-center text-success">Hold your mouse over an option to view more information.</p>
                            <div class="row mt-5 ms-3">
                                <div id="SurveyAddOnsChecksContainer" onmouseout="ClearSurveyAddOnDetails()">
                                    <div class="form-check form-switch w-fit-content mb-0" onmouseover="DisplaySurveyAddOnDetails('recall')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="AllowRecallAddOn" >Allow Recall of Completed Survey</label>
                                        <input class="form-check-input" type="checkbox" id="AllowRecallAddOn" checked>
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('randomize')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="RandomizeOrderAddOn">Randomize Order of Questions</label>
                                        <input class="form-check-input" type="checkbox" id="RandomizeOrderAddOn">
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('usercred')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="RequireUserCredAddOn">Require User Credential Verification</label>
                                        <input class="form-check-input" type="checkbox" id="RequireUserCredAddOn">
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('prevbtn')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="ShowSurveyPrevBtnAddOn">Show Survey Previouse Button</label>
                                        <input class="form-check-input" type="checkbox" id="ShowSurveyPrevBtnAddOn" checked>
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('exportbtn')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="ShowReportExportBtnAddOn">Show Report Export Button</label>
                                        <input class="form-check-input" type="checkbox" id="ShowReportExportBtnAddOn" checked>
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('correctanswer')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="ShowCorrectAnswerBtnAddOn">Show Correct Answer</label>
                                        <input class="form-check-input" type="checkbox" id="ShowCorrectAnswerBtnAddOn" checked>
                                    </div>
                                    <div class="form-check form-switch w-fit-content mb-0 mt-3" onmouseover="DisplaySurveyAddOnDetails('scoredsummary')">
                                        <label class="form-check-label fs-14 cursor-pointer" for="ShowScoredSummaryBtnAddOn">Show Scored Summary</label>
                                        <input class="form-check-input" type="checkbox" id="ShowScoredSummaryBtnAddOn" checked>
                                    </div>
                                    <div class="mb-0 mt-3 d-flex" onmouseover="DisplaySurveyAddOnDetails('acceptablescore')">
                                        <p class="fs-14 mb-0 w-fit-content align-content-center me-2 cursor-pointer">Acceptable Score (%)</p>
                                        <input class="custom-input-text" type="number" step="1" min="0" max="100" value="80" style="width:70px" id="SurveyAddOnAcceptableScore" />
                                    </div>
                                </div>
                                <div id="SurveyAddOnsAnswerContainer">
                                    <p class="custom-p fs-15 fw-bold w-fit-content">Option Details</p>
                                    <div class="survey-addon-details-box mt-4 d-flex" id="AddOnDetailsTextOnly">
                                        <p class="mb-0" id="AddOnDetailsTextOnlyText">Hold your mouse over an option to view more information.</p>
                                        <img class="hidden" id="SurveyAddOnDetailsImage"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Delivery Method Tab -->
                        <div id="DeliveryTab-6" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5">
                            <h5 class="fw-bold mt-4">6. Delivery Method</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please define the delivery method/s of this survey.</p>
                            <p class="fw-bold mt-4 fs-13 text-center text-success">Note: More than one delivery method can be selected.</p>
                            <div class="row mt-5">
                                <div class="survey-delivery-method-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="SurveyDeveryViaScreensaver">Delivery via Screensaver</label>
                                        <input class="form-check-input" type="checkbox" id="SurveyDeveryViaScreensaver" onchange="SurveyDeliveryViaModules(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">The survey will launch when the user interrupts their screensaver.</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="survey-delivery-method-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="SurveyDeliveryViaPopup">Delivery via Popup</label>
                                        <input class="form-check-input" type="checkbox" id="SurveyDeliveryViaPopup" onchange="SurveyDeliveryViaModules(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">The survey will launch when the linked popup is clicked by the user.</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="survey-delivery-method-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="SurveyDeliveryViaTicker">Delivery via Ticker</label>
                                        <input class="form-check-input" type="checkbox" id="SurveyDeliveryViaTicker" onchange="SurveyDeliveryViaModules(this.id)">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">The survey will launch when the linked ticker is clicked on by the user from the CLA Widget to make it</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="survey-delivery-method-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="SurveyDeliveryViaWidget">Delivery via Widget Only</label>
                                        <input class="form-check-input" type="checkbox" id="SurveyDeliveryViaWidget" onchange="SurveyDeliveryViaWidget()">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">The survey ca only be launched from within the CLA Widget</p>
                                </div>
                            </div>
                        </div>
                        <!-- Target Users -->
                        <div id="TargetUserTab-7" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mb-3 module-heading-theme">7. Survey Target Users</h5>
                            <p class="module-heading-theme">Survey target user settings.</p>
                            
                            <div id="SurveyTargetedEntities">
                            </div>
                        </div>
                        <!-- Exposure Summary Tab -->
                        <div id="ExposureSummaryTab-8" class="survey-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mb-3 module-heading-theme">8. Survey Exposure Summary</h5>
                            <p class="module-heading-theme">Survey exposure summary settings.</p>
                            
                            <div id="SurveyTargetingExposure">
                            </div>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="row fix-content-bottom" style="margin-left:100px">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn module-wizard-nav-btns hidden" id="SurveyPrevTabBtn" onclick="PreviousSurveyTab()">Back</button>
                                    <button class="btn module-wizard-nav-btns" id="SurveyNextTabBtn" onclick="NextSurveyTab()">Next</button>
                                    <button class="btn module-new-submit-btn hidden" id="AddSurveySubmitBtn">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
}


<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/modules/survey.js"></script>

<script>

    $(document).ready(function ()
    {
        HideAllSurveyTabs();
        InitialiseFlatPicker();
        UpdateDisplayTimeDetails();
        LoadSurveyTargetedEntity();
    });

    function LoadSurveyTargetedEntity()
    {
        var url = GetPageUrl('@TargetingPages.TargetedEntities', '@ModuleNamesType.Survey');
        LoadPartialView(url, "SurveyTargetedEntities");

        url = GetPageUrl('@TargetingPages.TargetingExposure', '@ModuleNamesType.Survey');
        LoadPartialView(url, "SurveyTargetingExposure");
    }

    function InitialiseFlatPicker()
    {
        $("#SurveyCriticalSnoozeDate").flatpickr({
            dateFormat: "Y-m-d", // Internal format (ISO 8601)
            altInput: true,      // Display formatted date
            altFormat: "l, d F Y, H:i", // Custom display format (e.g., Thursday, 03 October 2024, 17:00)
            minDate: "today",    // Disable past dates
            defaultDate: "today",  // Set initial date to today
            allowInput: true,
            enableTime: true,
        });
    }

    $("#SurveyTitleText").on('input', function()
    {
        CheckOrUncheckInput("ShowHideSurveyTitle", false);
    });

    $("#SurveyIntroductionText").on('input', function ()
    {
        CheckOrUncheckInput("ShowHideSurveyIntro", false);
    });

    $("#SurveyConclusionText").on('input', function ()
    {
        CheckOrUncheckInput("ShowHideSurveyConclusion", false);
    });

    function UpdateDisplayTimeDetails()
    {
        var startDate = $("#DatePickerStartDate").val();
        var endDate = $("#DatePickerEndDate").val();
        var startTime = $("#TimePickerStartTime").val();
        var endTime = $("#TimePickerEndTime").val();

        if (IsNotEmptyString(startDate) && IsNotEmptyString(endDate) && IsNotEmptyString(startTime) && IsNotEmptyString(endTime))
        {
            $("#SurveyStartEffDate").text(startDate);
            $("#SurveyEndEffDate").text(endDate);
            $("#SurveyStartTimeSlot").text(startTime);
            $("#SurveyEndTimeSlot").text(endTime);
        }
    }

    $("#DatePickerStartDate").change(function ()
    {
        UpdateDisplayTimeDetails();
    });

    $("#DatePickerEndDate").change(function ()
    {
        UpdateDisplayTimeDetails();
    });

    $("#TimePickerStartTime").change(function ()
    {
        UpdateDisplayTimeDetails();
    });

    $("#TimePickerEndTime").change(function ()
    {
        UpdateDisplayTimeDetails();
    });

</script>