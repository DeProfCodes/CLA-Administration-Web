@model PopupReportsRaw

<div class="card-body p-1 pb-0">
    <!-- Report Type -->
    <div class="row mt-1">
        <div class="btn-group w-auto overview-filter-btn-group mx-auto">
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-1" id="SummaryLink-1" onclick="NavigateToPopupReportTab(1)">Popup Summary</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-2" id="ResponseSummaryLink-2" onclick="NavigateToPopupReportTab(2)">Response Summary</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-3" id="ResponseClikcLink-3" onclick="NavigateToPopupReportTab(3)">Response (Click)</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-4" id="ResponseDismissLink-4" onclick="NavigateToPopupReportTab(4)">Response (Dismiss)</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-5" id="ResponseAutoHideLink-5" onclick="NavigateToPopupReportTab(5)">Response (Autohide)</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-6" id="ResponseSnoozeLink-6" onclick="NavigateToPopupReportTab(6)">Response (Snooze)</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-7" id="ResponseShowLink-7" onclick="NavigateToPopupReportTab(7)">Response (Show)</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-8" id="OutstandingLink-8" onclick="NavigateToPopupReportTab(8)">Outstanding</button>
        </div>
    </div>
</div>

<div class="report-outter-container">
    <div class="card-body p-1">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container px-5">
                <!-- 1. Response Summary Tab -->
                <div id="SummaryTab-1" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Summary)
                    </div>
                </div>
                <!-- 2. Response Summary Tab -->
                <div id="ResponseSummaryTab-2" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.QuestionsSummary)
                    </div>
                </div>
                <!-- 3. Response Breakdown Click Tab -->
                <div id="ResponseBreakdownClickTab-3" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseBreakdownClick)
                    </div>
                </div>
                <!-- 4. Response Breakdown Dismiss Tab -->
                <div id="ResponseBreakdownDismissTab-4" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseBreakdownDismiss)
                    </div>
                </div>
                <!-- 5. Response Breakdown AutoHide Tab -->
                <div id="ResponseBreakdownAutoHideTab-5" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseBreakdownAutoHide)
                    </div>
                </div>
                <!-- 6. Response Breakdown Snooze Tab -->
                <div id="ResponseBreakdownSnoozeTab-6" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseBreakdownSnooze)
                    </div>
                </div>
                <!-- 7. Response Breakdown Show Tab -->
                <div id="ResponseBreakdownShowTab-7" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.ResponseBreakdownShow)
                    </div>
                </div>
                <!-- 8. Outstanding Tab -->
                <div id="OutstandingTab-8" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Outstanding)
                    </div>
                </div>
                <!-- Navigation Buttons -->
                <div class="row fix-content-bottom">
                    <div class="col-12 ">
                        <div class="pagination-section flex-column flex-md-row  text-center align-content-center justify-content-center ">
                            <button class="btn section-nav-btns hidden" id="ReportPrevTabBtn" onclick="PreviousReportTab()">Back</button>
                            <button class="btn section-nav-btns ms-3" id="ReportNextTabBtn" onclick="NextReportTab()">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function()
    {
        NavigateToPopupReportTab(1);
    });

</script>