var currentSurveyTab = 1;
var totalSurveyTabs = 9;

var currentSurveyQuestionTab = 1;
var totalSurveyQuestionTabs = 4;

var backBtnId = "SurveyPrevTabBtn"
var nextBtnId = "SurveyNextTabBtn";
var submitBtnId = "AddSurveySubmitBtn";

function ValidateSurveyTabs(currentTab)
{
    if (currentTab == 1) return IsValidSurveyTexts();
    if (currentTab == 2) return IsSurveySkinsTabValid();
    if (currentTab == 4) return IsValidSurveyResponseUrgency();
    if (currentTab == 6) return IsValidDeliveryMethod();

    return true;
}

function ValidateSurveyQuestionsTabs(currentTab)
{
    if (currentTab == 1) return SurveyQuestionTextValid();
    if (currentTab == 2) return SurveyQuestionResponseValid();

    return true;
}

/*============================================= Survey Tabs Navigation ===================================================*/
function PreviousSurveyTab()
{
    if (currentSurveyTab > 1)
    {
        currentSurveyTab = PreviousModuleTab("survey", currentSurveyTab, totalSurveyTabs, backBtnId, nextBtnId, submitBtnId);
    }
}

function NextSurveyTab()
{
    if (currentSurveyTab < totalSurveyTabs)
    {
        if (!ValidateSurveyTabs(currentSurveyTab))
            return;

        currentSurveyTab = NextModuleTab("survey", currentSurveyTab, totalSurveyTabs, backBtnId, nextBtnId, submitBtnId);
    }
}

function NavigateToSurveyTab(navLinkId, tabLinkNumber)
{
    currentSurveyTab = NavigateToModuleTab("survey", navLinkId, tabLinkNumber, currentSurveyTab, backBtnId, nextBtnId, submitBtnId);
}

/*============================================ Survey Questions  ===================================================*/
function NavigateToSurveyQuestionTab(navLinkId, tabLinkNumber)
{
    currentSurveyQuestionTab = NavigateToModuleTab("survey-questions", navLinkId, tabLinkNumber, currentSurveyQuestionTab, backBtnId, nextBtnId, submitBtnId);
}

function PreviousSurveyQuestionTab()
{
    if (currentSurveyQuestionTab > 1)
    {
        currentSurveyQuestionTab = PreviousModuleTab("survey-questions", currentSurveyQuestionTab, totalSurveyQuestionTabs, backBtnId, nextBtnId, submitBtnId);
    }
}

function NextSurveyQuestionTab()
{
    if (currentSurveyQuestionTab < totalSurveyQuestionTabs)
    {
        if (!ValidateSurveyQuestionsTabs(currentSurveyQuestionTab))
            return;

        currentSurveyQuestionTab = NextModuleTab("survey-questions", currentSurveyQuestionTab, totalSurveyQuestionTabs, backBtnId, nextBtnId, submitBtnId);
    }
}

function HideAllSurveyQuestionTabs()
{
    HideShowElement(".survey-questions-wizard-tabs", HideShow.HIDE);
    HideShowElement("#QuestionsTab-1", HideShow.SHOW);
}

function UncheckTrueFalseOptions()
{
    var yesNoId = GetIdOfSelectedRadioInGroup("SurveyScoringYesNoNA");
    var agreeDisAgreeId = GetIdOfSelectedRadioInGroup("SurveyScoringAgreeDisagreeNA");

    CheckOrUncheckInput(yesNoId, false);
    CheckOrUncheckInput(agreeDisAgreeId, false);
}

function EnableSurveyQuestionScoring(event)
{
    if (IsCheckboxChecked("SurveyQuestionScoringToggle"))
    {
        HideShowElement("#SurveyQuestionScoringText", HideShow.SHOW);
        HideShowElement(".survey-select-correct-answer", HideShow.SHOW);
    }
    else
    {
        HideShowElement("#SurveyQuestionScoringText", HideShow.HIDE);
        HideShowElement(".survey-select-correct-answer", HideShow.HIDE);
        UncheckTrueFalseOptions();
    }
}

function SurveyQuestionResponseTypeSelect()
{
    HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.SHOW);

    HideShowElement("#SurveyQuestionAnswerYES-NO", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswerYES-NO .na-option", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA .na-option", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswer-ReArrange", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswer-SingleSelect", HideShow.HIDE);
    HideShowElement("#SurveyQuestionAnswer-MultiSelect", HideShow.HIDE);

    CheckOrUncheckInput("#SurveyQuestionAnswerYES-NO .na-option", false);
    CheckOrUncheckInput("#SurveyQuestionAnswerAGREE-DISAGREE-NA .na-option", false);

    var questionResponseType = $("#SurveyQuestionResponseType").val();

    if (questionResponseType == 0)
    {
        CheckOrUncheckInput("SurveyQuestionScoringToggle", false);
        HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.HIDE);
    }
    else 
    {
        if (questionResponseType == 1 || questionResponseType == 2)
        {
            HideShowElement("#SurveyQuestionAnswerYES-NO", HideShow.SHOW);

            if (questionResponseType == 2)
                HideShowElement("#SurveyQuestionAnswerYES-NO .na-option", HideShow.SHOW);
        }
        else if (questionResponseType == 3 || questionResponseType == 4)
        {
            HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA", HideShow.SHOW);

            if (questionResponseType == 4)
                HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA .na-option", HideShow.SHOW);
        }
        else if (questionResponseType == 5)
        {
            CheckOrUncheckInput("SurveyQuestionScoringToggle", false);
            HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.HIDE);
        }
        else if (questionResponseType == 6)
        {
            HideShowElement("#SurveyQuestionAnswer-ReArrange", HideShow.SHOW);
            CreateSurveyResponseReArrangeOptions("rearrange");
        }
        else if (questionResponseType == 7)
        {
            HideShowElement("#SurveyQuestionAnswer-SingleSelect", HideShow.SHOW);
            CreateSurveyResponseReArrangeOptions("singleselect");
        }
        else if (questionResponseType == 8)
        {
            HideShowElement("#SurveyQuestionAnswer-MultiSelect", HideShow.SHOW);
            CreateSurveyResponseReArrangeOptions("multiselect");
        }
    }
}

function SurveyResponseTypeTrueFalse(id)
{
    var questionResponseType = $("#SurveyQuestionResponseType").val();

    var yesOrNoNotSelected = (questionResponseType == 1 || questionResponseType == 2) && !IsCheckboxChecked("SurveyQuestionScoringToggle")
    var agreeOrDisAgreeNotSelected = (questionResponseType == 3 || questionResponseType == 4) && !IsCheckboxChecked("SurveyQuestionScoringToggle")

    if (yesOrNoNotSelected || agreeOrDisAgreeNotSelected)
    {
        CheckOrUncheckInput(id, false);
        swal("Survey Response Type", "Please first enable Survey Scoring before selecting the correct answer for this Question.", "warning");
    }
}

function CreateSurveyResponseReArrangeOptions(id)
{
    id = id.toLowerCase();

    var prefix = "";

    if (id.includes("rearrange")) prefix = "ReArrange";
    if (id.includes("single")) prefix = "SingleSelect";
    if (id.includes("multi")) prefix = "MultiSelect";

    var destinationDivId = `#SurveyQuestions${prefix}Options`;
    var inputCountsId = `#SurveyAnswer${prefix}Count`;

    var optionsCount = $(inputCountsId).val();

    var htmlOptions = id.includes("select") ? `<div class="mb-0 fs-12 ms-auto w-fit-content fw-bold me-3 text-success survey-select-correct-answer hidden">Correct</div>` : "";

    var answerType = id.includes("single") ? "radio" : "checkbox";

    var hideShowScoring = IsCheckboxChecked("SurveyQuestionScoringToggle") ? "" : "hidden";

    for (var i = 0; i < optionsCount; i++)
    {
        var optionNo = i + 1;

        var slider = id.includes("select") ?
            `<div class="form-check form-switch w-fit-content ms-2 mt-1 survey-select-correct-answer ${hideShowScoring}">
                                <input class="form-check-input" type="${answerType}" name="${prefix}-select" id="${prefix}-select-${optionNo}">
                             </div>` : "";

        htmlOptions += `
                    <div class="d-flex mb-2">
                        <p class="custom-p w-fit-content align-content-center"> Options ${(optionNo)}</p>
                        <input class="custom-input-text w-200p ms-3" type="text" id="${prefix}-Option-${optionNo}"/>
                        ${slider}
                    </div>
                `;
    }

    $(destinationDivId).html(htmlOptions);

    if (id.includes("single"))
    {
        ShowSingleListAsDropdown();
    }
}

function ShowSingleListAsDropdown()
{
    if (IsCheckboxChecked("SurveyAnswerSingleSelectAsDropdownCheck"))
    {
        HideShowElement("#SurveyAnswerSingleSelectAsDropdownContainer", HideShow.SHOW);

        var html = `<select class="custom-input-text w-150p fs-12 h-25p" onclick="UpdateSingleListOptionValues()">`;
        var optionsCount = $("#SurveyAnswerSingleSelectCount").val();

        for (var i = 0; i < optionsCount; i++)
        {
            var optionNo = i + 1;
            var optionText = $(`#SingleSelect-Option-${optionNo}`).val();

            optionText = StringNullOrEmpty(optionText) ? `option ${optionNo}` : optionText;

            html += `<option id="single-drop-option-${optionNo}" value="">${optionText}</option>`;
        }
        html += "</select>";
        $("#SurveyAnswerSingleSelectAsDropdownData").html(html);
    }
    else
    {
        HideShowElement("#SurveyAnswerSingleSelectAsDropdownContainer", HideShow.HIDE);
    }
}

function UpdateSingleListOptionValues()
{
    var optionsCount = $("#SurveyAnswerSingleSelectCount").val();

    for (var i = 0; i < optionsCount; i++)
    {
        var optionNo = i + 1;
        var optionText = $(`#SingleSelect-Option-${optionNo}`).val();

        optionText = StringNullOrEmpty(optionText) ? `option ${optionNo}` : optionText;

        $(`#single-drop-option-${optionNo}`).text(optionText);
    }
}

function SurveyQuestionDatePickerSettings()
{
    $("#SurveyQuestionCalendarStartTime").flatpickr({
        dateFormat: "Y-m-d", // Internal format (ISO 8601)
        altInput: true,      // Display formatted date
        altFormat: "l, d F Y, H:i", // Custom display format (e.g., Thursday, 03 October 2024, 17:00)
        minDate: "today",    // Disable past dates
        defaultDate: "today",  // Set initial date to today
        allowInput: true,
        enableTime: true,
    });

    $("#SurveyQuestionCalendarEndTime").flatpickr({
        dateFormat: "Y-m-d", // Internal format (ISO 8601)
        altInput: true,      // Display formatted date
        altFormat: "l, d F Y, H:i", // Custom display format (e.g., Thursday, 03 October 2024, 17:00)
        minDate: "today",    // Disable past dates
        defaultDate: "today",  // Set initial date to today
        allowInput: true,
        enableTime: true,
    });
}

function PopuplateTimeIntervals()
{
    let timeIntervals = [];

    timeIntervals.push('0 minutes');
    timeIntervals.push('5 minutes');
    timeIntervals.push('10 minutes');
    timeIntervals.push('15 minutes');
    timeIntervals.push('30 minutes');

    for (let hour = 1; hour <= 11; hour++)
    {
        timeIntervals.push(hour + ' hour' + (hour > 1 ? 's' : ''));
    }

    timeIntervals.push('0.5 days (12 hours)');
    timeIntervals.push('18 hours');

    for (let day = 1; day <= 4; day++)
    {
        timeIntervals.push(day + ' day' + (day > 1 ? 's' : ''));
    }

    timeIntervals.push('1 week');
    timeIntervals.push('2 weeks');

    return timeIntervals;
}

function CreateSurveyQuestionsReminderOptions()
{
    let timeIntervals = PopuplateTimeIntervals();

    let selectElement = document.getElementById('SurveyQuestionCalendarReminder');

    timeIntervals.forEach(function (interval)
    {
        let option = document.createElement('option');
        option.value = interval;
        option.text = interval;
        selectElement.appendChild(option);
    });
}

