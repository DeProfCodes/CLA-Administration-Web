function ToggleSurveyQuestionType(id, surveyQuestionType)
{
    if (IsCheckboxChecked(id))
    {
        HideShowElement(`#SurveyQuestion${surveyQuestionType}Container`, HideShow.SHOW);
    }
    else
    {
        HideShowElement(`#SurveyQuestion${surveyQuestionType}Container`, HideShow.HIDE);
    }
}

function SurveyQuestionSelectType(id, surveyQuestionType)
{
    var option = $(`#${id}`).val();

    var questionTextHTML = "";
    var qualifyingOptionsHTML = "";

    if (option == 0)
    {
        HideShowElement(`#SurveyQuestion${surveyQuestionType}AnswerOptionsContainer`, HideShow.HIDE);
        depedencyQuestionType = SurveyQuestionResponseTypes.NONE;
    }
    else 
    {
        HideShowElement(`#SurveyQuestion${surveyQuestionType}AnswerOptionsContainer`, HideShow.SHOW);
        HideShowElement(`#Add${surveyQuestionType}Question`, HideShow.SHOW);

        if (option == 1)
        {
            questionTextHTML = "Do you like CLA, with all your heart?";

            qualifyingOptionsHTML = `
                                     <div id="SurveyQuestion${surveyQuestionType}AnswerYES-NO" class="p-3 ms-3">
                                         <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                             <input class="form-check-input" type="radio" name="Survey${surveyQuestionType}YesNoNA" id="Survey${surveyQuestionType}YESNO-YES" onclick="SurveyQuestion${surveyQuestionType}OptionSelect(this.id)">
                                             <label class="form-check-label" for="Survey${surveyQuestionType}YESNO-YES" id="Survey${surveyQuestionType}YESNO-YES-txt">Yes</label>
                                         </div>
                                         <div class= "form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                             <input class= "form-check-input" type="radio" name="Survey${surveyQuestionType}YesNoNA" id="Surve${surveyQuestionType}YESNO-NO" onclick="SurveyQuestion${surveyQuestionType}OptionSelect(this.id)">
                                             <label class="form-check-label" for="Survey${surveyQuestionType}YESNO-NO" id="Survey${surveyQuestionType}YESNO-NO-txt">No</label>
                                         </div>
                                     </div>`;

            depedencyQuestionType = SurveyQuestionResponseTypes.YES_NO;
        }
        else if (option == 2)
        {
            var singleSelectOptions = ["Banana", "Apple", "Pear", "Orange"];

            questionTextHTML = "What is your favorite fruit?";

            qualifyingOptionsHTML = `<div id="SurveyQuestionAnswer-${surveyQuestionType}-SingleSelect" class="p-3 ms-3">`;

            for (var i = 0; i < singleSelectOptions.length; i++)
            {
                var optionNo = i + 1;

                qualifyingOptionsHTML += `
                        <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-1">
                            <input class="form-check-input" type="radio" name="SurveyQuestionAnswer-SingleSelect-Options" id="SurveyQuestion${surveyQuestionType}-SingleOption-${optionNo}" onclick="SurveyQuestionCalendarOptionSelect(this.id)">
                            <label class="form-check-label" for="SurveyQuestion${surveyQuestionType}-SingleOption-${optionNo}" id="SurveyQuestion${surveyQuestionType}-SingleOption-${optionNo}-txt">${singleSelectOptions[i]}</label>
                        </div>`;
            }

            qualifyingOptionsHTML += `</div>`;
            depedencyQuestionType = SurveyQuestionResponseTypes.SINGLE_SELECT;
        }

        var selectedOptionText = GetTextOfSelectedOptionInSelectList(id);

        $(`#Survey${surveyQuestionType}QuestionNo`).text(selectedOptionText);
        $(`#Survey${surveyQuestionType}QuestionTextPreviewer`).html(questionTextHTML);
        $(`#SurveyQuestion${surveyQuestionType}Options`).html(qualifyingOptionsHTML);
    }
}

function AddSurveyQuestionType(surveyQuestionType)
{
    var option = $(`#SurveyQuestion${surveyQuestionType}Type`).val();
    var answerRadioId = "";
    if (depedencyQuestionType == SurveyQuestionResponseTypes.YES_NO)
    {
        if (!RadioGroupHasAtLeastOneChecked(`Survey${surveyQuestionType}YesNoNA`))
        {
            swal(`Survey Question ${surveyQuestionType} Error`, `Please select a ${surveyQuestionType} response to the question.`, "error");
            return;
        }
        answerRadioId = GetIdOfSelectedRadioInGroup(`Survey${surveyQuestionType}YesNoNA`);
    }
    else if (depedencyQuestionType == SurveyQuestionResponseTypes.SINGLE_SELECT)
    {
        if (!RadioGroupHasAtLeastOneChecked("SurveyQuestionAnswer-SingleSelect-Options"))
        {
            swal(`Survey Question ${surveyQuestionType} Error`, `Please select a ${surveyQuestionType} response to the question.`, "error");
            return;
        }
        answerRadioId = GetIdOfSelectedRadioInGroup("SurveyQuestionAnswer-SingleSelect-Options");
    }

    var dependentQuestion = GetTextOfSelectedOptionInSelectList(`SurveyQuestion${surveyQuestionType}Type`);
    var dependentAnswer = $(`#${answerRadioId}-txt`).text();

    var newRow = `
                      <tr>
                          <td><input type="checkbox" class="row-checkbox"/></td>
                          <td>${dependentQuestion}</td>
                          <td>${dependentAnswer}</td>
                      </tr>`;

    $(`#SurveyQuestions${surveyQuestionType}Selection-Body`).append(newRow);
    HideShowElement(`#RemoveSelected${surveyQuestionType}`, HideShow.SHOW);
}

function RemoveSurveyQuestionType(surveyQuestionType)
{
    $(`#SurveyQuestions${surveyQuestionType}Selection tbody tr`).each(function ()
    {
        var checkbox = $(this).find('input.row-checkbox');

        if (checkbox.is(':checked'))
        {
            $(this).remove();

            if ($(`#SurveyQuestions${surveyQuestionType}Selection tbody tr`).length == 0)
            {
                HideShowElement(`#RemoveSelected${surveyQuestionType}`, HideShow.HIDE);
            }
        }
        else 
        {
            swal(`Survey Question ${surveyQuestionType} Error`, `Please select a ${surveyQuestionType} row to remove it from the question.`, "error");
        }
    });
}

function SurveyQuestionCalendarOptionSelect(id)
{
    HideShowElement("#SurveyQuestionCalendarFormContainer", HideShow.SHOW);
}

function SurveyQuestionTextValid()
{
    $("#SurveyQuestionTitleError").text("");
    $("#SurveyQuestionTitleError").text("");

    var isValid = true;

    if (IsEmptyText("SurveyQuestionTitle"))
    {
        $("#SurveyQuestionTitleError").text("please enter title.");
        isValid = false;
    }
    if (IsEmptyText("SurveyQuestionDetails"))
    {
        $("#SurveyQuestionDetailsError").text("please enter question text.");
        isValid = false;
    }

    if (!isValid)
    {
        swal("Survey Question Text Error", "Please enter both survey question title and question text.", "error");
    }
    return isValid;
}

function SurveyQuestionResponseValid()
{
    var questionResponseType = $("#SurveyQuestionResponseType").val();

    if (questionResponseType == 0)
    {
        swal("Survey Question Response Type Error", "Please select Response Type.", "error");
        return false;
    }
    else
    {
        var scoringEnable = IsCheckboxChecked("SurveyQuestionScoringToggle");
        if (questionResponseType < 5 && scoringEnable)
        {
            var yesOrNoNotSelected = (questionResponseType == 1 || questionResponseType == 2) && !RadioGroupHasAtLeastOneChecked("SurveyScoringYesNoNA");

            var agreeOrDisAgreeNotSelected = (questionResponseType == 3 || questionResponseType == 4) && !RadioGroupHasAtLeastOneChecked("SurveyScoringAgreeDisagreeNA");

            if (yesOrNoNotSelected || agreeOrDisAgreeNotSelected)
            {
                swal("Survey Question Response Type Error", "Please select correct answer for this SCORED question.", "error");
                return false;
            }
        }
        else if (questionResponseType != 5)
        {
            var singleSelect = (questionResponseType == 7) && !RadioGroupHasAtLeastOneChecked("SingleSelect-select");
            var multiSelect = (questionResponseType == 8) && !RadioGroupHasAtLeastOneChecked("MultiSelect-select");

            if (singleSelect || multiSelect)
            {
                swal("Survey Question Response Type Error", "Please select correct answer for this SCORED question.", "error");
                return false;
            }
        }
    }
    return true;
}

