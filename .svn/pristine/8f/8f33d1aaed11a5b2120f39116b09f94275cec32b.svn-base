@model CLA_Administration_Web.ViewModels.Reports.PopupReportViewModel

@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Reports

@{
    var labels_1 = new List<string> { "Delivered", "Not Delivered" };
    var colors_1 = new List<string> { "green", "crimson" };
    var data_1 = new List<int> { 8, 1 };
    var total_1 = data_1.Sum(x => x);

    var labels_2 = new List<string> { "Click", "Dismiss", "Autohide", "Snooze", "Show" };
    var colors_2 = new List<string> { "blue", "orange", "crimson", "slate", "silver" };
    var data_2 = new List<int> { 107, 55, 23, 12, 17 };
    var total_2 = data_2.Sum(x => x);
}


<div class="container-fluid">

    @{
        <!-- Breadcrumb Component -->
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ReportBreadcrumb.cshtml", new ReportBreadcrumbViewModel
            {
                ReportCurrentPage = ReportsPages.PopupReport,
                HasLinkedModulePage = true,
                LinkedModulePage = ModulesPages.PopupOverview
            });

        <!-- Report Filter Component -->
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportFilter.cshtml", new ModuleReportFilterViewModel
            {
                ModuleName = ModuleNamesType.Popup
            });
    }

    <!-- Card for Popup Report Body -->
    <div class="card mb-4 mt-2 overview-filters-card theme-txt-clr app-card-main-scaling">
        <div class="card-body p-3 pb-0">
            <!-- Report Type -->
            <div class="row mt-3">
                <div class="btn-group w-auto overview-filter-btn-group mx-auto">
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-1" id="SummaryLink-1" onclick="NavigateToPopupReportTab(1)">Popup Summary</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-2" id="ResponseSummaryLink-2" onclick="NavigateToPopupReportTab(2)">Response Summary</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-3" id="ResponseClikcLink-3" onclick="NavigateToPopupReportTab(3)">Response (Click)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-4" id="ResponseDismissLink-4" onclick="NavigateToPopupReportTab(4)">Response (Dismiss)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-5" id="ResponseAutoHideLink-5" onclick="NavigateToPopupReportTab(5)">Response (Autohide)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-6" id="ResponseSnoozeLink-6" onclick="NavigateToPopupReportTab(6)">Response (Snooze)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-7" id="ResponseShowLink-7" onclick="NavigateToPopupReportTab(7)">Response (Show)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-8" id="OutstandingLink-8" onclick="NavigateToPopupReportTab(8)">Outstanding</button>
                </div>
            </div>
        </div>

        <div class="report-outter-container">
            <div class="card-body">
                <div class="row flex-sm-nowrap">
                    <div class="flex-wrap report-body-container px-5">
                        <!-- 1. Response Summary Tab -->
                        <div id="SummaryTab-1" class="report-module-tabs-popup hidden">
                            <h5 class="fw-bold text-center">1. Popup Summary</h5>
                            <div class="row mt-2 mb-2">
                                <div class="w-50">
                                    <p class="custom-p fs-16 fw-bold">(54) WPS Status Popup</p>
                                    <p class="custom-p mt-1">Effective from <span class="fw-bold">2020/02/14</span> to <span class="fw-bold">2024/08/23</span></p>

                                    <table class="table table-bordered mb-0 w-400p mt-3 hidden">
                                        <thead>
                                            <tr>
                                                <th scope="col">Event</th>
                                                <th scope="col">Count</th>
                                                <th scope="col">Percentage (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < data_1.Count; i++)
                                            {
                                                var bgColor = $"report-piechart-color-{colors_1[i]}-dim";
                                                var percent = Math.Round(((data_1[i] / (double)total_1) * 100.0), 2);
                                                <tr>
                                                    <td class="@bgColor">@labels_1[i]</td>
                                                    <td class="@bgColor">@data_1[i]</td>
                                                    <td class="@bgColor w-150p">@percent</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td>Targeted</td>
                                                <td>@total_1</td>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="w-50 mt-5">
                                    <div id="PopupReportSummaryChart">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <iframe src="@Url.Action("ShowLocalReport", "Reports")" width="100%" height="800px"></iframe>
                            </div>
                        </div>
                        <!-- 2. Response Summary Tab -->
                        <div id="ResponseSummaryTab-2" class="report-module-tabs-popup hidden">
                            <h5 class="fw-bold text-center">2. Popup Question Summary</h5>
                            <div class="row">
                                <div class="w-50">
                                    <p class="custom-p fs-16 fw-bold">(54) WPS Status Popup</p>
                                    <p class="custom-p mt-1">Effective from <span class="fw-bold">2020/02/14</span> to <span class="fw-bold">2024/08/23</span></p>
                                    <table class="table table-bordered mb-0 w-400p mt-3">
                                        <thead>
                                            <tr>
                                                <th scope="col">Event</th>
                                                <th scope="col">Count</th>
                                                <th scope="col">Percentage (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < data_2.Count; i++)
                                            {
                                                var bgColor = $"report-piechart-color-{colors_2[i]}-dim";
                                                var percent = Math.Round(((data_2[i] / (double)total_2) * 100.0), 2);
                                                <tr>
                                                    <td class="@bgColor">@labels_2[i]</td>
                                                    <td class="@bgColor">@data_2[i]</td>
                                                    <td class="@bgColor w-150p">@percent</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td>Total</td>
                                                <td>@total_2</td>
                                                <td>100</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="w-50 mt-5">
                                    <div id="PopupReportResponseSummaryChart">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Navigation Buttons -->
                        <div class="row fix-content-bottom">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn section-nav-btns hidden" id="ReportPrevTabBtn" onclick="PreviousReportTab()">Back</button>
                                    <button class="btn section-nav-btns ms-3" id="ReportNextTabBtn" onclick="NextReportTab()">Next</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<script>
    var labels_1 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(labels_1));
    var data_1 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(data_1));
    var colors_1 = ["#16a085", "#B22222"];
    let apexPieChart1;

    var labels_2 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(labels_2));
    var data_2 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(data_2));
    var colors_2 = ["#4169E1", "#FF8C00", "#B22222", "#2F4F4F", "#C0C0C0"];
    let apexPieChart2;

    $(document).ready(function()
    {
        NavigateToPopupReportTab(1);
    });

    //DrawPieChart(apexPieChart1, "#PopupReportSummaryChart", data_1, labels_1, colors_1);
    //DrawPieChart(apexPieChart2, "#PopupReportResponseSummaryChart", data_2, labels_2, colors_2);

</script>