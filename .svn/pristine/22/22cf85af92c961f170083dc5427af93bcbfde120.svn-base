@model int

@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Modules.Components.Form
@using CLA_Administration_Web.ViewModels.Modules.PST

@{
    var surveySkin = $"{LaunchSettingsHelper.GetBaseAddressForImages()}/images/others/modules/skins/SurveyBackground.bmp";

}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Survey Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Survey</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Overview</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.SurveyDetails', '@Model');">@Model</span> /
                <span class="breadcrumb-item">Add New Survey Question</span>
            </p>
        </div>
    </div>

    <!-- Card for Filters -->
    <div class="card mb-4 mt-5 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Add New Survey Question for Survey Id: @Model</h4>
        </div>
    </div>


    <div class="card module-wizard-container">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link T-1 active" id="TextsTabLink-1" onclick="NavigateToSurveyQuestionTab(this.id, 1)">
                            Question Details<i class="bi bi-dot module-nav-link-dot T-1 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-2" id="ResponseScoringTabLink-2" onclick="NavigateToSurveyQuestionTab(this.id, 2)">
                            Response & Scoring <i class="bi bi-dot module-nav-link-dot T-2 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-3" id="DependenciesTabLink-3" onclick="NavigateToSurveyQuestionTab(this.id, 3)">
                            Dependencies <i class="bi bi-dot module-nav-link-dot T-3 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-4" id="CalendarTabLink-4" onclick="NavigateToSurveyQuestionTab(this.id, 4)">
                            Calendar <i class="bi bi-dot module-nav-link-dot T-4 hidden"></i>
                        </a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap" id="ModuleWizardMain">
                    <div class="form-horizontal theme-txt-clr" id="popupForm">
                        <!-- Question Details Tab -->
                        <div id="QuestionsTab-1" class="survey-questions-wizard-tabs  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold mt-4">1. Survey Title, Introduction & Conclusion</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Enter survey texts.</p>
                            <!-- Question Title Title input-->
                            <div class="row mt-4 me-5">
                                <div class="col-sm-2 ms-auto">
                                    <label class="fw-bold text-center fl-right">Question Title:</label>
                                </div>
                                <div class="w-fit-content me-auto">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyQuestionTitle",
                                            HeightPx = "55px",
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = false,
                                            MaxCharacterCount = 25,
                                        });
                                    }
                                </div>
                            </div>
                            <!-- Introduction input-->
                            <div class="row mt-2 me-5">
                                <div class="col-sm-2 ms-auto">
                                    <label class="fw-bold text-center fl-right">Question</label>
                                </div>
                                <div class="w-fit-content me-auto">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyQuestionDetails",
                                            HeightPx = "120px",
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = true,
                                            DestinationTextDivId = "SurveyQuestionTextPreviewer"
                                        });
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- ResponseScoring Tab -->
                        <div id="ResponseScoringTab-2" class="survey-questions-wizard-tabs flex-wrap justify-content-center mb-5 ps-2 hidden">
                            <h5 class="fw-bold mt-4 text-center">2. Survey Response & Scoring </h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select survey question type, response type, and scoring</p>
                            
                            <div class="mx-auto w-fit-content mt-5">
                                <div class="row mt-4">
                                    <div class="col-sm-2 ">
                                        <label class="fw-bold text-center fl-right w-max-content">Question Type:</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <div class="form-check form-switch w-fit-content mb-0">
                                            <label class="form-check-label fs-14" for="ShowHideSurveyTitle">Is Anonymous ?</label>
                                            <input class="form-check-input" type="checkbox" id="ShowHideSurveyTitle">
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-sm-2 align-content-center">
                                        <label class="fw-bold text-center fl-right w-max-content">Response Type</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <select class="form-control ml-3 w-50 w-300p fs-14 " id="SurveyQuestionResponseType" style="appearance:menulist" onchange="SurveyQuestionResponseTypeSelect()">
                                            <option value="0" selected>Please select response type...</option>
                                            <option value="1">Yes / No</option>
                                            <option value="2">Yes / No / NA</option>
                                            <option value="3">Agree / Disagree</option>
                                            <option value="4">Agree / Disagree / Na</option>
                                            <option value="5">Text</option>
                                            <option value="6">Re-Arrange</option>
                                            <option value="7">Single Select</option>
                                            <option value="8">Multi Select</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row mt-4 ">
                                    <div class="col-sm-2 ">
                                        <label class="fw-bold text-center fl-right w-max-content">Survey Scoring</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <div id="SurveyQuestionScoringToggleContainer">
                                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                <input class="form-check-input" type="checkbox" name="SurveyScoringYesNo" id="SurveyQuestionScoringToggle" onclick="EnableSurveyQuestionScoring(event)">
                                                <label class="form-check-label cursor-pointer" for="SurveyQuestionScoringToggle">Enable</label>
                                            </div>
                                        </div>
                                        <div id="SurveyQuestionScoringOptionsContainer" class="hidden w-400p">
                                            <div class="theme-border p-2" id="QuestionContainer">
                                                <p class="custom-p fw-bold text-center fs-16">Question</p>
                                                <p class="custom-p html-text-editor" id="SurveyQuestionTextPreviewer"></p>
                                            </div>
                                            <div class="theme-border" id="QuestionOptionsContainer">
                                                <p class="custom-p fw-bold text-center fs-16 mx-auto px-5 w-fit-content border-2 theme-border-bottom">Qualifying Options</p>
                                                <!-- Yes/No/NA -->
                                                <div id="SurveyQuestionAnswerYES-NO" class="hidden p-3 ms-3">
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-YES">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-YES">Yes</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-NO">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-NO">No</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2 hidden na-option">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-NA">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-NA">NA</label>
                                                    </div>
                                                </div>
                                                <!-- Agree/Disagree/NA -->
                                                <div id="SurveyQuestionAnswerAGREE-DISAGREE-NA" class="hidden p-3 ms-3">
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-Agree">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-Agree">Agree</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-Disagree">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-Disagree">Disagree</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2 hidden na-option">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-NA">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-NA">NA</label>
                                                    </div>
                                                </div>
                                                <!-- ReArrange -->
                                                <div id="SurveyQuestionAnswer-ReArrange" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerReArrangeCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerReArrangeCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)"/>
                                                    </div>
                                                    <div id="SurveyQuestionsReArrangeOptions" class="mt-3">
                                                    </div>
                                                </div>
                                                <!-- Single Select -->
                                                <div id="SurveyQuestionAnswer-SingleSelect" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerSingleSelectCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerSingleSelectCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)" />
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="checkbox" id="SurveyAnswerSingleSelectAsDropdownCheck" onchange="ShowSingleListAsDropdown()">
                                                        <label class="form-check-label fs-12" for="SurveyAnswerSingleSelectAsDropdownCheck">Show as a dropdown</label>
                                                    </div>
                                                    <div class="d-flex mt-2 hidden" id="SurveyAnswerSingleSelectAsDropdownContainer">
                                                        <p class="custom-p w-fit-content align-content-center fst-italic fs-12">Dropdown Preview</p>
                                                        <div id="SurveyAnswerSingleSelectAsDropdownData" class="w-fit-content ms-3"></div>
                                                    </div>
                                                    <div id="SurveyQuestionsSingleSelectOptions" class="mt-3">
                                                    </div>
                                                </div>
                                                <!-- Multi Select -->
                                                <div id="SurveyQuestionAnswer-MultiSelect" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerMultiSelectCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)" />
                                                    </div>
                                                    <div id="SurveyAnswerMultiSelectCountContainer" class="d-flex mt-3 fs-12">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">Required Selections</p>
                                                        <input class="custom-input-text w-50p  ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectMIN" />
                                                        <p class="custom-p fw-bold w-fit-content align-content-center ms-1"> = MIN</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectMAX" />
                                                        <p class="custom-p fw-bold w-fit-content align-content-center ms-1"> = MAX</p>
                                                    </div>
                                                    <div id="SurveyQuestionsMultiSelectOptions" class="mt-3">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Dependencies Tab -->
                        <div id="DependenciesTab-3" class="survey-questions-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Survey Effective Dates & Timeslots</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please define the date and time range that the Survey must display</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                Tip:In order to maximize exposure, we recommend that the date range span over multiple calendar weeks (Thursday to Thursday) and setting the time
                                to be as long as possible (e.g 07h00 to 19h00).
                            </p>

                        </div>
                        <!-- Calendar Options Tab -->
                        <div id="CalendarTab-4" class="survey-questions-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Survey Effective Dates & Timeslots</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please define the date and time range that the Survey must display</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                Tip:In order to maximize exposure, we recommend that the date range span over multiple calendar weeks (Thursday to Thursday) and setting the time
                                to be as long as possible (e.g 07h00 to 19h00).
                            </p>
                            
                        </div>
                        
                        <!-- Navigation Buttons -->
                        <div class="row fix-content-bottom" style="margin-left:100px">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn module-wizard-nav-btns hidden" id="SurveyPrevTabBtn" onclick="PreviousSurveyQuestionTab()">Back</button>
                                    <button class="btn module-wizard-nav-btns" id="SurveyNextTabBtn" onclick="NextSurveyQuestionTab()">Next</button>
                                    <button class="btn module-new-submit-btn hidden" id="AddSurveySubmitBtn">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
}


<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/modules/survey.js"></script>

<script>

    $(document).ready(function ()
    {
        HideAllSurveyQuestionTabs();
    });

    function HideAllSurveyQuestionTabs()
    {
        HideShowElement(".survey-questions-wizard-tabs", HideShow.HIDE);
        HideShowElement("#QuestionsTab-1", HideShow.SHOW);
    }

    function EnableSurveyQuestionScoring(event)
    {
        var questionResponseType = $("#SurveyQuestionResponseType").val();

        if (questionResponseType == 0)
        {
            event.preventDefault();
            swal("Survey Question Response Type", "Please select survey Response Type before selecting Scoring.", "warning");
        }
        else if (questionResponseType == 5)
        {
            event.preventDefault();
            swal("Survey Question Response Type", "TEXT response type cannot be scored.", "info");
        }
        else
        {
            HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.SHOW);
        }

        if (!IsCheckboxChecked("SurveyQuestionScoringToggle"))
        {
            HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.HIDE);
        }
    }

    function SurveyQuestionResponseTypeSelect()
    {

        HideShowElement("#SurveyQuestionAnswerYES-NO", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswerYES-NO .na-option", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA .na-option", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswer-ReArrange", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswer-SingleSelect", HideShow.HIDE);
        HideShowElement("#SurveyQuestionAnswer-MultiSelect", HideShow.HIDE);

        var questionResponseType = $("#SurveyQuestionResponseType").val();
        if (questionResponseType == 0)
        {
            CheckOrUncheckInput("SurveyQuestionScoringToggle", false);
            HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.HIDE);
        }
        else 
        {
            if (questionResponseType == 1 || questionResponseType == 2)
            {
                HideShowElement("#SurveyQuestionAnswerYES-NO", HideShow.SHOW);
                
                if(questionResponseType == 2)
                    HideShowElement("#SurveyQuestionAnswerYES-NO .na-option", HideShow.SHOW);
            }
            else if (questionResponseType == 3 || questionResponseType == 4)
            {
                HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA", HideShow.SHOW);

                if (questionResponseType == 4)
                    HideShowElement("#SurveyQuestionAnswerAGREE-DISAGREE-NA .na-option", HideShow.SHOW);
            }
            else if (questionResponseType == 5)
            {
                CheckOrUncheckInput("SurveyQuestionScoringToggle", false);
                HideShowElement("#SurveyQuestionScoringOptionsContainer", HideShow.HIDE);
            }
            else if(questionResponseType == 6)
            {
                HideShowElement("#SurveyQuestionAnswer-ReArrange", HideShow.SHOW);
                CreateSurveyResponseReArrangeOptions("rearrange");
            }
            else if(questionResponseType == 7)
            {
                HideShowElement("#SurveyQuestionAnswer-SingleSelect", HideShow.SHOW);
                CreateSurveyResponseReArrangeOptions("singleselect");
            }
            else if (questionResponseType == 8)
            {
                HideShowElement("#SurveyQuestionAnswer-MultiSelect", HideShow.SHOW);
                CreateSurveyResponseReArrangeOptions("multiselect");
            }
        }
    }

    function CreateSurveyResponseReArrangeOptions(id)
    {
        id = id.toLowerCase();

        var prefix = "";

        if (id.includes("rearrange")) prefix = "ReArrange";
        if (id.includes("single")) prefix = "SingleSelect";
        if (id.includes("multi")) prefix = "MultiSelect";

        var destinationDivId = `#SurveyQuestions${prefix}Options`;
        var inputCountsId = `#SurveyAnswer${prefix}Count`;

        var optionsCount = $(inputCountsId).val();

        var htmlOptions = id.includes("select") ? `<div class="mb-0 fs-12 ms-auto w-fit-content fw-bold me-3 text-success">Correct</div>` : "";

        var answerType = id.includes("single") ? "radio" : "checkbox";

        for(var i=0; i < optionsCount; i++)
        {
            var optionNo = i+1;
            
            var slider = id.includes("select") ?
                            `<div class="form-check form-switch w-fit-content ms-2 mt-1">
                                <input class="form-check-input" type="${answerType}" name="${prefix}-select" id="${prefix}-select-${optionNo}">
                             </div>` : "";

            htmlOptions += `
                    <div class="d-flex mb-2">
                        <p class="custom-p w-fit-content align-content-center"> Options ${(optionNo)}</p>
                        <input class="custom-input-text w-200p ms-3" type="text" id="${prefix}-Option-${optionNo}"/>
                        ${slider}
                    </div>
                `;
        }

        $(destinationDivId).html(htmlOptions);

        if(id.includes("single"))
        {
            ShowSingleListAsDropdown();
        }
    }

    function ShowSingleListAsDropdown()
    {
        if (IsCheckboxChecked("SurveyAnswerSingleSelectAsDropdownCheck"))
        {
            HideShowElement("#SurveyAnswerSingleSelectAsDropdownContainer", HideShow.SHOW);

            var html = `<select class="custom-input-text w-150p fs-12 h-25p" onclick="UpdateSingleListOptionValues()">`;
            var optionsCount = $("#SurveyAnswerSingleSelectCount").val();
            
            for (var i = 0; i < optionsCount; i++)
            {
                var optionNo = i + 1;
                var optionText = $(`#SingleSelect-Option-${optionNo}`).val();

                optionText = StringNullOrEmpty(optionText) ? `option ${optionNo}` : optionText;

                html += `<option id="single-drop-option-${optionNo}" value="">${optionText}</option>`;
            }
            html += "</select>";
            $("#SurveyAnswerSingleSelectAsDropdownData").html(html);
        }
        else
        {
            HideShowElement("#SurveyAnswerSingleSelectAsDropdownContainer", HideShow.HIDE);
        }
    }

    function UpdateSingleListOptionValues()
    {
        var optionsCount = $("#SurveyAnswerSingleSelectCount").val();

        for (var i = 0; i < optionsCount; i++)
        {
            var optionNo = i + 1;
            var optionText = $(`#SingleSelect-Option-${optionNo}`).val();

            optionText = StringNullOrEmpty(optionText) ? `option ${optionNo}` : optionText;

            $(`#single-drop-option-${optionNo}`).text(optionText);
        }
    }


</script>