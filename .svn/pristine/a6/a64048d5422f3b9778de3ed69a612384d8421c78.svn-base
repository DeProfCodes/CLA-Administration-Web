@model CLA_Administration_Web.ViewModels.Modules.Rss.RssCategoryOverviewViewModel
@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.RSSCategoryDetails, itemId = Model.CategoryId })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">RSS Category Details for Category Id: @Model.CategoryId</h4>
        </div>
    </div>

    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="w-fit-content" id="RSSCategoryDetailsContainer">
                    <h4 class="w-100 theme-txt-clr fw-bold">RSS Category Details</h4>
                    <div class="row mt-4">
                        <table>
                            <tr>
                                <td><p class="custom-p popup-info-headings mt-3">Category Id</p></td>
                                <td><p class="custom-p-bold ms-3 mt-3">@Model.CategoryId</p></td>
                            </tr>
                            <tr class="mt-3">
                                <td><p class="custom-p popup-info-headings mt-3">Category Name</p></td>
                                <td><p class="custom-p-bold ms-3 mt-3">@Model.CategoryName</p></td>
                            </tr>
                            <tr>
                                <td><p class="custom-p popup-info-headings mt-3">Category Description</p></td>
                                <td><p class="custom-p-bold ms-3 mt-3">@Model.CategoryDescription</p></td>
                            </tr>
                        </table>
                    </div>
                    <div class="mt-4 ms-3">
                        <button class="btn btn-sm btn-success" onclick="OpenPage('@ModulesPages.RSSAddNewFeed', '@Model.CategoryId');">Create New Feed</button>
                        <button class="btn btn-sm btn-primary ms-2" onclick="OpenPage('@ModulesPages.RSSFeedOverview', '@Model.CategoryId');">Open Category Feed</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>