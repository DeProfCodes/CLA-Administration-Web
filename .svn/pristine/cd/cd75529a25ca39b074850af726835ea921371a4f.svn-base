@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.DesktopOverview })

      <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.DesktopOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataTables", new { page = ModulesPages.DesktopOverview })

</div>

<script>

    $(document).ready(function ()
    {
        LoadDesktopsDefaultOverviewData();
    });

    function LoadDesktopsDefaultOverviewData()
    {
        FilterModuleDataOverviewByStatus('Desktop', `ActiveDesktopBtnFilter`, AllStatusTypes.Active);
    }

</script>