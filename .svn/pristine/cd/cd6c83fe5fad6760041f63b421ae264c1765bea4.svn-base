@model CLA_Administration_Web.ViewModels.Modules.LDS.AddNewContentLibraryCategory
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

@{
    var treeParents = !string.IsNullOrEmpty(Model.ContentLibraryParents) ? $"{Model.ContentLibraryParents} > " : "";
}

<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.AddNewContentLibraryCategory })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">Add Content Library Category</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;min-height:500px">
        <div class="card-body">
            <div class="row theme-txt-clr">
                <h5 class="fw-bold mt-3 text-center">Category Details</h5>
                <div class="form-border-inputs-content-library">
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <div class="row mt-3 mb-4">
                            <div class="common-titles-col">
                                <p class="custom-p fl-right">Parent Category</p>
                            </div>
                            <div class="common-titles-value-col">
                                <p class="fs-14 mb-0">
                                    <span class="fst-italic theme-txt-clr">@treeParents</span>
                                    <span class="fw-bold text-success">@Model.CategoryName</span>
                                </p>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">New Category Name</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewContentLibCategoryName" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Category Description</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewContentLibCategoryDescription" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewContentLibCategoryDescriptionError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">User Last Modified</p>
                        </div>
                        <div class="common-titles-value-col">
                            <p class="custom-p fw-bold">NDHUVAZIM</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Machine Last Modified</p>
                        </div>
                        <div class="common-titles-value-col">
                            <p class="custom-p fw-bold">Proficient-PC</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Targeting</p>
                        </div>
                        <div class="common-titles-value-col">
                            <button class="btn btn-warning btn-sm" onclick="OpenTargetedEntityPreviewModal('@ModuleNamesType.ContentLibrary', false)">Set Content Targeting</button>
                            <button class="btn btn-info btn-sm ms-2" onclick="OpenTargetingExposurePreviewModal('@ModuleNamesType.ContentLibrary')">Open Targeting</button>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-sm btn-success px-5" onclick="SubmitNewContentLibraryCategory()">Save Category</button>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
}

<script>

    function ValidateContentLibraryCategory()
    {
        $("#NewContentLibCategoryNameError").text("");
        $("#NewContentLibCategoryDescriptionError").text("");

        var valid = true;

        if (IsEmptyInput("NewContentLibCategoryName"))
        {
            $("#NewContentLibCategoryNameError").text("please enter category name");
            valid = false;
        }
        if (IsEmptyInput("NewContentLibCategoryDescription"))
        {
            $("#NewContentLibCategoryDescriptionError").text("please enter category description");
            valid = false;
        }

        if (!valid)
        {
            swal("New Category Success", "Please enter all required fields", "error");
        }
        return valid;
    }

    function SubmitNewContentLibraryCategory()
    {
        var valid = SubmitNewContentLibraryCategory();

        if (valid)
        {
            swal("New Category Success", "Content Library Category (will be) Added Successfully.", "success");
        }
    }


</script>