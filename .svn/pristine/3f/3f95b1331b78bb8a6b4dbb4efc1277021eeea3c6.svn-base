using CLA_Administration_Web.Helpers.Constants;
using CLA_Administration_Web.Helpers.Reporting;
using CLA_Administration_Web.ViewModels.Reports;

namespace CLA_Administration_Web.Helpers.MockData
{
    public class ReportsMockData
    {
        public static PopupReportStatsMockViewModel PopupReportData { get; set; } = GeneratePopupReportData();

        public static PopupReportStatsMockViewModel GeneratePopupReportData()
        {
            var random = new Random();

            var popupId = random.Next(1, 1000);

            var result = new PopupReportStatsMockViewModel
            {
                PopupId = popupId,
                PopupTitle = $"Popup Title {popupId}",
                EffectiveFrom = DateTime.Now.AddDays(-100).ToString("yyyy-MM-dd"),
                EffectiveTo = DateTime.Now.ToString("yyyy-MM-dd"),
                PopupReportTitle = $"Report for Popup {popupId}",
                PopupReportTimeframe = "Last 30 Days",

                Delivered = random.Next(500, 1000),
                NotDelivered = random.Next(0, 100),

                Click = random.Next(100, 500),
                Dismiss = random.Next(100, 500),
                Snooze = random.Next(50, 300),
                AutoHide = random.Next(50, 300),
                Show = random.Next(500, 1000),

                // Populate response breakdowns and outstanding data
                ResponseClick = GenerateResponseBreakDownList(10),
                ResponseDismiss = GenerateResponseBreakDownList(10),
                ResponseAutoHide = GenerateResponseBreakDownList(10),
                ResponseSnooze = GenerateResponseBreakDownList(10),
                ResponseShow = GenerateResponseBreakDownList(10),

                PopupOutstandings = GenerateOutstandingList(5),
            };

            result.Targeted = result.Delivered + result.NotDelivered;

            return result;
        }

        private static List<PopupResponseBreakDown> GenerateResponseBreakDownList(int count)
        {
            var list = new List<PopupResponseBreakDown>();
            var random = new Random();

            for (int i = 0; i < count; i++)
            {
                list.Add(new PopupResponseBreakDown
                {
                    Domain = $"domain_{random.Next(1, 10)}.com",
                    UserId = $"user_{random.Next(1, 1000)}",
                    Username = $"User_{random.Next(1, 1000)}",
                    UserStatus = (UserStatus)random.Next(1, 4), // Random between Active, Inactive, NotInstalled
                    MachineId = $"machine_{random.Next(1, 100)}",
                    MachineName = $"Machine_{random.Next(1, 100)}",
                    BubbleShowDT = DateTime.Now.AddDays(-random.Next(1, 100)),
                    BubbleClickDT = DateTime.Now.AddDays(-random.Next(1, 100)),
                    BubbleDismissDT = DateTime.Now.AddDays(-random.Next(1, 100)),
                    BubbleSnoozeDT = DateTime.Now.AddDays(-random.Next(1, 100)),
                    BubbleAutoHideDT = DateTime.Now.AddDays(-random.Next(1, 100)),
                    FeedbackLikeDislike = random.Next(0, 2) == 0 ? "Like" : "Dislike",
                    FeedbackComment = GenerateRandomFeedbackComment(),
                    LastSyncDT = DateTime.Now.AddDays(-random.Next(1, 100))
                });
            }

            return list;
        }

        private static List<PopupOutstanding> GenerateOutstandingList(int count)
        {
            var list = new List<PopupOutstanding>();
            var random = new Random();

            for (int i = 0; i < count; i++)
            {
                list.Add(new PopupOutstanding
                {
                    Domain = $"domain_{random.Next(1, 10)}.com",
                    UserId = $"user_{random.Next(1, 1000)}",
                    Username = $"User_{random.Next(1, 1000)}",
                    UserStatus = (UserStatus)random.Next(1, 4), // Random between Active, Inactive, NotInstalled
                    MachineId = $"machine_{random.Next(1, 100)}",
                    MachineName = $"Machine_{random.Next(1, 100)}",
                    LastSyncDT = DateTime.Now.AddDays(-random.Next(1, 100))
                });
            }

            return list;
        }

        private static string GenerateRandomFeedbackComment()
        {
            var comments = new List<string> { "Good feature", "Annoying popup", "Helpful", "Not useful" };
            var random = new Random();
            return comments[random.Next(comments.Count)];
        }

        public static ReportDataRDLCViewModel GetReportingMockData()
        {
            var result = new ReportDataRDLCViewModel();

            var reportsBaseAddress = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "resources", "reports", "popup");
            
            result.PopupReporting = new PopupReports
            {
                Summary = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptSTM_Summary.rdlc",
                    RDLCName = "dsSummary_STM",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true, 
                                                ReportingJsonResults.Popup.STM_Summary_ACTIVE, 
                                                ReportingJsonResults.Popup.STM_Summary_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Summary_NOT_INSTALLED
                                              )
                },
                OutstandingSummary = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptSTM_Outstanding_Summary.rdlc",
                    RDLCName = "dsSTM_Question_Summary",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_NOT_INSTALLED
                                              )
                },
                CompletedLiveAndStaging = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptSTM_Question_Summary.rdlc",
                    RDLCName = "dsSTM_Outstanding_Summary",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true,
                                                ReportingJsonResults.Popup.STM_Completed_LiveAndStaging_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Completed_LiveAndStaging_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Completed_LiveAndStaging_NOT_INSTALLED
                                              )
                },
                ResponseDetailsLiveAndStaging = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptSTM_Responses_Breakdown.rdlc",
                    RDLCName = "dsSTM_Response_Optimize_Detail",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true,
                                                ReportingJsonResults.Popup.STM_Responses_Detail_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Responses_Detail_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Responses_Detail_NOT_INSTALLED
                                              )
                },
                OutstandingLiveAndStaging = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptSTM_Outstanding.rdlc",
                    RDLCName = "dsSTM_Outstanding",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_Outstanding_Summary_NOT_INSTALLED
                                              )
                },
                AllDataOnly = new ReportRDLC
                {
                    ReportRDLCPath = $"{reportsBaseAddress}\\rptReporting_STM_All_Export_Only.rdlc",
                    RDLCName = "dsSTM_All_Data_Only",
                    DataSet = ReportingHelper.ConstructFilteredDataSet
                                             (
                                                true, true, true,
                                                ReportingJsonResults.Popup.STM_All_Data_Only_ACTIVE,
                                                ReportingJsonResults.Popup.STM_All_Data_Only_IN_ACTIVE,
                                                ReportingJsonResults.Popup.STM_All_Data_Only_NOT_INSTALLED
                                              )
                }
            };
            return result;
        }

