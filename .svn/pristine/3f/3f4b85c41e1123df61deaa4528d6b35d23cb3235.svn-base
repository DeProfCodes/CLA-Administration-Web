{
    cursor:pointer !important;
}
/**======================================================= Scaling ====================================================*/

@media screen and (max-width:767px)
{
    .breadcrumb-title
    {
        font-size: 20px !important;
        margin-bottom: 0;
    }
    .breadcrumb-nav-body
    {
        font-size: 11px;
        margin-bottom:0;
    }
    .breadcrumb-btn
    {
        width: 130px !important;
        font-size: 12px;
        padding-left: 5px;
        padding-top: 4px;
        height: 25px;
    }
    .breadcrumb-btn-icon
    {
        margin-right:1px;
    }
}

@media screen and (max-width:415px)
{
    #BreadcrumbBtnContainer
    {
        margin-left:0 !important;
        margin-top: 15px;
    }
}