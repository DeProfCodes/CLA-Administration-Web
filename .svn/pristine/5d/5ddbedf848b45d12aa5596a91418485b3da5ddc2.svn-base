@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

<div id="TargetedEntityPreviewModal" class="modal">
    <span class="close text-danger" onclick="CloseTargetedEntityPreviewerModal()">&times;</span>
    <div id="ModalTargetedEntities">
        <h3 class="theme-txt-clr text-center fw-bold p-2" id="TargetEntityTitle"></h3>
        <div id="ModalTargetedEntitiesData">
        </div>
        <div class="text-center mt-2 pb-3">
            <button class="btn btn-sm btn-success px-5" id="SaveModalTargeting">Save Changes</button>
        </div>
    </div>
    <div id="caption">
        <p>Targeted Entities</p>
    </div>

</div>

<script>

    function OpenTargetedEntityPreviewModal(moduleType, isReadonly)
    {
        LoadModalTargetedEntity(moduleType, isReadonly);

        $("#TargetedEntityPreviewModal").fadeIn();

        var moduleName = GetModuleName(moduleType);
        $("#TargetEntityTitle").text(`${moduleName} Targeting`);
        $("#SaveModalTargeting").attr("disabled", isReadonly);
    }

    function CloseTargetedEntityPreviewerModal()
    {
        $("#TargetedEntityPreviewModal").fadeOut();
    }

    function LoadModalTargetedEntity(moduleType, isReadonly)
    {
        var url = GetPageUrl('@TargetingPages.TargetedEntities', moduleType, isReadonly);
        LoadPartialViewWithLoader(url, "ModalTargetedEntitiesData", "SecondaryLoader");
    }


</script>