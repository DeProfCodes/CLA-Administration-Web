@model CLA_Administration_Web.ViewModels.Modules.Components.Form.DateTimeRangePicker

@{
    var toggleShowDateTilesCss = !Model.ShowDatesTitle ? "hidden" : "";
    var flowStyle = Model.VerticalAlign ? "flex-direction: column" : "flex-wrap:nowrap";

    var startDateTitle = Model.ShowFullTitles ? "Start Date" : "From";
    var endDateTitle = Model.ShowFullTitles ? "End Date" : "to";

    var widthCss = !string.IsNullOrEmpty(Model.WidthCss) ? Model.WidthCss : "w-200p";

    var titlesWidth = Model.ShowFullTitles ? "width:100px;" : "width:40px;";

    var titlesToStyle = Model.ShowFullTitles ? titlesWidth : "width:fit-content;";

    var titlesStartStyle = !Model.VerticalAlign ? "margin-right:-8px;" : "";
    titlesToStyle += !Model.VerticalAlign ? "margin-left:10px;margin-right:-8px;" : "";

    var marginBottom = Model.VerticalAlign ? "margin-bottom: 10px;" : "";

    var titlesWeight = Model.TitlesBold ? "fw-bold" : "";

    var externalCss = !string.IsNullOrEmpty(Model.ExternalCssControl) ? Model.ExternalCssControl : "";
}

<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/timepicker/jquery.timepicker.min.css" />


<div class="w-fit-content d-flex w-fit-content theme-txt-clr @externalCss" style="@flowStyle">
    <div class="d-flex" style="@marginBottom">
        <div class="align-content-center @toggleShowDateTilesCss" style="@titlesWidth;@titlesStartStyle">
            <p class="custom-p @titlesWeight" id="DatePickerStartDateTitle">@startDateTitle</p>
        </div>
        <div id="dateRange"></div>
        <div class="d-flex cursor-pointer">
            <i class="fas fa-calendar-alt calendar-icon-date-box" onclick="OpenDatePicker()"></i>
            <input type="text" class="custom-input-text fs-12 cursor-pointer @widthCss ps-30p" id="DatePickerStartDate" readonly onclick="OpenDatePicker('@Model.OnChangeFunction')" />
        </div>
    </div>
    <div class="d-flex" id="DatePickerEndDateContainer">
        <div class="col-md-4 align-content-center @toggleShowDateTilesCss" style="@titlesToStyle">
            <p class="custom-p @titlesWeight" id="DatePickerEndDateTitle">@endDateTitle</p>
        </div>
        <div class="d-flex cursor-pointer">
            <i class="fas fa-calendar-alt calendar-icon-date-box" onclick="OpenDatePicker()"></i>
            <input type="text" class="custom-input-text fs-12 cursor-pointer @widthCss ps-30p" id="DatePickerEndDate" readonly onclick="OpenDatePicker('@Model.OnChangeFunction')" />
        </div>
    </div>
</div>

<input type="text" value="@Model.OnChangeFunction" id="OnChangeFunction" hidden/>

<script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

<script>
    
    $(document).ready(function ()
    {
        InitializeDatePicker();
        SetInitialDatesToday();
    });

    function SetInitialDatesToday()
    {
        var today = FormatDate(TodayDate(), "DD-MMM-YYYY");
        
        $("#DatePickerStartDate").val(FormatDate(today, 'DDDD, DD MMMM YYYY'));
        $("#DatePickerEndDate").val(FormatDate(today, 'DDDD, DD MMMM YYYY'));
    }

    function SetDateRangePickerDate(date, id)
    {
        id = EnsureJQueryId(id);
        $(id).val(FormatDate(date, 'DDDD, DD MMMM YYYY'));
    }

    function InitializeDatePicker()
    {
        $('#dateRange').daterangepicker({
            opens: 'right',
            autoApply: true,
            showDropdowns: true, 
            locale: {
                format: 'YYYY-MM-DD'
            }
        }, 
        function (start, end)
        {
            $('#DatePickerStartDate').val(FormatDate(start,'DDDD, DD MMMM YYYY'));
            $('#DatePickerEndDate').val(FormatDate(end, 'DDDD, DD MMMM YYYY'));
        });
    }

    function OpenDatePicker(onChangeFunction)
    {
        $('#dateRange').click();
    }

    $('#dateRange').on('apply.daterangepicker', function (ev, picker)
    {
        DateRangePickerChangeFunction($("#OnChangeFunction").val());
    });

    function DateRangePickerChangeFunction(onChangeFunction)
    {
        if (onChangeFunction && typeof window[onChangeFunction] === 'function')
        {
            window[onChangeFunction]();
        }
    }

</script>