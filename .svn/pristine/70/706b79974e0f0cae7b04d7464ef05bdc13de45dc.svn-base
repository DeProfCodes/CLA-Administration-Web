@model CLA_Administration_Web.ViewModels.Modules.Rss.AddNewRssFeed

@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared

@{
    var pageTitle = Model.AddOrEditType == AddOrEditType.Add ? "Add New RSS Feed" : $"Edit RSS Feed: {Model.RssFeedData.FeedId}";
    var breadcrumbLast = Model.AddOrEditType == AddOrEditType.Add ? "Add New RSS Feed" : $"Edit RSS Feed / {Model.RssFeedData.FeedId}";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">RSS Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'RSS', '@ModulesPages.RSSCategoryOverview', 'RSSLink')">RSS</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'RSS', '@ModulesPages.RSSCategoryOverview', 'RSSLink')">Categories</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.RSSCategoryDetails', '@Model.CurrentCategoryId');">@Model.CurrentCategoryId</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.RSSFeedOverview', '@Model.CurrentCategoryId')">Feeds</span> /
                <span class="breadcrumb-item">@breadcrumbLast</span>
            </p>
        </div>
    </div>

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">@pageTitle</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;min-height:500px">
        <div class="card-body">
            <div class="row theme-txt-clr">
                <h5 class="fw-bold mt-3 text-center">RSS Feed Details</h5>
                <div class="form-border-inputs">
                    <div class="row">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Feed Name</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewRSSFeedName"/>
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewRSSFeedNameError"></p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="common-titles-col align-content-center">
                            <p class="custom-p fl-right pt-2">Category</p>
                        </div>
                        <div class="common-titles-value-col">
                            <select class="form-control mt-3 w-50 w-250p fs-14 theme-border" id="NewRSSFeedCategory" style="appearance:menulist">
                                <option value="0">Please select</option>
                                @foreach (var category in Model.RssCategories)
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            </select>
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewRSSFeedCategoryError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Feed URL</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewRSSFeedURL" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewRSSFeedURLError"></p>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-sm btn-success px-5" onclick="SubmitNewRssFeed()">Save Feed</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function ()
    {
        SelectCurrentCategory();

        if ('@Model.AddOrEditType' == '@AddOrEditType.Edit')
            PrePopulateFeedData();
    });

    function SelectCurrentCategory()
    {
        $(`#NewRSSFeedCategory option`).each(function ()
        {
            if ($(this).val() == "@Model.CurrentCategoryId")
            {
                $(this).prop('selected', true);
            }
        });
    }

    function ValidateRSSFeed()
    {
        $("#NewRSSFeedNameError").text("");
        $("#NewRSSFeedCategoryError").text("");
        $("#NewRSSFeedURLError").text("");

        var valid = true;

        if (IsEmptyInput("NewRSSFeedName"))
        {
            $("#NewRSSFeedNameError").text("please enter feed name");
            valid = false;
        }
        if ($("#NewRSSFeedCategory").val() == "0")
        {
            $("#NewRSSFeedCategoryError").text("please select rss category");
            valid = false;
        }
        if (IsEmptyInput("NewRSSFeedURL"))
        {
            $("#NewRSSFeedURLError").text("please enter feed url");
            valid = false;
        }

        if(!valid)
        {
            swal("New RSS Feed Error", "Please enter all required fields", "error");
        }
        return valid;
    }

    function SubmitNewRssFeed()
    {
        var valid = ValidateRSSFeed();

        if (valid)
        {
            swal("New RSS Feed Success", "Rss Feed (will be) Added Successfully.", "success");
        }
    }

    function PrePopulateFeedData()
    {
        $("#NewRSSFeedName").val("@Model.RssFeedData.FeedName");
        $("#NewRSSFeedURL").val("@Model.RssFeedData.FeedURL");
    }

</script>