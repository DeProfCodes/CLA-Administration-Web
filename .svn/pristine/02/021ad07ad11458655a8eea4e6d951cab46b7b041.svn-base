@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Shared

<!--start wrapper-->
<div class="wrapper">

    <!--start sidebar -->
    <div id="LeftNavigation">
    </div>
    <!--end sidebar -->

    <!--start top header-->
    <div id="TopNavigation">
    </div>
    <!--end top header-->
    
    <!-- Loader -->
    <div id="MainLoader" class="loader">
        <img src="~/images/others/loading-waiting.gif" alt="Loading..." id="MainLoaderImage" class="loader-image" />
        <p id="MainLoaderMessage">Loading...</p>
    </div>
    <!--End Loader -->

    <!-- Loader -->
    <div id="SecondaryLoader" class="loader">
        <img src="~/images/others/loading-waiting.gif" alt="Loading..." id="SecondaryLoaderImage" class="loader-image" />
        <p id="SecondaryLoaderMessage">Loading...</p>
    </div>
    <!--End Loader -->

    <!-- start page content wrapper-->
    <div class="page-content-wrapper" id="PageArea">
        <!-- start page content-->
        <div class="page-content" id="DashboardMainArea">
            
        </div>
        <!-- end page content-->
    </div>
    <!--end page content wrapper-->

    <!--Start Back To Top Button-->
    <a href="javaScript:;" class="back-to-top">
        <ion-icon name="arrow-up-outline"></ion-icon>
    </a>
    <!--End Back To Top Button-->
    
</div>
<!--end wrapper-->

<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>

@{ 
    await Html.RenderPartialAsync("~/Views/Shared/Helpers/HtmlHelpers/AppUrlsHelper.cshtml"); 
    await Html.RenderPartialAsync("~/Views/Shared/Helpers/Resources/ResourcesLibrary.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Helpers/Resources/CommonFunctions.cshtml");
}

<script>

    $(document).ready(function ()
    {
        LoadLayoutSections();
    });

    function LoadLayoutSections()
    {
        var topNavUrl = '@Url.Action("TopNavigation", "Dashboard")';
        var leftNavUrl = '@Url.Action("LeftNavigation", "Dashboard")';

        LoadPartialView(topNavUrl, "#TopNavigation");
        LoadPartialView(leftNavUrl, "#LeftNavigation");
    }

    function Logout()
    {
        swal({
            title: "Logout",
            text: "You will be logged out of CLA Admin Tool",
            icon: "warning",
            buttons: true,
            dangerMode: false
        }).then((confirmed) =>
        {
            swal('Log out success', 'You have been successfully logged out!', 'success');
        });
    }
</script>