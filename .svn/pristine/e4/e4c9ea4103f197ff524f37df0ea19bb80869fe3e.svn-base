@model CLA_Administration_Web.ViewModels.Modules.Rss.RssCategoryOverviewViewModel
@using CLA_Administration_Web.Helpers.Enums.AppPages

@{
    var pageTitle = Model.CategoryId == 0 ? "Add New RSS Category" : $"Edit RSS Category: {Model.CategoryId}";
}

<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.RSSAddNewCategory })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">@pageTitle</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;min-height:500px">
        <div class="card-body">
            <div class="row theme-txt-clr">
                <h5 class="fw-bold mt-3 text-center">RSS Category Details</h5>
                <div class="form-border-inputs">
                    <div class="row">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Category Name</p>
                        </div>
                        <div class="common-titles-value-col">
                            <input class="custom-input-text w-250p" type="text" id="NewRSSCategoryName" />
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewRSSCategoryNameError"></p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="common-titles-col">
                            <p class="custom-p fl-right">Category Description</p>
                        </div>
                        <div class="common-titles-value-col">
                            <textarea class="custom-input-textarea w-250p" rows="4" id="NewRSSCategoryDescription"></textarea>
                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="NewRSSCategoryDescriptionError"></p>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-sm btn-success px-5" onclick="SubmitNewRssCategory()">Save Category</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function()
    {
        if('@Model' != null && '@Model.CategoryId' > 0)
        {
            PrePopulateRSSCategoryForEdit();
        }
    });

    function ValidateRSSCategory()
    {
        $("#NewRSSCategoryNameError").text("");
        $("#NewRSSCategoryDescriptionError").text("");

        var valid = true;

        if (IsEmptyInput("NewRSSCategoryName"))
        {
            $("#NewRSSCategoryNameError").text("please enter category name");
            valid = false;
        }
        if (IsEmptyInput("NewRSSCategoryDescription"))
        {
            $("#NewRSSCategoryDescriptionError").text("please enter category description");
            valid = false;
        }

        if (!valid)
        {
            swal("New RSS Category Error", "Please enter all required fields", "error");
        }
        return valid;
    }

    function SubmitNewRssCategory()
    {
        var valid = ValidateRSSCategory();

        if (valid)
        {
            swal("New RSS Feed Success", "Rss Feed (will be) Added Successfully.", "success");
        }
    }

    function PrePopulateRSSCategoryForEdit()
    {
        $("#NewRSSCategoryName").val("@Model.CategoryName");
        $("#NewRSSCategoryDescription").val("@Model.CategoryDescription");
    }

</script>