@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

<div id="TargetingExposurePreviewModal" class="modal">
    <span class="close text-danger" onclick="CloseTargetingExposurePreviewerModal()">&times;</span>
    <div id="ModalTargetedEntities">
        <h3 class="theme-txt-clr text-center fw-bold p-2" id="TargetingExposureTitle"></h3>
        <div id="ModalTargetingExposureData">
        </div>
    </div>
    <div id="caption">
        <p>Targeted Entities</p>
    </div>

</div>

<script>

    function OpenTargetingExposurePreviewModal(moduleType)
    {
        LoadModalTargetingExposure(moduleType);

        $("#TargetingExposurePreviewModal").fadeIn();

        var moduleName = GetModuleName(moduleType);
        $("#TargetingExposureTitle").text(`${moduleName} Targeting Exposure`);
    }

    function CloseTargetingExposurePreviewerModal()
    {
        $("#TargetingExposurePreviewModal").fadeOut();
    }

    function LoadModalTargetingExposure(moduleType)
    {
        var url = GetPageUrl('@TargetingPages.TargetingExposure', moduleType);
        LoadPartialViewWithLoader(url, "ModalTargetingExposureData", "SecondaryLoader");
    }


</script>