@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.LockedDesktopOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.LockedDesktopOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataTables", new { page = ModulesPages.LockedDesktopOverview })

</div>

<script>

    $(document).ready(function ()
    {
        LoadLockedDesktopsDefaultOverviewData();
    });

    function LoadLockedDesktopsDefaultOverviewData()
    {
        FilterModuleDataOverviewByStatus('LockedDesktop', `ActiveLockedDesktopBtnFilter`, AllStatusTypes.Active);
    }

</script>