@using CLA_Administration_Web.Helpers.Enums.AppPages

<div class="container-fluid">
    
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.AllModules})

    <div class="container text-center">
        <button class="custom-btn custom-btn-default" onclick="OpenPageWithAnimations('Modules', 'Popup', '@ModulesPages.PopupOverview', 'PopupOverviewLink');">
            <i class="bi bi-plus-circle-fill custom-btn-icons"></i> Popups
        </button>
        <button class="custom-btn custom-btn-default ms-3" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyOverviewLink');">
            <i class="bi bi-plus-circle-fill custom-btn-icons"></i> Surveys
        </button>
    </div>

</div>
