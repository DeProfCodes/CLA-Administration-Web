@model CLA_Administration_Web.ViewModels.Modules.PST.AddNewTickerViewModel

@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.ViewModels.Modules.Components.Form
@using CLA_Administration_Web.ViewModels.Modules.PST

<div class="container-fluid">
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.TickerAddNew })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">Add New Ticker</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link T-1 active" id="LinkTabLink-1" onclick="NavigateToTickerTab(this.id, 1)">
                            Link Type<i class="bi bi-dot module-nav-link-dot T-1 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-2" id="TextsTabLink-2" onclick="NavigateToTickerTab(this.id, 2)">
                            Texts<i class="bi bi-dot module-nav-link-dot T-2 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-3" id="TimesTabLink-3" onclick="NavigateToTickerTab(this.id, 3)">
                            Times<i class="bi bi-dot module-nav-link-dot T-3 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-4" id="TargetUsersTabLink-4" onclick="NavigateToTickerTab(this.id, 4)">
                            Target Users<i class="bi bi-dot module-nav-link-dot T-4 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-5" id="ExposureSummaryTabLink-5" onclick="NavigateToTickerTab(this.id, 5)">
                            Exposure Summary<i class="bi bi-dot module-nav-link-dot T-5 hidden"></i>
                        </a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap theme-txt-clr" id="ModuleWizardMain">
                    <div class="form-horizontal" id="popupForm">
                        <!-- Link Type Tab -->
                        <div id="LinkTypeTab-1" class="ticker-wizard-tabs flex-wrap justify-content-center hidden" style="margin-bottom:50px;">
                            <h5 class="fw-bold mt-4 text-center">1. Ticker Link Type</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Select what the popup will link to when clicked by the user.</p>
                            <p class="custom-p fs-13 text-center">The popup can launch any of the below options when clicked on or be linked to nothing.</p>
                            <!-- Links Options -->
                            <div class="row mt-5 w-fit-content mx-auto pe-5">
                                <div class="col-lg-3 align-content-center">
                                    <p class="fw-bold text-center theme-txt-clr">Link Type</p>
                                </div>
                                <div class="col-lg-9" id="ModuleLinkTypeContainer" style="max-width:400px;">
                                    <div class="btn-group mb-2 w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn btn-group-active" onclick="TickerLinkTypeClick(this.id)" id="NoLink">No Link</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="ImageLink">Image</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="AudioLink">Audio</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="VideoLink">Video</button>
                                    </div>
                                    <div class="btn-group w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="DocumentLink">Document</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="WebsiteLink">Website</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="EmailLink">Email</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="TickerLinkTypeClick(this.id)" id="SurveyTypeLink">Survey</button>
                                    </div>
                                </div>
                            </div>
                            <!-- Attachment -->
                            <div class="row mt-3 w-fit-content mx-auto pe-5" id="LinkTypeAttachment">
                                <p class="col-lg-3 fw-bold text-center theme-txt-clr mb-0" id="UploadFileTitle"></p>
                                <div class="col-lg-9 p-0">
                                    <!-- Uploader Component -->
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml",
                                        new FileUploaderModel { ComponentId = "TickerLinkType", InputId = "TickerLinkTypeUploadInput", ShowPreviewButton = true, InitialHidden = true, WidthPx = "396px", OnFileUploadCallback = null });
                                    }
                                    <!-- Website Textbox -->
                                    <div class="w-100 mt-2 p-0 d-flex hidden" id="LinkTypeUrl">
                                        <input type="text" class="custom-input-text" id="LinkTypeUrlInput" />
                                        <button class="btn btn-success content-preview-btn custom-btn-sm ms-3" id="ModuleContentPreviewUpload" onclick="PreviewWebsite()">Preview</button>
                                    </div>
                                    <!-- Email Inputs Section -->
                                    <div class="w-fit-content border border-light-1 p-3 pe-5 mb-3 hidden" id="LinkTypeEmail">
                                        <div>
                                            <p class="mb-0">Emails <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter Recipients Emails" id="LinkTypeEmailInput" />
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">CC <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter CC Emails" id="LinkTypeCCEmailInput" />
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeCCEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">Subject</p>
                                            <input type="text" class="custom-input-text w-300p" placeholder="Enter Subject" id="LinkTypeEmailSubjectInput" />
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailSubjectValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0 mt-1">Message</p>
                                            <textarea class="w-300p" rows="5" id="LinkTypeEmailMessageInput"></textarea>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailMessageValid"></p>
                                        </div>
                                    </div>
                                    <!-- Survey Type -->
                                    <div class="mt-2 p-0 hidden" id="SurveyType">
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12 ps-2">Survey Type</p>
                                            <div class="col-md-8 btn-group w-auto overview-filter-btn-group">
                                                <button class="btn module-link-type custom-btn-group btn-group-active" onclick="SurveyLinkTypeClick(this.id)" id="ActiveSurveyLink">Active</button>
                                                <button class="btn module-link-type custom-btn-group" onclick="SurveyLinkTypeClick(this.id)" id="PendingSurveyLink">Pending</button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12">Select Survey</p>
                                            <div class="col-md-8">
                                                <select class="form-select-sm" id="SelectSurveyLinkType1">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.ActiveSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                                <select class="form-select-sm hidden" id="SelectSurveyLinkType2">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.PendingSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Texts Tab -->
                        <div id="TextsTab-2" class="ticker-wizard-tabs flex-wrap  text-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mt-4">2. Ticker Text</h5>
                            <p class="custom-p mt-2 fs-13 text-center mb-3">Enter ticker text.</p>
                            <div class="row mt-4 d-flex pe-4 w-fit-content mx-auto">
                                <label class="fw-bold w-fit-content">Ticker Text</label>
                                <div class="col">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel 
                                        { 
                                            EditorId = "TickerText", 
                                            HeightPx = "160px",
                                            WidthPx = "450px",
                                            MaxCharacterCount = 300,
                                            WriteToDesitnationOnInput = true, 
                                            DestinationTextDivId = "TickerPreviewText" 
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="TickerTextError"></p>
                                </div>
                            </div>
                            <div class="ticker-container mt-3">
                                <p class="text-center pt-2 fw-bold fst-italic">Preview</p>
                                <div class="ticker-tape ">
                                    <div class="ticker-left-icon">
                                        <img src="~/images/logos/app-icon-blue.png" alt="Warning Icon" width="30">
                                    </div>
                                    <div class="ticker-content">
                                        <span class="ticker-text" id="TickerPreviewText">Enter Ticker Text</span>
                                    </div>
                                </div>
                                <div class="ticker-right-icons bg-black w-fit-content">
                                    <img src="https://img.icons8.com/material-rounded/24/ffffff/minimize-window.png" alt="Minimize" class="ticker-right-icon bg-primary" width="30" onclick="minimizeTicker()">
                                    <img src="https://img.icons8.com/material-rounded/24/ffffff/delete-sign.png" alt="Dismiss" class="ticker-right-icon bg-danger" width="30" onclick="dismissTicker()">
                                </div>
                            </div>
                        </div>
                        <!-- Times Tab -->
                        <div id="TimesTab-3" class="ticker-wizard-tabs flex-wrap  text-center justify-content-center mb-3 w-75 mx-auto hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Ticker Effective Dates & Timeslots</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please define the date and time range that the Ticker must display</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                Tip:In order to maximize exposure, we recommend that the date range span over multiple calendar weeks (Thursday to Thursday) and setting the time
                                to be as long as possible (e.g 07h00 to 19h00).
                            </p>
                            <div class="row mt-5 p-4">
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Effective Dates</p>
                                    <div class="mt-4">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/DateRangePicker.cshtml");
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Timeslots</p>
                                    <div class="mt-4">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/TimeRangePicker.cshtml");
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <p class="w-600p mx-auto p-2 theme-border">
                                    This survey will attempt to show everyday startting from <span id="TickerStartEffDate"></span>, until <span id="TickerEndEffDate"></span>.
                                    It will only appear between the time range of <span id="TickerStartTimeSlot"></span> and <span id="TickerEndTimeSlot"></span>. Once
                                    this survey has been completed/opted out. it will not display again
                                </p>
                            </div>
                        </div>
                        <!-- Target Users -->
                        <div id="TargetUserTab-4" class="ticker-wizard-tabs flex-wrap  text-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mb-3 module-heading-theme">4. Ticker Target Users</h5>
                            <p class="module-heading-theme">Ticker target user settings.</p>
                            
                        </div>
                        <!-- Exposure Summary Tab -->
                        <div id="ExposureSummaryTab-5" class="ticker-wizard-tabs flex-wrap  text-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mb-3 module-heading-theme">5. Ticker Exposure Summary</h5>
                            <p class="module-heading-theme">Ticker exposure summary settings.</p>
                            
                        </div>
                       
                        <!-- Navigation Buttons -->
                        <div class="row fix-content-bottom" style="margin-left:100px">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn module-wizard-nav-btns hidden" id="TickerPrevTabBtn" onclick="PreviousTickerTab()">Back</button>
                                    <button class="btn module-wizard-nav-btns" id="TickerNextTabBtn" onclick="NextTickerTab()">Next</button>
                                    <button class="btn module-new-submit-btn hidden" id="AddTickerSubmitBtn">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
}

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/modules/ticker.js"></script>

<script>

    $(document).ready(function ()
    {
        HideAllTickerTabs();
        UpdateTickerDisplayTimeDetails();
    });

    function UpdateTickerDisplayTimeDetails()
    {
        var startDate = $("#DatePickerStartDate").val();
        var endDate = $("#DatePickerEndDate").val();
        var startTime = $("#TimePickerStartTime").val();
        var endTime = $("#TimePickerEndTime").val();

        if (IsNotEmptyString(startDate) && IsNotEmptyString(endDate) && IsNotEmptyString(startTime) && IsNotEmptyString(endTime))
        {
            $("#TickerStartEffDate").text(startDate);
            $("#TickerEndEffDate").text(endDate);
            $("#TickerStartTimeSlot").text(startTime);
            $("#TickerEndTimeSlot").text(endTime);
        }
    }

    $("#DatePickerStartDate").change(function ()
    {
        UpdateTickerDisplayTimeDetails();
    });

    $("#DatePickerEndDate").change(function ()
    {
        UpdateTickerDisplayTimeDetails();
    });

    $("#TimePickerStartTime").change(function ()
    {
        UpdateTickerDisplayTimeDetails();
    });

    $("#TimePickerEndTime").change(function ()
    {
        UpdateTickerDisplayTimeDetails();
    });


</script>