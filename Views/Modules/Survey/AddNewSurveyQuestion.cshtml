@model CLA_Administration_Web.ViewModels.Modules.PST.AddNewSurveyQuestion

@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Components.Form
@using CLA_Administration_Web.ViewModels.Modules.PST

@{
    var surveySkin = $"{LaunchSettingsHelper.GetBaseAddressForImages()}/images/others/modules/skins/SurveyBackground.bmp";

    var pageTitle = (Model.AddOrEditType == AddOrEditType.Edit) ? $"Edit Survey Question Id: {Model.SurveyQuestionId}" : 
                                                                  $"Add New Survey Question for Survey Id: {Model.SurveyId}";

    var lastBreadcrumb = (Model.AddOrEditType == AddOrEditType.Edit) ? $"Edit Survey Question / {Model.SurveyQuestionId}" : "Add New Survey Question";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Survey Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Survey</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.SurveyOverview', 'SurveyLink')">Overview</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.SurveyDetails', '@Model');">@Model.SurveyId</span> /
                <span class="breadcrumb-item">@lastBreadcrumb</span>
            </p>
        </div>
    </div>

    <!-- Card for Filters -->
    <div class="card mb-4 mt-5 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">@pageTitle</h4>
        </div>
    </div>


    <div class="card module-wizard-container">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link T-1 active" id="TextsTabLink-1" onclick="NavigateToSurveyQuestionTab(this.id, 1)">
                            Question Details<i class="bi bi-dot module-nav-link-dot T-1 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-2" id="ResponseScoringTabLink-2" onclick="NavigateToSurveyQuestionTab(this.id, 2)">
                            Response & Scoring <i class="bi bi-dot module-nav-link-dot T-2 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-3" id="DependenciesTabLink-3" onclick="NavigateToSurveyQuestionTab(this.id, 3)">
                            Dependencies <i class="bi bi-dot module-nav-link-dot T-3 hidden"></i>
                        </a>
                        <a class="module-left-nav-link mt-4 T-4" id="CalendarTabLink-4" onclick="NavigateToSurveyQuestionTab(this.id, 4)">
                            Calendar <i class="bi bi-dot module-nav-link-dot T-4 hidden"></i>
                        </a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap" id="ModuleWizardMain">
                    <div class="form-horizontal theme-txt-clr" id="popupForm">
                        <!-- Question Details Tab -->
                        <div id="QuestionsTab-1" class="survey-questions-wizard-tabs  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold mt-4">1. Survey Title, Introduction & Conclusion</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Enter survey texts.</p>
                            <!-- Question Title input-->
                            <div class="row mt-4 me-5">
                                <div class="col-sm-2 ms-auto">
                                    <label class="fw-bold text-center fl-right">Question Title:</label>
                                </div>
                                <div class="w-fit-content me-auto">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyQuestionTitle",
                                            HeightPx = "55px",
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = false,
                                            MaxCharacterCount = 25,
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="SurveyQuestionTitleError"></p>
                                </div>
                            </div>
                            <!-- Question Details input-->
                            <div class="row mt-2 me-5">
                                <div class="col-sm-2 ms-auto">
                                    <label class="fw-bold text-center fl-right">Question</label>
                                </div>
                                <div class="w-fit-content me-auto">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel
                                        {
                                            EditorId = "SurveyQuestionDetails",
                                            HeightPx = "120px",
                                            WidthPx = "500px",
                                            WriteToDesitnationOnInput = true,
                                            DestinationTextDivId = "SurveyQuestionTextPreviewer"
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="SurveyQuestionDetailsError"></p>
                                </div>
                            </div>
                        </div>
                        <!-- ResponseScoring Tab -->
                        <div id="ResponseScoringTab-2" class="survey-questions-wizard-tabs flex-wrap justify-content-center mb-5 ps-2 hidden">
                            <h5 class="fw-bold mt-4 text-center">2. Survey Response & Scoring </h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select survey question type, response type, and scoring</p>
                            
                            <div class="mx-auto w-fit-content mt-5">
                                <div class="row mt-4">
                                    <div class="col-sm-2 ">
                                        <label class="fw-bold text-center fl-right w-max-content">Question Type:</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <div class="form-check form-switch w-fit-content mb-0">
                                            <label class="form-check-label fs-14" for="ShowHideSurveyTitle">Is Anonymous ?</label>
                                            <input class="form-check-input" type="checkbox" id="ShowHideSurveyTitle">
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-sm-2 align-content-center">
                                        <label class="fw-bold text-center fl-right w-max-content">Survey Scoring</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                            <input class="form-check-input" type="checkbox" name="SurveyScoringYesNo" id="SurveyQuestionScoringToggle" onclick="EnableSurveyQuestionScoring(event)">
                                            <label class="form-check-label cursor-pointer" for="SurveyQuestionScoringToggle">Enable</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-4 ">
                                    <div class="col-sm-2 ">
                                        <label class="fw-bold text-center fl-right w-max-content">Response Type</label>
                                    </div>
                                    <div class="w-400p ms-5">
                                        <div id="SurveyQuestionScoringToggleContainer">
                                            <select class="form-control ml-3 w-50 w-300p fs-14 " id="SurveyQuestionResponseType" style="appearance:menulist" onchange="SurveyQuestionResponseTypeSelect()">
                                                <option value="0" selected>Please select response type...</option>
                                                <option value="1">Yes / No</option>
                                                <option value="2">Yes / No / NA</option>
                                                <option value="3">Agree / Disagree</option>
                                                <option value="4">Agree / Disagree / Na</option>
                                                <option value="5">Text</option>
                                                <option value="6">Re-Arrange</option>
                                                <option value="7">Single Select</option>
                                                <option value="8">Multi Select</option>
                                            </select>
                                        </div>
                                        <div id="SurveyQuestionScoringOptionsContainer" class="hidden w-400p mt-2">
                                            <div class="theme-border p-2" id="QuestionContainer">
                                                <p class="custom-p fw-bold text-center fs-16">Question</p>
                                                <p class="custom-p html-text-editor" id="SurveyQuestionTextPreviewer"></p>
                                            </div>
                                            <div class="theme-border" id="QuestionOptionsContainer">
                                                <p class="custom-p fw-bold text-center fs-16 mx-auto px-5 w-fit-content border-2 theme-border-bottom">Qualifying Options</p>
                                                <p class="fw-bold fs-12 mb-0 pt-2 text-center text-alternate hidden" id="SurveyQuestionScoringText">Please select correct answer below</p>
                                                <!-- Yes/No/NA -->
                                                <div id="SurveyQuestionAnswerYES-NO" class="hidden p-3 ms-3">
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-YES" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-YES">Yes</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-NO" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-NO">No</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2 hidden na-option">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringYesNoNA" id="SurveyScoringYesNoNA-NA" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringYesNoNA-NA">NA</label>
                                                    </div>
                                                </div>
                                                <!-- Agree/Disagree/NA -->
                                                <div id="SurveyQuestionAnswerAGREE-DISAGREE-NA" class="hidden p-3 ms-3">
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-Agree" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-Agree">Agree</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-Disagree" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-Disagree">Disagree</label>
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2 hidden na-option">
                                                        <input class="form-check-input" type="radio" name="SurveyScoringAgreeDisagreeNA" id="SurveyScoringAgreeDisagreeNA-NA" onchange="SurveyResponseTypeTrueFalse(this.id)">
                                                        <label class="form-check-label" for="SurveyScoringAgreeDisagreeNA-NA">NA</label>
                                                    </div>
                                                </div>
                                                <!-- ReArrange -->
                                                <div id="SurveyQuestionAnswer-ReArrange" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerReArrangeCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerReArrangeCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)"/>
                                                    </div>
                                                    <div id="SurveyQuestionsReArrangeOptions" class="mt-3">
                                                    </div>
                                                </div>
                                                <!-- Single Select -->
                                                <div id="SurveyQuestionAnswer-SingleSelect" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerSingleSelectCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerSingleSelectCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)" />
                                                    </div>
                                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mt-2">
                                                        <input class="form-check-input" type="checkbox" id="SurveyAnswerSingleSelectAsDropdownCheck" onchange="ShowSingleListAsDropdown()">
                                                        <label class="form-check-label fs-12" for="SurveyAnswerSingleSelectAsDropdownCheck">Show as a dropdown</label>
                                                    </div>
                                                    <div class="d-flex mt-2 hidden" id="SurveyAnswerSingleSelectAsDropdownContainer">
                                                        <p class="custom-p w-fit-content align-content-center fst-italic fs-12">Dropdown Preview</p>
                                                        <div id="SurveyAnswerSingleSelectAsDropdownData" class="w-fit-content ms-3"></div>
                                                    </div>
                                                    <div id="SurveyQuestionsSingleSelectOptions" class="mt-3">
                                                    </div>
                                                </div>
                                                <!-- Multi Select -->
                                                <div id="SurveyQuestionAnswer-MultiSelect" class="hidden p-3 ms-3">
                                                    <div id="SurveyAnswerMultiSelectCountContainer" class="d-flex ">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">#Options</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectCount" onchange="CreateSurveyResponseReArrangeOptions(this.id)" />
                                                    </div>
                                                    <div id="SurveyAnswerMultiSelectCountContainer" class="d-flex mt-3 fs-12">
                                                        <p class="custom-p fw-bold w-fit-content align-content-center">Required Selections</p>
                                                        <input class="custom-input-text w-50p  ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectMIN" />
                                                        <p class="custom-p fw-bold w-fit-content align-content-center ms-1"> = MIN</p>
                                                        <input class="custom-input-text w-50p ms-3" type="number" step="1" min="1" value="1" id="SurveyAnswerMultiSelectMAX" />
                                                        <p class="custom-p fw-bold w-fit-content align-content-center ms-1"> = MAX</p>
                                                    </div>
                                                    <div id="SurveyQuestionsMultiSelectOptions" class="mt-3">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Dependencies Tab -->
                        <div id="DependenciesTab-3" class="survey-questions-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Survey Question Dependency</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please set survey question dependency options</p>
                            <div class="row mt-5">
                                <div class="col-md-12">
                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mx-auto">
                                        <input class="form-check-input" type="checkbox" id="EnableSurveyQuestionDependency" onchange="ToggleSurveyQuestionDependency(this.id)">
                                        <label class="form-check-label" for="EnableSurveyQuestionDependency">Enable Survey Question Dependency</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-5 hidden" id="SurveyQuestionDependencyContainer">
                                <div class="col-md-6 mb-4">
                                    <div class="w-400p ms-auto" id="SelectSurveyDependencyQuestionContainer">
                                        <div id="SelectSurveyDependentQuestion" class="d-flex">
                                            <select class="form-control ml-3 w-50 w-200p fs-14 " id="SurveyQuestionDependencyType" style="appearance:menulist" onchange="SurveyQuestionDependencySelect(this.id)">
                                                <option value="0" selected>Please Select Question...</option>
                                                <option value="1">Question 1</option>
                                                <option value="2">Question 3</option>
                                            </select>
                                            <button class="btn btn-success btn-sm px-4 ms-auto hidden" id="AddDependencyQuestion" onclick="AddSurveyQuestionDependency()">Add Dependency...</button>
                                        </div>
                                        <div id="SurveyQuestionDependencyAnswerOptionsContainer" class="mt-2 hidden">
                                            <div class="theme-border p-2" id="QuestionContainer">
                                                <p class="custom-p fw-bold text-center fs-16" id="SurveyDependencyQuestionNo">Question</p>
                                                <p class="custom-p html-text-editor" id="SurveyDependencyQuestionTextPreviewer"></p>
                                            </div>
                                            <div class="theme-border" id="QuestionOptionsContainer">
                                                <p class="custom-p fw-bold text-center fs-16 mx-auto px-5 w-fit-content border-2 theme-border-bottom">Qualifying Options</p>
                                                <p class="fw-bold fs-12 mb-0 pt-2 text-center text-alternate" id="SurveyQuestionScoringText">Please select dependent question answer</p>
                                                <div id="SurveyQuestionDependencyOptions">

                                                </div>
                                            
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <table class="table table-striped table-bordered w-400p me-auto" id="SurveyQuestionsDependencySelection">
                                            <thead>
                                                <tr>
                                                    <th class="theme-bg text-white"><input type="checkbox" /></th>
                                                    <th class="theme-bg text-white">Dependent Question</th>
                                                    <th class="theme-bg text-white">Qualifying Options</th>
                                                </tr>
                                            </thead>
                                            <tbody id="SurveyQuestionsDependencySelection-Body">
                                            
                                            </tbody>
                                        </table>
                                    </div>
                                    <div>
                                        <button class="btn btn-danger btn-sm fl-left hidden" onclick="RemoveSurveyQuestionDependency()" id="RemoveSelectedDependency">Remove Selected Dependency</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Calendar Options Tab -->
                        <div id="CalendarTab-4" class="survey-questions-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5 hidden">
                            <h5 class="fw-bold module-heading-theme mt-4">4. Survey Question Calendar</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please set survey question calendar options</p>
                            <div class="row mt-5">
                                <div class="col-md-12">
                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center mx-auto">
                                        <input class="form-check-input" type="checkbox" id="EnableSurveyQuestionCalendar" onchange="ToggleSurveyQuestionCalendar(this.id)">
                                        <label class="form-check-label" for="EnableSurveyQuestionCalendar">Enable Survey Question Calendar</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-5 hidden" id="SurveyQuestionCalendarContainer">
                                <div class="col-md-6 mb-4">
                                    <div class="w-400p ms-auto" id="SelectSurveyCalendarQuestionContainer">
                                        <div id="SelectSurveyCalendarQuestion" class="d-flex">
                                            <select class="form-control ml-3 w-50 w-200p fs-14 " id="SurveyQuestionCalendarType" style="appearance:menulist" onchange="SurveyQuestionCalendarSelect(this.id)">
                                                <option value="0" selected>Please Select Question...</option>
                                                <option value="1">Question 1</option>
                                                <option value="2">Question 3</option>
                                            </select>
                                            <button class="btn btn-success btn-sm px-4 ms-auto hidden" id="AddCalendarQuestion" onclick="AddSurveyQuestionCalendar()">Add Calendar Item...</button>
                                        </div>
                                        <div id="SurveyQuestionCalendarAnswerOptionsContainer" class="mt-2 hidden">
                                            <div class="theme-border p-2" id="QuestionContainer">
                                                <p class="custom-p fw-bold text-center fs-16" id="SurveyCalendarQuestionNo">Question</p>
                                                <p class="custom-p html-text-editor" id="SurveyCalendarQuestionTextPreviewer"></p>
                                            </div>
                                            <div class="theme-border" id="QuestionOptionsContainer">
                                                <p class="custom-p fw-bold text-center fs-16 mx-auto px-5 w-fit-content border-2 theme-border-bottom">Qualifying Options</p>
                                                <p class="fw-bold fs-12 mb-0 pt-2 text-center text-alternate" id="SurveyQuestionScoringText">Please select calendar question answer</p>
                                                <div id="SurveyQuestionCalendarOptions">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <table class="table table-striped table-bordered w-400p me-auto" id="SurveyQuestionsCalendarSelection">
                                            <thead>
                                                <tr>
                                                    <th class="theme-bg text-white"><input type="checkbox" /></th>
                                                    <th class="theme-bg text-white">Modify</th>
                                                    <th class="theme-bg text-white">Option</th>
                                                </tr>
                                            </thead>
                                            <tbody id="SurveyQuestionsCalendarSelection-Body">
                                            </tbody>
                                        </table>
                                    </div>
                                    <div>
                                        <button class="btn btn-danger btn-sm fl-left hidden" onclick="RemoveSurveyQuestionCalendar()" id="RemoveSelectedCalendar">Remove Selected Calendar Item</button>
                                    </div>
                                </div>
                            </div>
                            <div id="SurveyQuestionsCalendarPreviewModal" class="modal">
                                <span class="close text-danger" onclick="CloseSurveyCalendarItemDetails()">&times;</span>
                                <div id="ModalTargetedEntities" style="width: 800px;height: 700px;">
                                    <h3 class="theme-txt-clr text-center fw-bold p-2" id="TargetEntityTitle"></h3>
                                    <div class="w-600p mx-auto" id="SurveyQuestionCalendarFormContainer">
                                        <div id="SurveyQuestionCalendarForm" class="theme-border">
                                    <p class="custom-p fw-bold text-center fs-16 mx-auto px-3 w-fit-content border-2 theme-border-bottom mt-3">Question Calendar Details</p>
                                    <div class="d-flex mt-4">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">Subject</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <input class="custom-input-text fl-left w-200p" />
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">Location</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <input class="custom-input-text fl-left w-200p" />
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title"> 
                                            <p class="custom-p fw-bold fl-right">Description</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <textarea class="custom-input-textarea fl-left w-200p" rows="3"></textarea>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">Start Time</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <input type="date" class="custom-input-text fs-12 w-200p cursor-pointer fl-left" id="SurveyQuestionCalendarStartTime" />
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">End Time</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <input type="date" class="custom-input-text fs-12 w-200p cursor-pointer fl-left" id="SurveyQuestionCalendarEndTime" />
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">Show As</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3">
                                            <select class="custom-input-text w-200p fl-left">
                                                <option value="1">Free</option>
                                                <option value="1">Tentative</option>
                                                <option value="3" selected>Busy</option>
                                                <option value="4">Out of office</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <div class="survey-calendar-item-form-title">
                                            <p class="custom-p fw-bold fl-right">Reminder</p>
                                        </div>
                                        <div class="survey-calendar-item-form-value ms-3 ">
                                            <select class="custom-input-text w-200p fl-left" id="SurveyQuestionCalendarReminder">
                                                
                                            </select>
                                        </div>
                                    </div>
