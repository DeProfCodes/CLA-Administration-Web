<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/modules/survey.js"></script>

<script>

    var SurveyQuestionResponseTypes = 
    {
        NONE: -1,
        YES_NO: 0,
        YES_NO_NA: 1,
        AGREE_DISAGREE: 2,
        AGREE_DISAGREE_NA: 3,
        SINGLE_SELECT: 4,
    };

    var depedencyQuestionType = SurveyQuestionResponseTypes.NONE;

    $(document).ready(function ()
    {
        HideAllSurveyQuestionTabs();
        SurveyQuestionDatePickerSettings();
        CreateSurveyQuestionsReminderOptions();

        if('@Model.AddOrEditType' == '@AddOrEditType.Edit')
        {
            PrePopulateSurveyQuestionDataForEdit();
        }
    });

    function PrePopulateSurveyQuestionDataForEdit()
    {
        $(".module-left-nav-link").addClass("visited-nav-link");
        $(".module-nav-link-dot").removeClass("hidden");

        $("#SurveyQuestionTitle").html("Some information for edit view only");
        $("#SurveyQuestionDetails").html("information informatics & data");
        $("#SurveyQuestionTextPreviewer").html("Some information for edit view only");

        CheckOrUncheckInput("ShowHideSurveyTitle", true);
        
        CheckOrUncheckInput("SurveyQuestionScoringToggle", true);
        HideShowElement(`#SurveyQuestionScoringOptionsContainer`, HideShow.SHOW);
        SelectAnOptionWithValue("SurveyQuestionResponseType", 2);
        SurveyQuestionResponseTypeSelect();

        var newRow = `<tr>
                        <td><input type="checkbox" class="row-checkbox"/></td>
                        <td>Question 2</td>
                        <td>Agree</td>
                      </tr>`;

        $(`#SurveyQuestionsDependencySelection-Body`).append(newRow);
        HideShowElement(`#RemoveSelectedDependency`, HideShow.SHOW);
    }


</script>