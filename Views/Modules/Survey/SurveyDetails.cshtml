@model CLA_Administration_Web.ViewModels.Modules.PST.ModulePSTDataViewModel
@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages

@{
    var testSurveyTitle = "<p class='mb-0' style='color:yellow;font-size:16px;'>Survey Title HTML</p>";
    var testSurveyBody = "<p class='mb-0' style='color:navy;font-size:16px;'>Survey Body HTML</p>";
    var testSurveyConclusion = "<p class='mb-0' style='color:deepskyblue;font-size:16px;'>Survey Conclusion HTML</p>";

    var surveySkin = $"{LaunchSettingsHelper.GetBaseAddressForImages()}/images/others/modules/skins/SurveyBackground.bmp";
}

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.SurveyDetails, itemId = Model.Id })

    <!-- Card for Filters -->
    <div class="card mb-4 mt-5 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Survey Details for Survey Id: @Model.Id</h4>
        </div>
    </div>
    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card p-4">
        <div class="card-body" id="PopupDetailsContainer">
            <div class="row">
                <!-- Survey Texts -->
                <div class="col-md-6 mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Survey Texts</h4>
                    <div class="row mt-4">
                        <p class="custom-p-bold ps-0">Survey Title</p>
                        <div class="mt-1" id="SurveyDetailsTitlePreview">
                            @Html.Raw(testSurveyTitle)
                        </div>
                    </div>
                    <div class="row mt-3">
                        <p class="custom-p-bold ps-0">Survey Introduction</p>
                        <div class="mt-1" id="SurveyDetailsBodyPreview">
                            @Html.Raw(testSurveyBody)
                        </div>
                    </div>
                    <div class="row mt-3">
                        <p class="custom-p-bold ps-0">Survey Conclusion</p>
                        <div class="mt-1" id="SurveyDetailsBodyPreview">
                            @Html.Raw(testSurveyConclusion)
                        </div>
                    </div>
                </div>
                <!-- Survey Details -->
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Survey Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Delivery Method</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Screensaver | Popup</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Response Urgency</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Critical</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Auto Crtical Snooze Settings</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">After (1) Snooze | Friday, 01 May 2025, 14:30</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Show Survey Previous Button</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-success">Yes</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Show Correct Answer</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-success">Yes</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Show Scored Summary</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-danger">No</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Allow Recall if Completed Survey</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-success">Yes</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Require User Credential Verification</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-danger">No</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Randomize Order Of Question</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-danger">No</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Show Report Export Button</p>
                        </div>
                        <div class="col-md-6">
                            <span class="badge bg-success">Yes</span>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Acceptable Score (%)</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">80%</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex mt-5" id="SurveyPreviewAndDetailsContainer">
                <!-- Survey Preview -->
                <div class="mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Survey Preview</h4>
                    <div class="row mt-4 d-flex">
                        <div class="mb-3 w-fit-content p-0">
                            <p class="custom-p">Survey Skin <span class="custom-p-bold text-decoration-underline">StandardVodacomSkin.png</span></p>
                            <div class="mt-1 me-4" id="SurveyPreviewSkin" style="background-image: url('@surveySkin')">
                                <div id="SurveyQuestionPreview">
                                    <div class="row">
                                        <p class="text-center fw-bold pt-2">survey</p>
                                        <p class="text-center fw-bold">Question 1</p>
                                    </div>
                                    <div style="border:1px solid black; height:75px">
                                        <p>Have you used C.L.A before?</p>
                                    </div>
                                    <div style="border:1px solid black;height: 150px;overflow-y: scroll;padding:10px">
                                        <p>Just a quick question!</p>
                                    </div>
                                    <div class="d-flex pt-3" style="border: 1px solid gray;border-top: 2px solid gray;margin: 1px;margin-top: 5px;">
                                        <div class="col-md-6">
                                            <div class="d-flex ms-3">
                                                <input type="checkbox" disabled /> <p class="ms-1 mb-0">Snooze</p>
                                            </div>
                                            <div class="d-flex ms-3">
                                                <input type="checkbox" disabled /> <p class="ms-1 mb-0">Never Remind Me...</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-0 ms-5">Duration: 00:00:01</p>
                                            <p class="ms-5">Question: 1/6</p>
                                        </div>
                                    </div>
                                    <div class="row text-center mt-3">
                                        <button class="btn btn-sm btn-secondary ms-auto survey-preview-btns">PREVIOUS</button>
                                        <button class="btn btn-sm btn-secondary me-auto ms-5 survey-preview-btns">NEXT</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Times, Targeting, Modifications Settings -->
                <div id="SurveyPreviewDetails">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Times & Targeting Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective From</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Thursday, 26 September 2024</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective To</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Monday, 30 September 2024</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Timeslots</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">07:00 - 16:30</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Target Users</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-success module-details-targeting-btns">Targeting</btn>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Who Is Targeted</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-primary module-details-targeting-btns">Targeting Exposure</btn>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Date Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.LastModifiedDate</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">User Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.UserIdLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Machine Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.MachineLastModified</p>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <btn class="custom-btn custom-btn-default mt-4 px-5" onclick="OpenPage('@ModulesPages.SurveyQuestionsOverview', '@Model.Id');">Open Survey Questions</btn>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="ImagePreviwer">
    </div>
</div>


<script>

    $(document).ready(function ()
    {
        LoadContentPreviewer("#ImagePreviwer");
    });

</script>