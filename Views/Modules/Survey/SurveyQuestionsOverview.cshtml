@model List<CLA_Administration_Web.ViewModels.Modules.SurveyQuestionViewModel>

<h3 class="w-100 text-center theme-txt-clr overview-table-caption">
    <span id="SurveyQuesitonsOverviewTableCaption">Survey Questions For Survey ID: 5</span>
</h3>
<table id="SurveyQuesitonsOverviewDataTable" class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>No</th>
            <th class="text-center">Question Text</th>
            <th>Correct Answer</th>
            <th>Dependencies</th>
            <th>From</th>
            <th>To</th>
            <th>Status</th>
            <th>Last Modified Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var surveyQuestion in Model)
        {
            <tr>
                <td class="text-center">@surveyQuestion.QuestionNo</td>
                <td><p class="popup-dt-header-text">@surveyQuestion.QuestionTitle</p></td>
                <td><p class="popup-dt-body-text">@surveyQuestion.QuestionText</p></td>
                <td>@surveyQuestion.IsScored</td>
                <td>@surveyQuestion.CorrectAnswer</td>
                <td>@surveyQuestion.Dependencies</td>
                <td>@surveyQuestion.IsAnnonymouse</td>
                <td>@surveyQuestion.Randomize</td>
                <td>@surveyQuestion.ResponseType</td>
                <td>@surveyQuestion.UserIdLastModified</td>
                <td>@surveyQuestion.MachineLastModifiedDate</td>
                <td>
                    <button class="btn btn-info btn-sm mx-1" onclick="OpenModuleDetails('@surveyQuestion.Id')">Open</button>
                    <button class="btn btn-secondary btn-sm mx-1">Edit</button>
                    <button class="btn btn-danger btn-sm mx-1">Expire</button>
                </td>
            </tr>
        }
    </tbody>
</table>
