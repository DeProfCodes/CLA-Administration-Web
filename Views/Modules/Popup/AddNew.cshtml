                                                <button type="button" class="btn btn-outline-primary">Ticker</button>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-4 fw-bold">
                                          
                                        </div>
                                        <div class="col-12 col-md-8">
                                            <div class="btn-group mb-2 w-100">
                                                <button type="button" class="btn btn-outline-primary">No Link</button>
                                                <button type="button" class="btn ">Image</button>
                                                <button type="button" class="btn btn-outline-primary">Audio</button>
                                                <button type="button" class="btn btn-outline-primary">Video</button>
