<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    const sidebarLinks = document.querySelectorAll('.sidebar a');

  
    let currentPopup = 1;
    const totalPopups = sidebarLinks.length;

    // Show popup by number
    function showPopup(popupNumber) {
        for (let i = 1; i <= totalPopups; i++) {
            document.getElementById(`popup${i}`).style.display = i === popupNumber ? 'block' : 'none';
        }
        document.getElementById('pageNumber').textContent = `Page ${popupNumber}`;
        document.getElementById('backBtn').style.display = popupNumber === 1 ? 'none' : 'inline-block'; 
        document.getElementById('nextBtn').style.display = popupNumber === totalPopups ? 'none' : 'inline-block'; 
        document.getElementById('submitBtn').style.display = popupNumber === totalPopups ? 'inline-block' : 'none'; 
        updatePopupSidebar(popupNumber);
    }

    // Go to the next popup
    function nextPopup(event) {
  
        if (currentPopup < totalPopups) {
            currentPopup++;
            showPopup(currentPopup);
            updatePopupSidebar(currentPopup)
        }
    }

    // Go to the previous popup
    function prevPopup(event) {
 
        if (currentPopup > 1) {
            currentPopup--;
            showPopup(currentPopup);
            updatePopupSidebar(currentPopup)
        }
    }

    // Drag and drop logic
    const uploadSection = document.getElementById('upload-section');
    const fileInput = document.getElementById('file-input');
    const fileNameDisplay = document.getElementById('fileName');

    uploadSection.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadSection.classList.add('dragging');
    });

    uploadSection.addEventListener('dragleave', () => {
        uploadSection.classList.remove('dragging');
    });

    uploadSection.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadSection.classList.remove('dragging');
        const files = e.dataTransfer.files;
        handleFiles(files);
    });

    fileInput.addEventListener('change', (e) => {
        const files = e.target.files;
        handleFiles(files);
    });

    function handleFiles(files) {
        if (files.length > 0) {
            fileNameDisplay.textContent = files[0].name;
        } else {
            fileNameDisplay.textContent = "No file selected";
        }
    }

    // Update the sidebar to reflect the current popup step
    function updatePopupSidebar(step) {
        sidebarLinks.forEach(link => link.classList.remove('active'));

        switch (step) {
            case 1:
                document.getElementById('sidebar-link-type').classList.add('active');
                break;
            case 2:
                document.getElementById('sidebar-skin').classList.add('active');
                break;
            case 3:
                document.getElementById('sidebar-texts').classList.add('active');
                break;
            case 4:
                document.getElementById('sidebar-times').classList.add('active');
                break;
            case 5:
                document.getElementById('sidebar-displays').classList.add('active');
                break;
            case 6:
                document.getElementById('sidebar-repeat').classList.add('active');
                break;
            case 7:
                document.getElementById('sidebar-feedback').classList.add('active');
                break;
            case 8:
                document.getElementById('sidebar-target-users').classList.add('active');
                break;
            case 9:
                document.getElementById('sidebar-exposure-summary').classList.add('active');
                break;
            default:
                console.log('Invalid step');
                break;
        }
    }

    // Initialize the first popup on page load
    showPopup(currentPopup);
    document.getElementById('backBtn').style.display = 'none'; // Hide back button on the first step





</script>