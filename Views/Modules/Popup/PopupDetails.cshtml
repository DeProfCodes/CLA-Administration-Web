@model CLA_Administration_Web.ViewModels.Modules.PSTR.ModulePSTRDataViewModel
@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupDetails, itemId = Model.Id })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Popup Details for Popup Id: @Model.Id</h4>
        </div>
    </div>

    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <div class="col-md-6">
                <div class="row">
                    <p class="fw-bold theme-txt-clr">Popup Title</p>
                    <div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>