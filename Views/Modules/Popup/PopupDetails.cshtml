    var testPopupBody = @"
                            <font color=""#000000"" size=""3"" face=""Arial""><table style=""WIDTH: 148pt; BORDER-COLLAPSE: collapse"" cellspacing=""0"" cellpadding=""0"" width=""198"" border=""0""><colgroup><col style=""WIDTH: 101pt; mso-width-source: userset; mso-width-alt: 4937"" width=""135""><col style=""WIDTH: 47pt; mso-width-source: userset; mso-width-alt: 2304"" width=""63""><tbody><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl68"" style=""BORDER-TOP: windowtext 0.5pt solid; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 148pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16"" width=""198"" colspan=""2""><strong><font size=""2"" face=""Calibri"">WIP Status</font></strong></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font size=""2"" face=""Calibri"">Opening prior</font></td><td class=""xl67"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: transparent"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">880 222</font></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font face=""Calibri""><font size=""2"">In-Cycle Prior month&nbsp; </font></font></td><td class=""xl67"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: transparent"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">644 868</font></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font size=""2"" face=""Calibri"">% in-cycle</font></td><td class=""xl69"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: #00b050"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">73%</font></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font size=""2"" face=""Calibri"">Out-Cycle Prior</font></td><td class=""xl67"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: transparent"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">141 710</font></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font size=""2"" face=""Calibri"">Opening Current</font></td><td class=""xl67"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: transparent"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">786 466</font></td></tr><tr style=""HEIGHT: 12pt"" height=""16""><td class=""xl66"" style=""BORDER-TOP: windowtext; HEIGHT: 12pt; BORDER-RIGHT: windowtext 0.5pt solid; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext 0.5pt solid; BACKGROUND-COLOR: transparent"" height=""16""><font size=""2"" face=""Calibri"">Target</font></td><td class=""xl67"" style=""BORDER-TOP: windowtext; BORDER-RIGHT: windowtext 0.5pt solid; WIDTH: 47pt; BORDER-BOTTOM: windowtext 0.5pt solid; BORDER-LEFT: windowtext; BACKGROUND-COLOR: transparent"" width=""63"" align=""right""><font size=""2"" face=""Segoe UI"">393 233</font></td></tr></tbody></colgroup></table></font>
                            ";

}

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupDetails, itemId = Model.Id })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Popup Details for Popup Id: @Model.Id</h4>
        </div>
    </div>

    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card p-4">
        <div class="card-body" id="PopupDetailsContainer">
            <div class="row">
                <!-- Popup Texts -->
                <div class="col-md-6 mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Texts</h4>
                    <div class="row mt-4">
                        <p class="custom-p-bold ps-0">Popup Title <span class="fst-italic fw-normal">(Display: Yes)</span></p>
                        <div class="mt-1" id="PopupDetailsTitlePreview">
                            @Html.Raw(testPopupTitle)
                        </div>
                    </div>
                    <div class="row mt-3">
                        <p class="custom-p-bold ps-0">Popup Text <span class="fst-italic fw-normal">(Display: Yes)</span></p>
                        <div class="mt-1" id="PopupDetailsBodyPreview">
                            @Html.Raw(testPopupBody)
                        </div>
                    </div>
                </div>
                <!-- Popup Details -->
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Link Type</p>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-0 d-flex">
                                <span class="custom-p-bold me-2">Image | </span> 
                                <i class="bi bi-card-image popup-info-attachment-icon"></i>
                                <p class="popup-info-attachment-text ms-1" onclick="PreviewImage()">testImage101.png</p>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Popup Icon</p>
                        </div>
                        <div class="col-md-6">
                            <img class="popup-icon" src="~/images/icons/modules/popup/icon-info.png"/>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Display Type</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Dismissable | Snoozable</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Auto Hide Seconds</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">N/A</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Popup Display Position</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Middle Center</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Feedback Request</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Like/Dislike | Comment</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Repeat Settings</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Repeat Daily</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Auto Crtical Snooze Settings</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">After (1) Snooze | Friday, 01 May 2025, 14:30</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-5">
                <!-- Popup Preview -->
                <div class="col-md-6 mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Preview</h4>
                    <div class="row mt-3 d-flex">
                        <div class="mb-3 w-fit-content p-0">
                            <p class="custom-p">Popup Skin <span class="custom-p-bold text-decoration-underline">StandardVodacomSkin.png</span></p>
                            <div class="mt-1 me-4" id="PopupBodyPreview" style="background-image: url('/images/others/modules/skins/Popup_Skin_Default.png')">
                                <div class="d-flex" id="PopupBodyPreviewTitle">
                                    <div id="PopupBodyPreviewTitleIcon">
                                        <img src="~/images/icons/modules/popup/icon-info.png" />
                                    </div>
                                    <div id="PopupBodyPreviewTitleText">
                                        @Html.Raw(testPopupTitle)
                                    </div>
                                    <div id="PopupBodyPreviewTitleDismiss">
                                        <img src="~/images/icons/modules/popup/icon-error.png" />
                                    </div>
                                </div>
                                <div id="PopupBodyPreviewText">
                                    <div id="PopupBodyPreviewTextBody">
                                        @Html.Raw(testPopupBody)
                                    </div>
                                    <div id="PopupBodyPreviewTextBodyFooter">
                                        <button class="btn">Remind Me Later</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="w-fit-content p-0">
                            <p class="custom-p">Popup Feedback</p>
                            <div class="mt-1" id="PopupBodyPreview" style="background-image: url('/images/others/modules/skins/Popup_Skin_Default.png'); opacity:0.4">
                                <div class="d-flex" id="PopupBodyPreviewTitle">
                                    <div id="PopupBodyPreviewTitleIcon">
                                        <img src="~/images/icons/modules/popup/icon-info.png" />
                                    </div>
                                    <div id="PopupBodyPreviewTitleText">
                                        @Html.Raw(testPopupTitle)
                                    </div>
                                    <div id="PopupBodyPreviewTitleDismiss">
                                        <img src="~/images/icons/modules/popup/icon-error.png" />
                                    </div>
                                </div>
                                <div id="PopupBodyPreviewText">
                                    <div id="PopupBodyPreviewTextBody">
                                        @Html.Raw(testPopupBody)
                                    </div>
                                    <div id="PopupBodyPreviewTextBodyFooter">
                                        <button class="btn">Remind Me Later</button>
                                    </div>
                                </div>
                            </div>
                            <div id="PopupFeedbackContents">
                                <p class="pt-1 mb-0 w-100 text-center" style="font-size:11px">Please provide feedback on this popup</p>
                                <div class="d-flex mt-1">
                                    <img src="~/images/icons/modules/popup/Like-icon.png" class="popup-feedback-icons ms-auto"/>
                                    <img src="~/images/icons/modules/popup/Dislike-icon.png" class="popup-feedback-icons me-auto" />
                                </div>
                                <div class="mt-1 text-center">
                                    <textarea rows="3" id="PopupFeedbackText" disabled></textarea>
                                </div>
                                <div class="text-center">
                                    <button class="btn" id="PopupFeedbackBtn">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Times & Targeting Settings -->
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Times & Targeting Settings</h4>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective From</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Thursday, 26 September 2024</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective To</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Monday, 30 September 2024</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Timeslots</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">07:00 - 16:30</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Target Users</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-success module-details-targeting-btns">Targeting</btn>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Who Is Targeted</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-primary module-details-targeting-btns">Targeting Exposure</btn>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Modification Details -->
            <div class="row mt-3" style="">
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Modifications Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Date Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.LastModifiedDate</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">User Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.UserIdLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Machine Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.MachineLastModified</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="ImagePreviwer">
    </div>
</div>


<script>

    $(document).ready(function ()
    {
        LoadContentPreviewer("#ImagePreviwer");
    });

</script>