@model CLA_Administration_Web.ViewModels.Modules.PST.ModulePSTDataViewModel
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLAModulesLibrary.Helpers.Enums.Modules.Popup
@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Module
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.Helpers.Modules

@{
    var displayHeaderText = Model.DisplayHeaderText ? "Yes" : "No";
    var displayBodyText = Model.DisplayBodyText ? "Yes" : "No";

    var popupPosition = PopupHelper.GetPopupPositionString(Model.PopupPosition);

    var displayTypeText = PopupHelper.GetPopupDisplayTypeString(Model.PopupDisplayType);
    var popupAutoHideSecconds = displayTypeText.ToLower().Contains(PopupDisplayTypes.AutoHide.GetDisplayName().ToLower()) ? $"{Model.PopupAutoHideSeconds}" : "N/A";
    var snoozable = displayTypeText.ToLower().Contains(PopupDisplayTypes.Snoozable.GetDisplayName().ToLower());
    var dismissableCss = !displayTypeText.ToLower().Contains(PopupDisplayTypes.Dismissable.GetDisplayName().ToLower()) ? CssHtmlHelpers.CSS_INVISIBLE : "";

    var skinFilename = !string.IsNullOrEmpty(Model.ModuleSkinUrl) ? Model.ModuleSkinUrl.Split("/")?.LastOrDefault() ?? "" : "";

    var hasIconCss = Model.PopupIcon == PopupIconType.None ? CssHtmlHelpers.CSS_INVISIBLE : "";
    var iconUrl = $"{ResourcesLibrary.ModulesLibrary.Icons.PopupBaseAddress}/{Model.PopupIcon.GetDisplayShortName()}";

    var hasFeedback = Model.PopupFeedback.RequireFeedbackLikeDislike || Model.PopupFeedback.RequireFeedbackComment;
    var feedbackText = PopupHelper.GetPopupFeedbackTypeString(Model.PopupFeedback);

    var feedbackLikeCss = !Model.PopupFeedback.RequireFeedbackLikeDislike ? CssHtmlHelpers.CSS_INVISIBLE : "";
    var feedbackCommentCss = !Model.PopupFeedback.RequireFeedbackComment ? CssHtmlHelpers.CSS_INVISIBLE : "";
}


<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupDetails, itemId = Model.Id })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Popup Details for Popup Id: @Model.Id</h4>
        </div>
    </div>

    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card p-4">
        <div class="card-body" id="PopupDetailsContainer">
            <div class="row">
                <!-- Popup Texts -->
                <div class="col-md-6 mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Texts</h4>
                    <div class="row mt-4">
                        <p class="custom-p-bold ps-0">Popup Title <span class="fst-italic fw-normal">(Display: @displayHeaderText)</span></p>
                        <div class="mt-1" id="PopupDetailsTitlePreview">
                            @Html.Raw(Model.HeaderText)
                        </div>
                    </div>
                    <div class="row mt-3">
                        <p class="custom-p-bold ps-0">Popup Text <span class="fst-italic fw-normal">(Display: @displayBodyText)</span></p>
                        <div class="mt-1" id="PopupDetailsBodyPreview">
                            @Html.Raw(Model.BodyText)
                        </div>
                    </div>
                </div>
                <!-- Popup Details -->
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Link Type</p>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-0 d-flex">
                                <span class="custom-p-bold me-2">Image | </span> 
                                <i class="bi bi-card-image popup-info-attachment-icon"></i>
                                <p class="popup-info-attachment-text ms-1" onclick="PreviewContentType(ContentTypes.IMAGE, `${APP_BASE_ADDRESS}/images/others/modules/skins/Popup_Skin_Default.png`)">testImage101.png</p>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Popup Icon</p>
                        </div>
                        <div class="col-md-6">
                            <img class="popup-icon @hasIconCss" src="@iconUrl"/>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Display Type</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@displayTypeText</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Auto Hide Seconds</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@popupAutoHideSecconds</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Popup Display Position</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@popupPosition</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Feedback Request</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@feedbackText</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Repeat Settings</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">Repeat Daily</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Auto Crtical Snooze Settings</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">After (1) Snooze | Friday, 01 May 2025, 14:30</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-5">
                <!-- Popup Preview -->
                <div class="col-md-6 mb-3">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Popup Preview</h4>
                    <div class="row mt-3 d-flex">
                        <div class="mb-3 w-fit-content p-0">
                            <p class="custom-p">Popup Skin <span class="custom-p-bold text-decoration-underline">@skinFilename</span></p>
                            <div class="mt-1 me-4" id="PopupBodyPreview" style="background-image: url('@Model.ModuleSkinUrl')">
                                <div class="d-flex" id="PopupBodyPreviewTitle">
                                    <div id="PopupBodyPreviewTitleIcon">
                                        <img class="@hasIconCss" src="@iconUrl" />
                                    </div>
                                    <div class="poup-body-preview-title-text" id="PopupBodyPreviewTitleText">
                                        @Html.Raw(Model.HeaderText)
                                    </div>
                                    <div id="PopupBodyPreviewTitleDismiss">
                                        <img src="~/images/icons/modules/popup/icon-error.png" class="@dismissableCss" />
                                    </div>
                                </div>
                                <div id="PopupBodyPreviewText">
                                    <div class="popup-body-preview-text-body" id="PopupBodyPreviewTextBody">
                                        @Html.Raw(Model.BodyText)
                                    </div>
                                    @if (snoozable)
                                    {
                                        <div id="PopupBodyPreviewTextBodyFooter">
                                            <button class="btn">Remind Me Later</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="w-fit-content p-0">
                            <p class="custom-p">Popup Feedback</p>
                            @if (hasFeedback)
                            {
                                <div class="mt-1" id="PopupBodyPreview" style="background-image: url('@Model.ModuleSkinUrl');opacity:0.4">
                                    <div class="d-flex" id="PopupBodyPreviewTitle">
                                        <div id="PopupBodyPreviewTitleIcon">
                                            <img class="@hasIconCss" src="@iconUrl" />
                                        </div>
                                        <div class="poup-body-preview-title-text" id="PopupBodyPreviewTitleText">
                                            @Html.Raw(Model.HeaderText)
                                        </div>
                                        <div id="PopupBodyPreviewTitleDismiss">
                                            <img src="~/images/icons/modules/popup/icon-error.png" class="@dismissableCss" />
                                        </div>
                                    </div>
                                    <div id="PopupBodyPreviewText">
                                        <div class="popup-body-preview-text-body" id="PopupBodyPreviewTextBody">
                                            @Html.Raw(Model.BodyText)
                                        </div>
                                        @if (snoozable)
                                        {
                                            <div id="PopupBodyPreviewTextBodyFooter">
                                                <button class="btn">Remind Me Later</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div id="PopupFeedbackContents">
                                    <p class="pt-1 mb-0 w-100 text-center" style="font-size:11px">Please provide feedback on this popup</p>
                                    <div class="d-flex mt-1 @feedbackLikeCss">
                                        <img src="~/images/icons/modules/popup/Like-icon.png" class="popup-feedback-icons ms-auto"/>
                                        <img src="~/images/icons/modules/popup/Dislike-icon.png" class="popup-feedback-icons me-auto" />
                                    </div>
                                    <div class="mt-1 text-center @feedbackCommentCss">
                                        <textarea rows="3" id="PopupFeedbackText" disabled></textarea>
                                    </div>
                                    <div class="text-center">
                                        <button class="btn" id="PopupFeedbackBtn">Submit</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="custom-p fst-italic p-5 fs-18">No Feedback</p>   
                            }
                        </div>
                    </div>
                </div>
                <!-- Times & Targeting Settings -->
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Times & Targeting Settings</h4>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective From</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.EffectiveFromDate.ToString("dddd, dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective To</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.EffectiveToDate.ToString("dddd, dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Timeslots</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.TimeslotFrom - @Model.TimeslotFrom</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Target Users</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-success module-details-targeting-btns" onclick="OpenTargetedEntityPreviewModal('@ModuleNamesType.Popup', true)">Targeting</btn>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Who Is Targeted</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-primary module-details-targeting-btns" onclick="OpenTargetingExposurePreviewModal('@ModuleNamesType.Popup')">Targeting Exposure</btn>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Modification Details -->
            <div class="row mt-3" style="">
                <div class="col-md-6">
                    <h4 class="w-100 text-center theme-txt-clr fw-bold">Modifications Details</h4>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Date Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.LastModifiedDate</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">User Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.UserIdLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Machine Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.MachineLastModified</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
}

