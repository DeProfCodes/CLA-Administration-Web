@model List<CLA_Administration_Web.ViewModels.Modules.PopupViewModel>
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using Newtonsoft.Json

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.PopupOverview })

    <!-- Card for Table -->
    <div class="card" id="ModuleOverviewCard">
        <div class="card-body">
            <div class="table-responsive" id="PopupOverviewTableContainer">

            </div>
        </div>
    </div>
</div>


<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        ModuleOverviewLoader("Popups");
        LoadDefaultPopups();
    });

    function LoadDefaultPopups()
    {
        var startDate = "2024/01/01";
        var endDate = TodayDate('/');

        var url = `@Url.Action("_FilterPopupsOverview", "Modules")?status=all&userType=all&startDate=${startDate}&endDate=${endDate}`;

        LoadPartialView(url, "#PopupOverviewTableContainer");

        FilterData("ActivePopupBtnFilter", AllStatusTypes.Active);
    }

</script>
