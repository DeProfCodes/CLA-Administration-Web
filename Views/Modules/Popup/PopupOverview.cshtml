@using CLA_Administration_Web.Helpers.Enums.AppPages

<div class="container-fluid">
    
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupOverview })

    <!-- Card for Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <h4 class="text-center mb-1 theme-txt-clr">Filter Popup Types</h4>
                <div class="col-12 mb-4 d-flex flex-wrap justify-content-between align-items-center">
                    <div class="mb-3 mb-md-0">
                        <p class="text-left theme-txt-clr">Status</p>
                        <div class="btn-group w-100" role="group" aria-label="Status filter">
                            <button class="btn btn-primary">All</button>
                            <button class="btn btn-outline-primary">Active</button>
                            <button class="btn btn-outline-primary">Expired</button>
                            <button class="btn btn-outline-primary">Pending</button>
                            <button class="btn btn-outline-primary">Custom</button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center">
                        <div class="mb-3 mb-md-0">
                            <label for="userFilter" class="col-form-label fw-bold">User</label>
                            <select class="form-select" id="userFilter">
                                <option selected>All Users</option>
                                <option value="1">User 1</option>
                                <option value="2">User 2</option>
                                <option value="3">User 3</option>
                            </select>
                        </div>
                        <div class="mb-3 mb-md-0 ms-3">
                            <label for="dateFrom" class="col-form-label fw-bold">From</label>
                            <input type="date" class="form-control" id="dateFrom" value="2020-01-01">
                        </div>
                        <div class="mb-3 mb-md-0 ms-3">
                            <label for="dateTo" class="col-form-label fw-bold">To</label>
                            <input type="date" class="form-control" id="dateTo" value="2024-08-31">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card for Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="myTable" class="table table-striped table-bordered table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Header Text</th>
                            <th>Body Text</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>Timeslot From</th>
                            <th>Timeslot To</th>
                            <th>Status</th>
                            <th>Last Modified Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Image Popup</td>
                            <td>Click this popup to open...</td>
                            <td>2024/07/01</td>
                            <td>2024/08/30</td>
                            <td>08:00</td>
                            <td>17:30</td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>2024/08/20 16:42</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-primary btn-sm mx-1" style="border: 1px solid ;">Open</button>
                                    <button class="btn btn-secondary btn-sm mx-1" style="border: 1px solid;">Edit</button>
                                    <button class="btn btn-danger btn-sm mx-1" style="border: 1px solid;">Expired</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Another Popup</td>
                            <td>Click this popup for details...</td>
                            <td>2024/06/15</td>
                            <td>2024/07/20</td>
                            <td>09:00</td>
                            <td>18:00</td>
                            <td><span class="badge bg-danger">Expired</span></td>
                            <td>2024/07/18 12:32</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-primary btn-sm mx-1" style="border: 1px solid ;">Open</button>
                                    <button class="btn btn-secondary btn-sm mx-1" style="border: 1px solid;">Edit</button>
                                    <button class="btn btn-danger btn-sm mx-1" style="border: 1px solid;">Expired</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>
    $(document).ready(function ()
    {
        $('#myTable').DataTable();
    });
</script>
