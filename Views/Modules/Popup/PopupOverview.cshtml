@model List<CLA_Administration_Web.ViewModels.Modules.PopupViewModule>
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.PopupOverview })

    <!-- Card for Table -->
    <div class="card" id="ModuleOverviewCard">
        <div class="card-body">
            <div class="table-responsive">
                <h3 class="w-100 text-center theme-txt-clr overview-table-caption">Active Popups</h3>
                <table id="PopupOverviewDataTable" class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Header Text</th>
                            <th class="text-center">Body Text</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Status</th>
                            <th>Last Modified Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var popup in Model)
                        {
                            <tr>
                                <td class="text-center">@popup.Id</td>
                                <td><p class="popup-dt-header-text">@popup.HeaderText</p></td>
                                <td><p class="popup-dt-body-text">@popup.BodyText</p></td>
                                <td>@popup.EffectiveFrom</td>
                                <td>@popup.EffectiveTo</td>
                                <td>@popup.TimeslotFrom</td>
                                <td>@popup.TimeslotTo</td>
                                <td><span class="@popup.Status.CssClass">@popup.Status.StatusType.GetDisplayName()</span></td>
                                <td>@popup.LastModifiedDate</td>
                                <td>
                                    <button class="btn btn-info btn-sm mx-1">Open</button>
                                    <button class="btn btn-secondary btn-sm mx-1">Edit</button>
                                    <button class="btn btn-danger btn-sm mx-1">Expire</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        $('#PopupOverviewDataTable').DataTable();
    });

</script>
