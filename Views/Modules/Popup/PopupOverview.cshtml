@model List<CLA_Administration_Web.ViewModels.Modules.PSTR.ModulePSTRDataViewModel>
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using Newtonsoft.Json

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.PopupOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataTables", new { page = ModulesPages.PopupOverview })

</div>

<script>

    $(document).ready(function ()
    {
        LoadPopupDefaultOverviewData();
    });

    function LoadPopupDefaultOverviewData()
    {
        FilterModuleDataOverviewByStatus('Popup', `ActivePopupBtnFilter`, AllStatusTypes.Active);
    }

</script>
