<div class="container-fluid">
    <!-- Row for Title and Button -->

    <div class="row mb-1">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold mb-0">Popup Module</h2>
            <button class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add New Popup</button>
        </div>
    </div>

    <!-- Breadcrumbs -->
    <div class="row mb-2">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Modules</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Popup</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Card for Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <p class="text-center mb-1">Filter Popup Types</p>
                <div class="col-12 mb-4 d-flex flex-wrap justify-content-between align-items-center">
                    <div class="mb-3 mb-md-0">
                        <h5 class="text-left mb-2">Status</h5>
                        <div class="btn-group w-100" role="group" aria-label="Status filter">
                            <button type="button" class="btn btn-primary">All</button>
                            <button type="button" class="btn btn-outline-primary">Active</button>
                            <button type="button" class="btn btn-outline-primary">Expired</button>
                            <button type="button" class="btn btn-outline-primary">Pending</button>
                            <button type="button" class="btn btn-outline-primary">Custom</button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center">
                        <div class="mb-3 mb-md-0">
                            <label for="userFilter" class="col-form-label fw-bold">User</label>
                            <select class="form-select" id="userFilter">
                                <option selected>All Users</option>
                                <option value="1">User 1</option>
                                <option value="2">User 2</option>
                                <option value="3">User 3</option>
                            </select>
                        </div>
                        <div class="mb-3 mb-md-0 ms-3">
                            <label for="dateFrom" class="col-form-label fw-bold">From</label>
                            <input type="date" class="form-control" id="dateFrom" value="1900-01-01">
                        </div>
                        <div class="mb-3 mb-md-0 ms-3">
                            <label for="dateTo" class="col-form-label fw-bold">To</label>
                            <input type="date" class="form-control" id="dateTo" value="2024-08-31">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card for Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="myTable" class="table table-striped table-bordered table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Header Text</th>
                            <th>Body Text</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>Timeslot From</th>
                            <th>Timeslot To</th>
                            <th>Status</th>
                            <th>Last Modified Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Example Row -->
                        <tr>
                            <td>1</td>
                            <td>Image Popup</td>
                            <td>Click this popup to open...</td>
                            <td>2024/07/01</td>
                            <td>2024/08/30</td>
                            <td>08:00</td>
                            <td>17:30</td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>2024/08/20 16:42</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-primary btn-sm">Open</button>
                                    <button class="btn btn-secondary btn-sm">Edit</button>
                                    <button class="btn btn-danger btn-sm">Expired</button>
                                </div>
                            </td>
                        </tr>
                        <!-- Repeat similar rows as needed -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
