<style>




.module-heading-theme {
    color: var(--dark-blue);
    text-align: center;
}

.module-subheading-theme {
    color: var(--dark-blue);
    text-align: center;
}


/* 
.btn-group.btn {
    font-size: x-small;
}
 */
.form-check-input:checked
{
    background-color: var(--dark-blue);
    border-color: var(--dark-blue);
}

/* Preview Box Styling */
.preview-box {
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: auto;
}

.skin-filename {
    font-weight: bold;
    margin-bottom: 15px;
}

.preview-box{
    width:100%;
}
#previewContent{
    overflow:auto;
}

.preview-box div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    width: 100%;
    height: 100% ;
    overflow-x: hidden;
    overflow-y: auto;
    text-align: justify;
}

.preview-box img,
.preview-box .title,
.preview-box .body {
    display: block;
    margin: 0 auto;
    width: 100%;
}

.pagination-section {
    align-items: center;
}



    
.popup {
    color: var(--navy-blue);
}

.btn-toolbar {
    padding-left: 60px;
    padding-right: 60px;
}

/*wyswig*/
#wysiwyg {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.1);
}

.title-section,
.toggle-preview {
    padding: 10px;
    display: flex;
    align-items: center;
}

.toggle-preview {
    padding: 10px;
    display: flex;
    align-items: center;
}
/* 
.btns {
    padding: 0.3em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    border-bottom: 1px solid #EFEFEF;
} */

.category {
    display: flex;
    align-items: center;
    padding: 0 4px;
    border-right: 1px solid #EFEFEF;
}
/* 
button,
select,
input {
    background-color: white;
    border: none;
    padding: 5px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    margin-right: 5px;
}

    input[type="color"] {
        width: 30px;
        height: 30px;
        border-radius: 50%;
    }
 */
.option {
    margin-bottom: 20px;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
}

    .option label {
        font-size: 16px;
        color: var(--dark-blue);
    }

.toggle-switch {
    width: 50px;
    height: 24px;
    position: relative;
    appearance: none;
    background-color: var(--navy-blue);
    border-radius: 15px;
    cursor: pointer;
    outline: none;
    transition: background-color 0.3s;
}

/*popup 3 css*/
#titleInput {
    padding: 20px;
    background-color: var(--light-blue);
    outline: none;
    border: none;
    resize: vertical;
    overflow: auto;
}

#bodyInput {
    padding: 20px;
    background-color: var(--light-blue);
    outline: none;
    border: none;
    resize: vertical;
    overflow: auto;
    height: 150px;
}

#preview {
    border: 1px solid #EFEFEF;
    border-radius: 4px;
}


</style>


