<script>
    const popupTitleEditor = document.getElementById('PopupTextHeader');
    const popupBodyEditor = document.getElementById('PopupTextBody');
</script>

<div class="container-fluid">
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupAddNew })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">Add New Popup</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link active" id="LinkTabLink-1">Link Type</a>
                        <a class="module-left-nav-link" id="SkinTabLink-2">Skin</a>
                        <a class="module-left-nav-link" id="TextsTabLink-3">Texts</a>
                        <a class="module-left-nav-link" id="TimesTabLink-4">Times</a>
                        <a class="module-left-nav-link" id="DisplaysTabLink-5">Displays</a>
                        <a class="module-left-nav-link" id="RepeatTabLink-6">Repeat</a>
                        <a class="module-left-nav-link" id="FeedbackTabLink-7">Feedback</a>
                        <a class="module-left-nav-link" id="TargetUsersTabLink-8">Target Users</a>
                        <a class="module-left-nav-link" id="ExposureSummaryTabLink-9">Exposure Summary</a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap" id="ModuleWizardMain">
                    <div class="form-horizontal" id="popupForm">
                        <!-- Link Type Tab -->
                        <div id="LinkTypeTab-1" class="add-new-popup popup flex-wrap align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold module-heading-theme mt-4">1. Popup Link Type</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Select what the popup will link to when clicked by the user.</p>
                            <p class="custom-p fs-13 text-center">The popup can launch any of the below options when clicked on or be linked to nothing.</p>
                            <!-- Links Options -->
                            <div class="row mt-5">
                                <div class="col-lg-3 align-content-center">
                                    <p class="fw-bold text-center theme-txt-clr">Link Type</p>
                                </div>
                                <div class="col-lg-9" id="ModuleLinkTypeContainer">
                                    <div class="btn-group mb-2 w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn btn-group-active" onclick="PopupLinkTypeClick(this.id)" id="NoLink">No Link</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="ImageLink">Image</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="AudioLink">Audio</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="VideoLink">Video</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="DocumentLink">Document</button>
                                    </div>
                                    <div class="btn-group w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="WebsiteLink">Website</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="EmailLink">Email</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="TickerTypeLink">Ticker</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="SurveyTypeLink">Survey</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="PolicyTypeLink">Policy</button>
                                    </div>
                                </div>
                            </div>
                            <!-- Attachment -->
                            <div class="row mt-3 " id="LinkTypeAttachment">
                                <p class="col-lg-3 fw-bold text-center theme-txt-clr mb-0" id="UploadFileTitle"></p>
                                <div class="col-lg-9 p-0">
                                    <!-- Uploader Component -->
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml", 
                                            new FileUploaderModel { InputId = "ContentUploadInput", ShowPreviewButton = true, InitialHidden = true, WidthPx = "396px" });
                                    }
                                    <!-- Website Textbox -->
                                    <div class="w-100 mt-2 p-0 d-flex hidden" id="LinkTypeUrl">
                                        <input type="text" class="custom-input-text" id="LinkTypeUrlInput" />
                                        <button class="btn btn-success content-preview-btn custom-btn-sm ms-3" id="ModuleContentPreviewUpload" onclick="PreviewWebsite()">Preview</button>
                                    </div>
                                    <!-- Email Inputs Section -->
                                    <div class="w-fit-content border border-light-1 p-3 pe-5 mb-3 hidden" id="LinkTypeEmail">
                                        <div>
                                            <p class="mb-0">Emails <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter Recipients Emails" id="LinkTypeEmailInput"/>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">CC <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter CC Emails" id="LinkTypeCCEmailInput" />
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeCCEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">Subject</p>
                                            <input type="text" class="custom-input-text w-300p" placeholder="Enter Subject" id="LinkTypeEmailSubjectInput"/>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailSubjectValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0 mt-1">Message</p>
                                            <textarea class="w-300p" rows="5" id="LinkTypeEmailMessageInput"></textarea>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailMessageValid"></p>
                                        </div>
                                    </div>
                                    <!-- Survey Type -->
                                    <div class="mt-2 p-0 hidden" id="SurveyType">
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12 ps-2">Survey Type</p>
                                            <div class="col-md-8 btn-group w-auto overview-filter-btn-group">
                                                <button class="btn module-link-type custom-btn-group btn-group-active" onclick="SurveyLinkTypeClick(this.id)" id="ActiveSurveyLink">Active</button>
                                                <button class="btn module-link-type custom-btn-group" onclick="SurveyLinkTypeClick(this.id)" id="PendingSurveyLink">Pending</button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12">Select Survey</p>
                                            <div class="col-md-8">
                                                <select class="form-select-sm" id="SelectSurveyLinkType1">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.ActiveSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                                <select class="form-select-sm hidden" id="SelectSurveyLinkType2">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.PendingSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Skins Tab -->
                        <div id="SkinsTab-2" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold module-heading-theme mt-4">2. Popup Skin</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select the skin for this group</p>
                            <p class="custom-p fs-13 text-center">
                                If you import your own custom skin, please note that the image must be saved as a *.BMP file and must be 314x188 pixels in dimension.
                            </p>
                            <div class="mt-4 p-5">
                                <div class="form-group">
                                    <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupDefaultSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                    <label class="form-check-label ms-2" for="exampleRadios2">Use Default Skin</label>
                                </div>
                                <div class="form-group mt-5">
                                    <div class="col-sm-10 d-inline-flex justify-content-between align-items-center">
                                        <div class="form-check mr-3">
                                            <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupCustomSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                            <label class="form-check-label ml-2" for="exampleRadios2">Use Custom Skin</label>
                                        </div>
                                        <select class="form-control ml-3 w-50 hidden" id="PopupSkinImage" onchange="UpdatePopupSkinPreview()" style="appearance:menulist">
                                            <option value="0" selected>Please select skin</option>
                                            @foreach (var popupSkin2 in Model.CustomSkins)
                                            {
                                                <option value="@popupSkin2.FileURL">@popupSkin2.Filename</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Texts Tab -->
                        <div id="TextsTab-3" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold module-heading-theme mt-4">3. Popup Title & Body Texts</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Enter popup title and body texts.</p>
                            <div class="form-group row">
                                <label class="col-sm-2 fw-bold text-center">Title:</label>
                                <div class="col-sm-10">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel { EditorId = "PopupTextHeader", HeightPx = "55px", WriteToDesitnationOnInput = true, DestinationTextDivId = "PopupBodyPreviewTitleText" });
                                    }
                                </div>
                            </div>

                            <!-- Body input-->
                            <div class="form-group row">
                                <label class="col-sm-2 fw-bold  text-center">Body:</label>
                                <div class="col-sm-10">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel { EditorId = "PopupTextBody", HeightPx = "150px", WriteToDesitnationOnInput = true, DestinationTextDivId = "PopupBodyPreviewTextBody" });
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- Times Tab -->
                        <div id="TimesTab-4" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <div class="row text-center align-content-center justify-content-center">
                                <div class="col-12">
                                    <h5 class="fw-bold mb-3 module-heading-theme">4. Popup Preview</h5>
                                    <p class="module-subheading-theme">This is what the preview will look like based on the information you have entered.</p>
                                </div>
                                <div class="col-lg-2 ">
                                    col 1
                                </div>
                                <div class="col-lg-10"> col2 </div>
                            </div>
                        </div>
                        <!-- Displays Tab -->
                        <div id="DisplaysTab-5" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold mb-3 module-heading-theme">5. Popup Displays</h5>
                            <p class="module-subheading-theme">Popup display settings.</p>
                            <!-- Add content for Popup 5 -->
                        </div>
                        <!-- Repeat Tab -->
                        <div id="RepeatTab-6" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold mb-3 module-heading-theme">6. Popup Repeat</h5>
                            <p class="module-subheading-theme">Popup repeat settings.</p>
                            <!-- Add content for Popup 6 -->
                        </div>
                        <!-- Feedback Tab -->
                        <div id="FeedbackTab-7" class="add-new-popup popup flex-wrap text-center align-items-center justify-content-center mb-3 mt-2">
                            <h5 class="fw-bold mb-3 module-heading-theme">7. Popup Feedback Request</h5>
                            <p class="module-subheading-theme">Select popup feedback preferences: Like/Dislike and/or comment.</p>

                            <div class="form-group row justify-content-center">
                                <div class="option form-check form-switch">
                                    <label for="likeDislikeToggle">Allow recipients to <strong>LIKE or DISLIKE</strong> the popup</label>
                                    <input type="checkbox" id="commentToggle" class="form-check-input">

                                </div>
                                <div class="option form-check form-switch">
                                    <label for="commentToggle">Allow recipients to add <strong>COMMENT</strong> to the popup</label>
                                    <input type="checkbox" id="commentToggle" class="form-check-input">

                                </div>

                            </div>

                        </div>
                        <!-- Target Users -->
                        <div id="TargetUserTab-8" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold mb-3 module-heading-theme">8. Popup Target Users</h5>
                            <p class="module-heading-theme">Popup target user settings.</p>
                            <!-- Add content for Popup 8 -->
                        </div>
                        <!-- Exposure Summary Tab -->
                        <div id="ExposureSummaryTab-9" class="add-new-popup popup flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold mb-3 module-heading-theme">9. Popup Exposure Summary</h5>
                            <p class="module-heading-theme">Popup exposure summary settings.</p>
                            <!-- Add content for Popup 9 -->
                        </div>

                        <div class="row fix-content-bottom">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn module-wizard-nav-btns hidden" id="PopupPrevTabBtn" onclick="PreviousPopupTab()">Back</button>
                                    <button class="btn module-wizard-nav-btns" id="PopupNextTabBtn" onclick="NextPopupTab()">Next</button>
                                    <button class="btn hidden" id="AddPopupSubmitBtn">Submit</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Preview Side -->
                <div class="col" id="ModulePreviewSection">
                    <p class="fst-italic mt-4" style="color:silver">Preview</p>
                    <p class="theme-txt-clr mb-0 mt-2">Skin filename: <span class="fw-bold" id="SkinFileName">STMBackground.BMP</span></p>
                    <!-- Popup Preview-->
                    <div class="mt-1 border border-light-1" id="PopupBodyPreview">
                        <div class="d-flex" id="PopupBodyPreviewTitle">
                            <div id="PopupBodyPreviewTitleIcon">
                                <img src="~/images/icons/modules/popup/icon-info.png" />
                            </div>
                            <div id="PopupBodyPreviewTitleText" class="poup-body-preview-title-text">
                                @Html.Raw(testPopupTitle)
                            </div>
                            <div id="PopupBodyPreviewTitleDismiss">
                                <img src="~/images/icons/modules/popup/icon-error.png" />
                            </div>
                        </div>
                        <div id="PopupBodyPreviewText">
                            <div id="PopupBodyPreviewTextBody" class="popup-body-preview-text-body">
                                @Html.Raw(testPopupBody)
                            </div>
                            <div id="PopupBodyPreviewTextBodyFooter">
                                <button class="btn">Remind Me Later</button>
                            </div>
                        </div>
                    </div>
                    <!-- Feedback -->
                    <div class="mt-3 p-0">
                        <p class="custom-p">Feedback Skin with:</p>
                        <ul class="mb-0" style="font-size:10px">
                            <li>Like/Dislike</li> 
                            <li>Comment</li>
                        </ul>
                        <div class="mt-0 border border-light-1" id="PopupBodyPreviewFeedback" style="background-image: url('@popupSkin'); opacity:0.4">
                            <div class="d-flex" id="PopupBodyPreviewTitle">
                                <div id="PopupBodyPreviewTitleIcon">
                                    <img src="~/images/icons/modules/popup/icon-info.png" />
                                </div>
                                <div id="PopupBodyPreviewTitleTextFeedback" class="poup-body-preview-title-text">
                                    @Html.Raw(testPopupTitle)
                                </div>
                                <div id="PopupBodyPreviewTitleDismiss">
                                    <img src="~/images/icons/modules/popup/icon-error.png" />
                                </div>
                            </div>
                            <div id="PopupBodyPreviewText">
                                <div id="PopupBodyPreviewTextBodyFeedback" class="popup-body-preview-text-body">
                                    @Html.Raw(testPopupBody)
                                </div>
                                <div id="PopupBodyPreviewTextBodyFooter">
                                    <button class="btn">Remind Me Later</button>
                                </div>
                            </div>
                        </div>
                        <div id="PopupFeedbackContents">
                            <p class="pt-1 mb-0 w-100 text-center" style="font-size:11px">Please provide feedback on this popup</p>
                            <div class="d-flex mt-1">
                                <img src="~/images/icons/modules/popup/Like-icon.png" class="popup-feedback-icons ms-auto" />
                                <img src="~/images/icons/modules/popup/Dislike-icon.png" class="popup-feedback-icons me-auto" />
                            </div>
                            <div class="mt-1 text-center">
                                <textarea rows="3" id="PopupFeedbackText" disabled></textarea>
                            </div>
                            <div class="text-center">
                                <button class="btn" id="PopupFeedbackBtn">Submit</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
}

<script>

    let linkTypeFile = null;
    
    $(document).ready(function ()
    {
        HideAllTabs();
        LoadDefaultSkinPreview();
    });

    function LoadDefaultSkinPreview()
    {
        $("#PopupBodyPreview").css("background", "url(@popupSkin)"); 
        $("#PopupBodyPreviewFeedback").css("background", "url(@popupSkin)");
    }

    function PreviewWebsite()
    {
        var url = $("#LinkTypeUrlInput").val();

        if (url == null || url.length == 0)
        {
            swal("Preview Error", `Please upload enter website URL`, "error");
        }
        else
        {
            window.open(url);
        }
    }

    function HideAllTabs()
    {
        HideShowElement(".add-new-popup", HideShow.HIDE);
        HideShowElement("#LinkTypeTab-1", HideShow.SHOW);
    }

    function PopupLinkTypeClick(linkBtnId)
    {
        HideShowElement("#ContentUploadComponent", HideShow.HIDE);
        HideShowElement("#LinkTypeUrl", HideShow.HIDE);
        HideShowElement("#LinkTypeEmail", HideShow.HIDE);
        HideShowElement("#SurveyType", HideShow.HIDE);

        ClearFileUpload();

        $(".link-type-btn").removeClass("btn-group-active");
        $(`#${linkBtnId}`).addClass("btn-group-active");

        var btnType = linkBtnId.toLowerCase();

        if (btnType == "nolink" || btnType.includes("ticker"))
        {
            HideShowElement("#LinkTypeAttachment", HideShow.HIDE);
        }
        else
        { 
            HideShowElement("#LinkTypeAttachment", HideShow.SHOW);
            $("#UploadFileTitle").removeClass("align-content-center");

            var isAttachmentType = btnType.includes("image") || btnType.includes("audio") || btnType.includes("video") || btnType.includes("document") || btnType.includes("policy");
            var isUrlType = btnType.includes("website") || btnType.includes("email");
            
            if (isAttachmentType)
            {
                HideShowElement("#ContentUploadComponent", HideShow.SHOW);
                $("#UploadFileTitle").removeClass("align-content-center");

                if(btnType.includes("image"))
                {
                    $("#UploadFileTitle").text("Image");
                    $("#ContentUploadInput").attr("accept", "image/*");
                }
                else if (btnType.includes("audio"))
                {
                    $("#UploadFileTitle").text("Audio");
                    $("#ContentUploadInput").attr("accept", "audio/*");
                }
                else if (btnType.includes("video"))
                {
                    $("#UploadFileTitle").text("Video");
                    $("#ContentUploadInput").attr("accept", "video/*");
                }
                else if (btnType.includes("document"))
                {
                    $("#UploadFileTitle").text("Document");
                    $("#ContentUploadInput").attr("accept", ".xlsx,.xls,.doc, .docx,.ppt, .pptx,.txt,.pdf");
                }
                else if (btnType.includes("policy"))
                {
                    $("#UploadFileTitle").text("Policy (PDF)");
                    $("#ContentUploadInput").attr("accept", ".pdf");
                }
            }
            else if (btnType.includes("website"))
            {
                HideShowElement("#LinkTypeUrl", HideShow.SHOW);
                $("#UploadFileTitle").text("Website")
                $("#UploadFileTitle").addClass("align-content-center");

            }
            else if(btnType.includes("email"))
            {
                HideShowElement("#LinkTypeEmail", HideShow.SHOW);
                $("#UploadFileTitle").text("Email")
            }
            else if (btnType.includes("survey"))
            {
                HideShowElement("#SurveyType", HideShow.SHOW);
                $("#UploadFileTitle").text("Survey");
            }
        }
    }

    function SurveyLinkTypeClick(btnId)
    {
        $(".module-link-type").removeClass("btn-group-active");
        $(`#${btnId}`).addClass("btn-group-active");

        btnId = btnId.toLowerCase();
        
        if (btnId.includes("active"))
        {
            HideShowElement("#SelectSurveyLinkType1", HideShow.SHOW);
            HideShowElement("#SelectSurveyLinkType2", HideShow.HIDE);
        }
        else if (btnId.includes("pending"))
        {
            HideShowElement("#SelectSurveyLinkType1", HideShow.HIDE);
            HideShowElement("#SelectSurveyLinkType2", HideShow.SHOW);
        }
    }

    function CheckAllEmailsListValid(emailList)
    {
        var emails = emailList.split(";");
        for(let i=0; i < emails.length; i++)
        {
            if(!CheckEmail(emails[i]))
                return false;
        }
        return true;
    }

    function IsLinksTabValid()
    {
        var linkTypeBtn = $(".link-type-btn.btn-group-active");

        var btnId = linkTypeBtn.attr("id").toLowerCase();
        var btnText = $(linkTypeBtn).text();
        
        var isAttachmentType = btnId.includes("image") || btnId.includes("audio") || btnId.includes("video") || btnId.includes("document") || btnId.includes("policy");

        if (btnId.includes("nolink") || btnId.includes("ticker"))
        {
            return true;
        }
        else if(isAttachmentType)
        {
            if (StringNullOrEmpty(UploadFileUrl))
            {
                swal("Popup Link Error", `Please upload ${btnText} file`, "error");
                return false;
            }
            return true;
        }
        else if (btnId.includes("website"))
        {
            if (IsEmptyInput("#LinkTypeUrlInput"))
            {
                swal("Popup Link Error", `Please upload enter website URL`, "error");
                return false;
            }
        }
        else if (btnId.includes("email"))
        {
            $("#LinkTypeEmailValid").text("");
            $("#LinkTypeCCEmailValid").text("");
            $("#LinkTypeEmailSubjectValid").text("");
            $("#LinkTypeEmailMessageValid").text("");

            var emails = $("#LinkTypeEmailInput").val();
            var ccEmails = $("#LinkTypeCCEmailInput").val();
            var emailsValid = true;

            if (IsEmptyInput("#LinkTypeEmailInput") || !CheckAllEmailsListValid(emails))
            {
                $("#LinkTypeEmailValid").text("please enter valid emails!");
                emailsValid = false;
            }
            if (!IsEmptyInput("#LinkTypeCCEmailInput") && !CheckAllEmailsListValid(ccEmails))
            {
                $("#LinkTypeCCEmailValid").text("please enter valid emails!");
                emailsValid = false;
            }
            if (IsEmptyInput("#LinkTypeEmailSubjectInput"))
            {
                $("#LinkTypeEmailSubjectValid").text("please enter subject!");
                emailsValid = false;
            }
            if (IsEmptyInput("#LinkTypeEmailMessageInput"))
            {
                $("#LinkTypeEmailMessageValid").text("please enter email message!");
                emailsValid = false;
            }

            if (!emailsValid)
            {
                swal("Popup Link Error", `Please enter valid emails information.`, "error");
                return false;
            }
            return true;
        }
        else if (btnId.includes("survey"))
        {
            var surveyTypeTxt = $(".module-link-type.btn-group-active").text().toLowerCase();

            var invalidSurvey = (surveyTypeTxt.includes("active")) ? ($("#SelectSurveyLinkType1").val() == null || $("#SelectSurveyLinkType1").val() == 0) :
                                                                     ($("#SelectSurveyLinkType2").val() == null || $("#SelectSurveyLinkType2").val() == 0);

            if (invalidSurvey)
            {
                swal("Popup Link Error", `Please select an existing survey to link this Popup to.`, "error");
                return false;
            }
            return true;
        }
        return false;
    }

    function PopupSkinTypeSelect(id)
    {
        id = id.toLowerCase();
        if (id.includes("defaultskin"))
        {
            LoadDefaultSkinPreview();
            HideShowElement("#PopupSkinImage", HideShow.HIDE);
        }
        else
        {
            HideShowElement("#PopupSkinImage", HideShow.SHOW);
            UpdatePopupSkinPreview();
            //$(`#PopupSkinImage option[value="0"]`).attr("selected", "selected");
        }
    }

    function UpdatePopupSkinPreview()
    {
        var skinImgSrc = $("#PopupSkinImage").val();

        if(skinImgSrc != "0")
        {
            $("#PopupBodyPreview").css("background", `url(${skinImgSrc})`); 
            $("#PopupBodyPreviewFeedback").css("background", `url(${skinImgSrc})`);
            $("#SkinFileName").text($("#PopupSkinImage option:selected").text());
        }
    }


    $(document).ready(function ()
    {
        // Execute commands (like bold, italic, etc.)
        $('.btns button').click(function (event)
        {
            event.preventDefault();

            const cmd = $(this).data('cmd');
            let value = null;

            if ($(this).hasClass('prompt'))
            {
                value = prompt('Enter the link or image URL:', 'http://');
            }
            execCmd(cmd, value);
        });

        $('.btns select').change(function ()
        {
            const cmd = $(this).data('cmd');
            const value = $(this).val();
            execCmd(cmd, value);
        });

        $('.btns input').change(function ()
        {
            const cmd = $(this).data('cmd');
            const value = $(this).val();
            execCmd(cmd, value);
        });

        $('#showPreview').change(function ()
        {
            togglePreview();
        });

        $('#titleInput').on('input', function ()
        {
            updatePreview();
        });

        $('#bodyInput').on('input', function ()
        {
            updatePreview();
        });

        function execCmd(cmd, value)
        {
            document.execCommand(cmd, false, value);
            updatePreview();
        }

        $('#showPreview').change(function ()
        {
            togglePreview();
        });

        function updatePreview()
        {
            if ($('#showPreview').is(':checked'))
            {
                let title = $('#titleInput').html();
                let content = $('#bodyInput').html();

                $('#previewTitle').html(title);
                $('#previewContent').html(content);
            } else
            {

                $('#previewTitle').html('');
                $('#previewContent').html('');
            }
        }

        function togglePreview()
        {
            if ($('#showPreview').is(':checked'))
            {
                $('#previewContent').show();
                $('#previewTitle').show();
                updatePreview();
            } else
            {
                $('#previewContent').hide();
                $('#previewTitle').hide();
            }
        }

        togglePreview();
    });

</script>