/* Preview Box Styling */
.preview-box {
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: auto;
}

.skin-filename {
    font-weight: bold;
    margin-bottom: 15px;
}

.preview-box{
    width:100%;
}
#previewContent{
    overflow:auto;
}

.preview-box div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    width: 100%;
    height: 100% ;
    overflow-x: hidden;
    overflow-y: auto;
    text-align: justify;
}

.preview-box img,
.preview-box .title,
.preview-box .body {
    display: block;
    margin: 0 auto;
    width: 100%;
}

.pagination-section {
    align-items: center;
}



    
.popup {
    color: var(--navy-blue);
}

.btn-toolbar {
    padding-left: 60px;
    padding-right: 60px;
}

/*wyswig*/
#wysiwyg {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.1);
}

.title-section,
.toggle-preview {
    padding: 10px;
    display: flex;
    align-items: center;
}

.toggle-preview {
    padding: 10px;
    display: flex;
    align-items: center;
}
