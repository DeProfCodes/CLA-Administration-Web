@model CLA_Administration_Web.ViewModels.Modules.PST.AddNewPopupViewModel

@using CLA_Administration_Web.Helpers.Constants
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Modules.Components.Form
@using CLA_Administration_Web.ViewModels.Modules.PST


<div class="container-fluid">
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.PopupAddNew })

    <!-- Card for Title -->
    <div class="card mb-4 mt-2" style="min-width:940px;">
        <div class="card-body pb-0">
            <h4 class="w-100 text-center theme-txt-clr">Add New Popup</h4>
        </div>
    </div>

    <div class="card" style="min-width:940px;">
        <div class="card-body">
            <div class="row flex-sm-nowrap">
                <!-- Left Navigation Side -->
                <div class="col module-wizard-link-nav" id="ModuleLeftNavLinkCol">
                    <div id="ModuleLeftNavLinksContainer" class="mt-4">
                        <a class="module-left-nav-link T-1 active" id="LinkTabLink-1" onclick="NavigateToPopupTab(this.id, 1)">
                            Link Type<i class="bi bi-dot module-nav-link-dot T-1 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-2" id="SkinTabLink-2" onclick="NavigateToPopupTab(this.id, 2)">
                            Skin & Icons<i class="bi bi-dot module-nav-link-dot T-2 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-3" id="TextsTabLink-3" onclick="NavigateToPopupTab(this.id, 3)">
                            Texts<i class="bi bi-dot module-nav-link-dot T-3 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-4" id="TimesTabLink-4" onclick="NavigateToPopupTab(this.id, 4)">
                            Times<i class="bi bi-dot module-nav-link-dot T-4 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-5" id="DisplaysTabLink-5" onclick="NavigateToPopupTab(this.id, 5)">
                            Displays<i class="bi bi-dot module-nav-link-dot T-5 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-6" id="RepeatTabLink-6" onclick="NavigateToPopupTab(this.id, 6)">
                            Repeat<i class="bi bi-dot module-nav-link-dot T-6 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-7" id="FeedbackTabLink-7" onclick="NavigateToPopupTab(this.id, 7)">
                            Feedback<i class="bi bi-dot module-nav-link-dot T-7 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-8" id="TargetUsersTabLink-8" onclick="NavigateToPopupTab(this.id, 8)">
                            Target Users<i class="bi bi-dot module-nav-link-dot T-8 hidden"></i>
                        </a>
                        <a class="module-left-nav-link T-9" id="ExposureSummaryTabLink-9" onclick="NavigateToPopupTab(this.id, 8)">
                            Exposure Summary<i class="bi bi-dot module-nav-link-dot T-9 hidden"></i>
                        </a>
                    </div>
                </div>
                <!-- Main Content -->
                <div class="col main-content flex-wrap" id="ModuleWizardMain">
                    <div class="form-horizontal theme-txt-clr" id="popupForm">
                        <!-- Link Type Tab -->
                        <div id="LinkTypeTab-1" class="popup-wizard-tabs flex-wrap align-content-center justify-content-center mb-3 hidden">
                            <h5 class="fw-bold mt-4 text-center">1. Popup Link Type</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Select what the popup will link to when clicked by the user.</p>
                            <p class="custom-p fs-13 text-center">The popup can launch any of the below options when clicked on or be linked to nothing.</p>
                            <!-- Links Options -->
                            <div class="row mt-5">
                                <div class="col-lg-3 align-content-center">
                                    <p class="fw-bold text-center theme-txt-clr">Link Type</p>
                                </div>
                                <div class="col-lg-9" id="ModuleLinkTypeContainer" style="max-width:700px;">
                                    <div class="btn-group mb-2 w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn btn-group-active" onclick="PopupLinkTypeClick(this.id)" id="NoLink">No Link</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="ImageLink">Image</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="AudioLink">Audio</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="VideoLink">Video</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="DocumentLink">Document</button>
                                    </div>
                                    <div class="btn-group w-auto overview-filter-btn-group">
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="WebsiteLink">Website</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="EmailLink">Email</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="TickerTypeLink">Ticker</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="SurveyTypeLink">Survey</button>
                                        <button class="btn custom-btn-group link-type-btn" onclick="PopupLinkTypeClick(this.id)" id="PolicyTypeLink">Policy</button>
                                    </div>
                                </div>
                            </div>
                            <!-- Attachment -->
                            <div class="row mt-3 " id="LinkTypeAttachment">
                                <p class="col-lg-3 fw-bold text-center theme-txt-clr mb-0" id="UploadFileTitle"></p>
                                <div class="col-lg-9 p-0">
                                    <!-- Uploader Component -->
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml",
                                        new FileUploaderModel { ComponentId = "PopupLinkType", InputId = "PopupLinkTypeUploadInput", ShowPreviewButton = true, InitialHidden = true, WidthPx = "396px",OnFileUploadCallback = null });
                                    }
                                    <!-- Website Textbox -->
                                    <div class="w-100 mt-2 p-0 d-flex hidden" id="LinkTypeUrl">
                                        <input type="text" class="custom-input-text" id="LinkTypeUrlInput" />
                                        <button class="btn btn-success content-preview-btn custom-btn-sm ms-3" id="ModuleContentPreviewUpload" onclick="PreviewWebsite('LinkTypeUrlInput')">Preview</button>
                                    </div>
                                    <!-- Email Inputs Section -->
                                    <div class="w-fit-content border border-light-1 p-3 pe-5 mb-3 hidden" id="LinkTypeEmail">
                                        <div>
                                            <p class="mb-0">Emails <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter Recipients Emails" id="LinkTypeEmailInput"/>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">CC <span class="fst-italic me-1 fs-11 text-silver">seperated by ";" </span></p>
                                            <input type="email" class="custom-input-text w-300p" placeholder="Enter CC Emails" id="LinkTypeCCEmailInput" />
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeCCEmailValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0">Subject</p>
                                            <input type="text" class="custom-input-text w-300p" placeholder="Enter Subject" id="LinkTypeEmailSubjectInput"/>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailSubjectValid"></p>
                                        </div>
                                        <div>
                                            <p class="mb-0 mt-1">Message</p>
                                            <textarea class="w-300p" rows="5" id="LinkTypeEmailMessageInput"></textarea>
                                            <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="LinkTypeEmailMessageValid"></p>
                                        </div>
                                    </div>
                                    <!-- Survey Type -->
                                    <div class="mt-2 p-0 hidden" id="SurveyType">
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12 ps-2">Survey Type</p>
                                            <div class="col-md-8 btn-group w-auto overview-filter-btn-group">
                                                <button class="btn module-link-type custom-btn-group btn-group-active" onclick="SurveyLinkTypeClick(this.id)" id="ActiveSurveyLink">Active</button>
                                                <button class="btn module-link-type custom-btn-group" onclick="SurveyLinkTypeClick(this.id)" id="PendingSurveyLink">Pending</button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12">Select Survey</p>
                                            <div class="col-md-8">
                                                <select class="form-select-sm" id="SelectSurveyLinkType1">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.ActiveSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                                <select class="form-select-sm hidden" id="SelectSurveyLinkType2">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.PendingSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Skins & Icons Tab -->
                        <div id="SkinsTab-2" class="popup-wizard-tabs flex-wrap justify-content-center mb-4 ps-2">
                            <h5 class="fw-bold mt-4 text-center">2. Popup Skin & Icons</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select the skin & icons for this popup</p>
                            <div class="mt-3" id="PopupSkinContainer">
                                <p class="custom-p fw-bold w-fit-content fs-16">Popup Skin</p>
                                <p class="custom-p fs-12 w-fit-content mt-2">
                                    If you import your own custom skin, please note that the image must be saved as a *.BMP file and must be 314x188 pixels in dimension.
                                </p>
                                <div class="mt-2 p-2">
                                    <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                        <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupDefaultSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                        <label class="form-check-label ms-2 cursor-pointer" for="PopupDefaultSkinOption">Use Default Skin</label>
                                    </div>
                                    <div class="form-group mt-3">
                                    <div class="col-sm-10 d-inline-flex justify-content-between align-items-center">
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                            <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupCustomSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                            <label class="form-check-label ml-2 cursor-pointer" for="PopupCustomSkinOption">Use Custom Skin</label>
                                        </div>
                                        <select class="form-control ml-3 w-50 hidden" id="PopupSkinImage" onchange="UpdatePopupSkinPreview()" style="appearance:menulist">
                                            <option value="0" selected>Please select skin</option>
                                            @foreach (var popupSkin2 in Model.CustomSkins)
                                            {
                                                <option value="@popupSkin2.FileURL">@popupSkin2.Filename</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                </div>
                            </div>
                            <div class="mt-3" id="PopupIconsContainer">
                                <p class="custom-p fw-bold w-fit-content fs-16">Popup Icons</p>
                                <p class="custom-p fs-12 w-fit-content mt-2">
                                    If you import your own custom icon, please note that the image must be 48x48 pixels in dimension.
                                </p>
                                <div class="mt-2 p-2">
                                    <div class="form-group">
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                            <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupStandardIcons" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                            <label class="form-check-label ms-1 cursor-pointer" for="PopupStandardIcons">Use Standard Icons</label>
                                        </div>
                                        <div class="row w-fit-content hidden ms-5 border border-light-1 p-1" id="PopupStandardIconsContainer">
                                            <div class="col p-0 popup-icon-container">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconInfo" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-info.png" />
                                            </div>
                                            <div class="col p-0 popup-icon-container ms-2">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconWarning" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-warning.png" />
                                            </div>
                                            <div class="col p-0 popup-icon-container ms-2">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconError" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-error.png" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mt-3">
                                        <div class="col form-group mb-0">
                                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupCustomIconsOption" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                                <label class="form-check-label cursor-pointer" for="PopupCustomIconsOption">Use Custom Icon</label>
                                            </div>
                                            <div class="col w-fit-content hidden ms-5" id="PopupCustomIconsContainer">
                                                <!-- Uploader Component -->
                                                @{
                                                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml",
                                                    new FileUploaderModel 
                                                    { 
                                                        ComponentId = "PopupCustomIcon", 
                                                        InputId = "CustomIconInput", 
                                                        ShowPreviewButton = true, 
                                                        InitialHidden = false, 
                                                        WidthCss = "w-50",
                                                        OnFileUploadCallback = "UpdatePopupIconCustom"
                                                    });
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mt-3 mb-3">
                                        <div class="col form-check form-switch w-fit-content mb-0 align-content-center">
                                            <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupNONEIconsOption" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                            <label class="form-check-label cursor-pointer" for="PopupNONEIconsOption">Do Not Show Icon</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Texts Tab -->
                        <div id="TextsTab-3" class="popup-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold mt-4">3. Popup Title & Body Texts</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Enter popup title and body texts.</p>
                            <!-- Title input-->
                            <div class="row mt-4">
                                <label class="col-sm-2 fw-bold text-center">Title:</label>
                                <div class="col-sm-10">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel 
                                        { 
                                            EditorId = "PopupTextHeader", 
                                            HeightPx = "55px", 
                                            WriteToDesitnationOnInput = true, 
                                            MaxCharacterCount = 25,
                                            DestinationTextDivId = "PopupBodyPreviewTitleText" 
                                        });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="LinkTypeTextsTitleError"></p>
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-12" for="ShowHidePopupTitle">Show</label>
                                        <input class="form-check-input" type="checkbox" id="ShowHidePopupTitle" onchange="ShowHidePopupText(this.id,'title')" checked>
                                    </div>
                                    
                                </div>
                            </div>
                            <!-- Body input-->
                            <div class="row">
                                <label class="col-sm-2 fw-bold  text-center">Body:</label>
                                <div class="col-sm-10">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/HtmlEditor.cshtml",
                                        new HtmlEditorModel { EditorId = "PopupTextBody", HeightPx = "150px", WriteToDesitnationOnInput = true, DestinationTextDivId = "PopupBodyPreviewTextBody" });
                                    }
                                    <p class="mb-0 fs-12 text-danger fst-italic ps-1 w-fit-content" id="LinkTypeTextsBodyError"></p>
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-12" for="ShowHidePopupBody">Show</label>
                                        <input class="form-check-input" type="checkbox" id="ShowHidePopupBody" onchange="ShowHidePopupText(this.id,'body')" checked>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Times Tab -->
                        <div id="TimesTab-4" class="popup-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3">
                            <h5 class="fw-bold module-heading-theme mt-4">4. Popup Effective Dates & Timeslots</h5>
                            <p class="custom-p mt-2 fs-13 text-center">Please define the date and time range that the Popup must display</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                Tip:In order to maximize exposure, we recommend that the date range span over multiple calendar weeks (Thursday to Thursday) and setting the time
                                to be as long as possible (e.g 07h00 to 19h00).
                            </p>
                            <div class="row mt-5 p-4">
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Effective Dates</p>
                                    <div class="mt-4">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/DateRangePicker.cshtml", new DateTimeRangePicker { ShowDatesTitle = true });
                                    }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <p class="fw-bold fs-16 text-center">Timeslots</p>
                                    <div class="mt-4">
                                    @{
                                        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/TimeRangePicker.cshtml");
                                    }
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <p class="w-600p mx-auto p-2 theme-border">
                                    This survey will attempt to show everyday startting from <span id="PopupStartEffDate"></span>, until <span id="PopupEndEffDate"></span>.
                                    It will only appear between the time range of <span id="PopupStartTimeSlot"></span> and <span id="PopupEndTimeSlot"></span>. Once
                                    this survey has been completed/opted out. it will not display again
                                </p>
                            </div>
                        </div>
                        <!-- Displays Tab -->
                        <div id="DisplaysTab-5" class="popup-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-5">
                            <h5 class="fw-bold mt-4">5. Popup Displays</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please define how much flexibilitythe user is allowed when the Popup arrives.</p>
                            <div class="row mt-5">
                                <div class="popup-display-settings-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="AutoHidePopupToggle">Auto Hide</label>
                                        <input class="form-check-input" type="checkbox" id="AutoHidePopupToggle">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">Select this option if you want Popup to AUTOMATICALLY hide after appearing on the screen.</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="popup-display-settings-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="DismissablePopupToggle">Dismissable</label>
                                        <input class="form-check-input" type="checkbox" id="DismissablePopupToggle" onchange="TogglePopupDisplaySettings()">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">Select this option if you want the user to CLOSE the Popup without viewing the attachment.</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="popup-display-settings-titles">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                        <label class="form-check-label fs-14" for="SnoozePopupToggle">Snoozable</label>
                                        <input class="form-check-input" type="checkbox" id="SnoozePopupToggle" onchange="TogglePopupDisplaySettings()">
                                    </div>
                                </div>
                                <div class="popup-display-settings-info">
                                    <p class="mb-0">Select this option if you want the user to SNOOZE the Popup for later viewing</p>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="popup-display-settings-titles w-fit-content" style="margin-left:45px;margin-right:-45px;">
                                    <div class="form-check form-switch w-fit-content mb-0">
                                       <p class="mb-0 fw-bold fs-14">Popup Position</p>
                                    </div>
                                </div>
                                <div class="popup-display-settings-info popup-pos-container">
                                    <div class="grid-container">
                                        <div class="popup-pos grid-item" id="PopupPositionTL" onclick="SetPopupPosition(this.id)">Top Left</div>
                                        <div class="popup-pos grid-item" id="PopupPositionTC" onclick="SetPopupPosition(this.id)">Top Center</div>
                                        <div class="popup-pos grid-item" id="PopupPositionTR" onclick="SetPopupPosition(this.id)">Top Right</div>
                                        <div class="popup-pos grid-item" id="PopupPositionML" onclick="SetPopupPosition(this.id)">Middle Left</div>
                                        <div class="popup-pos grid-item" id="PopupPositionC" onclick="SetPopupPosition(this.id)">Center</div>
                                        <div class="popup-pos grid-item" id="PopupPositionMR" onclick="SetPopupPosition(this.id)">Middle Right</div>
                                        <div class="popup-pos grid-item" id="PopupPositionBL" onclick="SetPopupPosition(this.id)">Bottom Left</div>
                                        <div class="popup-pos grid-item" id="PopupPositionBC" onclick="SetPopupPosition(this.id)">Bottom Center</div>
                                        <div class="popup-pos grid-item active" id="PopupPositionBR" onclick="SetPopupPosition(this.id)">Bottom Right</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Repeat Tab -->
                        <div id="RepeatTab-6" class="popup-wizard-tabs flex-wrap  text-center align-content-center justify-content-center mb-3 p-5">
                            <h5 class="fw-bold mt-4">6. Popup Repeat</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select repeate frequency of the Popup.</p>
                            <p class="custom-p mt-4 fs-13 text-center">
                                If you want this same popup to repeat either a Daily or Weekly basis. Please select the relevant option below. as well as expiry date
                                at which point you want Popup to STOP repeating
                            </p>
                            <div class="w-fit-content mt-3">
                                <div class="form-group mt-4 w-fit-content">
                                    <div class="col form-check form-switch w-fit-content mb-0 align-content-center">
                                        <input class="form-check-input" type="radio" name="PopupRepeatOption" id="PopupNoRepeatOption" value="option2" onchange="PopupRepeatOptionSelect(this.id)">
                                        <label class="form-check-label cursor-pointer" for="PopupNoRepeatOption">Do Not Repeat</label>
                                    </div>
                                </div>
                                <div class="row w-fit-content d-flex mt-3 align-content-center">
                                    <div class="form-group w-fit-content" style="position:fixed">
                                        <div class="col form-check form-switch w-fit-content mb-0 align-content-center">
                                            <input class="form-check-input" type="radio" name="PopupRepeatOption" id="PopupRepeatDailyOption" value="option2" onchange="PopupRepeatOptionSelect(this.id)">
                                            <label class="form-check-label cursor-pointer" for="PopupRepeatDailyOption">Repeat Daily</label>
