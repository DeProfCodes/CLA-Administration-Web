 */
.option {
    margin-bottom: 20px;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
}

    .option label {
        font-size: 16px;
        color: var(--dark-blue);
    }

.toggle-switch {
    width: 50px;
    height: 24px;
    position: relative;
    appearance: none;
    background-color: var(--navy-blue);
    border-radius: 15px;
    cursor: pointer;
    outline: none;
    transition: background-color 0.3s;
}

/*popup 3 css*/
#titleInput {
    padding: 20px;
    background-color: var(--light-blue);
    outline: none;
    border: none;
    resize: vertical;
    overflow: auto;
}

#bodyInput {
    padding: 20px;
    background-color: var(--light-blue);
    outline: none;
    border: none;
    resize: vertical;
    overflow: auto;
    height: 150px;
}

#preview {
    border: 1px solid #EFEFEF;
    border-radius: 4px;
}


</style>


