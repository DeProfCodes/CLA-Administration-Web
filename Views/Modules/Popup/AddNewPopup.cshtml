                                                <button class="btn module-link-type custom-btn-group" onclick="SurveyLinkTypeClick(this.id)" id="PendingSurveyLink">Pending</button>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <p class="col-md-4 mb-0 align-content-center fs-12">Select Survey</p>
                                            <div class="col-md-8">
                                                <select class="form-select-sm" id="SelectSurveyLinkType1">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.ActiveSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                                <select class="form-select-sm hidden" id="SelectSurveyLinkType2">
                                                    <option value="0" selected>Please select survey</option>
                                                    @foreach (var survey in Model.PendingSurveys)
                                                    {
                                                        <option value="@survey.Id">@survey.HeaderText</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Skins & Icons Tab -->
                        <div id="SkinsTab-2" class="add-new-popup popup flex-wrap justify-content-center mb-4 ps-2">
                            <h5 class="fw-bold mt-4 text-center">2. Popup Skin & Icons</h5>
                            <p class="custom-p mt-4 fs-13 text-center">Please select the skin & icons for this popup</p>
                            <div class="mt-3" id="PopupSkinContainer">
                                <p class="custom-p fw-bold w-fit-content fs-16">Popup Skin</p>
                                <p class="custom-p fs-12 w-fit-content mt-2">
                                    If you import your own custom skin, please note that the image must be saved as a *.BMP file and must be 314x188 pixels in dimension.
                                </p>
                                <div class="mt-2 p-2">
                                    <div class="form-group">
                                        <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupDefaultSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                        <label class="form-check-label ms-2" for="exampleRadios2">Use Default Skin</label>
                                    </div>
                                    <div class="form-group mt-3">
                                    <div class="col-sm-10 d-inline-flex justify-content-between align-items-center">
                                        <div class="form-check mr-3">
                                            <input class="form-check-input" type="radio" name="PopupSkinOption" id="PopupCustomSkinOption" value="option2" onchange="PopupSkinTypeSelect(this.id)">
                                            <label class="form-check-label ml-2" for="exampleRadios2">Use Custom Skin</label>
                                        </div>
                                        <select class="form-control ml-3 w-50 hidden" id="PopupSkinImage" onchange="UpdatePopupSkinPreview()" style="appearance:menulist">
                                            <option value="0" selected>Please select skin</option>
                                            @foreach (var popupSkin2 in Model.CustomSkins)
                                            {
                                                <option value="@popupSkin2.FileURL">@popupSkin2.Filename</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                </div>
                            </div>
                            <div class="mt-3" id="PopupIconsContainer">
                                <p class="custom-p fw-bold w-fit-content fs-16">Popup Icons</p>
                                <p class="custom-p fs-12 w-fit-content mt-2">
                                    If you import your own custom icon, please note that the image must be 48x48 pixels in dimension.
                                </p>
                                <div class="mt-2 p-2">
                                    <div class="row form-group">
                                        <div class="w-fit-content">
                                            <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupStandardIcons" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                            <label class="form-check-label ms-1" for="exampleRadios2">Use Standard Icons</label>
                                        </div>
                                        <div class="row w-fit-content hidden ms-5 border border-light-1 p-1" id="PopupStandardIconsContainer">
                                            <div class="col p-0 popup-icon-container">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconInfo" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-info.png" />
                                            </div>
                                            <div class="col p-0 popup-icon-container ms-2">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconWarning" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-warning.png" />
                                            </div>
                                            <div class="col p-0 popup-icon-container ms-2">
                                                <input class="form-check-input popup-icon-radio" type="radio" name="PopupStandardIconOption" id="PopupStandardIconError" value="option2" onchange="PopupStandardIconSelect(this.id)">
                                                <img class="popup-icon-img" src="~/images/icons/modules/popup/icon-error.png" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mt-3">
                                        <div class="col form-group mb-0">
                                            <div class="form-check w-fit-content">
                                                <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupCustomIconsOption" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                                <label class="form-check-label" for="exampleRadios2">Use Custom Icon</label>
                                            </div>
                                            <div class="col w-fit-content hidden ms-5" id="PopupCustomIconsContainer">
                                                <!-- Uploader Component -->
                                                @{
                                                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Form/FileUploader.cshtml",
                                                    new FileUploaderModel 
                                                    { 
                                                        ComponentId = "PopupCustomIcon", 
                                                        InputId = "CustomIconInput", 
                                                        ShowPreviewButton = true, 
                                                        InitialHidden = false, 
                                                        WidthCss = "w-50",
                                                        OnFileUploadCallback = "UpdatePopupIconCustom"
                                                    });
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group mt-3 mb-3">
                                        <div class="col form-check mr-3">
                                            <input class="form-check-input" type="radio" name="PopupIconOption" id="PopupNONEIconsOption" value="option2" onchange="PopupIconOptionSelect(this.id)">
                                            <label class="form-check-label ml-2" for="exampleRadios2">Do Not Show Icon</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
