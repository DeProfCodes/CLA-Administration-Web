<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<script>


    let uploadSection = document.getElementById('UploadFileContainer');

    let fileInput = document.getElementById('file-input');
    let fileNameDisplay = document.getElementById('ModuleContentUploadFileName');

    uploadSection.addEventListener('dragover', (e) =>
    {
        e.preventDefault();
        uploadSection.classList.add('dragging');
    });

    uploadSection.addEventListener('dragleave', () =>
    {
        uploadSection.classList.remove('dragging');
    });

    uploadSection.addEventListener('drop', (e) =>
    {
        e.preventDefault();
        uploadSection.classList.remove('dragging');
        const files = e.dataTransfer.files;
        handleFiles(files);
    });

    fileInput.addEventListener('change', (e) =>
    {
        const files = e.target.files;
        handleFiles(files);
    });

    function handleFiles(files)
    {
        if (files.length > 0)
        {
            fileNameDisplay.textContent = files[0].name;
        } else
        {
            fileNameDisplay.textContent = "No file selected";
        }
    }



    $(document).ready(function ()
    {
        // Execute commands (like bold, italic, etc.)
        $('.btns button').click(function (event)
        {
            event.preventDefault();

            const cmd = $(this).data('cmd');
            let value = null;

            if ($(this).hasClass('prompt'))
            {
                value = prompt('Enter the link or image URL:', 'http://');
            }
            execCmd(cmd, value);
        });

        $('.btns select').change(function ()
        {
            const cmd = $(this).data('cmd');
            const value = $(this).val();
            execCmd(cmd, value);
        });

        $('.btns input').change(function ()
        {
            const cmd = $(this).data('cmd');
            const value = $(this).val();
            execCmd(cmd, value);
        });

        $('#showPreview').change(function ()
        {
            togglePreview();
        });

        $('#titleInput').on('input', function ()
        {
            updatePreview();
        });

        $('#bodyInput').on('input', function ()
        {
            updatePreview();
        });

        function execCmd(cmd, value)
        {
            document.execCommand(cmd, false, value);
            updatePreview();
        }

        $('#showPreview').change(function ()
        {
            togglePreview();
        });

        function updatePreview()
        {
            if ($('#showPreview').is(':checked'))
            {
                let title = $('#titleInput').html();
                let content = $('#bodyInput').html();

                $('#previewTitle').html(title);
                $('#previewContent').html(content);
            } else
            {

                $('#previewTitle').html('');
                $('#previewContent').html('');
            }
        }

        function togglePreview()
        {
            if ($('#showPreview').is(':checked'))
            {
                $('#previewContent').show();
                $('#previewTitle').show();
                updatePreview();
            } else
            {
                $('#previewContent').hide();
                $('#previewTitle').hide();
            }
        }

        togglePreview();
    });

</script>