<!-- Modules Data Table Component for PSTR Modules : Popups, Surveys, Tickers, RSS -->
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

@model CLA_Administration_Web.ViewModels.Modules.PSTR.ModulePSTRFilterOverviewModel

@{
    var moduleName = Model.ModuleName.GetDisplayName();
    //FilterPSTRModulesOverview
}

<h3 class="w-100 text-center theme-txt-clr overview-table-caption">
    <span id="ModuleOverviewTableCaption">@Model.FilterTitle</span>
</h3>
<table id="ModuleOverviewDataTable" class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Id</th>
            @if (Model.ModuleName != ModuleNamesType.Ticker)
            {
                <th>Header Text</th>
            }
            <th class="text-center">Body Text</th>
            <th>Effective From</th>
            <th>Effective To</th>
            <th>From</th>
            <th>To</th>
            <th>Status</th>
            <th>Last Modified Date</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var module in Model.ModulesData)
        {
            <tr>
                <td class="text-center">@module.Id</td>
                @if (Model.ModuleName != ModuleNamesType.Ticker)
                {
                    <td><p class="module-dt-header-text">@module.HeaderText</p></td>
                }
                <td><p class="module-dt-body-text">@module.BodyText</p></td>
                <td>@module.EffectiveFrom</td>
                <td>@module.EffectiveTo</td>
                <td>@module.TimeslotFrom</td>
                <td>@module.TimeslotTo</td>
                <td><span class="@module.Status.CssClass">@module.Status.StatusType.GetDisplayName()</span></td>
                <td>@module.LastModifiedDate</td>
                <td>
                    <button class="btn btn-info btn-sm mx-1" onclick="OpenModuleDetails('@module.Id')">Open</button>
                    @if (Model.ModuleName == ModuleNamesType.Survey)
                    {
                        <button class="btn btn-success btn-sm mx-1" onclick="OpenSurveyQuestions('@module.Id')">Questions</button>
                    }
                    <button class="btn btn-secondary btn-sm mx-1">Edit</button>
                    <button class="btn btn-danger btn-sm mx-1">Expire</button>
                </td>
            </tr>
        }
    </tbody>
</table>


<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        SetDataTableData();
    });

    function SetDataTableData()
    {
        if ('@Model.ModuleName' == '@ModuleNamesType.Popup')
        {
            popupsDataTable = $('#ModuleOverviewDataTable').DataTable();
        }
        else if ('@Model.ModuleName' == '@ModuleNamesType.Ticker')
        {
            tickersDataTable = $('#ModuleOverviewDataTable').DataTable();
        }
        else if ('@Model.ModuleName' == '@ModuleNamesType.Survey')
        {
            surveysDataTable = $('#ModuleOverviewDataTable').DataTable();
        }
    }

    function OpenModuleDetails(itemId)
    {
        OpenPage('@Model.ModuleDetailsPage', itemId);
    }

    function OpenSurveyQuestions(surveyId)
    {
        OpenPage('@ModulesPages.SurveyQuestionsOverview', surveyId);
    }

</script>