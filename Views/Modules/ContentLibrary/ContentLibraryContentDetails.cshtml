@model CLA_Administration_Web.ViewModels.Modules.ContentLibrary.ContentLibraryContentModel
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames


<div class="container-fluid">

    <!-- Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Content Library Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.ContentLibraryCategories', 'ContentLibraryCategoriesLink')">Content Library </span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'Survey', '@ModulesPages.ContentLibraryCategories', 'ContentLibraryCategoriesLink')">Categories</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.ContentLibraryCategoryDetails', '@Model.CategoryId');">@Model.CategoryId</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPage('@ModulesPages.ContentLibraryContent', '@Model.CategoryId')">Contents Overview</span> /
                <span class="breadcrumb-item">@Model.ContentId</span>
            </p>
        </div>
    </div>

    <!-- Card for Title -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Content Library Contents Details for Category Id: @Model.CategoryId</h4>
        </div>
    </div>

    <!-- Card for Body -->
    <div class="card mb-4 mt-2 overview-filters-card p-3">
        <div class="card-body" id="LockedDesktopDetailsContainer">
            <div class="row">
                <h4 class="w-100 text-center theme-txt-clr fw-bold">Content Library Content Details</h4>
                <div class="col-md-6">
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Category Id</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.CategoryId</p>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Product Id</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.ProductId</p>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Advert Id</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.AdvertId</p>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Advert Description</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.AdvertDescription</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Category Name</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.CategoryName</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Content Type</p>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-0 d-flex">
                                <i class="bi bi-card-image popup-info-attachment-icon"></i>
                                <span class="custom-p-bold ms-2">Picture</span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Content Path</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.ContentPath</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Targeted Modules</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.TargetedModulesFullName</p>
                        </div>
                    </div>
                    
                </div>
                <div class="col-md-6">
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Duration</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.Duration seconds</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Archive</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.Archive</p>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective From</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.EffectiveFromDate.ToString("dddd, dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Effective To</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.EffectiveToDate.ToString("dddd, dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Date Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.DateLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">User Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.UserIdLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <p class="custom-p popup-info-headings">Machine Id Last Modified</p>
                        </div>
                        <div class="col-md-6">
                            <p class="custom-p-bold">@Model.MachineIdLastModified</p>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Target Users</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-success module-details-targeting-btns" onclick="OpenTargetedEntityPreviewModal('@ModuleNamesType.ContentLibrary', true)">Targeting</btn>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 align-content-center">
                            <p class="custom-p popup-info-headings">Who Is Targeted</p>
                        </div>
                        <div class="col-md-6">
                            <btn class="btn btn-sm btn-primary module-details-targeting-btns" onclick="OpenTargetingExposurePreviewModal('@ModuleNamesType.ContentLibrary')">Targeting Exposure</btn>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <btn class="custom-btn custom-btn-default mt-4 px-5" onclick="PreviewContentType(ContentTypes.IMAGE, '/images/others/modules/skins/Popup_Skin_Default.png')">Preview Content</btn>
            </div>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
}
