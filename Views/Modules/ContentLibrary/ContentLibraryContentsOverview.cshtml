@model CLA_Administration_Web.ViewModels.Modules.ContentLibrary.ContentLibraryContentsViewModel
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    <div class="row mb-2">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Content Library Module</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, 'Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, 'AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', 'ContentLibrary', 'None', 'Link')">Content Library</span> /
                <span class="breadcrumb-item">Content</span>
            </p>
        </div>
        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenPage('@ModulesPages.AddNewContentLibraryContent', '@Model.CategoryId')"><i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon"></i> Add New Content</button>
        </div>
    </div>

    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Filters To Be Added</h4>
        </div>
    </div>

    <!-- Card for Table -->
    <div class="card" id="SurveyQuestionsOverviewCard">
        <div class="card-body">
            <div class="table-responsive" id="SurveyQuestionsOverviewTableContainer">
                <h3 class="w-100 text-center theme-txt-clr overview-table-caption">
                    <span id="SurveyQuesitonsOverviewTableCaption">Contents For Category ID: @Model.CategoryId</span>
                </h3>
                <table id="SurveyQuesitonsOverviewDataTable" class="table table-striped table-bordered table-hover align-middle" style="font-size:12px">
                    <thead>
                        <tr>
                            <th class="text-center">CategoryName</th>
                            <th class="text-center">Advert Description</th>
                            <th class="text-center">Duration</th>
                            <th class="text-center">Content Type</th>
                            <th class="text-center">Content Path</th>
                            <th class="text-center">Preview</th>
                            <th class="text-center">Targeted Module</th>
                            <th class="text-center">Effective From</th>
                            <th class="text-center">Effective To</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var content in Model.ContentLibraryContents)
                        {
                            <tr>
                                <td class="text-center">@content.CategoryName</td>
                                <td><p class="module-dt-header-text">@content.AdvertDescription</p></td>
                                <td><p class="text-center">@content.Duration</p></td>
                                <td><p class="text-center">@content.ContentType</p></td>
                                <td><p class="module-dt-header-text">@content.ContentPath</p></td>
                                <td><p class="text-center"><button class="btn btn-sm btn-info custom-btn-sm" onclick="PreviewImage()">Open</button></td>
                                <td><p class="text-center">@content.TargetedModules</p></td>
                                <td><p class="text-center">@content.EffectiveFrom</p></td>
                                <td><p class="text-center">@content.EffectiveTo</p></td>
                                <td><span class="@content.Status.CssClass">@content.Status.StatusType.GetDisplayName()</span></td>
                                <td>
                                    <button class="btn btn-info btn-sm mx-1 custom-btn-sm" onclick="OpenContentDetails('@content.ContentId')">Open</button>
                                    <button class="btn btn-secondary btn-sm custom-btn-sm mx-1">Edit</button>
                                    <button class="btn btn-danger btn-sm custom-btn-sm">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="ImagePreviwer">
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script>

    $(document).ready(function ()
    {
        $('#SurveyQuesitonsOverviewDataTable').DataTable();
        LoadContentPreviewer("#ImagePreviwer");
    });

    function OpenCategory()
    {
        OpenPage('@ModulesPages.ContentLibraryCategoryDetails', '@Model.CategoryId');
    }

    function OpenContentDetails(contentId)
    {
        OpenPage('@ModulesPages.ContentLibraryContentDetails', contentId);
    }

</script>