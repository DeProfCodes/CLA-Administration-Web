@model List<CLA_Administration_Web.ViewModels.Modules.Rss.RssFeedOverviewViewModel>
@using CLA_Administration_Web.Helpers.Enums.AppPages

@{
    var rssCategoryId = Model?.FirstOrDefault()?.CategoryId ?? 0;
}

<div class="container-fluid">
    <!-- Breadcrumb Component -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.RSSFeedOverview, itemId = rssCategoryId })

    <!-- Card for Filters -->
    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">RSS Management</h4>
        </div>
    </div>

    <!-- Card for Table -->
    <div class="card" id="ModuleOverviewCard">
        <div class="card-body">
            <div class="table-responsive" id="ModuleOverviewTableContainer">
                <h3 class="w-100 text-center theme-txt-clr overview-table-caption" id="ModuleOverviewTableCaption">
                    RSS Feed
                </h3>
                <table id="RSSFeedOverviewDataTable" class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category Name</th>
                            <th>Feed Name</th>
                            <th>Feed URL</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rss in Model)
                        {
                            <tr>
                                <td>@rss.FeedId</td>
                                <td>@rss.CategoryName</td>
                                <td>@rss.FeedName</td>
                                <td>@rss.FeedURL</td>
                                <td>
                                    <button class="btn btn-info btn-sm mx-1" onclick="OpenRSSFeedDetails('@rss.CategoryId', '@rss.FeedId')">Open</button>
                                    <button class="btn btn-secondary btn-sm mx-1">Edit</button>
                                    <button class="btn btn-danger btn-sm mx-1">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        SetDataTableData();
    });

    function SetDataTableData()
    {
        rssCategoryDataTable = $('#RSSFeedOverviewDataTable').DataTable();
    }

    function OpenRSSFeedDetails(rssCategoryId, rssFeedId)
    {
        OpenPage('@ModulesPages.RSSFeedDetails', rssCategoryId, rssFeedId);
    }


</script>