@using CLA_Administration_Web.Helpers.Enums.AppPages


<div class="container-fluid">
    <!-- Top Page Navigation Breadcrumb -->
    @await Component.InvokeAsync("Breadcrumbs", new { page = ModulesPages.ScreensaverOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataFilters", new { page = ModulesPages.ScreensaverOverview })

    <!-- ModuleFilter Component -->
    @await Component.InvokeAsync("OverviewDataTables", new { page = ModulesPages.ScreensaverOverview })

</div>

<script>

    $(document).ready(function ()
    {
        LoadScreensaverDefaultOverviewData();
    });

    function LoadScreensaverDefaultOverviewData()
    {
        FilterModuleDataOverviewByStatus('Screensaver', `ActiveScreensaverBtnFilter`, AllStatusTypes.Active);
    }

</script>
