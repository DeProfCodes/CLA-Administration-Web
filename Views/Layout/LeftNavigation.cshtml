@model CLA_Administration_Web.ViewModels.Layouts.LeftNavigationViewModel

@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Html


<link href="~/assets/plugins/metismenu/css/metisMenu.min.css" rel="stylesheet" />

<!--start sidebar -->
<aside class="sidebar-wrapper theme-bg" data-simplebar="true" id="LeftNavMenu">
    <div class="sidebar-header">
        <div>
            <img src="~/assets/images/white-logo.png" class="logo-icon" alt="logo icon">
        </div>
    </div>
    <!--navigation-->
    <ul class="metismenu" id="menu">
        <!-- Dashboard -->
        <li>
            <a onclick="ExpandToggleLeftMainNavMenu('Dashboard')" id="DashboardLink" class="left-nav-menu-item">
                <i class="bi bi-grid-fill left-nav-icons" id="DashboardLeftIcon"></i>
                <span class="left-nav-titles" id="DashboardTitle">Dashboard</span>
                <i class="bi bi-chevron-right ms-lg-auto left-nav-icons" id="DashboardRightIcon"></i>
            </a>
            <ul id="DashboardDropdown" class="mm-collapse left-nav-sub-menu">
                <li>
                    <a onclick="OpenPage('@DashboardPages.Dashboard')" class="left-sub-nav-link">
                        <i class="bi bi-house left-sub-nav-icons" id="DashboardHomeLeftIcon"></i><span class="left-sub-nav-title">Home</span>
                    </a>
                </li>
                <li>
                    <a onclick="OpenPage('@DashboardPages.Calendar')" class="left-sub-nav-link">
                        <i class="bi bi-calendar2-week left-sub-nav-icons" id="DashboardCalendarLeftIcon"></i><span class="left-sub-nav-title">Calendar</span>
                    </a>
                </li>
            </ul>
        </li>
        <!-- Modules -->
        <li>
            <a onclick="ExpandToggleLeftMainNavMenu('Modules')" id="ModulesLink" class="left-nav-menu-item">
                <i class="bi bi-boxes left-nav-icons" id="ModulesLeftIcon"></i>
                <span class="left-nav-titles" id="ModulesTitle">Modules</span>
                <i class="bi bi-chevron-right ms-lg-auto left-nav-icons" id="ModulesRightIcon"></i>
            </a>
            <ul id="ModulesDropdown" class="mm-collapse left-nav-sub-menu">
                @foreach (var modulePage in Model.ModulesLeftNavigation)
                {
                    var moduleName = modulePage.ModuleName.GetDisplayName();
                    var linkId = $"{moduleName}Link";
                    var leftIconId = $"{moduleName}LeftIcon";
                    var titleId = $"{moduleName}Title";
                    var title = modulePage.ModuleName.GetDisplayDescription();
                    var rightIconId = $"{moduleName}RightIcon";
                    var dropdownId = $"{moduleName}Dropdown";
                    var overviewLeftIcon = $"{moduleName}OverviewLeftIcon";
                    
                    <li>
                        <a onclick="ExpandToggleLeftSubNavMenu('@moduleName')" id="@linkId" class="left-sub-nav-link">
                            <img class="left-nav-icons" id="@leftIconId" src="@modulePage.IconWhiteUrl"/>
                            <span class="left-sub-nav-title" id="@titleId">@title</span>
                            <i class="bi bi-chevron-right ms-lg-auto left-nav-icons" id="@rightIconId"></i>
                        </a>
                        <ul id="@dropdownId" class="mm-collapse left-nav-sub-menu">
                            <li>
                                <a onclick="OpenPage('@modulePage.OverviewPage')" class="left-sub-nav-link">
                                    <i class="ri-menu-search-fill left-sub-nav-icons" id="@overviewLeftIcon"></i><span class="left-sub-nav-title">Overview</span>
                                </a>
                            </li>
                            <li>
                                <a onclick="OpenPage('@modulePage.AddNewPage')" class="left-sub-nav-link">
                                    <i class="bi bi-plus-circle-fill left-sub-nav-icons" id="@leftIconId"></i><span class="left-sub-nav-title">Add New</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </li>
        <!-- Settings -->
        <li>
            <a onclick="ExpandToggleLeftMainNavMenu('Settings')" id="SettingsLink" class="left-nav-menu-item">
                <i class="bi bi-boxes left-nav-icons" id="SettingsLeftIcon"></i>
                <span class="left-nav-titles" id="SettingsTitle">Settings</span>
                <i class="bi bi-chevron-right ms-lg-auto left-nav-icons" id="SettingsRightIcon"></i>
            </a>
            <ul id="SettingsDropdown" class="mm-collapse left-nav-sub-menu">
                @foreach (var settingVm in Model.SettingsLeftNavigation)
                {
                    var settingName = settingVm.SettingName.GetDisplayName();
                    var linkId = $"{settingName}Link";
                    var leftIconId = $"{settingName}LeftIcon";
                    var titleId = $"{settingName}Title";
                    var title = settingVm.SettingName.GetDisplayDescription();
                    
                    <li>
                        <a onclick="OpenPage('@settingVm.SettingName')" id="@linkId" class="left-sub-nav-link">
                            <img class="left-nav-icons" id="@leftIconId" src="@settingVm.IconWhiteUrl" />
                            <span class="left-sub-nav-title" id="@titleId">@title</span>
                        </a>
                    </li>
                }
            </ul>
        </li>
        <!-- Reports -->
        <li>
            <a onclick="ExpandToggleLeftMainNavMenu('Reports')" id="ReportsLink" class="left-nav-menu-item">
                <i class="bi bi-boxes left-nav-icons" id="ReportsLeftIcon"></i>
                <span class="left-nav-titles" id="ReportsTitle">Reports</span>
                <i class="bi bi-chevron-right ms-lg-auto left-nav-icons" id="ReportsRightIcon"></i>
            </a>
            <ul id="ReportsDropdown" class="mm-collapse left-nav-sub-menu">
                @foreach (var reportVm in Model.ReportsLeftNavigation)
                {
                    var reportName = reportVm.ReportName.GetDisplayName();
                    var linkId = $"{reportName}Link";
                    var leftIconId = $"{reportName}LeftIcon";
                    var titleId = $"{reportName}Title";
                    var title = reportVm.ReportName.GetDisplayDescription();

                    <li>
                        <a onclick="OpenPage('@reportVm.ReportName')" id="@linkId" class="left-sub-nav-link">
                            <img class="left-nav-icons" id="@leftIconId" src="@reportVm.IconWhiteUrl" />
                            <span class="left-sub-nav-title" id="@titleId">@title</span>
                        </a>
                    </li>
                }
            </ul>
        </li>
      
    </ul>
    <!--end navigation-->
</aside>
<!--end sidebar -->

<script src="~/assets/plugins/metismenu/js/metisMenu.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    
    function ToggleIconImageActive(leftIconId, isActive)
    {
        var iconImgUrl = $(leftIconId).attr("src");
        
        var newUrl = isActive ? iconImgUrl.replace('white', 'blue') : iconImgUrl.replace('blue', 'white');

        $(leftIconId).attr("src", newUrl);
    }

    function ExpandToggleLeftNavMenu(linkId, leftIconId, titleId, rightIconId, dropDownId, activeNavCss, isImageIcon)
    {
        if ($(dropDownId).hasClass('menu-active') == false)
        {
            if(isImageIcon)
                ToggleIconImageActive(leftIconId, true);
            else
                $(leftIconId).addClass(activeNavCss);
            
            $(titleId).addClass(activeNavCss);
            $(rightIconId).addClass(activeNavCss);
            $(rightIconId).removeClass('bi-chevron-right');
            $(rightIconId).addClass('bi-chevron-down');

            $(linkId).addClass(activeNavCss);


            $(dropDownId).addClass("menu-active");
            $(dropDownId).slideDown();

        }
        else
        {
            if (isImageIcon)
                ToggleIconImageActive(leftIconId, false);
            else
                $(leftIconId).removeClass(activeNavCss);

            $(titleId).removeClass(activeNavCss);
            $(rightIconId).removeClass(activeNavCss);
            $(rightIconId).addClass('bi-chevron-right');
            $(rightIconId).removeClass('bi-chevron-down');

            $(linkId).removeClass(activeNavCss);
            $(dropDownId).removeClass("menu-active");
            $(dropDownId).slideUp();
        }
    }

    function ExpandToggleLeftMainNavMenu(groupName)
    {
        var linkId = `#${groupName}Link`;
        var leftIconId = `#${groupName}LeftIcon`;
        var titleId = `#${groupName}Title`;
        var rightIconId = `#${groupName}RightIcon`;
        var dropDownId = `#${groupName}Dropdown`;

        ExpandToggleLeftNavMenu(linkId, leftIconId, titleId, rightIconId, dropDownId, 'left-nav-menu-active', false);
    }

    function ExpandToggleLeftSubNavMenu(groupName)
    {
        var linkId = `#${groupName}Link`;
        var leftIconId = `#${groupName}LeftIcon`;
        var titleId = `#${groupName}Title`;
        var rightIconId = `#${groupName}RightIcon`;
        var dropDownId = `#${groupName}Dropdown`;

        ExpandToggleLeftNavMenu(linkId, leftIconId, titleId, rightIconId, dropDownId, 'left-sub-nav-menu-active', true);
    }

</script>