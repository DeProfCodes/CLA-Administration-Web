</header>

<script>

    window.addEventListener('click', function (e)
    {
        if (document.getElementById('ProfileDropdownContainer').contains(e.target))
        {
            $("#ProfileDropdown").addClass('show');
        } 
        else
        {
            $("#ProfileDropdown").removeClass('show');
        }
    });

    function ToggleLeftNavigationMenu()
    {
        var isClosed = $("#TopNavigationBar").css('left') == '0px';
        if(isClosed)
        {
            $("#TopNavigationBar").css('left', '260px');
            $("#PageArea").css('margin-left', '260px');
            $("#LeftNavMenu").css('left', '0');
        }
        else
        {
            $("#TopNavigationBar").css('left', '0px');
            $("#PageArea").css('margin-left', '0px');
            $("#LeftNavMenu").css('left', '-300px');
        }
    }

    function OpenCalendar()
    {
        var groupName = 'Dashboard';

        var linkId = `#${groupName}Link`;
        var leftIconId = `#${groupName}LeftIcon`;
        var titleId = `#${groupName}Title`;
        var rightIconId = `#${groupName}RightIcon`;
        var dropDownId = `#${groupName}Dropdown`;

        ExpandCloseAllMainMenuDropdowns();
        ExpandOpenLeftNavMenu(linkId, leftIconId, titleId, rightIconId, dropDownId, 'left-nav-menu-active', false);

        OpenLeftNavigationPage('@DashboardNameTypes.Calendar', 'CalendarSubLink');
    }


</script>