                    </ul>
                </li>
                <li style="margin-left:10px; cursor:pointer">
                    <div class="text-white" style="display:grid" id="UserInfoGrid">
                        <span id="UserName">@Model.UserFullname</span>
                        <span id="UserRole" style="color:silver;font-style:italic; font-size:12px">@Model.CompanyDepartment</span>
                    </div>
                </li>
            </ul>
            <span style="border-right:1px solid silver; margin:10px;" id="UserCompanyImageSeparator"></span>
            <div id="UserCompany">
                <img src="@Model.CompanyLogo" id="UserCompanyImage" />
            </div>

        </div>
