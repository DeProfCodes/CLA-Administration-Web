@using CLA_Administration_Web.ViewModels.Settings.CustomUser
@model CustomUserMainViewModel
@using static CLA_Administration_Web.ViewModels.Modules.LDS.AddNewContentLibraryCategory
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

@{
    int index = 0;
    var connectServer = "";
    var lastSyncLast3Days = "";
    var lastDBSync = "";
    var userMachine = "";
    var ipAddress = "";
    var syncVersion = "";
    var msdimVersion = "";
    var svcVersion = "";
    var activeConns = "";
    var lastPopup = "";
    var lastPopupDisplay = "";
    var lastSurvey = "";
    var lastSurveyDisplay = "";
    var network = "";
    var screenTime = "";
    var popupTime = "";
    var desktopTime = "";
    var ticker = "";
    var syncTime = "";
    var syncFrom = "";
    var syncTo = "";
    var allowTickerLaunch = false;
    var updateFuture = false;
    var passProtectScr = false;
    var allowUserChangeScre = false;
    var allowUserChangeDesk = false;
    var enableErrorLog = false;
    var aspectRatio = false;
    var impresionLog = false;
    var audio = false;
    var useMachineId = false;
    var surveyTargeting = "module-not-targeted";
    var popupTargeting = "module-not-targeted";
    var tickerTargeting = "module-not-targeted";
    var screensaverTargeting = "module-not-targeted";
    var desktopTargeting = "module-not-targeted";
    var lockscreenTargeting = "module-not-targeted";
    var usersGroups = "";
    var bgRedCss = "";
    var bgGreenCss = "";
    @if (Model != null && !Model.IsBlank)
{
    var lastSyncDetails = Model.LastSyncDetails;
if (lastSyncDetails != null)
{
    connectServer = Model.ConnectedToLive ? "Connected to Live" : "Connected to Staging";
    lastSyncLast3Days = (lastSyncDetails.LastUpdateDT >= DateTime.Now.AddDays(-3) && lastSyncDetails.LastUpdateDT <= DateTime.Now) ? "Yes" : "No";
    lastDBSync = lastSyncDetails.LastUpdateDT?.ToString("yyyy/MM/dd HH:mm:ss") ?? "";
    userMachine = lastSyncDetails.MachineID;
    ipAddress = lastSyncDetails.IPAddress;
    syncVersion = lastSyncDetails.MSDIMSYNCVersion?.ToString("yyyy/MM/dd");
    msdimVersion = lastSyncDetails.MSDIMVersion?.ToString("yyyy/MM/dd");
    svcVersion = lastSyncDetails.MSDIMSVCVersion?.ToString("yyyy/MM/dd");
    activeConns = "1/100";
    lastPopup = $"({lastSyncDetails.LastSurveyID}) {lastSyncDetails.PopupTitle}";
    lastPopupDisplay = lastSyncDetails.LastSTMDT?.ToString("yyyy/MM/dd HH:mm:ss");
    lastSurvey = $"({lastSyncDetails.LastSurveyID}) {lastSyncDetails.SurveyTitle}";
    lastSurveyDisplay = lastSyncDetails.LastSurveyDT?.ToString("yyyy/MM/dd HH:mm:ss");
    bgRedCss = "bg-red";
    bgGreenCss = "bg-success";
}
var settings = Model.Settings;
if (settings != null)
{
    network = settings.Network;
    screenTime = settings.ScreensaverTimeout?.ToString() ?? "";
    popupTime = settings.PopUpTimeout?.ToString() ?? "";
    desktopTime = settings.DesktopTimeout?.ToString() ?? "";
    ticker = settings.TickerTimeout?.ToString() ?? "";
    syncTime = settings.SyncTimeout?.ToString() ?? "";
    syncFrom = settings.SyncTimeslotFrom;
    syncTo = settings.SyncTimeslotTo;
    allowTickerLaunch = settings.AllowTickerToLaunchAutomatically == 1;
    updateFuture = settings.UpdateFutureContent == 1;
    passProtectScr = settings.ScreenSaverIsSecure == 1;
    allowUserChangeScre = settings.PolicyControlledScreensaver == 1;
    allowUserChangeDesk = settings.DesktopIsSecure == 1;
    enableErrorLog = settings.ErrorLogging == 1;
    aspectRatio = settings.MaintainAspectRatio == 1;
    impresionLog = settings.ImpressionLogging == 1;
    audio = settings.UseAudio == "1";
    useMachineId = settings.UseMachineID == 1;
}
var targeting = Model.Targeting;
if (targeting != null)
{
    surveyTargeting = targeting.FirstOrDefault(x => x.Destination == "SURVEYS")?.CNT > 0 ? "module-targeted" : "module-not-targeted";
    popupTargeting = targeting.FirstOrDefault(x => x.Destination == "POPUPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
    tickerTargeting = targeting.FirstOrDefault(x => x.Destination == "TICKERS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
    screensaverTargeting = targeting.FirstOrDefault(x => x.Destination == "SEQUENCES")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
    desktopTargeting = targeting.FirstOrDefault(x => x.Destination == "DESKTOPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
    lockscreenTargeting = targeting.FirstOrDefault(x => x.Destination == "LOCKED DESKTOPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
}
var users = Model.UserGroups.Select(x => x.GroupID);
if (users != null)
{
usersGroups = string.Join(Environment.NewLine, users);
}
}
}
@{

    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
{
    SettingsCurrentPage = SettingsPages.CustomUserSettings,
    HasAddNewButton = true,
    BreadcrumbButtonName = "Add New User Settings",
    BreadcrumbButtonCallbackFunction = "AddNewCustomSettingsUser"
})
    ;
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");

    var usersDomains = Model.CustomUsersSettings.Select(x => x.Id).Distinct().ToList();
    var machinesDomains = Model.UserGroups.Select(x => x.GroupID).Distinct().ToList();
}

<div  class="container-fluid">
<!-- Settings Filter Component -->

    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling hidden">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1 mb-2">
                <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
                <div class="row col-12 d-flex flex-wrap module-overview-filters">
                    <div class="w-fit-content ms-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">View Type</p>
                            <div class="row mx-auto">
                                <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                    <button class="btn module-filter-btn-group filter-type-btn btn-group-active" onclick="ToggleStaginUserMachines(this.id)" id="StagingUserBtn">Users</button>
                                    <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">Machines</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-auto me-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">Domain</p>
                            <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                                <option value="0">Please select Domain Name</option>
                                @foreach (var domain in usersDomains)
                                {
                                    <option value="@domain">@domain</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Card for  Customer user setting  Body -->
<div class="card mb-1 mt-1 p-4 overview-filters-card app-card-main-scaling" id="report-data-area">
<div id="SettingsData">
    <h3 class="w-100 text-center theme-txt-clr">
    Existing <span id="StagingUserMachineTitle">Users Settings</span>
    </h3>
    <!-- Inject Partial Here -->
    <div id="StagingUsersSettings" class="mt-3">
    <table id="StagingUsersData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
        <thead>
            <tr>
                <th class="theme-bg text-white">CustomID</th>
                <th class="theme-bg text-white">Description</th>
                <th class="theme-bg text-white">Screensaver Timeout</th>
                <th class="theme-bg text-white">Popup Timeout</th>
                <th class="theme-bg text-white">Desktop Timeout</th>
                <th class="theme-bg text-white">Ticker Timeout</th>
                <th class="theme-bg text-white">Sync Timeout</th>
                <th class="theme-bg text-white">Network</th>
                <th class="theme-bg text-white">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var userSetting in Model.CustomUsersSettings)
            {
            var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
            cssBg += " theme-txt-clr";
            <tr>
                <td class="cssBg">@userSetting.Id</td>
                <td class="cssBg">@userSetting.Description</td>
                <td class="cssBg">@userSetting.ScreensaverTimeout</td>
                <td class="cssBg">@userSetting.PopupTimeout</td>
                <td class="cssBg">@userSetting.DeskTopTimeout</td>
                <td class="cssBg">@userSetting.TickerTimeout</td>
                <td class="cssBg">@userSetting.SyncTimeout</td>
                <td class="cssBg">@userSetting.Network</td>
                <td class="cssBg">
                                    <button class="btn btn-sm custom-btn-sm btn-danger" onclick="DeleteExistingUser(@userSetting.Id)">Delete</button>
                  <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting(@userSetting.Id)">Edit</button>
               
                </td>
            </tr>
            }
        </tbody>
    </table>
    </div>
</div>
</div>
</div>
</div>

    <!------Add new settings modal--------->
