
@model StagingUsersMainViewModel

@{
    int index = 0;

    var usersDomains = Model.StagingUsers.Select(x => x.Domain).Distinct().ToList();
    var machinesDomains = Model.StagingMachines.Select(x => x.Domain).Distinct().ToList();
    var users = Model.StagingUsers.Select(x => x.UserLastModified).Distinct().ToList();
}

<div class="container-fluid">

<!-- Breadcrumb Component -->
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
        {
            SettingsCurrentPage = SettingsPages.StagingUsers,
            HasAddNewButton = true,
            BreadcrumbButtonName = "Add New Staging User",
            BreadcrumbButtonCallbackFunction = "AddNewStagingEntity"
        });
}

    <link rel="stylesheet" href="~/css/settings.css"/>
<!-- Settings Filter Component -->
<div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
    <div class="card-body pt-0 pb-0">
        <div class="row fs-12 mt-1 mb-2">
            <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
            <div class="row col-12 d-flex flex-wrap module-overview-filters">
                <div class="w-fit-content ms-auto mb-1">
                    <div class="d-flex">
                        <p class="custom-p w-fit-content align-content-center">View Type</p>
                        <div class="row mx-auto">
                            <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                <button class="btn module-filter-btn-group filter-type-btn btn-group-active" onclick="ToggleStaginUserMachines(this.id)" id="StagingUserBtn">Users</button>
                                <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">Machines</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-auto me-auto mb-1">
                    <div class="d-flex">
                        <p class="custom-p w-fit-content align-content-center">Domain</p>
                        <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                            <option value="0">Please select Domain Name</option>
                            @foreach (var domain in usersDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Card for Popup Report Body -->
<div class="card mb-1 mt-1 card mb-4 mt-2 overview-filters-card app-card-main-scaling p-4" id="report-data-area">
    <div id="SettingsData">
        <h3 class="w-100 text-center theme-txt-clr">
            Staging <span id="StagingUserMachineTitle">Users</span>
        </h3>
        <!-- Inject Partial Here -->
        <div id="StagingUsersSettings" class="mt-3">
            <table id="StagingUsersData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                <thead>
                    <tr>
                        <th class="theme-bg text-white">UserID</th>
                        <th class="theme-bg text-white">Domain</th>
                        <th class="theme-bg text-white">NT Username</th>
                        <th class="theme-bg text-white">Firstname</th>
                        <th class="theme-bg text-white">Surname</th>
                        <th class="theme-bg text-white">User Last Modified</th>
                        <th class="theme-bg text-white">Machine Last Modified</th>
                        <th class="theme-bg text-white">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stagingUser in Model.StagingUsers)
                    {
                        var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                        cssBg += " theme-txt-clr";

                        <tr>
                            <td class="@cssBg">@stagingUser.Id</td>
                            <td class="@cssBg">@stagingUser.Domain</td>
                            <td class="@cssBg">@stagingUser.Username</td>
                            <td class="@cssBg">@stagingUser.Firstname</td>
                            <td class="@cssBg">@stagingUser.Lastname</td>
                            <td class="@cssBg">@stagingUser.UserLastModified</td>
                            <td class="@cssBg">@stagingUser.MachineLastModified</td>
                            <td class="@cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-danger" onclick="DeleteExistingUser(@stagingUser.Id)" >Delete</button>
                                <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting(@stagingUser.Id, 'User')">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="StagingMachinesSettings" class="mt-3 hidden">
            <table id="StagingMachinesData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                <thead>
                    <tr>
                        <th class="theme-bg text-white">MachineID</th>
                        <th class="theme-bg text-white">Domain</th>
                        <th class="theme-bg text-white">Machine Name</th>
                        <th class="theme-bg text-white">Machine Description</th>
                        <th class="theme-bg text-white">User Last Modified</th>
                        <th class="theme-bg text-white">Machine Last Modified</th>
                        <th class="theme-bg text-white">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stagingMachine in Model.StagingMachines)
                    {
                        var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                        cssBg += " theme-txt-clr";

                        <tr>
                            <td class="@cssBg">@stagingMachine.Id</td>
                            <td class="@cssBg">@stagingMachine.Domain</td>
                            <td class="@cssBg">@stagingMachine.MachineName</td>
                            <td class="@cssBg">@stagingMachine.MachineDescription</td>
                            <td class="@cssBg">@stagingMachine.UserLastModified</td>
                            <td class="@cssBg">@stagingMachine.MachineLastModified</td>
                            <td class="@cssBg">

                                <button class="btn btn-sm custom-btn-sm btn-danger" onclick=" DeleteExistingUser(@stagingMachine.Id)">Delete</button>
                                <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting(@stagingMachine.Id, 'Machine')">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>

<!-- Create New Staging User Modal -->
<div class="modal fade" id="CreateStagingUserModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Staging User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingUserModal')"></button>
            </div>
            <div class="modal-body">
                <form id="CreateStagingUserForm">
                    <!-- UserID -->
                    <div class="mb-3">
                        <label for="UserID" class="form-label">UserID</label>
                        <input type="text" class="form-control" id="UserID" readonly>
                    </div>

                    <!-- Domain -->
                    <div class="mb-3">
                        <label for="StagingUserDomain" class="form-label">Domain</label>
                           <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                            <option value="0">Please select Domain Name</option>
                            @foreach (var domain in usersDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                    </div>

                    <!-- NT Username -->
                    <div class="mb-3">
                        <label for="StagingUserUsername" class="form-label">NT Username</label>
                        <input type="text" class="form-control" id="StagingUserUsername" >
                    </div>

                    <!-- First Name -->
                    <div class="mb-3">
                        <label for="StagingUserFirstname" class="form-label">Firstname</label>
                        <input type="text" class="form-control" id="StagingUserFirstname" required>
                    </div>

                    <!-- Surname -->
                    <div class="mb-3">
                        <label for="StagingUserLastname" class="form-label">Surname</label>
                        <input type="text" class="form-control" id="StagingUserLastname" required>
                    </div>

                    <!-- User Last Modified -->
                    <div class="mb-3">
                        <label for="StagingUserUserLastModified" class="form-label">User Last Modified</label>
                        <input type="text" class="form-control" id="StagingUserUserLastModified" >
                    </div>

                    <!-- Machine Last Modified -->
                    <div class="mb-3">
                        <label for="StagingMachineLastModified" class="form-label">Machine Last Modified</label>
                        <input type="text" class="form-control" id="StagingMachineLastModified" readonly>
                    </div>

                    <!-- Button to open Users Modal -->
                    <div class="mb-3">
                        <label for="SelectUser" class="form-label">Select User</label>
                        <button class="btn btn-secondary" type="button" id="StagingUserBtn" onclick="openUsersModal()">Select User</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingUserModal')">Cancel</button>
                <button type="button" class="btn custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>



<!-- Users Modal -->
<div class="modal fade" id="UsersModal" tabindex="-1" aria-labelledby="UsersModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="UsersModalLabel">Select User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeUsersModal()"></button>
            </div>
            <div class="modal-body">
                <!-- Search Box for Filtering -->
                <div class="mb-3">
                    <label for="filterInputMember" class="form-label">Filter:</label>
                    <input type="text" id="filterInputMember" placeholder="Search..." oninput="filterTreeView('filterInputMember', '.tree-view')">

                </div>
                <!-- Tree View for Active Directory Objects -->
                <div class="scroll-box treeview mt-3">
                    <ul id="directoryTree" class="tree-view">
                        <!-- Root Node: Active Directory Objects -->
                        <li>
                            <input type="checkbox" id="node1" class="tree-toggle" hidden>
                            <label for="node1" class="tree-toggle-label"><i class="bi bi-folder"></i> Active Directory Objects</label>
                            <ul class="tree-content">
                                <!-- Groups Node -->
                                <li>
                                    <input type="radio" id="node1-1" class="tree-toggle">
                                    <label for="node1-1" class="tree-toggle-label"><i class="bi bi-people"></i> Groups</label>
                                    <ul class="tree-content">
                                        <li data-type="group" data-name="Admins"><input type="radio" id="group_admins"> Admins</li>
                                        <li data-type="group" data-name="Developers"><input type="radio" id="group_developers"> Developers</li>
                                        <li data-type="group" data-name="HR"><input type="radio" id="group_hr"> HR</li>
                                    </ul>
                                </li>
                                <!-- Users Node -->
                                <li>
                                    <input type="radio" id="node1-2" class="tree-toggle">
                                    <label for="node1-2" class="tree-toggle-label"><i class="bi bi-person"></i> Users</label>
                                    <ul class="tree-content">
                                        <li data-username="nhlamulo"><input type="radio" class="user-checkbox" id="user_nhlamulo"> nhlamulo</li>
                                        <li data-username="jane_smith"><input type="radio" class="user-checkbox" id="user_jane_smith"> Jane Smith</li>
                                        <li data-username="john_doe"><input type="radio" class="user-checkbox" id="user_john_doe"> John Doe</li>
                                    </ul>
                                </li>
                                <!-- Machines Node -->
                                <li>
                                    <input type="radio" id="node1-3" class="tree-toggle">
                                    <label for="node1-3" class="tree-toggle-label"><i class="bi bi-laptop"></i> Machines</label>
                                    <ul class="tree-content">
                                        <li data-type="machine" data-name="Server-1"><input type="radio" id="machine_server_1"> Server-1</li>
                                        <li data-type="machine" data-name="Workstation-5"><input type="radio" id="machine_workstation_5"> Workstation-5</li>
                                    </ul>
                                </li>
                                <!-- IP Ranges Node -->
                                <li>
                                    <input type="radio" id="node1-4" class="tree-toggle">
                                    <label for="node1-4" class="tree-toggle-label"><i class="bi bi-globe"></i> IP Ranges</label>
                                    <ul class="tree-content">
                                        <li data-type="iprange" data-name="192.168.0.0/24"><input type="radio" id="iprange_192_168_0_0"> 192.168.0.0/24</li>
                                        <li data-type="iprange" data-name="10.0.0.0/8"><input type="radio" id="iprange_10_0_0_0"> 10.0.0.0/8</li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeUsersModal()">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveSelections()">Save Selection</button>
            </div>
        </div>
    </div>
</div>

<!-- Create New Staging Machine Modal -->
<div class="modal fade" id="CreateStagingMachineModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
<div class="modal-dialog modal-lg">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Staging Machine</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingMachineModal')"></button>
        </div>
        <div class="modal-body">
            <form id="CreateStagingUserForm">
                <div class="mb-3">
                    <label for="StagingUserDomain" class="form-label">Domain</label>
                    <select class="form-select" id="StagingUserDomain" required>
                        <option value="">Please select a domain</option>
                        @foreach (var domain in usersDomains)
                        {
                            <option value="@domain">@domain</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="StagingMachinename" class="form-label">Machine Name</label>
                    <input type="text" class="form-control" id="StagingMachinename" required>
                </div>
                <div class="mb-3">
                    <label for="StagingMachineDescription" class="form-label">Machine Description</label>
                    <input type="text" class="form-control" id="StagingMachineDescription" required>
                </div>
                <div class="mb-3">
                    <label for="StagingUserUserLastModified" class="form-label">User Last Modified</label>
                    <input type="text" class="form-control" id="StagingUserUserLastModified" required>
                </div>
                <div class="mb-3">
                    <label for="StagingMachineLastModified" class="form-label">Machine Last Modified</label>
                    <input type="datetime-local" class="form-control" id="StagingMachineLastModified">
                </div>

            </form>
        </div>
        <div class="modal-footer">
            <button type="button" id="closeModal" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingMachineModal')">Cancel</button>
