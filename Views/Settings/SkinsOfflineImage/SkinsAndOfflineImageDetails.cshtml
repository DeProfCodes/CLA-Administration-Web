                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                        onclick="closeModal('EditModal')">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-primary"
                        onclick="SaveImage()">
                    Save Image
                </button>
            </div>
        </div>
    </div>
</div>




<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <script>

    function AddNewTargetGroup() {
      
        const userModal = new bootstrap.Modal(document.getElementById('EditModal'));
        userModal.show();
       
    }


    function SaveImage() {
        const module = document.getElementById("Module").value;
        const fileInput = document.getElementById("SkinsAndOfllineImageUploadInput").files[0];

        if (!fileInput) {
            swal("Validation Error", "Please upload an image.", "error");
            return;
        }

        ValidateImage(fileInput, module)
            .then(() => {
                swal("Success", "New Skin and Offline Image is saved.", "success");
                // Proceed with saving logic here
            })
            .catch(errMessage => {
                swal("Validation Error", errMessage, "error");
            });
    }

    function ValidateImage(file, module) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();

            reader.onload = function (e) {
                const image = new Image();
                image.src = e.target.result;

                image.onload = function () {
                    const width = image.width;
                    const height = image.height;
                    const fileType = file.type.split("/")[1].toUpperCase();

                    const validationRules = {
                        "Offline": { formats: ["JPG", "PNG"], width: null, height: null },
                        "Popups": { formats: ["BMP"], width: [314, 414], height: [188, 288] },
                        "Surveys": { formats: ["BMP"], width: [485], height: [600] },
                        "SingleTicker": { formats: ["BMP"], width: [80], height: [40] },
                        "DoubleTicker": { formats: ["BMP"], width: [80], height: [80] }
                    };

                    const rules = validationRules[module];

                    if (!rules.formats.includes(fileType)) {
                        reject(`Invalid file type. Allowed formats: ${rules.formats.join(", ")}`);
                        return;
                    }

                    if (rules.width && (!Array.isArray(rules.width) || !rules.width.includes(width))) {
                        reject(`Invalid width (${width}px). Expected: ${rules.width.join(", ")}px`);
                        return;
                    }

                    if (rules.height && (!Array.isArray(rules.height) || !rules.height.includes(height))) {
                        reject(`Invalid height (${height}px). Expected: ${rules.height.join(", ")}px`);
                        return;
                    }

                    resolve();
                };

                image.onerror = function () {
                    reject("The uploaded file is not a valid image.");
                };
            };

            reader.onerror = function () {
                reject("An error occurred while reading the file.");
            };

            reader.readAsDataURL(file);
        });
    }

            function deleteSkine(categoryId)
            {
                   
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Deleted!",
                        text: "Your file has been deleted.",
                        icon: "success"
                    });
                }
            });
          }
</script>