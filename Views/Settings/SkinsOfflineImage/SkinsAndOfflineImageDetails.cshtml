@using CLA_Administration_Web.ViewModels.Settings.SkinAndOfflineImage;
@using Newtonsoft.Json
@model SkinsAndOfflineModel;
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.Helpers.Constants



@{

    int index = 0;

    //var treeParents = (Model.SkinOfflineCategortyTrees != null && Model.SkinOfflineCategortyTrees.Any()) 
        //? $"{string.Join(" > ", Model.SkinOfflineCategortyTrees.Select(x => x.CategoryName))}" 
        //: "No categories available";
    var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
    cssBg += " theme-txt-clr";


}



<div class="container-fluid">

    <div class="row ">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Skins and Offline Image Details</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, 'Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, 'AllModules', 'AllModulesLink', true)">Settings</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Settings', 'null', '@SettingsPages.SkinsOfflineImages', 'SurveyOverviewLink')">Skins and Offline Image</span> /
                <span class="breadcrumb-item">Skins and Offline Image Details</span>
            </p>
        </div>
        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenPage('@SettingsPages.SkinsOfflineImages')"><i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon"></i>Skins and Offline Image</button>
        </div>
    </div>


    <div class="card mb-4 mt-2 overview-filters-card">
        <div class="card-body">
            <h4 class="w-100 text-center theme-txt-clr">Edit Skins And Offline Images @Model.Id  for @Model.CategoryName</h4>
        </div>
    </div>
    @Model.Id
    @Model.ModuleName
    @Model.MachineLastModified
    @Model.Description
    <div class="card bg-white shadow-sm">
        <div class="card-body">

            <!-- Table -->
            <table class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12" id="StagingMachinesData">
                <thead>
                    <tr>
                        <th class="theme-bg text-white">
                            <input type="checkbox" id="select-all" aria-label="Select All">
                        </th>
                        <td class="theme-bg text-white">Category Name</td>
                        <th class="theme-bg text-white">Item Path</th>
                        <th class="theme-bg text-white">View</th>
                        <th class="theme-bg text-white">Default?</th>
                        <th class="theme-bg text-white">Description</th>
                        <th class="theme-bg text-white">User Last Modified</th>
                        <th class="theme-bg text-white">Machine Last Modified</th>
                        <th class="theme-bg text-white">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.SkinOfflineCategortyTrees)
                    {
                        <tr>
                            <td class="cssBg">
                                <input type="checkbox" name="select-item" aria-label="Select Item">
                            </td>
                            <td class="cssBg">
                                @category.CategoryName
                            </td>
                            <td class="cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-success" onclick="AddNewTargetGroup()">Select Item Path</button>
                            </td>
                            <td class="cssBg">
                                <img src="https://via.placeholder.com/50" alt="View Image" class="img-thumbnail">
                                <button class="btn btn-sm btn-info custom-btn-sm" onclick="PreviewContentType(ContentTypes.IMAGE, `${APP_BASE_ADDRESS}/images/others/modules/skins/Popup_Skin_Default.png`)">Open</button>
                            </td>
                            <td class="cssBg">
                                <input type="checkbox" name="default" aria-label="Set as Default">
                            </td>
                            <td class="cssBg">
                                @category.CategoryDescription
                            </td>
                            <td class="cssBg">
                                @category.UserLastModified
                            </td>
                            <td class="cssBg">
                                @category.MachineLastModified
                            </td>
                            <td class="cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-danger" aria-label="Delete" onclick="deleteSkine(@category.CategoryId)">
                                    Delete
                                </button>
                                <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEntry(@category.CategoryId)" aria-label="Edit">
                                    Edit
                                </button>
                            </td>
                        </tr>

                        @* Render child categories *@
                        @if (category._children != null && category._children.Any())
                        {
                            @foreach (var child in category._children)
                            {
                                <tr>
                                    <td class="cssBg"></td> <!-- Empty cell for alignment -->
                                    <td class="cssBg" style="padding-left: 20px;">
                                        @child.CategoryName
                                    </td>
                                    <td class="cssBg">
                                        <button class="btn btn-sm custom-btn-sm btn-success" onclick="AddNewTargetGroup()">Select Item Path</button>
                                    </td>
                                    <td class="cssBg">
                                        <img src="https://via.placeholder.com/50" alt="View Image" class="img-thumbnail">
                                        <button class="btn btn-sm btn-info custom-btn-sm" onclick="PreviewContentType(ContentTypes.IMAGE, `${APP_BASE_ADDRESS}/images/others/modules/skins/Popup_Skin_Default.png`)">Open</button>
                                    </td>
                                    <td class="cssBg">
                                        <input type="checkbox" name="default" aria-label="Set as Default">
                                    </td>
                                    <td class="cssBg">
                                        @child.CategoryDescription
                                    </td>
                                    <td class="cssBg">
                                        @child.UserLastModified
                                    </td>
                                    <td class="cssBg">
                                        @child.MachineLastModified
                                    </td>
                                    <td class="cssBg">
                                        <button class="btn btn-sm custom-btn-sm btn-danger" aria-label="Delete" onclick="deleteSkine(@child.CategoryId)">
                                            Delete
                                        </button>
                                        <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEntry(@child.CategoryId)" aria-label="Edit">
                                            Edit
                                        </button>
                                    </td>
                                </tr>

                                @* Render grandchild categories *@
                                @if (child._children != null && child._children.Any())
                                {
                                    @foreach (var grandchild in child._children)
                                    {
                                        <tr>
                                            <td class="cssBg"></td> <!-- Empty cell for alignment -->
                                            <td class="cssBg" style="padding-left: 40px;">
                                                @grandchild.CategoryName
                                            </td>
                                            <td class="cssBg">
                                                <button class="btn btn-sm custom-btn-sm btn-success" onclick="AddNewTargetGroup()">Select Item Path</button>
                                            </td>
                                            <td class="cssBg">
                                                <img src="https://via.placeholder.com/50" alt="View Image" class="img-thumbnail">
                                                <button class="btn btn-sm btn-info custom-btn-sm" onclick="PreviewContentType(ContentTypes.IMAGE, `${APP_BASE_ADDRESS}/images/others/modules/skins/Popup_Skin_Default.png`)">Open</button>
                                            </td>
                                            <td class="cssBg">
                                                <input type="checkbox" name="default" aria-label="Set as Default">
                                            </td>
                                            <td class="cssBg">
                                                @grandchild.CategoryDescription
                                            </td>
                                            <td class="cssBg">
                                                @grandchild.UserLastModified
                                            </td>
                                            <td class="cssBg">
                                                @grandchild.MachineLastModified
                                            </td>
                                            <td class="cssBg">
                                                <button class="btn btn-sm custom-btn-sm btn-danger" aria-label="Delete" onclick="deleteSkine(@grandchild.CategoryId)">
                                                    Delete
                                                </button>
                                                <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEntry(@grandchild.CategoryId)" aria-label="Edit">
                                                    Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }


                </tbody>
            </table>


            <div id="ImagePreviewModal" class="modal">
                <span class="close text-danger" onclick="CloseImagePreviewerModal()">&times;</span>
                <img class="modal-content" id="ImagePreviewer" />
                <div id="caption">
                    <button class="btn btn-warning" onclick="OpenImageInNewWindow()">Open New Window</button>
                </div>

            </div>
        </div>
    </div>

</div>



<!-------- Add New Skins and Offline Images Modal -------->
<div class="modal fade" id="EditModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Select Item Path</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="closeModal('EditModal')">
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body" id="EditModalContainer">

                <div class="mb-3">
                    <input type="hidden" id="Module" name="ModuleType" value="@Model.CategoryName">

                </div>

                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/FileUploader.cshtml",
                    new FileUploaderModel { ComponentId = "SkinsAndOfllineImage", InputId = "SkinsAndOfllineImageUploadInput", ShowPreviewButton = true, InitialHidden = false, WidthPx = "510px", OnFileUploadCallback = null });
                }
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                        onclick="closeModal('EditModal')">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-primary"
                        onclick="SaveImage()">
                    Save Image
                </button>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <script>

    function AddNewTargetGroup() {
      
        const userModal = new bootstrap.Modal(document.getElementById('EditModal'));
        userModal.show(); 
       
    }


    function SaveImage() 
    {
        const module = document.getElementById("Module").value; 
        const fileInput = document.getElementById("SkinsAndOfllineImageUploadInput").files[0]; 

        if (!fileInput) {
            swal("Validation Error", "Please upload an image.", "error");
            return;
        }

        // Validate the image
        ValidateImage(fileInput, module)
            .then(() => {
            
                SaveImageToServer(fileInput)
                    .then(() => {
                        swal("Success", "New Skin and Offline Image is saved successfully.", "success");
                    })
                    .catch((err) => {
                        swal("Error", `Failed to save the image: ${err}`, "error");
                    });
            })
            .catch(errMessage => {
                swal("Validation Error", errMessage, "error");
            });
    }

   
    function SaveImageToServer(file) {
        return new Promise((resolve, reject) => {
           
            setTimeout(() => {
                const isSuccess = true; 
                if (isSuccess) {
                    resolve(); 
                } else {
                    reject("Server error occurred");
                }
            }, 1000); 
        });
    }

    function ValidateImage(file, module) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();

            reader.onload = function (e) {
                const image = new Image();
                image.src = e.target.result;

                image.onload = function () {
                    const width = image.width;
                    const height = image.height;
                    const fileType = file.type.split("/")[1].toUpperCase(); 

                    const validationRules = {
                        "@ModuleNamesType.Popup": { formats: ["JPG", "PNG"], width: null, height: null },
                        "@ModuleNamesType.Screensaver": { formats: ["BMP"], width: [314, 414], height: [188, 288] },
                        "Survey": { formats: ["BMP"], width: [485], height: [600] },
                        "Ticker": { formats: ["BMP"], width: [80], height: [40] },
                        "Ticker": { formats: ["BMP"], width: [80], height: [80] }
                    };

                    const rules = validationRules[module];

                  
                    if (!rules) {
                        reject(`Invalid module type: ${module}. Please select a valid module.`);
                        return;
                    }

                
                    const validFormats = rules.formats.map(format => format.toUpperCase());

                    if (!validFormats.includes(fileType)) {
                        reject(`Invalid file type. Allowed formats: ${validFormats.join(", ")}`);
                        return;
                    }

                    if (rules.width && (!Array.isArray(rules.width) || !rules.width.includes(width))) {
                        reject(`Invalid width (${width}px). Expected: ${rules.width.join(", ")}px`);
                        return;
                    }

                    if (rules.height && (!Array.isArray(rules.height) || !rules.height.includes(height))) {
                        reject(`Invalid height (${height}px). Expected: ${rules.height.join(", ")}px`);
                        return;
                    }

                    resolve();
                };

                image.onerror = function () {
                    reject("The uploaded file is not a valid image.");
                };
            };

            reader.onerror = function () {
                reject("An error occurred while reading the file.");
            };

            reader.readAsDataURL(file);
        });
    }


            function deleteSkine(categoryId)
            {
                   
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Deleted!",
                        text: "Your file has been deleted.",
                        icon: "success"
                    });
                }
            });
          }
</script>