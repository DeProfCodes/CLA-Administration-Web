@model CLA_Administration_Web.ViewModels.Settings.DesktopInformation.DesktopInformantionMainModel
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

<div class="container-fluid">
    @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel { SettingsCurrentPage = SettingsPages.DesktopInformation, HasAddNewButton = true, BreadcrumbButtonName = "Add New Desktop Info", BreadcrumbButtonCallbackFunction = "AddNewStagingEntity" });
    }

    <!-- Environment Selection -->
    <div class="mb-3">
        <div class="card mb-4 mt-2 overview-filters-card">
            <div class="card-body pt-0 pb-0">
                <div class="row align-items-center">
                    <!-- Filters Section -->
                    <div class="col-md-4 d-flex flex-column justify-content-center mb-2" id="StatusFilterContainer">
                        <p class="theme-txt-clr fw-bold text-center mb-1">Filters</p>
                        <div class="row mx-auto mt-1">
                            <p class="theme-txt-clr overview-filter-title2 text-center" id="TypeFilterTitle">Type</p>
                            <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                <button class="btn module-filter-btn-group filter-type-btn btn-group-active Screensaver" onclick="ToggleStaginLive(this.id)" id="Staging">Staging</button>
                                <button class="btn module-filter-btn-group filter-type-btn Screensaver" onclick="ToggleStaginLive(this.id)" id="Live">Live</button>
                            </div>
                        </div>
                    </div>

                                  <!-- Action Buttons Section -->
                    <div class="col-md-8 d-flex flex-column align-items-end mb-2" id="ModuleFilterActionButtonsContainer">
                        <p class="theme-txt-clr fw-bold text-center overview-filter-title2 " id="ModuleActionBtsFilterTitle">Action Buttons</p>
                        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                           
                            <button class="btn btn-sm btn-success" id="PromoteModuleBtn" onclick="OpenTargetedEntityPreviewModal('@SettingsNamesType.DesktopInformation', true)">Target Users</button>
                            <button class="btn btn-warning btn-sm" id="RepeatModuleBtn" onclick="OpenTargetingExposurePreviewModal('@SettingsNamesType.DesktopInformation')">Who is Targeted</button>
                          
                            <button class="btn btn-sm theme-bg text-white" id="DuplicateModuleBtn">Replicated To Live</button>
                            <button class="btn btn-sm btn-danger" id="RemoveModuleBtn" onclick="ApplyChanges()">Apply</button>
                           
                            <button class="btn btn-sm btn-primary" id="ScreensaverTransitionBtn">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Staging Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card h-100">
                <div class="card-body">

                    <!-- Staging Section -->
                    <div id="DesktopStaging">
                        <!-- Section Header -->
                        <p class="theme-txt-clr fw-bold text-center" id="SectionTitle">Staging Information</p>
                        <div class="row justify-content-center">
                            <!-- Info Position Section -->
                            <div class="col-md-6 d-flex flex-column align-items-center">
                                <p class="theme-txt-clr fw-bold text-center mb-3">Info Position</p>
                                <div class="grid-container justify-content-center">
                                    @foreach (var position in Model.positions[0].Positions)
                                    {
                                        var isActive = Model.positions[0].SelectedPosition == position ? "active" : "";
                                        <div class="popup-pos grid-item @isActive text-center"
                                             id="PopupPosition@(position.Replace(" ", string.Empty))"
                                             onclick="SetDesktopInformationData(this.id)">
                                            @position
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Information to Display Section -->
                            <div class="col-md-6 d-flex flex-column align-items-center">
                                <p class="theme-txt-clr fw-bold text-center mb-3">Information to Display</p>
                                <div class="row justify-content-center">
                                    @foreach (var checkbox in Model.positions[0].Checkboxes)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="@checkbox.Key.Replace(" ", string.Empty)" @(checkbox.Value ? "checked" : "")>
                                                <label class="form-check-label" for="@checkbox.Key.Replace(" ", string.Empty)">
                                                    @checkbox.Key
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Section-->
                    <div id="DesktopLive" class="d-none">
                        <!-- Section Header -->
                        <p class="theme-txt-clr fw-bold text-center" id="SectionTitle">Live Information</p>
                        <div class="row justify-content-center">
                            <!-- Info Position Section -->
                            <div class="col-md-6 d-flex flex-column align-items-center">
                                <p class="theme-txt-clr fw-bold text-center mb-3">Info Position</p>
                                <div class="grid-container justify-content-center">
                                    @foreach (var position in Model.positions[0].Positions)
                                    {
                                        var isActive = Model.positions[0].SelectedPosition == position ? "active" : "";
                                        <div class="popup-pos grid-item @isActive text-center"
                                             id="PopupPosition@(position.Replace(" ", string.Empty))"
                                             onclick="SetDesktopInformationData(this.id)">
                                            @position
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Information to Display Section -->
                            <div class="col-md-6 d-flex flex-column align-items-center">
                                <p class="theme-txt-clr fw-bold text-center mb-3">Information to Display</p>
                                <div class="row justify-content-center">
                                    @foreach (var checkbox in Model.positions[0].Checkboxes)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="@checkbox.Key.Replace(" ", string.Empty)" @(checkbox.Value ? "checked" : "")>
                                                <label class="form-check-label" for="@checkbox.Key.Replace(" ", string.Empty)">
                                                    @checkbox.Key
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
}

<script>
  
    let stagingPosition = "Top Left";
    let livePosition = "Center";

    function ToggleStaginLive(activeSection)
    {
        $(".filter-type-btn").removeClass("btn-group-active");
        $(`#${activeSection}`).addClass("btn-group-active");

        if (activeSection === "Staging")
        {
            $("#BreadcrumSettingsBtnText").text("Add New Live Information");
            $("#DesktopStaging").removeClass("d-none");
            $("#DesktopLive").addClass("d-none");

            setDefaultPositionToCenter(stagingPosition, `PopupPosition${stagingPosition.replace(" ", "")}`);
        }
        else if (activeSection === "Live")
        {
            $("#BreadcrumSettingsBtnText").text("Add New Staging Information");
            $("#DesktopStaging").addClass("d-none");
            $("#DesktopLive").removeClass("d-none");

            setDefaultPositionToCenter(livePosition, `PopupPosition${livePosition.replace(" ", "")}`);
        }
    }

    function setDefaultPositionToCenter(position, id)
    {
     
        $(".popup-pos").removeClass("active");

        const targetElement = $("#" + id);
        if (targetElement.length)
        {
            targetElement.addClass("active");
        }
        else {
            console.error(`Element with ID "${id}" not found. Position: ${position}`);
        }

        if ($("#DesktopStaging").is(":visible")) {
            stagingPosition = position;
        }
        else if ($("#DesktopLive").is(":visible"))
        {
            livePosition = position;
        }
    }

    function SetDesktopInformationData(id)
    {
     
        $(".grid-item").removeClass("active");

        const selectedElement = $("#" + id);
        selectedElement.addClass("active");

        const positionMap = {
            "PopupPositionTL": "Top Left",
            "PopupPositionTC": "Top Center",
            "PopupPositionTR": "Top Right",
            "PopupPositionML": "Middle Left",
            "PopupPositionC": "Center",
            "PopupPositionMR": "Middle Right",
            "PopupPositionBL": "Bottom Left",
            "PopupPositionBC": "Bottom Center",
            "PopupPositionBR": "Bottom Right"
        };

        const position = positionMap[id] || "Center";

        if ($("#DesktopStaging").is(":visible")) {
            stagingPosition = position;
        } else if ($("#DesktopLive").is(":visible")) {
            livePosition = position;
        }
    }

    function ApplyChanges()
    {
        swal("success", "Desktop information has been saved");
    }

    $(document).ready(function () {
       
        ToggleStaginLive("Staging");
    });

</script>
