@model CLA_Administration_Web.ViewModels.Settings.DefaultFonts.DefaultFontMainViewModel
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
    {
        SettingsCurrentPage = SettingsPages.DefaultFonts,
        HasAddNewButton = true,
        BreadcrumbButtonName = "Add New Default Fonts",
        BreadcrumbButtonCallbackFunction = "AddNewDefaultFonts"
    });
}

<div class="container-fluid">
    <!-- Settings Filter Component -->
    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1 mb-2">
                <H4 class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters To be Added</H4>
                
            </div>
        </div>
    </div>
</div>



<div class="container-fluid my-4 border p-3 rounded">
    @foreach (var data in Model.DefaultFonts) 
    {
        <div class="border p-3 mb-3">
            <h5 class="text-center">
               <span>@data.DefaultHeading</span>
            </h5>

            @if (data.SubHeadings != null && data.SubHeadings.Any())
            {
                @foreach (var subheading in data.SubHeadings)
                {
                    <div class="row mb-3 align-items-center fs-14">
                        <div class="col-1 text-center fs-14">
                            <span data-sub="@subheading.SubId" style="cursor: pointer;" onclick=" EditNewStagingEnting(@subheading.SubId)">
                                <img src="@subheading.Icon" alt="Icon" />
                            </span>
                        </div>
                        <div class="col-4 fs-14">
                            <label for="subheadingTitle_@subheading.SubId" class="form-label">@subheading.Title</label>
                        </div>
                        <div class="col-7 fs-14">
                            <div class="form-control" style="border: none; background-color: gray;">
                                @subheading.Text
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<div id="details-section" class="mt-4"></div>


<!-- Add New Default fonts Modal -->
<div class="modal fade" id="DefaultfontsModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Staging User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingUserModal')"></button>
            </div>
            <div class="modal-body">
                <form id="CreateStagingUserForm">
                    <div class="mb-3">
                        <label for="StagingUserDomain" class="form-label">Module Name</label>
                        <select class="form-select" id="StagingUserDomain" required>
                            <option value="">Please select a Module</option>
                           
                            @foreach(var data in Model.DefaultFonts)
                            {
                            <option value="@data.DefaultHeading">@data.DefaultHeading</option>
                            }
                        </select>
                    </div>           

                    <div class="mb-3">
                        <label for="StagingUserUsername" class="form-label">Title</label>
                        <input type="text" class="form-control" id="StagingUserUsername" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserFirstname" class="form-label">Description</label>
                        <input type="text" class="form-control" id="StagingUserFirstname" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserLastname" class="form-label">Font Size</label>
                        <input type="text" class="form-control" id="StagingUserLastname" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserUserLastModified" class="form-label">Font Family</label>
                        <input type="text" class="form-control" id="StagingUserUserLastModified">
                    </div>
                    <div class="mb-3">
                            <label for="StagingUserMachineLastModified" class="form-label">FontWeight</label>
                        <input type="text" class="form-control" id="StagingUserMachineLastModified">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingUserModal')">Cancel</button>
                <button type="button" class="btn  custom-btn-default" onclick="SaveModal('DefaultfontsModal', 'Successfuly save fonts')">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Default fonts Modal -->
<div class="modal fade" id="EditDefaultFontsModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Edit Staging Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('EditModal')"></button>
            </div>
            <div class="modal-body" id="EditModalContainer">
                <!-- Dynamic content for the modal goes here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('EditModal')">Cancel</button>
                <button type="button" class="btn custom-btn-default" onclick="SaveModal('EditDefaultFontsModal', 'Default fonts saved successfully!' )">Save User</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    function Test(subId) {
        OpenPage('@SettingsPages.DefaultFontsDetails', subId)
    }

  
    function AddNewDefaultFonts()
    {
        const buttonText = document.getElementById("BreadcrumSettingsBtnText").innerText;
        const userModal = new bootstrap.Modal(document.getElementById('DefaultfontsModal'));
        userModal.show();
   
    }

    function EditNewStagingEnting(SubId)
    {
        // LoadEditModal(formData, '@Url.Action("EditStagingMachine", "Settings")', 'POST', editMachineForm, edit-machine-btn)
        $.ajax({
            url: '@Url.Action("DefaultFontsDetails", "Settings")',
            type: 'GET',
            data: { SubId: SubId },
            success: function (response)
            {
                console.log(response)
                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditDefaultFontsModal'));
                editModal.show();

            },
            error: function (error)
            {
                console.log('Error fetching machine data:', error);
            }
        });
    }
 
    $(document).ready(function () {
        // Handle button click for details
        $('.details-button').click(function () {
            var id = $(this).data('sub'); 

            OpenPage('@SettingsPages.DefaultFontsDetails', subId)
            // AJAX call to fetch details
         
        });
    });



    function SaveModal(modalId, successMessage)
    {
        closeModal(modalId); 
        setTimeout(() => {
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: successMessage,
                showConfirmButton: false,
                timer: 1500
            });
        }, 300); 
    }


    function closeModal(modalId)
    {

        const modalElement = document.getElementById(modalId);
        if (modalElement) {
            const bootstrapModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
            bootstrapModal.hide();
        } else {
            console.error(`Modal with ID "${modalId}" not found.`);
        }
    }


    // function closeModal(modalId) {
    //     $('#' + modalId).modal('hide');
    // }

</script>