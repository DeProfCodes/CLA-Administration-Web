@model SetupExclusionsMainViewModel
@using CLA_Administration_Web.ViewModels.Targeting
@using CLA_Administration_Web.ViewModels.Shared
@{
int index = 0;

var usersDomains = Model.Users.Select(x => x.Domain).Distinct().ToList();
var machinesDomains = Model.Machines.Select(x => x.Domain).Distinct().ToList();
var users = Model.Users.Select(x => x.UserLastModified).Distinct().ToList();
}

<div class="container-fluid">

<!-- Breadcrumb Component -->
@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
    {
        SettingsCurrentPage = SettingsPages.SetupExclusions,
        HasAddNewButton = true,
        BreadcrumbButtonName = "Add Exclusion User",
        BreadcrumbButtonCallbackFunction = "AddNewExcludedEntity"
    });
}

<!-- Settings Filter Component -->
<div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
    <div class="card-body pt-0 pb-0">
        <div class="row fs-12 mt-1 mb-2">
            <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
            <div class="row col-12 d-flex flex-wrap module-overview-filters">
                <div class="w-fit-content ms-auto mb-1">
                    <div class="d-flex">
                        <p class="custom-p w-fit-content align-content-center">View Type</p>
                        <div class="row mx-auto">
                            <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                <button class="btn module-filter-btn-group filter-type-btn btn-group-active" onclick="ToggleStaginUserMachines(this.id)" id="StagingUserBtn">Users</button>
                                <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">Machines</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-auto me-auto mb-1">
                    <div class="d-flex">
                        <p class="custom-p w-fit-content align-content-center">Domain</p>
                        <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                            <option value="0">Please select Domain Name</option>
                            @foreach (var domain in usersDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Card for Popup Report Body -->
<div class="card mb-1 mt-1  p-4 overview-filters-card app-card-main-scaling" id="report-data-area">
    <div id="SettingsData">
        <h3 class="w-100 text-center theme-txt-clr">
            Setup Exclusion <span id="StagingUserMachineTitle">Users</span>
        </h3>
        <!-- Inject Partial Here -->
        <div id="StagingUsersSettings" class="mt-3">
            <table id="StagingUsersData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                <thead>
                    <tr>
                        <th class="theme-bg text-white">UserID</th>
                        <th class="theme-bg text-white">Domain</th>
                        <th class="theme-bg text-white">NT Username</th>
                        <th class="theme-bg text-white">Firstname</th>
                        <th class="theme-bg text-white">Surname</th>
                        <th class="theme-bg text-white">User Last Modified</th>
                        <th class="theme-bg text-white">Machine Last Modified</th>
                        <th class="theme-bg text-white">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var User in Model.Users)
                    {
                        var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                        cssBg += " theme-txt-clr";

                        <tr>
                            <td class="@cssBg">@User.Id</td>
                            <td class="@cssBg">@User.Domain</td>
                            <td class="@cssBg">@User.Username</td>
                            <td class="@cssBg">@User.Firstname</td>
                            <td class="@cssBg">@User.Lastname</td>
                            <td class="@cssBg">@User.UserLastModified</td>
                            <td class="@cssBg">@User.MachineLastModified</td>
                            <td class="@cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-danger" onclick=" DeleteExistingUser(@User.Id)">Delete</button>
                                <button class="btn btn-sm custom-btn-sm btn-success" onclick="EditSetupExclusions(@User.Id,'User')">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="StagingMachinesSettings" class="mt-3 hidden">
            <table id="StagingMachinesData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                <thead>
                    <tr>
                        <th class="theme-bg text-white">MachineID</th>
                        <th class="theme-bg text-white">Domain</th>
                        <th class="theme-bg text-white">Machine Name</th>
                        <th class="theme-bg text-white">Machine Description</th>
                        <th class="theme-bg text-white">User Last Modified</th>
                        <th class="theme-bg text-white">Machine Last Modified</th>
                        <th class="theme-bg text-white">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Machine in Model.Machines)
                    {
                        var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                        cssBg += " theme-txt-clr";
  
                        <tr>
                            <td class="@cssBg">@Machine.Id</td>
                            <td class="@cssBg">@Machine.Domain</td>
                            <td class="@cssBg">@Machine.MachineName</td>
                            <td class="@cssBg">@Machine.MachineDescription</td>
                            <td class="@cssBg">@Machine.UserLastModified</td>
                            <td class="@cssBg">@Machine.MachineLastModified</td>
                            <td class="@cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-danger" onclick=" DeleteExistingUser(@Machine.Id)">Delete</button>
                                <button class="btn btn-sm custom-btn-sm btn-success" onclick="EditSetupExclusions(@Machine.Id, 'Machine')">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>




  


<!-- Create New Staging Machine Modal -->
<div class="modal fade" id="CreateStagingMachineModalss" tabindex="-1" aria-labelledby="CreateStagingMachineModalLabel" aria-hidden="true">
<div class="modal-dialog modal-lg">
