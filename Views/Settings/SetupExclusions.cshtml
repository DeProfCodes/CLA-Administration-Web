<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>






var usersDomains = @Html.Raw(Json.Serialize(usersDomains));
var machinesDomains = @Html.Raw(Json.Serialize(machinesDomains));

$(document).ready(function ()
{
    usersDT = MakeStandardDataTable("StagingUsersData");
    machinesDT = MakeStandardDataTable("StagingMachinesData");
});

function ToggleStaginUserMachines(id)
{
    $(".filter-type-btn").removeClass("btn-group-active");
    $(`#${id}`).addClass("btn-group-active");

    if(id.includes("User"))
    {
        $("#BreadcrumSettingsBtnText").text("Add New Staging User");
        $("#StagingUserMachineTitle").text("Users");
        HideShowElement("#StagingUsersSettings", HideShow.SHOW);
        HideShowElement("#StagingMachinesSettings", HideShow.HIDE);
        SwitchDomainsSelectDataSource(usersDomains);
    }
    else if (id.includes("Machine"))
    {
        $("#BreadcrumSettingsBtnText").text("Add New Staging Machine");
        $("#StagingUserMachineTitle").text("Machines");
        HideShowElement("#StagingUsersSettings", HideShow.HIDE);
        HideShowElement("#StagingMachinesSettings", HideShow.SHOW);
        SwitchDomainsSelectDataSource(machinesDomains);
    }
}

function SwitchDomainsSelectDataSource(dataSource)
{
    const selectList = document.getElementById("ReportModuleSelect");

    selectList.innerHTML = "";

    const defaultOption = document.createElement("option");
    defaultOption.value = "0";
    defaultOption.textContent = "Please select Domain Name";
    selectList.appendChild(defaultOption);

    dataSource.forEach(domain =>
    {
        const option = document.createElement("option");
        option.value = domain;
        option.textContent = domain;
        selectList.appendChild(option);
    });
}

function FilterByDomain()
{
    const selectedDomain = $("#ReportModuleSelect").val();

    var userActive = $("#StagingUserBtn").hasClass("btn-group-active");

    if (selectedDomain === "0")
    {
        if (userActive)
            usersDT.column(0).search("").draw();
        else
            machinesDT.column(0).search("").draw();
    }
    else
    {
        if (userActive)
            usersDT.column(0).search(selectedDomain).draw();
        else
            machinesDT.column(0).search(selectedDomain).draw();
    }
}

function AddNewExcludedEntity()
{
    const buttonText = document.getElementById("BreadcrumSettingsBtnText").innerText;

    if (buttonText.includes("User"))
    {
        const userModal = new bootstrap.Modal(document.getElementById('CreateStagingUserModal'));
        userModal.show();
        var backdrop = document.querySelector('.modal-backdrop');
        if (backdrop) {
               
            backdrop.style.position = 'relative'
        }
    } 
    else if (buttonText.includes("Machine"))
    {
        const machineModal = new bootstrap.Modal(document.getElementById('CreateStagingMachineModal'));
        machineModal.show();
    }
}

function EditSetupExclusions(machineId, entityType)
{

    formdata = 
    {
        machineId: machineId,
        entityType: entityType
    }

    $.ajax({
        url: '@Url.Action("EditSetupExclusions", "Settings")',
        type: 'GET',
        data: formdata,
        success: function (response)
        {
            console.log(response)
            $('#EditModalContainer').html(response);
            const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
            editModal.show();

        },
        error: function (error) 
        {
            console.log('Error fetching machine data:', error);
        }
    });
    
    // const formData = {
    //      "machineId": machineId,
    //      "entityType": entityType
    //  };

    // dynamicAjaxRequest(formData, "GET", '@Url.Action("EditSetupExclusions", "Settings")', 'EditModalContainer', 'EditModal');
}

 
function SaveEditNewStagingEnting(formdata)
{

    LoadEditModal(formData, '@Url.Action("SaveStagingData", "Settings")', 'POST', editMachineForm, edit - machine - btn)
}

    
function DeleteExistingUser(customID)

{

    Swal.fire({
        title: 'Are you sure you want to delete user '+ customID + '?',
        text: "You won't be able to undo this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'No, cancel!'
    }).then((result) => {
        if (result.isConfirmed)
        {

            Swal.fire(
                'Deleted!',
                'The user has been deleted.',
                'success'
            );
        }
        else
        {

            Swal.fire(
                'Cancelled',
                'The user is safe.',
                'info'
            );
        }
    });
}



    
function openUserModal(triggerInput, modal1Id, modal2Id)
{
    const modal1 = document.getElementById(modal1Id);
    const modal2 = document.getElementById(modal2Id);

    if (!modal1 || !modal2) {
        console.error("Modal IDs provided do not exist.");
        return;
    }
    const modalInstance2 = new bootstrap.Modal(modal2);
    modalInstance2.show();
}

function closeModal(modalId)
{
    const modalElement = document.getElementById(modalId);
    if (modalElement) {
        const modal = bootstrap.Modal.getInstance(modalElement);
        if (modal) modal.hide();
    }
}

$(document).ready(function ()
{

     
    const userTable = $('#userTable').DataTable({
        paging: true,
        searching: true,
        info: true,
        responsive: true,
    });

    const machineTable = $('#MachineTable').DataTable({
        paging: true,
        searching: true,
        info: true,
        responsive: true,
    });


        $("#searchButton").click(function () {
            const searchTerm = $('#searchInput').val();
            performAjaxRequest(
                '@Url.Action("SearchOrFetchAllUsers", "Settings")', 
                'GET',
                { searchTerm }, 
                function (data) {
                    populateTable(data, 'user');
                },
                function () { 
                    alert("An error occurred while fetching data.");
                }
            );
        });



        $("#searchMachineButton").click(function () {
            const searchTerm = $('#searchMachineInput').val();
            performAjaxRequest(
                '@Url.Action("SearchOrFetchAllMachines", "Settings")', 
                'GET', 
                { searchTerm },
                function (data) { 
                    console.log(data);
                    populateTable(data, 'machine');
                },
                function () { 
                    alert("An error occurred while fetching data.");
                }
            );
        });



        function populateTable(data, type) {
            const tbody = (type === 'user') ? $("#userTable tbody") : $("#MachineTable tbody");
            tbody.empty();

            if (data && data.length > 0) {
                data.forEach(item => {
                    const row = (type === 'user') ?
                        `<tr data-user-id="${item.id}">
                        <td>${item.id}</td>
                        <td>${item.username}</td>
                        <td>${item.firstname}</td>
                        <td>${item.lastname}</td>
                    </tr>` :
                        `<tr data-machine-id="${item.id}">
                        <td>${item.machineName}</td>
                            <td>${item.machineDescription}</td>
                   
                    
                    </tr>`;
                    tbody.append(row);
                });
            } else {
                tbody.append("<tr><td colspan='4'>No records found.</td></tr>");
            }
        }

   

});

function confirmSelection() 
{
    const selectedUser = document.querySelector('#userTable tbody tr.selected');
    const selectedMachine = document.querySelector('#MachineTable tbody tr.selected');

    if (selectedUser)
    {
        const username = selectedUser.querySelector('td:nth-child(2)').textContent;
        const firstname = selectedUser.querySelector('td:nth-child(3)').textContent;
        const lastname = selectedUser.querySelector('td:nth-child(4)').textContent;


            document.getElementById('NTUsername').value = username;
            document.getElementById('StagingUserFirstname').value = firstname;
            document.getElementById('StagingUserLastname').value = lastname;

        closeModal('UsersModals');
    }
    else if (selectedMachine) 
    {
        const machineName = selectedMachine.querySelector('td:nth-child(1)').textContent;
        const machineDescription = selectedMachine.querySelector('td:nth-child(2)').textContent;


            document.getElementById('StagingMachinename').value = machineName;
            document.getElementById('StagingMachineDescription').value = machineDescription;

        closeModal('MachineModals');
    } else {
        alert('Please select a user or machine first!');
    }
}

function selectRow(row, table)
{
    const rows = table === 'user' ? document.querySelectorAll('#userTable tbody tr') : document.querySelectorAll('#MachineTable tbody tr');
    rows.forEach(r => r.classList.remove('selected'));
    row.classList.add('selected');
}

document.querySelector('#userTable tbody').addEventListener('click', function (e)
{
    const row = e.target.closest('tr');
    if (row) selectRow(row, 'user');
});

document.querySelector('#MachineTable tbody').addEventListener('click', function (e)
{
    const row = e.target.closest('tr');
    if (row) selectRow(row, 'machine');
});


    function performAjaxRequest(url, type, data, successCallback, errorCallback) {
        $.ajax({
            url: url,
            type: type,
            data: data,
            success: function (response) {
                if (successCallback) {
                    successCallback(response);
                }
            },
            error: function (error) {
                if (errorCallback) {
                    errorCallback(error);
                }
            }
        });
    }



</script>