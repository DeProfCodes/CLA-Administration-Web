@model SetupExclusionsMainViewModel
@using CLA_Administration_Web.ViewModels.Targeting
@using CLA_Administration_Web.ViewModels.Shared
@{
    int index = 0;

    var usersDomains = Model.Users.Select(x => x.Domain).Distinct().ToList();
    var machinesDomains = Model.Machines.Select(x => x.Domain).Distinct().ToList();
    var users = Model.Users.Select(x => x.UserLastModified).Distinct().ToList();
}

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
        {
            SettingsCurrentPage = SettingsPages.SetupExclusions,
            HasAddNewButton = true,
            BreadcrumbButtonName = "Add Excluded User",
            BreadcrumbButtonCallbackFunction = "AddNewExcludedEntity"
        });
    }

    <!-- Settings Filter Component -->
    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1 mb-2">
                <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
                <div class="row col-12 d-flex flex-wrap module-overview-filters">
                    <div class="w-fit-content ms-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">View Type</p>
                            <div class="row mx-auto">
                                <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                    <button class="btn module-filter-btn-group filter-type-btn btn-group-active" onclick="ToggleStaginUserMachines(this.id)" id="StagingUserBtn">Users</button>
                                    <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">Machines</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-auto me-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">Domain</p>
                            <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                                <option value="0">Please select Domain Name</option>
                                @foreach (var domain in usersDomains)
                                {
                                    <option value="@domain">@domain</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card for Popup Report Body -->
    <div class="card mb-1 mt-1  p-4 overview-filters-card app-card-main-scaling" id="report-data-area">
        <div id="SettingsData">
            <h3 class="w-100 text-center theme-txt-clr">
                Setup Excluded <span id="StagingUserMachineTitle">Users</span>
            </h3>
            <!-- Inject Partial Here -->
            <div id="StagingUsersSettings" class="mt-3">
                <table id="StagingUsersData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                    <thead>
                        <tr>
                            <th class="theme-bg text-white">UserID</th>
                            <th class="theme-bg text-white">Domain</th>
                            <th class="theme-bg text-white">NT Username</th>
                            <th class="theme-bg text-white">Firstname</th>
                            <th class="theme-bg text-white">Surname</th>
                            <th class="theme-bg text-white">User Last Modified</th>
                            <th class="theme-bg text-white">Machine Last Modified</th>
                            <th class="theme-bg text-white">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var User in Model.Users)
                        {
                            var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                            cssBg += " theme-txt-clr";

                            <tr>
                                <td class="@cssBg">@User.Id</td>
                                <td class="@cssBg">@User.Domain</td>
                                <td class="@cssBg">@User.Username</td>
                                <td class="@cssBg">@User.Firstname</td>
                                <td class="@cssBg">@User.Lastname</td>
                                <td class="@cssBg">@User.UserLastModified</td>
                                <td class="@cssBg">@User.MachineLastModified</td>
                                <td class="@cssBg">
                                    <button class="btn btn-sm custom-btn-sm btn-danger" onclick=" DeleteExistingUser(@User.Id)">Delete</button>
                                    <button class="btn btn-sm custom-btn-sm btn-success" onclick="EditSetupExclusions(@User.Id,'User')">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="StagingMachinesSettings" class="mt-3 hidden">
                <table id="StagingMachinesData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                    <thead>
                        <tr>
                            <th class="theme-bg text-white">MachineID</th>
                            <th class="theme-bg text-white">Domain</th>
                            <th class="theme-bg text-white">Machine Name</th>
                            <th class="theme-bg text-white">Machine Description</th>
                            <th class="theme-bg text-white">User Last Modified</th>
                            <th class="theme-bg text-white">Machine Last Modified</th>
                            <th class="theme-bg text-white">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var Machine in Model.Machines)
                        {
                            var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                            cssBg += " theme-txt-clr";
  
                            <tr>
                                <td class="@cssBg">@Machine.Id</td>
                                <td class="@cssBg">@Machine.Domain</td>
                                <td class="@cssBg">@Machine.MachineName</td>
                                <td class="@cssBg">@Machine.MachineDescription</td>
                                <td class="@cssBg">@Machine.UserLastModified</td>
                                <td class="@cssBg">@Machine.MachineLastModified</td>
                                <td class="@cssBg">
                                    <button class="btn btn-sm custom-btn-sm btn-danger" onclick=" DeleteExistingUser(@Machine.Id)">Delete</button>
                                    <button class="btn btn-sm custom-btn-sm btn-success" onclick="EditSetupExclusions(@Machine.Id, 'Machine')">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>



@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Modal/_UserSelectionModal.cshtml", new ModalViewModel
            {
                ModalTitle = "Select Usersssssssss",
                TargetedEntities = Model.TargetedEntities,
                CallbackFunction = "handleUserSelection"
            });
}


<!-- Create New Staging User Modal -->
<div class="modal fade" id="CreateStagingUserModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Staging User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingUserModal')"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="SelectUser" class="form-label">Select User</label>
                    <button class="btn btn-secondary"
                            type="button"
                            id="StagingUserBtn"
                            data-callback="updateStagingMachineFields"
                            data-lastmodified-field="StagingUserUserLastModified"
                            onclick=" openTreeViewModal(this,'UsersModal', 'CreateStagingUserModal')">
                        Select User
                    </button>
                </div>
                <div class="mb-3">
                    <label for="StagingUserDomain" class="form-label">Domain</label>
                    <select class="form-control" id="StagingUserDomain" required>
                        <option value="">Please select a domain</option>
                        @foreach (var domain in usersDomains)
                        {
                            <option value="@domain">@domain</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="StagingUserFirstname" class="form-label">First Name</label>
                    <input type="text" class="form-control" id="StagingUserFirstname" required>
                </div>
                <div class="mb-3">
                    <label for="StagingUserLastname" class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="StagingUserLastname" required>
                </div>
                <div class="mb-3">
                    <label for="StagingUserUserLastModified" class="form-label">User Last Modified</label>
                    <input type="text" class="form-control" id="StagingUserUserLastModified">
                </div>
                <div class="mb-3">
                    <label for="StagingUserMachineLastModified" class="form-label">Machine Last Modified</label>
                    <input type="text" class="form-control" id="StagingUserMachineLastModified">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingUserModal')">Cancel</button>
                <button type="button" class="btn custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>

<!-- Create New Staging Machine Modal -->
<div class="modal fade" id="CreateStagingMachineModal" tabindex="-1" aria-labelledby="CreateStagingMachineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingMachineModalLabel">Add New Staging Machine</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingMachineModal')"></button>
            </div>
            <div class="modal-body">
                <form id="CreateStagingMachineForm">
                    <div class="mb-3">
                        <label for="StagingUserDomain" class="form-label">Domain</label>
                        <select class="form-select" id="StagingUserDomain" required>
                            <option value="">Please select a domain</option>
                            @foreach (var domain in usersDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="StagingMachinename" class="form-label">Machine Name</label>
                        <input type="text" class="form-control" id="StagingMachinename" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingMachineDescription" class="form-label">Machine Description</label>
                        <input type="text" class="form-control" id="StagingMachineDescription" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserUserLastModified" class="form-label">User Last Modified</label>
                        <input type="text" class="form-control" id="StagingUserUserLastModified" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingMachineLastModified" class="form-label">Machine Last Modified</label>
                        <input type="datetime-local" class="form-control" id="StagingMachineLastModified">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingMachineModal')">Cancel</button>
                <button type="button" class="btn custom-btn-default" onclick="SaveStagingMachine()">Save Machine</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Staging Modal -->
<div class="modal fade" id="EditModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Edit Staging Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('EditModal')"></button>
            </div>
            <div class="modal-body" id="EditModalContainer">
                <!-- Dynamic content for the modal goes here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('EditModal')">Cancel</button>
                <button type="button" class="btn custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>



    function handleUserSelection(selectedUsers, selectedGroups, selectedMachines, selectedIpRanges) {
        console.log("Callback executed!");
        console.log("Selected Users: ", selectedUsers);
        console.log("Selected Groups: ", selectedGroups);
        console.log("Selected Machines: ", selectedMachines);
        console.log("Selected IP Ranges: ", selectedIpRanges);

        Swal("Saved users", "success");
    }


    function closeModal(modalId) {
        var modal = document.getElementById(modalId);
        var backdrop = document.querySelector('.modal-backdrop');

        modal.style.display = 'none';

        if (backdrop) {
            backdrop.style.display = 'none'; 
        }
    }



    function openTreeViewModal(triggerButton, modal1Id, modal2Id) {
     
        var modal1 = document.getElementById(modal1Id);
        var modal2 = document.getElementById(modal2Id);  

        // Ensure modal1 (second modal) is fully visible
        modal1.style.display = 'block';
        modal1.style.opacity = '1';
        modal1.style.zIndex = '1055';

        // Ensure modal2 (main modal) is beneath modal1
        modal2.style.zIndex = '0';

      
        var backdrop = document.querySelector('.modal-backdrop');
        if (backdrop) {
            backdrop.style.zIndex = '0'; 
            backdrop.style.opacity = '0'; 
        }

     
        const lastModifiedField = triggerButton.getAttribute('data-lastmodified-field');
        const callbackFunction = triggerButton.getAttribute('data-callback');

       
        window.selectedFields = {
            lastModifiedField,
            callbackFunction,
        };
    }

    function closeUsersModal() {
        var usersModal = document.getElementById('UsersModal');
        var mainModal = document.getElementById('CreateStagingUserModal');

 
        usersModal.style.display = 'none';

        
        mainModal.style.zIndex = '1050'; 
        usersModal.style.zIndex = '0';
        usersModal.style.opacity = '0';

        var backdrop = document.querySelector('.modal-backdrop');
        if (backdrop) {
            backdrop.style.zIndex = '1040'; 
           backdrop.style.position = 'relative'
        }
    }



    var usersDomains = @Html.Raw(Json.Serialize(usersDomains));
    var machinesDomains = @Html.Raw(Json.Serialize(machinesDomains));

    $(document).ready(function ()
    {
        usersDT = MakeStandardDataTable("StagingUsersData");
        machinesDT = MakeStandardDataTable("StagingMachinesData");
    });

    function ToggleStaginUserMachines(id)
    {
        $(".filter-type-btn").removeClass("btn-group-active");
        $(`#${id}`).addClass("btn-group-active");

        if(id.includes("User"))
        {
            $("#BreadcrumSettingsBtnText").text("Add New Staging User");
            $("#StagingUserMachineTitle").text("Users");
            HideShowElement("#StagingUsersSettings", HideShow.SHOW);
            HideShowElement("#StagingMachinesSettings", HideShow.HIDE);
            SwitchDomainsSelectDataSource(usersDomains);
        }
        else if (id.includes("Machine"))
        {
            $("#BreadcrumSettingsBtnText").text("Add New Staging Machine");
            $("#StagingUserMachineTitle").text("Machines");
            HideShowElement("#StagingUsersSettings", HideShow.HIDE);
            HideShowElement("#StagingMachinesSettings", HideShow.SHOW);
            SwitchDomainsSelectDataSource(machinesDomains);
        }
    }

    function SwitchDomainsSelectDataSource(dataSource)
    {
        const selectList = document.getElementById("ReportModuleSelect");

        selectList.innerHTML = "";

        const defaultOption = document.createElement("option");
        defaultOption.value = "0";
        defaultOption.textContent = "Please select Domain Name";
        selectList.appendChild(defaultOption);

        dataSource.forEach(domain =>
        {
            const option = document.createElement("option");
            option.value = domain;
            option.textContent = domain;
            selectList.appendChild(option);
        });
    }

    function FilterByDomain()
    {
        const selectedDomain = $("#ReportModuleSelect").val();

        var userActive = $("#StagingUserBtn").hasClass("btn-group-active");

        if (selectedDomain === "0")
        {
            if (userActive)
                usersDT.column(0).search("").draw();
            else
                machinesDT.column(0).search("").draw();
        }
        else
        {
            if (userActive)
                usersDT.column(0).search(selectedDomain).draw();
            else
                machinesDT.column(0).search(selectedDomain).draw();
        }
    }

    function AddNewExcludedEntity()
    {
        const buttonText = document.getElementById("BreadcrumSettingsBtnText").innerText;

        if (buttonText.includes("User"))
        {
            const userModal = new bootstrap.Modal(document.getElementById('CreateStagingUserModal'));
            userModal.show();
            var backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) {
               
                backdrop.style.position = 'relative'
            }
        } 
        else if (buttonText.includes("Machine"))
        {
            const machineModal = new bootstrap.Modal(document.getElementById('CreateStagingMachineModal'));
            machineModal.show();
        }
    }

    function EditSetupExclusions(machineId, entityType)
    {

        formdata = 
        {
            machineId: machineId,
            entityType: entityType
        }

        $.ajax({
            url: '@Url.Action("EditSetupExclusions", "Settings")',
            type: 'GET',
            data: formdata,
            success: function (response)
            {
                console.log(response)
                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
                editModal.show();

            },
            error: function (error) 
            {
                console.log('Error fetching machine data:', error);
            }
        });
    
       // const formData = {
      //      "machineId": machineId,
      //      "entityType": entityType
      //  };

      // dynamicAjaxRequest(formData, "GET", '@Url.Action("EditSetupExclusions", "Settings")', 'EditModalContainer', 'EditModal');
    }

 
    function SaveEditNewStagingEnting(formdata)
    {

        LoadEditModal(formData, '@Url.Action("SaveStagingData", "Settings")', 'POST', editMachineForm, edit - machine - btn)
    }

    
    function DeleteExistingUser(customID)

    {

        Swal.fire({
            title: 'Are you sure you want to delete user '+ customID + '?',
            text: "You won't be able to undo this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!'
        }).then((result) => {
            if (result.isConfirmed)
            {

                Swal.fire(
                    'Deleted!',
                    'The user has been deleted.',
                    'success'
                );
            }
            else
            {

                Swal.fire(
                    'Cancelled',
                    'The user is safe.',
                    'info'
                );
            }
        });
    }
</script>