                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="desktopWrite" class="form-label">Desktop Write</label>
                            <select class="form-select form-control" id="desktopWrite">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="desktopReport" class="form-label">Desktop Report</label>
                            <select class="form-select form-control" id="desktopReport">
                                <option value="Enabled">Enabled</option>
                                <option value="Disabled">Disabled</option>
                            </select>
                        </div>
                        <!-- Tickers Permissions -->
                        <div class="col-md-4">
                            <label for="tickersEnvironment" class="form-label">Tickers Environment</label>
                            <input type="text" class="form-control" id="tickersEnvironment" value="TickersEnv1">
                        </div>
                        <div class="col-md-4">
                            <label for="tickersRead" class="form-label">Tickers Read</label>
                            <select class="form-select form-control" id="tickersRead">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="tickersWrite" class="form-label">Tickers Write</label>
                            <select class="form-select form-control" id="tickersWrite">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="tickersReport" class="form-label">Tickers Report</label>
                            <select class="form-select form-control" id="tickersReport">
                                <option value="Enabled">Enabled</option>
                                <option value="Disabled">Disabled</option>
                            </select>
                        </div>
                        <!-- RSS Permissions -->
                        <div class="col-md-4">
                            <label for="rssEnvironment" class="form-label">RSS Environment</label>
                            <input type="text" class="form-control" id="rssEnvironment" value="RSS_Env3">
                        </div>
                        <div class="col-md-4">
                            <label for="rssRead" class="form-label">RSS Read</label>
                            <select class="form-select form-control" id="rssRead">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="rssWrite" class="form-label">RSS Write</label>
                            <select class="form-select form-control" id="rssWrite">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="rssReport" class="form-label">RSS Report</label>
                            <select class="form-select form-control" id="rssReport">
                                <option value="Enabled">Enabled</option>
                                <option value="Disabled">Disabled</option>
                            </select>
                        </div>
                        <!-- Lockscreen Permissions -->
                        <div class="col-md-4">
                            <label for="lockscreenEnvironment" class="form-label">Lockscreen Environment</label>
                            <input type="text" class="form-control" id="lockscreenEnvironment" value="LockscreenEnv4">
                        </div>
                        <div class="col-md-4">
                            <label for="lockscreenRead" class="form-label">Lockscreen Read</label>
                            <select class="form-select form-control" id="lockscreenRead">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="lockscreenWrite" class="form-label">Lockscreen Write</label>
                            <select class="form-select form-control" id="lockscreenWrite">
                                <option value="Allowed">Allowed</option>
                                <option value="Restricted">Restricted</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="lockscreenReport" class="form-label">Lockscreen Report</label>
                            <select class="form-select form-control" id="lockscreenReport">
                                <option value="Enabled">Enabled</option>
                                <option value="Disabled">Disabled</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Save User</button>
            </div>
        </div>
    </div>
</div>
<!-- Second Modal -->
<div class="modal fade" id="directoryModal" tabindex="-1" aria-labelledby="directoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="directoryModalLabel">Select a User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-bordered-section">
                    <label for="filterInput" class="section-title-tree">Filter:</label>
                    <div class="d-flex">
                        <input type="text" id="filterInputMember" class="form-control filter-input" placeholder="Search..." oninput="filterTree()">
                        <button class="btn btn-secondary ms-2">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div class="scroll-box treeview mt-3">
                        <ul id="directoryTree" class="tree-view">
                            <li>
                                <span class="tree-toggle">
                                    <i class="bi bi-folder"></i> Active Directory Objects
                                </span>
                                <ul class="tree-content">
                                    <li>
                                        <span class="tree-toggle">
                                            <i class="bi bi-people"></i> Groups
                                        </span>
                                        <ul class="tree-content">
                                            <li class="option-item">Admins</li>
                                            <li class="option-item">Developers</li>
                                            <li class="option-item">HR</li>
                                        </ul>
                                    </li>
                                    <li>
                                        <span class="tree-toggle">
                                            <i class="bi bi-person"></i> Users
                                        </span>
                                        <ul class="tree-content">
                                            <li class="option-item" data-username="nhlamulo" onclick="">nhlamulo</li>
                                            <li class="option-item" data-username="jane_smith">Jane Smith</li>
                                            <li class="option-item" data-username="john_doe">John Doe</li>
                                        </ul>
                                    </li>
                                    <li>
                                        <span class="tree-toggle">
                                            <i class="bi bi-laptop"></i> Machines
                                        </span>
                                        <ul class="tree-content">
                                            <li class="option-item">Server-1</li>
                                            <li class="option-item">Workstation-5</li>
                                        </ul>
                                    </li>
                                    <li>
                                        <span class="tree-toggle">
                                            <i class="bi bi-globe"></i> IP Ranges
                                        </span>
                                        <ul class="tree-content">
                                            <li class="option-item">192.168.0.0/24</li>
                                            <li class="option-item">10.0.0.0/8</li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAndCloseDirectoryModal()">Save</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="EditModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Admin Access Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('EditModal')"></button>
            </div>
            <div class="modal-body" id="EditModalContainer"></div>
            <div class="modal-footer">
                <button type="button" class="btn custom-btn  btn-secondary" data-bs-dismiss="modal" onclick="closeModal('EditModal')">Cancel</button>
                <button type="button" class="custom-btn  custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<style>
    .sticky-action-column {
        position: sticky;
        right: 0;
        background-color: dimgray;
        z-index: 2;
    }

    .form-select {
        width: 100%;
    }

    .option-item {
        cursor: pointer;
        padding: 5px;
    }

        .option-item.active {
            background-color: #04316d;
            color: #fff;
            border-radius: 4px;
        }


        .option-item:hover {
            background-color: #f1f1f1;
            color: black;
        }
</style>
<script>

    (() => {
   
        const firstModal = document.getElementById('CreateStagingUserModal');
        const secondModal = document.getElementById('directoryModal');


        function AddNewAdminUser()
        {
            const usersModal = new bootstrap.Modal(firstModal);
            usersModal.show();

            const userSelectionInput = document.getElementById('userSelection');
            userSelectionInput.addEventListener('click', (event) =>
            {
                event.stopPropagation();
                const directoryModal = new bootstrap.Modal(secondModal);
                directoryModal.show();

        
                directoryModal._element.addEventListener('hidden.bs.modal', () =>
                {
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                });
            });
        }

    
        secondModal.addEventListener('show.bs.modal', () =>
        {
            firstModal.setAttribute('inert', 'true');
        });

    
        secondModal.addEventListener('hidden.bs.modal', () =>
        {
            firstModal.removeAttribute('inert');
            const backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) backdrop.remove();
        });


        function selectUser(event) 
        {
            const selectedOption = event.target;
            document.querySelectorAll('.option-item').forEach((item) =>
            {
                item.classList.remove('active');
            });
            selectedOption.classList.add('active');
            document.getElementById('userSelection').value = selectedOption.textContent.trim();
        }

     
        document.querySelectorAll('.option-item').forEach((option) =>
        {
            option.addEventListener('click', selectUser);
        });

    
        function saveAndCloseDirectoryModal()
        {
            const userSelection = document.getElementById('userSelection').value;
            if (userSelection)
            {
                const directoryModalInstance = bootstrap.Modal.getInstance(secondModal);
                directoryModalInstance.hide();
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove(); 
            }
            else 
            {
                alert('Please select a user before saving.');
            }
        }

   
        document.querySelectorAll('.tree-toggle').forEach((toggle) =>
        {
            toggle.addEventListener('click', function ()
            {
                this.classList.toggle('opened');
            });
        });

     
        function filterTree()
        {
            const filterInput = document.getElementById('filterInputMember').value.toLowerCase();
            const allOptions = document.querySelectorAll('.option-item');
            allOptions.forEach((option) =>
            {
                const text = option.textContent.toLowerCase();
                option.style.display = text.includes(filterInput) ? '' : 'none';
            });
        }

        // Expose functions globally for external calls if needed
        window.AddNewAdminUser = AddNewAdminUser;
        window.saveAndCloseDirectoryModal = saveAndCloseDirectoryModal;
        window.filterTree = filterTree;
    })();



    function DeleteAdminAccess(connectionID)
    {
        if (confirm("Are you sure you want to terminate this connection?"))
        {
            alert(`Delete admin: ${connectionID}`);
        }
    }
    $(document).ready(function () 
    {
        MakeStandardDataTable("AdminAccessData");
    });


    function EditAdminAccess(machineId) 
    {
        $.ajax({
            url: '@Url.Action("EditAdminAccess", "Settings")',
            type: 'GET',
            data:
            {
                adminID: machineId
            },
            success: function (response)
            {
                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
                editModal.show();
            },
            error: function (error)
            {
                console.log('Error fetching machine data:', error);
            }
        });
    }
</script>