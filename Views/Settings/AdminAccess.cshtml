                                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                                <input class="form-check-input" type="checkbox" @(access.LockscreenReport ? "checked" : "")>
                                            </div>
                                        </td>
                                        <td class="@cssBg">@access.UserLastModified</td>
                                        <td class="@cssBg">@access.MachineLastModified</td>
                                        <td class="@cssBg sticky-action-column">
                                            <button type="button" class="btn btn-sm custom-btn-sm btn-success" onclick="EditAdminAccess(@access.AdminID)">Edit</button>
                                            <button type="button" class="btn btn-sm custom-btn-sm btn-danger" onclick="DeleteAdminAccess(@access.AdminID)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



