@using CLA_Administration_Web.ViewModels.Settings.ManageAdminAccess
@model ManageAdminAccessMainViewModel
@using CLA_Administration_Web.ViewModels.Targeting
@using CLA_Administration_Web.ViewModels.Shared

@{
    int index = 0;
    var usersDomains = Model.AdminAccessItems?.Select(x => x.Domain).Distinct().ToList() ?? new List<string>();
    var usersUserName = Model.AdminAccessItems?.Select(x => x.Username).Distinct().ToList() ?? new List<string>();
    var usersMachine = Model.AdminAccessItems?.Select(x => x.MachineLastModified).Distinct().ToList() ?? new List<string>();
    var usersLastModified = Model.AdminAccessItems?.Select(x => x.UserLastModified).Distinct().ToList() ?? new List<string>();
}

<div class="container-fluid">
    <!-- Breadcrumb Component --> @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml",
        new SettingsBreadcrumbViewModel
            {
                SettingsCurrentPage = SettingsPages.AdminAccess,
                HasAddNewButton = true,
                BreadcrumbButtonName = "Add Admin User",
                BreadcrumbButtonCallbackFunction = "AddNewAdminUser"
            });
    }

    <!-- Admin Access Table -->
    <div class="card mb-4 mt-1 p-3" id="report-data-area">
        <div id="SettingsData">
            <h3 class="w-100 text-center theme-txt-clr"> Manage Admin Access </h3>
            <div id="AdminAccessSettings" class="table-responsive mt-3">
                <div class="table-responsive" style="position: relative;">
                    <div style="overflow-x: auto;">
                        <table id="AdminAccessData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                            <thead class="sticky-top theme-bg text-white">
                                <tr>
                                    <th class="theme-bg text-white">Domain</th>
                                    <th class="theme-bg text-white">Username</th>
                                    <th class="theme-bg text-white">Desktop (Environment)</th>
                                    <th class="theme-bg text-white">Desktop (Read)</th>
                                    <th class="theme-bg text-white">Desktop (Write)</th>
                                    <th class="theme-bg text-white">Desktop (Report)</th>
                                    <th class="theme-bg text-white">Tickers (Environment)</th>
                                    <th class="theme-bg text-white">Tickers (Read)</th>
                                    <th class="theme-bg text-white">Tickers (Write)</th>
                                    <th class="theme-bg text-white">Tickers (Report)</th>
                                    <th class="theme-bg text-white">RSS (Environment)</th>
                                    <th class="theme-bg text-white">RSS (Read)</th>
                                    <th class="theme-bg text-white">RSS (Write)</th>
                                    <th class="theme-bg text-white">RSS (Report)</th>
                                    <th class="theme-bg text-white">User Last Modified</th>
                                    <th class="theme-bg text-white">Machine Last Modified</th>
                                    <th class="theme-bg text-white">Lockscreen (Environment)</th>
                                    <th class="theme-bg text-white">Lockscreen (Read)</th>
                                    <th class="theme-bg text-white">Lockscreen (Write)</th>
                                    <th class="theme-bg text-white">Lockscreen (Report)</th>
                                    <th class="theme-bg text-white sticky-action-column">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var access in Model.AdminAccessItems)
                                {
                                    var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : ""; cssBg += " theme-txt-clr";
                                    <tr>
                                        <td class="@cssBg">@access.Domain</td>
                                        <td class="@cssBg">@access.Username</td>
                                        <td class="@cssBg">@access.DesktopEnvironment</td>
                                        <td class="@cssBg">@access.DesktopRead</td>
                                        <td class="@cssBg">@access.DesktopWrite</td>
                                        <td class="@cssBg">@access.DesktopReport</td>
                                        <td class="@cssBg">@access.TickersEnvironment</td>
                                        <td class="@cssBg">@access.TickersRead</td>
                                        <td class="@cssBg">@access.TickersWrite</td>
                                        <td class="@cssBg">@access.TickersReport</td>
                                        <td class="@cssBg">@access.RSS_Environment</td>
                                        <td class="@cssBg">@access.RSS_Read</td>
                                        <td class="@cssBg">@access.RSS_Write</td>
                                        <td class="@cssBg">@access.RSS_Report</td>
                                        <td class="@cssBg">@access.UserLastModified</td>
                                        <td class="@cssBg">@access.MachineLastModified</td>
                                        <td class="@cssBg">@access.LockscreenEnvironment</td>
                                        <td class="@cssBg">@access.LockscreenRead</td>
                                        <td class="@cssBg">@access.LockscreenWrite</td>
                                        <td class="@cssBg">@access.LockscreenReport</td>
                                        <td class="sticky-action-column">
                                            <button class="btn btn-sm custom-btn-sm btn-danger" onclick="DeleteAdminAccess(@access.AdminID)">Delete</button>
                                            <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditAdminAccess(@access.AdminID)">Edit</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- First Modal -->
