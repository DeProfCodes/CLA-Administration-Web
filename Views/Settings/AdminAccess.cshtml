<script>







    document.addEventListener("DOMContentLoaded", function () {
        // Get all environment radio buttons
        const envButtons = document.querySelectorAll('.btn-check');

        // Function to handle visibility logic
        function handleAccessRightsVisibility(event) {
            const selectedEnv = event.target.value;
            const readCheckbox = event.target.closest('tr').querySelector('.form-check-input[id^="read"]');
            const writeCheckbox = event.target.closest('tr').querySelector('.form-check-input[id^="write"]');

            if (selectedEnv === 'None') {
                // Disable and gray out Read and Write if "None" is selected
                readCheckbox.disabled = true;
                writeCheckbox.disabled = true;
                readCheckbox.closest('.form-check').classList.add('admin-disabled');
                writeCheckbox.closest('.form-check').classList.add('admin-disabled');
            } else if (selectedEnv === 'Staging') {
                // Disable and gray out Read if "Staging" is selected
                readCheckbox.disabled = true;
                writeCheckbox.disabled = false;
                readCheckbox.closest('.form-check').classList.add('admin-disabled');
                writeCheckbox.closest('.form-check').classList.remove('admin-disabled');
            } else if (selectedEnv === 'Both') {
                // Enable Read and Write if "Both" is selected
                readCheckbox.disabled = false;
                writeCheckbox.disabled = false;
                readCheckbox.closest('.form-check').classList.remove('admin-disabled');
                writeCheckbox.closest('.form-check').classList.remove('admin-disabled');
            }
        }

        // Add event listener to each environment button
        envButtons.forEach(button => {
            button.addEventListener('change', handleAccessRightsVisibility);
        });

        // Initialize visibility logic for all existing rows on page load
        envButtons.forEach(button => {
            if (button.checked) {
                handleAccessRightsVisibility({ target: button });
            }
        });
    });




    (() => {
   
        const firstModal = document.getElementById('CreateStagingUserModal');
        const secondModal = document.getElementById('directoryModal');


        function AddNewAdminUser()
        {
            const usersModal = new bootstrap.Modal(firstModal);
            usersModal.show();

            const userSelectionInput = document.getElementById('userSelection');
            userSelectionInput.addEventListener('click', (event) =>
            {
                event.stopPropagation();
                const directoryModal = new bootstrap.Modal(secondModal);
                directoryModal.show();

        
                directoryModal._element.addEventListener('hidden.bs.modal', () =>
                {
                    const backdrop = document.querySelector('.modal-backdrop');
                    if (backdrop) backdrop.remove();
                });
            });
        }

    
        secondModal.addEventListener('show.bs.modal', () =>
        {
            firstModal.setAttribute('inert', 'true');
        });

    
        secondModal.addEventListener('hidden.bs.modal', () =>
        {
            firstModal.removeAttribute('inert');
            const backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) backdrop.remove();
        });


        function selectUser(event) 
        {
            const selectedOption = event.target;
            document.querySelectorAll('.option-item').forEach((item) =>
            {
                item.classList.remove('active');
            });
            selectedOption.classList.add('active');
            document.getElementById('userSelection').value = selectedOption.textContent.trim();
        }

     
        document.querySelectorAll('.option-item').forEach((option) =>
        {
            option.addEventListener('click', selectUser);
        });

    
        function saveAndCloseDirectoryModal()
        {
            const userSelection = document.getElementById('userSelection').value;
            if (userSelection)
            {
                const directoryModalInstance = bootstrap.Modal.getInstance(secondModal);
                directoryModalInstance.hide();
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove(); 
            }
            else 
            {
                alert('Please select a user before saving.');
            }
        }

   
        document.querySelectorAll('.tree-toggle').forEach((toggle) =>
        {
            toggle.addEventListener('click', function ()
            {
                this.classList.toggle('opened');
            });
        });

     
        function filterTree()
        {
            const filterInput = document.getElementById('filterInputMember').value.toLowerCase();
            const allOptions = document.querySelectorAll('.option-item');
            allOptions.forEach((option) =>
            {
                const text = option.textContent.toLowerCase();
                option.style.display = text.includes(filterInput) ? '' : 'none';
            });
        }

        // Expose functions globally for external calls if needed
        window.AddNewAdminUser = AddNewAdminUser;
        window.saveAndCloseDirectoryModal = saveAndCloseDirectoryModal;
        window.filterTree = filterTree;
    })();



    function DeleteAdminAccess(customID) {
        Swal.fire({
            title: 'Are you sure you want to delete user ' + customID + '?',
            text: "You won't be able to undo this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!'
        }).then((result) => {
            if (result.isConfirmed) {

                Swal.fire(
                    'Deleted!',
                    'The user has been deleted.',
                    'success'
                );
            }
            else {

                Swal.fire(
                    'Cancelled',
                    'The user is safe.',
                    'info'
                );
            }
        });
    }
