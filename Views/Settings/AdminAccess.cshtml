                            <input type="text" class="form-control" id="machineLastModified" value="LegeB-PC" disabled>
                        </div>
                        <div class="col-md-4">
                            <label for="userSelection" class="form-label">UserName </label>
                            <input type="text" class="form-control" id="userSelection" value="">
                        </div>
                        <div class="col-md-4">
                            <label for="desktopEnvironment" class="form-label">Desktop Environment</label>
                            <input type="text" class="form-control" id="desktopEnvironment" value="desktopEnvironment">
                        </div>
                        <!-- Desktop Permissions -->
