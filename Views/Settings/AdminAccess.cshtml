@using CLA_Administration_Web.ViewModels.Settings.ManageAdminAccess
@model ManageAdminAccessMainViewModel

@{
    int index = 0;
    var usersDomains = Model.AdminAccessItems?.Select(x => x.Domain).Distinct().ToList() ?? new List<string>();
   
}

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
            {
                SettingsCurrentPage = SettingsPages.AdminAccess,
                HasAddNewButton = false,
                BreadcrumbButtonName = "Add Admin User",
                BreadcrumbButtonCallbackFunction = "AddNewAdminUser"
            });
    }

    <!-- Settings Filter Component -->
    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1 mb-2">
                <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
                <div class="row col-12 d-flex flex-wrap module-overview-filters">
                    <div class="w-auto me-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">Domain</p>
                            <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                                <option value="0">Please select Domain Name</option>
                                @foreach (var domain in usersDomains)
                                {
                                    <option value="@domain">@domain</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Access Table -->
    <div class="card mb-1 mt-1 p-3" id="report-data-area">
        <div id="SettingsData">
            <h3 class="w-100 text-center theme-txt-clr">
                Manage Admin Access
            </h3>
            <div id="AdminAccessSettings" class="table-responsive mt-3">
                <table id="AdminAccessData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                    @if (Model?.AdminAccessItems != null)
                    {
                        <thead class="sticky-top theme-bg text-white">
                            <tr>
                                <th>Domain</th>
                                <th>Username</th>
                                <th>Desktop (Environment)</th>
                                <th>Desktop (Read)</th>
                                <th>Desktop (Write)</th>
                                <th>Desktop (Report)</th>
                                <th>Tickers (Environment)</th>
                                <th>Tickers (Read)</th>
                                <th>Tickers (Write)</th>
                                <th>Tickers (Report)</th>
                                <th>RSS (Environment)</th>
                                <th>RSS (Read)</th>
                                <th>RSS (Write)</th>
                                <th>RSS (Report)</th>
                                <th>User Last Modified</th>
                                <th>Machine Last Modified</th>
                                <th>Lockscreen (Environment)</th>
                                <th>Lockscreen (Read)</th>
                                <th>Lockscreen (Write)</th>
                                <th>Lockscreen (Report)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var access in Model.AdminAccessItems)
                            {
                                var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                                cssBg += " theme-txt-clr";

                                <tr>
                                    <td class="@cssBg">@access.Domain</td>
                                    <td class="@cssBg">@access.Username</td>
                                    <td class="@cssBg">@access.DesktopEnvironment</td>
                                    <td class="@cssBg">@access.DesktopRead</td>
                                    <td class="@cssBg">@access.DesktopWrite</td>
                                    <td class="@cssBg">@access.DesktopReport</td>
                                    <td class="@cssBg">@access.TickersEnvironment</td>
                                    <td class="@cssBg">@access.TickersRead</td>
                                    <td class="@cssBg">@access.TickersWrite</td>
                                    <td class="@cssBg">@access.TickersReport</td>
                                    <td class="@cssBg">@access.RSS_Environment</td>
                                    <td class="@cssBg">@access.RSS_Read</td>
                                    <td class="@cssBg">@access.RSS_Write</td>
                                    <td class="@cssBg">@access.RSS_Report</td>
                                    <td class="@cssBg">@access.UserLastModified</td>
                                    <td class="@cssBg">@access.MachineLastModified</td>
                                    <td class="@cssBg">@access.LockscreenEnvironment</td>
                                    <td class="@cssBg">@access.LockscreenRead</td>
                                    <td class="@cssBg">@access.LockscreenWrite</td>
                                    <td class="@cssBg">@access.LockscreenReport</td>
                                      <td class="@cssBg">
                                <button class="btn btn-sm custom-btn-sm btn-danger" onclick="4 (@access.AdminID)" >Delete</button>
                                <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting(@access.Domain)">Edit</button>
                            </td>
                                </tr>
                            }
                        </tbody>
                    }
                    else
                    {
                        <p>No Admin Access data available or Model is null.</p>
                    }
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Create New Staging User Modal -->
<div class="modal fade" id="CreateStagingUserModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Staging User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingUserModal')"></button>
            </div>
            <div class="modal-body">
                <form id="CreateStagingUserForm">
                    <div class="mb-3">
                        <label for="StagingUserDomain" class="form-label">Domain</label>
                        <select class="form-select" id="StagingUserDomain" required>
                            <option value="">Please select a domain</option>
                            @foreach (var domain in usersDomains)
                            {
                                <option value="@domain">@domain</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserUsername" class="form-label">Username</label>
                        <select class="form-select" id="StagingUserDomain" required>
                            <option value="">Please select a user</option>
                        
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserFirstname" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="StagingUserFirstname" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserLastname" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="StagingUserLastname" required>
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserUserLastModified" class="form-label">User Last Modified</label>
                        <input type="text" class="form-control" id="StagingUserUserLastModified">
                    </div>
                    <div class="mb-3">
                        <label for="StagingUserMachineLastModified" class="form-label">Machine Last Modified</label>
                        <input type="text" class="form-control" id="StagingUserMachineLastModified">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingUserModal')">Cancel</button>
                <button type="button" class="btn  custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

      function DeleteAdminAccess(connectionID) {
        if (confirm("Are you sure you want to terminate this connection?")) {
            alert(`Delete admin: ${connectionID}`);
        }
    }

    $(document).ready(function () {
        usersDT = MakeStandardDataTable("AdminAccessData");
     
    });


    function FilterByDomain() {
        const selectedDomain = $("#ReportModuleSelect").val();

        var userActive = $("#StagingUserBtn").hasClass("btn-group-active");

        if (selectedDomain === "0") {
            if (userActive)
                usersDT.column(0).search("").draw();
            else
                machinesDT.column(0).search("").draw();
        }
        else {
            if (userActive)
                usersDT.column(0).search(selectedDomain).draw();

            else
                machinesDT.column(0).search(selectedDomain).draw();
        }
    }



    function EditNewStagingEnting(machineId, entityType)
    {
     
        $.ajax({
            url: '@Url.Action("EditStagingMachine", "Settings")',
            type: 'GET',
            data: { machineId: machineId, entityType: entityType },
            success: function (response)
            {e

                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
                editModal.show();

            },
            error: function (error)
            {
                console.log('Error fetching machine data:', error);
            }
        });
    }

</script>
