<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<style>
.sticky-action-column
{
    position: sticky;
    right: 0;
    background-color: white;
    z-index: 2;
}

.form-select
{
    width: 100%;
}

    .option-item.active {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
    }

    .option-item {
        padding: 10px;
        cursor: pointer;
        border: 1px solid transparent;
        border-radius: 5px;
    }

        .option-item:hover {
            background-color: #f1f1f1;
            color: black;
        }


</style>
<script>


    function AddNewAdminUser() {
 
        const usersModal = new bootstrap.Modal(document.getElementById('CreateStagingUserModal'));
        usersModal.show();

       
        const userSelectionInput = document.getElementById('userSelection');
        userSelectionInput.addEventListener('click', (event) => {
            event.stopPropagation(); 
            const directoryModal = new bootstrap.Modal(document.getElementById('directoryModal'));
            directoryModal.show();
        });
    }

    document.getElementById("directoryModal").addEventListener("show.bs.modal", () => {
        document.getElementById("CreateStagingUserModal").setAttribute("inert", "true");
    });


    document.getElementById("directoryModal").addEventListener("hidden.bs.modal", () => {
        document.getElementById("CreateStagingUserModal").removeAttribute("inert");
    });  

    document.querySelectorAll('.tree-toggle').forEach(toggle => {
        toggle.addEventListener('click', function () {
            this.classList.toggle('opened');
        });
    });

    function filterTree() {
        const filterInput = document.getElementById("filterInputMember").value.toLowerCase();
        const allOptions = document.querySelectorAll(".option-item");

        allOptions.forEach((option) => {
            const text = option.textContent.toLowerCase();
            if (text.includes(filterInput)) {
                option.style.display = ""; // Show matching items
            } else {
                option.style.display = "none"; // Hide non-matching items
            }
        });
    }


    function selectUser(event) {
        const selectedOption = event.target;

        const allOptions = document.querySelectorAll(".option-item");
        allOptions.forEach((option) => {
            option.classList.remove("active");
        });

  
        selectedOption.classList.add("active");

  
        const userSelectionInput = document.getElementById("userSelection");
        userSelectionInput.value = selectedOption.textContent.trim();
    }


    function saveAndCloseDirectoryModal() {
        const userSelectionInput = document.getElementById("userSelection").value;
        console.log(userSelectionInput);
        if (userSelectionInput) {
        
            const directoryModalInstance = bootstrap.Modal.getInstance(document.getElementById("directoryModal"));
            directoryModalInstance.hide();
        } else {
            alert("Please select a user before saving.");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const allOptions = document.querySelectorAll(".option-item");
        allOptions.forEach((option) => {
            option.addEventListener("click", selectUser);
        });
    });







      function DeleteAdminAccess(connectionID) 
      {
        if (confirm("Are you sure you want to terminate this connection?"))
        {
            alert(`Delete admin: ${connectionID}`);
        }
    }

    $(document).ready(function ()
    {
        usersDT = MakeStandardDataTable("AdminAccessData");
     
    });

 

    function FilterByDomain() 
    {
        const selectedDomain = $("#ReportModuleSelect").val();

        var userActive = $("#StagingUserBtn").hasClass("btn-group-active");

        if (selectedDomain === "0")
        {
            if (userActive)
                usersDT.column(0).search("").draw();
            else
                machinesDT.column(0).search("").draw();
        }
        else
        {
            if (userActive)
                usersDT.column(0).search(selectedDomain).draw();

            else
                machinesDT.column(0).search(selectedDomain).draw();
        }
    }



    function EditAdminAccess(machineId)
    {
     
        $.ajax({
            url: '@Url.Action("EditAdminAccess", "Settings")',
            type: 'GET',
            data: { adminID: machineId },
            success: function (response)
            {

                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
                editModal.show();

            },
            error: function (error)
            {
                console.log('Error fetching machine data:', error);
            }
        });
    }





</script>
