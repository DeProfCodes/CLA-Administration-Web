@using CLA_Administration_Web.ViewModels.Settings.ManageAdminAccess
@model ManageAdminAccessMainViewModel

@{
    int index = 0;
    var usersDomains = Model.AdminAccessItems?.Select(x => x.Domain).Distinct().ToList() ?? new List<string>();
    var usersUserName = Model.AdminAccessItems?.Select(x => x.Username).Distinct().ToList() ?? new List<string>();
    var usersMachine = Model.AdminAccessItems?.Select(x => x.MachineLastModified).Distinct().ToList() ?? new List<string>();
    var usersLastModified = Model.AdminAccessItems?.Select(x => x.UserLastModified).Distinct().ToList() ?? new List<string>();
   
}

<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
            {
                SettingsCurrentPage = SettingsPages.AdminAccess,
                HasAddNewButton = true,
                BreadcrumbButtonName = "Add Admin User",
                BreadcrumbButtonCallbackFunction = "AddNewAdminUser"
            });
    }

 


    <!-- Admin Access Table -->
    <div class="card mb-4 mt-1 p-3" id="report-data-area">
        <div id="SettingsData">
            <h3 class="w-100 text-center theme-txt-clr">
                Manage Admin Access
            </h3>
            <div id="AdminAccessSettings" class="table-responsive mt-3">
                <div class="table-responsive" style="position: relative;">
                    <div style="overflow-x: auto;">
                        <table id="AdminAccessData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                         
                                <thead class="sticky-top theme-bg text-white">
                                    <tr>
                                        
                                        <th>Domain</th>
                                        <th>Username</th>
                                        <th>Desktop (Environment)</th>
                                        <th>Desktop (Read)</th>
                                        <th>Desktop (Write)</th>
                                        <th>Desktop (Report)</th>
                                        <th>Tickers (Environment)</th>
                                        <th>Tickers (Read)</th>
                                        <th>Tickers (Write)</th>
                                        <th>Tickers (Report)</th>
                                        <th>RSS (Environment)</th>
                                        <th>RSS (Read)</th>
                                        <th>RSS (Write)</th>
                                        <th>RSS (Report)</th>
                                        <th>User Last Modified</th>
                                        <th>Machine Last Modified</th>
                                        <th>Lockscreen (Environment)</th>
                                        <th>Lockscreen (Read)</th>
                                        <th>Lockscreen (Write)</th>
                                        <th>Lockscreen (Report)</th>
                                        <th class="sticky-action-column">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var access in Model.AdminAccessItems)
                                    {
                                        var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                                        cssBg += " theme-txt-clr";

                                        <tr>
                                            
                                            <td class="@cssBg">@access.Domain</td>
                                            <td class="@cssBg">@access.Username</td>
                                            <td class="@cssBg">@access.DesktopEnvironment</td>
                                            <td class="@cssBg">@access.DesktopRead</td>
                                            <td class="@cssBg">@access.DesktopWrite</td>
                                            <td class="@cssBg">@access.DesktopReport</td>
                                            <td class="@cssBg">@access.TickersEnvironment</td>
                                            <td class="@cssBg">@access.TickersRead</td>
                                            <td class="@cssBg">@access.TickersWrite</td>
                                            <td class="@cssBg">@access.TickersReport</td>
                                            <td class="@cssBg">@access.RSS_Environment</td>
                                            <td class="@cssBg">@access.RSS_Read</td>
                                            <td class="@cssBg">@access.RSS_Write</td>
                                            <td class="@cssBg">@access.RSS_Report</td>
                                            <td class="@cssBg">@access.UserLastModified</td>
                                            <td class="@cssBg">@access.MachineLastModified</td>
                                            <td class="@cssBg">@access.LockscreenEnvironment</td>
                                            <td class="@cssBg">@access.LockscreenRead</td>
                                            <td class="@cssBg">@access.LockscreenWrite</td>
                                            <td class="@cssBg">@access.LockscreenReport</td>
                                            <td class="sticky-action-column @cssBg">
                                               <button class="btn btn-sm custom-btn-sm btn-danger" onclick="DeleteAdminAccess(@access.AdminID)">Delete</button>
                                               <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditAdminAccess(@access.AdminID)">Edit</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                          
                         
                        </table>
                    </div>
                </div>
                           

            </div>
        </div>
    </div>

</div>


<div class="modal fade" id="CreateStagingUserModal" tabindex="-1" aria-labelledby="CreateStagingUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CreateStagingUserModalLabel">Add New Admin User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('CreateStagingUserModal')"></button>
            </div>
            <div class="modal-body">
                <form id="CreateStagingUserForm">
                   
                        <div class="row g-3">
                            
                          
                            <!-- Modified Dates (Read-only) -->
                            <div class="col-md-4">
                                <label for="userLastModified" class="form-label">Modified by</label>
                                <input type="text" class="form-control" id="userLastModified" value="Proficient Mkansi" readonly>
                            </div>
                            <div class="col-md-4">
                                <label for="machineLastModified" class="form-label">Machine </label>
                                <input type="text" class="form-control" id="machineLastModified" value="LegeB-PC" readonly>
                            </div>
                            <div class="col-md-4">

                                <label for="domain" class="form-label">Domain</label>
                                <select class="form-select form-control" id="domain">
                                    @foreach (var domain in usersDomains)
                                    {
                                        <option value="@domain">@domain</option>
                                    }
                                </select>
                              
                            </div>

                            <!-- Username and Desktop Environment (Read-only) -->
                            <div class="col-md-4">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" value="" >


                             </div>
                            <div class="col-md-4">
                                <label for="desktopEnvironment" class="form-label">Desktop Environment</label>
                                <input type="text" class="form-control" id="desktopEnvironment" value="desktopEnvironment" readonly>
                            </div>

                            <!-- Desktop Permissions -->
                            <div class="col-md-4">
                                <label for="desktopRead" class="form-label">Desktop Read</label>
                                <select class="form-select form-control" id="desktopRead">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="desktopWrite" class="form-label">Desktop Write</label>
                                <select class="form-select form-control" id="desktopWrite">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="desktopReport" class="form-label">Desktop Report</label>
                                <select class="form-select form-control" id="desktopReport">
                                    <option value="Enabled">Enabled</option>
                                    <option value="Disabled">Disabled</option>
                                </select>
                            </div>

                            <!-- Tickers Permissions -->
                            <div class="col-md-4">
                                <label for="tickersEnvironment" class="form-label">Tickers Environment</label>
                                <input type="text" class="form-control" id="tickersEnvironment" value="TickersEnv1">
                            </div>
                            <div class="col-md-4">
                                <label for="tickersRead" class="form-label">Tickers Read</label>
                                <select class="form-select form-control" id="tickersRead">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="tickersWrite" class="form-label">Tickers Write</label>
                                <select class="form-select form-control" id="tickersWrite">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="tickersReport" class="form-label">Tickers Report</label>
                                <select class="form-select form-control" id="tickersReport">
                                    <option value="Enabled">Enabled</option>
                                    <option value="Disabled">Disabled</option>
                                </select>
                            </div>

                            <!-- RSS Permissions -->
                            <div class="col-md-4">
                                <label for="rssEnvironment" class="form-label">RSS Environment</label>
                                <input type="text" class="form-control" id="rssEnvironment" value="RSS_Env3">
                            </div>
                            <div class="col-md-4">
                                <label for="rssRead" class="form-label">RSS Read</label>
                                <select class="form-select form-control" id="rssRead">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="rssWrite" class="form-label">RSS Write</label>
                                <select class="form-select form-control" id="rssWrite">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="rssReport" class="form-label">RSS Report</label>
                                <select class="form-select form-control" id="rssReport">
                                    <option value="Enabled">Enabled</option>
                                    <option value="Disabled">Disabled</option>
                                </select>
                            </div>

                            <!-- Lockscreen Permissions -->
                            <div class="col-md-4">
                                <label for="lockscreenEnvironment" class="form-label">Lockscreen Environment</label>
                                <input type="text" class="form-control" id="lockscreenEnvironment" value="LockscreenEnv4">
                            </div>
                            <div class="col-md-4">
                                <label for="lockscreenRead" class="form-label">Lockscreen Read</label>
                                <select class="form-select form-control" id="lockscreenRead">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="lockscreenWrite" class="form-label">Lockscreen Write</label>
                                <select class="form-select form-control" id="lockscreenWrite">
                                    <option value="Allowed">Allowed</option>
                                    <option value="Restricted">Restricted</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="lockscreenReport" class="form-label">Lockscreen Report</label>
                                <select class="form-select form-control" id="lockscreenReport">
                                    <option value="Enabled">Enabled</option>
                                    <option value="Disabled">Disabled</option>
                                </select>
                            </div>

                          
                        </div>
                    </form>

            </div>
            <div class="modal-footer">
                <button type="button"  class="btn custom-btn  btn-secondary" data-bs-dismiss="modal" onclick="closeModal('CreateStagingUserModal')">Cancel</button>
                <button type="button" class="custom-btn  custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Admin Access  Modal -->
<div class="modal fade" id="EditModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Admin Access Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('EditModal')"></button>
            </div>
            <div class="modal-body" id="EditModalContainer">
                <!-- Dynamic content for the modal goes here -->
            </div>
            <div class="modal-footer">
                <button type="button"  class="btn custom-btn  btn-secondary"  data-bs-dismiss="modal" onclick="closeModal('EditModal')">Cancel</button>
                <button type="button" class="custom-btn  custom-btn-default" onclick="SaveStagingUser()">Save User</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<style>
.sticky-action-column
{
    position: sticky;
    right: 0;
    background-color: white;
    z-index: 2;
}

.form-select
{
    width: 100%;
}
</style>
<script>

      function DeleteAdminAccess(connectionID) 
      {
        if (confirm("Are you sure you want to terminate this connection?"))
        {
            alert(`Delete admin: ${connectionID}`);
        }
    }

    $(document).ready(function ()
    {
        usersDT = MakeStandardDataTable("AdminAccessData");
     
    });

    function AddNewAdminUser()
    {
        const usersModal = new bootstrap.Modal(document.getElementById('CreateStagingUserModal'));
        usersModal.show();
    }

    function FilterByDomain() 
    {
        const selectedDomain = $("#ReportModuleSelect").val();

        var userActive = $("#StagingUserBtn").hasClass("btn-group-active");

        if (selectedDomain === "0")
        {
            if (userActive)
                usersDT.column(0).search("").draw();
            else
                machinesDT.column(0).search("").draw();
        }
        else
        {
            if (userActive)
                usersDT.column(0).search(selectedDomain).draw();

            else
                machinesDT.column(0).search(selectedDomain).draw();
        }
    }



    function EditAdminAccess(machineId)
    {
     
        $.ajax({
            url: '@Url.Action("EditAdminAccess", "Settings")',
            type: 'GET',
            data: { adminID: machineId },
            success: function (response)
            {

                $('#EditModalContainer').html(response);
                const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
                editModal.show();

            },
            error: function (error)
            {
                console.log('Error fetching machine data:', error);
            }
        });
    }

</script>
