                <!-- Setting Description -->
                <div class="row mt-3">
                    <div class="common-titles-col">
                        <p class="custom-p fl-right">Setting Description</p>
                    </div>
                    <div class="common-titles-value-col">
                        <input class="custom-input-text w-250p" type="text" id="settingDescription">
                        <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="settingDescriptionError"></p>
                    </div>
                </div>

                <!-- Network -->
                <div class="row mt-3">
                    <div class="common-titles-col">
                        <p class="custom-p fl-right">Network</p>
                    </div>
                    <div class="common-titles-value-col">
