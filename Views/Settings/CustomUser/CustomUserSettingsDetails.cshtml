                <span class="breadcrumb-item">Custom User Settings Details</span>
            </p>
        </div>
        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenPage('@SettingsPages.CustomUserSettings', '@Model.Id')"><i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon"></i>Custom User Settings</button>
        </div>
    </div>


