<!-- Edit Staging Modal -->
<div class="modal fade" id="EditModal" tabindex="-1" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">Edit Popup Position</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal('EditModal')"></button>
            </div>
            <div class="modal-body" id="EditModalContainer">


                <div class="row mt-3">
                   
                    <div class="popup-display-settings-info popup-pos-container">
                        <div class="grid-container">
                            <div class="popup-pos grid-item" id="PopupPositionTL" onclick="setPopupPosition(this)">Top Left</div>
                            <div class="popup-pos grid-item" id="PopupPositionTC" onclick="setPopupPosition(this)">Top Center</div>
                            <div class="popup-pos grid-item" id="PopupPositionTR" onclick="setPopupPosition(this)">Top Right</div>
                            <div class="popup-pos grid-item" id="PopupPositionML" onclick="setPopupPosition(this)" >Middle Left</div>
                            <div class="popup-pos grid-item" id="PopupPositionC"  onclick="setPopupPosition(this)"   >Center</div>
                            <div class="popup-pos grid-item" id="PopupPositionMR" onclick="setPopupPosition(this)"  >Middle Right</div>
                            <div class="popup-pos grid-item" id="PopupPositionBL" onclick="setPopupPosition(this)"  >Bottom Left</div>
                            <div class="popup-pos grid-item" id="PopupPositionBC" onclick="setPopupPosition(this)"   >Bottom Center</div>
                            <div class="popup-pos grid-item active" id="PopupPositionBR" onclick="setPopupPosition(this)">Bottom Right</div>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn custom-btn btn-secondary" data-bs-dismiss="modal" onclick="closeModal('EditModal')">Cancel</button>
                <button type="button" class="custom-btn custom-btn-default" onclick="savePopupPosition()">Save</button>
            </div>

        </div>
    </div>
</div>


<script>

    let selectedPosition = '';

    function openEditModal() {
  
        const modal = new bootstrap.Modal(document.getElementById('EditModal'));
        modal.show();
    }

    function setPopupPosition(element) {
   
        document.querySelectorAll('.popup-pos').forEach(item => item.classList.remove('active'));

  
        element.classList.add('active');

        selectedPosition = element.textContent;
    }

    function savePopupPosition() {
        if (selectedPosition) {
          
            document.getElementById('syncTime').value = selectedPosition;

            const modalElement = document.getElementById('EditModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElement);
            modalInstance.hide();
        } else {
            alert('Please select a position before saving.');
        }
    }

    function closeModal(modalId) {
        const modalElement = document.getElementById(modalId);
        const modalInstance = bootstrap.Modal.getInstance(modalElement);
        modalInstance.hide();
    }


</script>