@using CLA_Administration_Web.ViewModels.Settings.CustomUser
@model CustomUserViewModel
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.Helpers.Constants




@{
    @*await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
            {
                SettingsCurrentPage =SettingsPages.CustomUserSettingsDetails,
                HasAddNewButton = true,
                BreadcrumbButtonName = "Add New Staging User",
                BreadcrumbButtonCallbackFunction = "AddNewStagingEntity"
            });*@

    var allowTickerLaunch = false;
    var updateFuture = false;
    var passProtectScr = false;
    var allowUserChangeScre = false;
    var allowUserChangeDesk = false;
    var enableErrorLog = false;
    var aspectRatio = false;
    var impresionLog = false;
    var audio = false;
    var useMachineId = false;


}


<div class="container-fluid">



    <!-- Top Page Navigation Breadcrumb -->
    <div class="row ">
        <div class="w-auto">
            <h2 class="theme-txt-clr breadcrumb-title">Custom User Settings Details</h2>
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, 'Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, 'AllModules', 'AllModulesLink', true)">Settings</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Settings', 'null', '@SettingsPages.CustomUserSettings', 'SurveyOverviewLink')">Custom User Settings</span> /
                <span class="breadcrumb-item">Custom User Settings Details</span>
            </p>
        </div>
        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenPage('@SettingsPages.CustomUserSettings', '@Model.Id')"><i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon"></i>Custom User Settings</button>
        </div>
    </div>


<div class="card mb-4 mt-2 overview-filters-card">
    <div class="card-body">
        <h4 class="w-100 text-center theme-txt-clr">Custom user settings for ID: @Model.Id</h4>
    </div>
</div>
  
<!-- User Settings Details -->
<div class="row">
    <div class="col-lg-8">
        <div class="card-bordered-section">
            <h5>User Settings Details</h5>
            <form>
                <div class="mb-3">
                    <label for="settingDescription" class="form-label">Setting Description</label>
                    <input type="text" id="settingDescription" class="form-control">
                </div>
                <div class="mb-3">
                    <label for="network" class="form-label">Network</label>
                    <select id="network" class="form-select">
                        <option>MICROSOFT</option>
                        <!-- Add more options if needed -->
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="screensaverTimeout" class="form-label">Screensaver Timeout (Seconds)</label>
                        <input type="number" id="screensaverTimeout" class="form-control" value="@Model.ScreensaverTimeout">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="popupTimeout" class="form-label">Popup Timeout (Seconds)</label>
                        <input type="number" id="popupTimeout" class="form-control" value="@Model.PopupTimeout">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="desktopTimeout" class="form-label">Desktop Timeout (Seconds)</label>
                        <input type="number" id="desktopTimeout" class="form-control" value="@Model.DeskTopTimeout">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="tickerTimeout" class="form-label">Ticker Timeout (Seconds)</label>
                        <input type="number" id="tickerTimeout" class="form-control" value="@Model.TickerTimeout">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="syncTimeout" class="form-label">Sync Timeout (Seconds)</label>
                        <input type="number" id="syncTimeout" class="form-control" value="@Model.SyncTimeout">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="syncTime" class="form-label">Sync Time</label>
                        <input type="time" id="syncTime" class="form-control" value="@Model.SyncTimeout">
                    </div>
                </div>
                <div class="form-check">
                        <input type="checkbox" id="passwordProtect" class="form-check-input"  @(allowTickerLaunch ? "checked" : "")>
                    <label for="passwordProtect" class="form-check-label">Password Protect Screensaver</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="overrideDesktop" class="form-check-input">
                    <label for="overrideDesktop" class="form-check-label">Allow User to Override Desktop</label>
                </div>
                <!-- Add more form fields if necessary -->
            </form>
        </div>
    </div>

    <!-- Client Components -->
    <div class="col-lg-4">
        <div class="card-bordered-section">

            <div class="card">
                <div class="card-header custom-p fw-bold fs-14">
                    Client Components
                </div>
                <div class="card-body" id="table-scroll">
                    <div>

                        <table class="table">
                            <thead>
                                <tr>

                                    <th scope="col">Module</th>
                                    <th scope="col">Is Enable</th>

                                </tr>
                            </thead>
                            <tbody>
                                <tr>

                                    <td>Screensave</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Dynamic Desktop</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Surveys</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault"></td>
                                </tr>
                                <tr>

                                    <td>Screensave</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Dynamic Desktop</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Surveys</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault"></td>
                                </tr>
                                <tr>

                                    <td>Screensave</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Dynamic Desktop</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" checked></td>
                                </tr>
                                <tr>

                                    <td>Surveys</td>
                                    <td> <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
            <!-- Add additional client components as needed -->
        </div>
    </div>
</div>

<div class="d-flex justify-content-between">
        <button class="custom-btn custom-btn-default  w-fit-content" id="BulkImportBtn"> <i class="bi bi-plus-circle-fill"></i>Add</button>
        <button class="custom-btn custom-btn-default  w-fit-content" id="BulkImportBtn"> <i class="bi bi-plus-circle-fill"></i>Revert to Globsl Settings</button>
        <button class="btn-danger custom-btn custom-btn-default  w-fit-content" id="BulkImportBtn"> <i class="bi bi-plus-circle-fill"></i>Delete</button>
  
</div>
</div>
