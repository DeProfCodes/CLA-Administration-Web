    <!-- User Settings Details -->
    <div class="row">
        <div class="col-lg-8">
            <div class="bordered-section">
                <h5>User Settings Details</h5>
                <form>
                    <div class="mb-3">
                        <label for="settingDescription" class="form-label">Setting Description</label>
                        <input type="text" id="settingDescription" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label for="network" class="form-label">Network</label>
                        <select id="network" class="form-select">
                            <option>MICROSOFT</option>
                            <!-- Add more options if needed -->
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="screensaverTimeout" class="form-label">Screensaver Timeout (Seconds)</label>
                            <input type="number" id="screensaverTimeout" class="form-control" value="6190">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="popupTimeout" class="form-label">Popup Timeout (Seconds)</label>
                            <input type="number" id="popupTimeout" class="form-control" value="300">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="desktopTimeout" class="form-label">Desktop Timeout (Seconds)</label>
                            <input type="number" id="desktopTimeout" class="form-control" value="600">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="tickerTimeout" class="form-label">Ticker Timeout (Seconds)</label>
                            <input type="number" id="tickerTimeout" class="form-control" value="3000">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="syncTimeout" class="form-label">Sync Timeout (Seconds)</label>
                            <input type="number" id="syncTimeout" class="form-control" value="90">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="syncTime" class="form-label">Sync Time</label>
                            <input type="time" id="syncTime" class="form-control">
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="passwordProtect" class="form-check-input">
                        <label for="passwordProtect" class="form-check-label">Password Protect Screensaver</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="overrideDesktop" class="form-check-input">
                        <label for="overrideDesktop" class="form-check-label">Allow User to Override Desktop</label>
                    </div>
                    <!-- Add more form fields if necessary -->
                </form>
            </div>
        </div>

