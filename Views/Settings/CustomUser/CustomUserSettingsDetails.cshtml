                <div class="row mt-3">
                    <div class="common-titles-col">
                        <p class="custom-p fl-right">Screensaver Timeout (Seconds)</p>
                    </div>
                    <div class="common-titles-value-col">
                        <input class="custom-input-text w-250p" type="number" id="screensaverTimeout" value="@Model.ScreensaverTimeout">
                        <p class="mb-0 fs-12 text-danger fst-italic ps-1" id="screensaverTimeoutError"></p>
                    </div>
                </div>

                <!-- Popup Timeout -->
                <div class="row mt-3">
                    <div class="common-titles-col">
                        <p class="custom-p fl-right">Popup Timeout (Seconds)</p>
                    </div>
                    <div class="common-titles-value-col">
