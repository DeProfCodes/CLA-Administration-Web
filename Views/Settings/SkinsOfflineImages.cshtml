                </li>
            </ul>
            <div class="tab-content border p-3" id="detailsTabContent">
                <div class="tab-pane fade show active" id="category-details" role="tabpanel" aria-labelledby="category-details-tab">
                    <form>
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" id="categoryName">
                        </div>
                        <div class="mb-3">
