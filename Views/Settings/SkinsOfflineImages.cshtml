<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
<link href="https://unpkg.com/tabulator-tables@4.1.1/dist/css/semantic-ui/tabulator_semantic-ui.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js" type="text/javascript"></script>


<script>


var tableDataNested2 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SkinOfflineCategortyTrees));

    var actionButtons = function (cell, formatterParams) {
        const categoryId = cell.getRow().getData().CategoryId;
        const isDisabled = categoryId === 0 ? "hidden" : "";

        return `
                <button class='btn btn-sm btn-info custom-btn-sm  ${isDisabled}' onclick="OpenSkinsCategories(${categoryId})">
                Open Content
            </button>
                <button class='btn btn-sm btn-danger me-2 custom-btn-sm  ${isDisabled}' onclick="alert('Delete = ${categoryId}');">
                Delete
            </button>`;
    };

var table = new Tabulator("#example-table",
{
    layout: "fitColumns",
    data: tableDataNested2,
    dataTree: true,
    dataTreeStartExpanded: false,
    pagination: "local",
    paginationSize: 10,
    paginationSizeSelector: [10, 25, 50, 100],
    movableColumns: true,
    paginationCounter: "rows",
    columns: [
        { title: "CategoryID", field: "CategoryId", responsive: 0, visible: false },
        { title: "Category Name", field: "CategoryName", responsive: 0 },
        { title: "Category Description", field: "CategoryDescription" },
        { title: "Machine Last Modified", field: "MachineLastModified" },
        { title: "User Last Modified", field: "UserLastModified" },
        { title: "Actions", formatter: actionButtons, hozAlign: "center" },
    ],
});



function handleModuleChange()
{
    const selectedModule = document.getElementById("Module").value;
    console.log("Selected Module:", selectedModule);
    document.getElementById("ValidationErrorContainer").innerText = ""; 
}

function SaveImage() 
{
    const module = document.getElementById("Module").value;
    const fileInput = document.getElementById("SkinsAndOfflineImageUploadInput").files[0];

    if (!fileInput)
    {
        swal("Validation Error", "Please upload an image.", "error");
        return;
    }

    ValidateImage(fileInput, module).then(isValid =>
        {
        if (isValid) 
        {
            swal("Success", "New Skin and offline Images is saved.", "success");
            // Proceed with saving
        } 
        else
        {
            swal("Success", "Image validation failed.", "error");
            console.error("Image validation failed.");
        }
    }).catch(err =>
        {
        console.error("Error during validation:", err);
        const errorMessageDiv = document.getElementById("ValidationErrorContainer");
        errorMessageDiv.style.display = "block";
        errorMessageDiv.innerText = `Error: ${err}`;
    });
}


function ValidateImage(file, module)
{
    return new Promise((resolve, reject) =>
    {
        const reader = new FileReader();

        reader.onload = function (e) {
            const image = new Image();
            image.src = e.target.result;

            image.onload = function () {
                const width = image.width;
                const height = image.height;
                const fileType = file.type.split("/")[1].toUpperCase();

                const validationRules = {
                    "Offline": { formats: ["JPG", "PNG"], width: null, height: null },
                    "Popups": { formats: ["BMP"], width: [314, 414], height: [188, 288] },
                    "Surveys": { formats: ["BMP"], width: [485], height: [600] },
                    "SingleTicker": { formats: ["BMP"], width: [80], height: [40] },
                    "DoubleTicker": { formats: ["BMP"], width: [80], height: [80] }
                };

                const rules = validationRules[module];
                if (!rules.formats.includes(fileType))
                {
                    reject(`Invalid file type. Allowed: ${rules.formats.join(", ")}`);
                    return;
                }

                if (rules.width && (!Array.isArray(rules.width) || !rules.width.includes(width)))
                {
                    reject(`Invalid width. Expected: ${rules.width.join(", ")}`);
                    return;
                }

                if (rules.height && (!Array.isArray(rules.height) || !rules.height.includes(height)))
                {
                    reject(`Invalid height. Expected: ${rules.height.join(", ")}`);
                    return;
                }

                resolve(true);
            };

            image.onerror = function () 
            {
                reject("Invalid image file.");
            };
        };

        reader.onerror = function () 
        {
            reject("File read error.");
        };

        reader.readAsDataURL(file);
    });
}



    function OpenSkinsCategories(CategoryId)
    {
       
            OpenPage('@SettingsPages.SkinsAndOfflineImageDetails', CategoryId);
        
    }


function AddNewSkinsAndOfflineImages() 
{
        const editModal = new bootstrap.Modal(document.getElementById('EditModal'));
        editModal.show();
}

 
