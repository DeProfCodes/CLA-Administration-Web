                                </li>
                            </ul>
                        </li>
                        <li>Surveys</li>
                        <li>Tickets</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Panel: Category Details -->
        <div class="col-md-6">
            <ul class="nav nav-tabs" id="detailsTab" role="tablist">
                <li class="nav-item" role="presentation">
