                    <button class="nav-link active" id="existing-categories-tab" data-bs-toggle="tab" data-<img src="C:\Users\IT-SPARE\Downloads\Settings\Settings\Skins & Offline.png" />bs-target="#existing-categories" type="button" role="tab" aria-controls="existing-categories" aria-selected="true">Existing Categories</button>
                </li>
            </ul>
            <div class="tab-content border p-3" id="categoriesTabContent">
                <div class="tab-pane fade show active" id="existing-categories" role="tabpanel" aria-labelledby="existing-categories-tab">
                    <ul class="list-unstyled">
                        <li>
                            Offline Skins
