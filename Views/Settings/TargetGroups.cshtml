@model CLA_Administration_Web.ViewModels.Targeting.TargetingExposureViewModel

@using static CLA_Administration_Web.ViewModels.Modules.LDS.AddNewContentLibraryCategory
@using  CLA_Administration_Web.ViewModels.Targeting
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames;
@{

    int index = 0;

    var usersDomains = Model.TargetedUsers?.Select(x => x.DomainName).Distinct().ToList() ?? new List<string>();
    var groups = Model.TargetedGroups?.Select(x => x.DomainName).Distinct().ToList() ?? new List<string>();
    var machinesDomains = Model.TargetedMachines?.Select(x => x.DomainName).Distinct().ToList() ?? new List<string>();

}



<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @{
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Settings/SettingsBreadcrumb.cshtml", new SettingsBreadcrumbViewModel
            {
                SettingsCurrentPage = SettingsPages.TargetGroups,
                HasAddNewButton = true,
                BreadcrumbButtonName = "Add New Target Group",
                BreadcrumbButtonCallbackFunction = "AddNewStagingEntity"
            });

        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetedEntityModal.cshtml");
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/Targeting/TargetingExposureModal.cshtml");
    
    }

    <!-- Settings Filter Component -->
    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1 mb-2">
                <p class="theme-txt-clr text-center w-100 fw-bold fs-16" id="TypeFilterTitle">Filters</p>
                <div class="row col-12 d-flex flex-wrap module-overview-filters">
                    <div class="w-fit-content ms-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">View Type</p>
                            <div class="row mx-auto">
                                <div class="btn-group w-auto overview-filter-btn-group" role="group" aria-label="Status filter" id="TypeStagingLiveBtns">
                                    <button class="btn module-filter-btn-group filter-type-btn btn-group-active" onclick="ToggleStaginUserMachines(this.id)" id="TargetUsers">Users</button>
                                    <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingGroupdBtn">Groups</button>
                                    <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">Machines</button>
                                    <button class="btn module-filter-btn-group filter-type-btn" onclick="ToggleStaginUserMachines(this.id)" id="StagingMachinesBtn">IP Ranges</button>
                              
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-auto me-auto mb-1">
                        <div class="d-flex">
                            <p class="custom-p w-fit-content align-content-center">Domain</p>
                            <select class="custom-input-text w-200p ms-2" id="ReportModuleSelect" onchange="FilterByDomain()">
                                <option value="0">Please select Domain Name</option>
                                @foreach (var domain in usersDomains)
                                {
                                    <option value="@domain">@domain</option>
                                }

                            </select>
                        </div>
                    </div>
                    <div class="w-auto me-auto mb-1">
                        <div class="d-flex">

                            <button class="custom-btn custom-btn-default breadcrumb-btn" data-bs-toggle="modal" data-bs-target="#bulkImportModal" id="BreadcrumSettingsBtn">
                                <i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon" id="BreadcrumSettingsBtnIcon"></i>
                                <span id="BreadcrumSettingsBtnText">Bulk Import</span>
                            </button>

                            <btn class="btn btn-sm btn-success module-details-targeting-btns" onclick="OpenTargetedEntityPreviewModal('@SettingsNamesType.TargetGroups', true)">Targeting</btn>


                            <button class="custom-btn custom-btn-default breadcrumb-btn" data-bs-toggle="modal" data-bs-target="#directoryModal" id="BreadcrumSettingsBtn">
                                <i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon" id="BreadcrumSettingsBtnIcon"></i>
                                <span id="BreadcrumSettingsBtnText">Membership info</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card for Popup Report Body -->
    <div class="card mb-1 mt-1 overview-filters-card app-card-main-scaling p-4" id="report-data-area">
        <div id="SettingsData">
            <h3 class="w-100 text-center theme-txt-clr">
               Target <span id="StagingUserMachineTitle">Groups</span>
            </h3>
         
            <!-- Inject Partial Here -->
            <div id="StagingUsersSettings" class="mt-3">
                <table id="StagingUsersData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                    <thead>
                        <tr>
                            <th class="theme-bg text-white">UserID</th>
                            <th class="theme-bg text-white">Domain</th>
                            <th class="theme-bg text-white">NT Username</th>
                            <th class="theme-bg text-white">Firstname</th>
                            <th class="theme-bg text-white">User Last Modified</th>
                            <th class="theme-bg text-white">Status</th>                     
                            <th class="theme-bg text-white">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stagingUser in Model.TargetedUsers)
                        {
                            var cssBg = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                            cssBg += " theme-txt-clr";

                            <tr>
                                <td class="@cssBg">@stagingUser.Id</td>
                                <td class="@cssBg">@stagingUser.DomainName</td>
                                <td class="@cssBg">@stagingUser.NTUsername</td>
                                <td class="@cssBg">@stagingUser.DisplayName</td>
                                <td class="@cssBg">@stagingUser.LastSyncDT</td>
                                <td><span class="@cssBg">Active</span></td>
                              
                                <td class="@cssBg">
                                    <button class="btn btn-sm custom-btn-sm btn-danger">Delete</button>
                                    <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting('@stagingUser.Id', 'User')">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

       @*<div id="StagingMachinesSettings" class="mt-3 hidden">
                <table id="StagingMachinesData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
                    <thead>
                        <tr>
                            <th class="theme-bg text-white">MachineID</th>
                            <th class="theme-bg text-white">Domain</th>
                            <th class="theme-bg text-white">Machine Name</th>
                            <th class="theme-bg text-white">Machine Description</th>
                            <th class="theme-bg text-white">User Last Modified</th>
                            <th class="theme-bg text-white">Machine Last Modified</th>
                            <th class="theme-bg text-white">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stagingMachine in Model.TargetedMachines)
