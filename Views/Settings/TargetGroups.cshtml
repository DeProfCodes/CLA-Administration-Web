function showDetails(type, key) {
const membersList = document.getElementById("membersList");
const memberOfList = document.getElementById("memberOfList");

// Clear previous details
membersList.innerHTML = "";
memberOfList.innerHTML = "";

if (type === "users") {
const userData = directoryData.users[key];

membersList.innerHTML += `
    <li><strong>Groups:</strong> ${userData.groups.join(", ") || "None"}</li>
    <li><strong>Machines:</strong> ${userData.machines.join(", ") || "None"}</li>
    <li><strong>IP Ranges:</strong> ${userData.ipRanges.join(", ") || "None"}</li>
`;

const memberOf = Object.keys(directoryData.groups)
    .filter(group => directoryData.groups[group].users.includes(key))
    .map(group => `<li>${group}</li>`)
    .join("");

memberOfList.innerHTML += `
    <li><strong>Groups:</strong><ul>${memberOf || "<li>None</li>"}</ul></li>
`;
}
}


document.getElementById("directoryTree").addEventListener("click", function (event) {
const clickedItem = event.target;
if (clickedItem.dataset.username) {
showDetails("users", clickedItem.dataset.username);
}
});


function filterTree() {
const query = document.getElementById("filterInputMember").value.toLowerCase();
const allItems = document.querySelectorAll("#directoryTree li");

allItems.forEach(item => {
const text = item.textContent.toLowerCase();
const matches = text.includes(query);

  
item.style.display = matches ? "list-item" : "none";
if (matches) {
    let parent = item.parentElement;
    while (parent && parent.tagName === "UL") {
        parent.style.display = "block"; 
        parent = parent.parentElement; 
    }
}
});


allItems.forEach(item => {
const children = item.querySelectorAll("li");
const anyChildVisible = Array.from(children).some(child => child.style.display === "list-item");
if (anyChildVisible) {
item.style.display = "list-item";
}
});
}
const fileInput = document.getElementById("fileInput");
const fileContentsDiv = document.getElementById("fileContents");
const progressBar = document.getElementById("progressBar");

fileInput.addEventListener("change", function (event) {
    const file = event.target.files[0];
    if (file) {
        // Reset progress bar
        progressBar.style.width = "0%";
        progressBar.setAttribute("aria-valuenow", 0);
        progressBar.textContent = "0%";

        const reader = new FileReader();

        reader.onloadstart = function () {
            // Show progress bar container if hidden
            document.getElementById("progressBarContainer").style.display = "block";
        };

        reader.onprogress = function (e) {
            if (e.lengthComputable) {
                const percentLoaded = Math.round((e.loaded / e.total) * 100);
                progressBar.style.width = percentLoaded + "%";
                progressBar.setAttribute("aria-valuenow", percentLoaded);
                progressBar.textContent = percentLoaded + "%";
            }
        };

        reader.onload = function (e) {
            // Hide progress bar
            progressBar.style.width = "100%";
            progressBar.setAttribute("aria-valuenow", 100);
            progressBar.textContent = "100%";

            const content = e.target.result;
            displayFileContent(content, file.name);
        };

        reader.onerror = function () {
            alert("Error reading file!");
        };

        const fileExtension = file.name.split('.').pop().toLowerCase();
        if (fileExtension === 'csv') {
            reader.readAsText(file);
        } else if (fileExtension === 'xls' || fileExtension === 'xlsx') {
                    
            alert("Excel file processing is not implemented client-side. Please use CSV files.");
                  
        } else {
            alert("Unsupported file type. Please upload a CSV or Excel file.");
        }
    }
});

function displayFileContent(content, fileName) {
           
    const rows = content.split(/\r?\n/);
    if (rows.length === 0) {
        fileContentsDiv.innerHTML = `
            <div class="section-title">Excel File Contents</div>
            <p class="text-muted">No data found in the uploaded file.</p>
        `;
        return;
    }

    let tableHtml = `<div class="section-title">Excel File Contents (${fileName})</div><table class="table table-bordered"><thead><tr>`;

    // Handle headers
    const headers = rows[0].split(",");
    headers.forEach(header => {
        tableHtml += `<th>${header.trim()}</th>`;
    });
    tableHtml += `</tr></thead><tbody>`;

    // Handle data rows
    for (let i = 1; i < rows.length; i++) {
        const row = rows[i].trim();
        if (row) { // Skip empty lines
            const columns = row.split(",");
            tableHtml += `<tr>`;
            columns.forEach(col => {
                tableHtml += `<td>${col.trim()}</td>`;
            });
            tableHtml += `</tr>`;
        }
    }
    tableHtml += `</tbody></table>`;

    fileContentsDiv.innerHTML = tableHtml;
}

