                                <td class="@cssBg">@stagingMachine.DomainName</td>
                                <td class="@cssBg">@stagingMachine.NTUsername</td>
                                <td class="@cssBg">
                                    <button class="btn btn-sm custom-btn-sm btn-danger">Delete</button>
                                    <button class="btn btn-sm custom-btn-sm btn-success" id="edit-staging-btn" onclick="EditNewStagingEnting('@stagingMachine.DomainName', 'Machine')">Edit</button>
