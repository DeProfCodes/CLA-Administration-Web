                                            <label for="node2" class="tree-toggle-label">Member Of</label>
                                            <ul class="tree-content">
                                                <li>
                                                    <input type="checkbox" id="node2-1" class="tree-toggle">
                                                    <label for="node2-1" class="tree-toggle-label">Groups</label>
                                                    <ul class="tree-content">
                                                        <li>Corporate</li>
                                                        <li>Finance</li>
                                                    </ul>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Right Side: Members and Member Of -->
                            <div class="col-8">
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <div class="  section-title">Members</div>
                                        <div class="scroll-box">
                                                                                    <ul>
                                                <li>
