<!-- Card for Popup Report Body -->
<div class="card mb-1 mt-1 overview-filters-card app-card-main-scaling p-4" id="report-data-area">
<div id="SettingsData">
    <h3 class="w-100 text-center theme-txt-clr">
        Target <span id="StagingUserMachineTitle">Users</span>
