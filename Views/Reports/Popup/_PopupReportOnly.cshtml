@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.Models.APIResponses.Reports.Popup
@model PopupReportsViewModel

@{
    var summaryT = Model.PopupReportSummary;

    var completedRate = Math.Round(((double)summaryT.Show / summaryT.Targeted) * 100, 2);
    var outstandingRate = 100 - completedRate;

    var questionSummary = Model.PopupReportQuestionSummary;

    var questionSummaryData = new List<int> 
    { 
        questionSummary.ClickCount, questionSummary.DismissCount, questionSummary.AutohideCount, questionSummary.SnoozeCount, questionSummary.ShowCount
    };
    var questionSummaryTitles = new List<string> { "Click", "Dismiss", "AutoHide", "Snooze", "Show" };
    var questionSummaryColors = new List<string> { "blue", "orange", "crimson", "slate", "silver" };
    var totalSummaryQuestionEventsCount = questionSummaryData.Sum();
}

<input id="ModuleReportId" value="@Model.PopupId" hidden/>

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container">
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportResultTitle.cshtml",
                    new ModuleReportResultTitleViewModel
                    {
                        ReportTypeName = ReportsNamesType.Popup,
                        ReportTitle = summaryT.Title,
                        EffectiveFromDate = summaryT.EffectiveFrom,
                        EffectiveToDate = summaryT.EffectiveTo,
                        OnBackReportTabClickCallbackFunction = "GoBackToPopupReportTab"
                    });
                }
                <!-- 1. Popup Summary Tab -->
                <div id="PopupSummaryTab-1" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 d-flex">
                        <div class="w-50 align-content-center">
                            <table class="table table-bordered mb-0 w-75 theme-border">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                        <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="report-piechart-color-darkgreen-dim">Delivered</td>
                                        <td class="report-piechart-color-darkgreen-dim">@summaryT.Show</td>
                                        <td class="report-piechart-color-darkgreen-dim">@completedRate</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-crimson-dim">Not Delivered</td>
                                        <td class="report-piechart-color-crimson-dim">@summaryT.Outstanding</td>
                                        <td class="report-piechart-color-crimson-dim">@outstandingRate</td>
                                    </tr>
                                    <tr>
                                        <td>Targeted</td>
                                        <td>@summaryT.Targeted</td>
                                        <td>100</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div id="SummaryChart"></div>
                        </div>
                    </div>
                </div>
                <!-- 2. Popup Questions Summary -->
                <div id="PopupQuestionDetailsTab-2" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 d-flex">
                        <div class="w-50 align-content-center">
                            <table class="table table-bordered mb-0 w-75 theme-border">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                        <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for(int i=0; i < questionSummaryTitles.Count; i++)
                                    {
                                        var cssColor = $"report-piechart-color-{questionSummaryColors[i]}-dim";
                                        var rate = Math.Round(((double)questionSummaryData[i] / totalSummaryQuestionEventsCount) * 100.0, 2); 

                                        <tr>
                                            <td class="@cssColor">@questionSummaryTitles[i]</td>
                                            <td class="@cssColor">@questionSummaryData[i]</td>
                                            <td class="@cssColor">@rate</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div id="SummaryChart2"></div>
                        </div>
                    </div>
                </div>
                <!-- 3. Popup Response - SHOW Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupSHOW-3",
                        TableId = "Popup-SHOW",
                        DataSource = Model.PopupResponseShow,
                        DefaultFallBackType = typeof(PopupReportResponseDetails),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
                <!-- 4. Popup Response - Click Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupCLICK-4",
                        TableId = "Popup-CLICK",
                        DataSource = Model.PopupResponseClick,
                        DefaultFallBackType = typeof(PopupReportResponseDetails),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
                <!-- 5. Popup Response - Snooze Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupSNOOZE-5",
                        TableId = "Popup-SNOOZE",
                        DataSource = Model.PopupResponseSnooze,
                        DefaultFallBackType = typeof(PopupReportResponseDetails),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
                <!-- 6. Popup Response - AutoHide Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupAUTOHIDE-6",
                        TableId = "Popup-AUTOHIDE",
                        DataSource = Model.PopupResponseAutoHide,
                        DefaultFallBackType = typeof(PopupReportResponseDetails),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
                <!-- 7. Popup Response - AutoHide Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupDISMISS-7",
                        TableId = "Popup-DISMISS",
                        DataSource = Model.PopupResponseDismiss,
                        DefaultFallBackType = typeof(PopupReportResponseDetails),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
                <!-- 8. Popup Outstanding Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PopupOutstanding-8",
                        TableId = "Popup-Outstanding",
                        DataSource = Model.PopupReportOutstanding,
                        DefaultFallBackType = typeof(PopupReportOutstanding),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    var responseBreakdownType = { DivId: "", Title: "" };
    var backToDivId = "PopupSummaryTab-1";
    var activeReportTab = "";

    $(document).ready(function ()
    {
        LoadAllPageData();
        PopupSummaryTab();
    });

    function LoadAllPageData()
    {
        //Load Popup Summary
        let apexPieChart = null;

        var completed = parseInt("@summaryT.Show");
        var outstanding = parseInt("@summaryT.Outstanding");

        var data = [completed, outstanding];
        var pieDataLabel = ["Delivered", "Not Delivered"];
        var colorsData = ["#067349", "#DC143C"];

        var dimension = new DimensionType(500);

        DrawPieChart(apexPieChart, "#SummaryChart", data, pieDataLabel, colorsData, dimension, onPieSummaryLabelClick, "#%");

        //Load Popup Question Summary
        let apexPieChart2 = null;

        var click = parseInt("@questionSummary.ClickCount");
        var dismiss = parseInt("@questionSummary.DismissCount");
        var autoHide = parseInt("@questionSummary.AutohideCount");
        var snooze = parseInt("@questionSummary.SnoozeCount");
        var show = parseInt("@questionSummary.ShowCount");

        data = [click, dismiss, autoHide, snooze, show];
        pieDataLabel = ["Click", "Dismiss", "AutoHide", "Snooze", "Show"];
        colorsData = ["#4169E1", "#FF8C00", "#DC143C", "#2F4F4F", "#C0C0C0"];

        DrawPieChart(apexPieChart2, "#SummaryChart2", data, pieDataLabel, colorsData, dimension, onPieQuestionSummaryLabelClick, "#");

        //Data Tables
        // $("#Popup-SHOW").DataTable();
        // $("#Popup-CLICK").DataTable();
        // $("#Popup-SNOOZE").DataTable();
        // $("#Popup-AUTOHIDE").DataTable();
        // $("#Popup-DISMISS").DataTable();
        // $("#Popup-Outstanding").DataTable();
    }


    function PopupSummaryTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.HIDE);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#PopupSummaryTab-1", HideShow.SHOW);

        $("#ModuleReportSubTitle").text("Popup Summary");
        $("#ModuleReportActiveReport").val("summary");
    }

    function QuestionsSummaryTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        
        HideShowElement("#PopupQuestionDetailsTab-2", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("SummaryTab");

        $("#ModuleReportSubTitle").text("Response Summary");
        $("#ModuleReportActiveReport").val("response_summary");
    }

    function ResponseBreakdownTypeTab()
    {
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);
        
        HideShowElement(responseBreakdownType.DivId, HideShow.SHOW);

        var title = `Response_Breakdown-${responseBreakdownType.Title}`;
        $("#ModuleReportActiveReport").val(title.toLowerCase());

        $("#ModuleReportSubTitle").text(title);

        $("#ModuleReportGoBackDiv").val("QuestionDetailsTab");
    }

    function onPieQuestionSummaryLabelClick(label)
    {
        if (label === 'Click') responseBreakdownType.DivId = "#PopupCLICK-4";
        else if (label === 'Snooze') responseBreakdownType.DivId = "#PopupSNOOZE-5";
        else if (label === 'AutoHide') responseBreakdownType.DivId = "#PopupAUTOHIDE-6";
        else if (label === 'Dismiss') responseBreakdownType.DivId = "#PopupDISMISS-7";
        else if (label === 'Show') responseBreakdownType.DivId = "#PopupSHOW-3";

        responseBreakdownType.Title = label;

        ResponseBreakdownTypeTab();
    }

    function OutstandingTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);
        HideShowElement("#PopupOutstanding-8", HideShow.SHOW);

        $("#ModuleReportSubTitle").text("Outstanding Response Breakdown - No Show");

        $("#ModuleReportGoBackDiv").val("SummaryTab");
        $("#ModuleReportActiveReport").val("noshow");
    }

    function onPieSummaryLabelClick(label)
    {
        if (label === 'Delivered')
        {
            QuestionsSummaryTab();
        }
        else if (label === 'Not Delivered')
        {
            OutstandingTab();
        }
    }

    function GoBackToPopupReportTab(destinationDiv)
    {
        if (destinationDiv == "SummaryTab")
        {
            PopupSummaryTab();
        }
        else if(destinationDiv == "QuestionDetailsTab")
        {
            QuestionsSummaryTab();
        }
    }


</script>