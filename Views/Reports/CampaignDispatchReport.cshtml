<script>



    function LoadCampaignReports()
    {
        var payload = {
            LockscreenReport: IsCheckboxChecked("LockscreensCampaign"),
            DesktopReport: IsCheckboxChecked("DesktopCampaign"),
            ScreensaverReport: IsCheckboxChecked("ScreensaverCampaign"),
            PopupReport: IsCheckboxChecked("PopupCampaign"),
            SurveyReport: IsCheckboxChecked("SurveyCampaign"),
            TickerReport: IsCheckboxChecked("TickersCampaign"),
            StartDate: $('#DatePickerStartDate').val(),
            EndDate: $('#DatePickerEndDate').val(),
            ViewType: $('#CampaignViewType').val()
        };

        var noneSelected = !payload.LockscreenReport && !payload.DesktopReport && !payload.ScreensaverReport && !payload.PopupReport && !payload.SurveyReport && !payload.TickerReport;

        if (noneSelected)
        {
            swal("Campaign Report Error", "Please select at least one module to generate report for.", "error");
        }
        else
        {

        }
    }


</script>