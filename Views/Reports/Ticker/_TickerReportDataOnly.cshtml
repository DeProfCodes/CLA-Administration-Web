@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.Models.APIResponses.Reports.Ticker
@model TickerReportsViewModel

@{
    var summaryT = Model.TickerReportSummary;

    var completedRate = summaryT != null ? Math.Round(((double)summaryT.Completed / summaryT.Targeted) * 100, 2) : 0;
    var outstandingRate = summaryT != null ? 100 - completedRate : 0;
}

<input id="ModuleReportId" value="@Model.TickerId" hidden />
<input id="ModuleReportActiveReport" hidden />

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container">
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportResultTitle.cshtml",
                    new ModuleReportResultTitleViewModel
                    {
                        ReportTypeName = ReportsNamesType.Ticker,
                        ReportTitle = summaryT.TickerText,
                        EffectiveFromDate = summaryT.EffectiveFrom,
                        EffectiveToDate = summaryT.EffectiveTo,
                        OnBackReportTabClickCallbackFunction = "GoBackToTickerReportTab"
                    });
                }
                <!-- 1. Ticker Summary Tab -->
                <div id="TickerSummaryTab-1" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 mt-5 d-flex" >
                        <div class="w-50 align-content-center">
                            <table class="table table-bordered mb-0 w-75 theme-border" >
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                        <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="report-piechart-color-darkgreen-dim">Completed</td>
                                        <td class="report-piechart-color-darkgreen-dim">@summaryT.Completed</td>
                                        <td class="report-piechart-color-darkgreen-dim">@completedRate</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-crimson-dim">Outstanding</td>
                                        <td class="report-piechart-color-crimson-dim">@summaryT.Outstanding</td>
                                        <td class="report-piechart-color-crimson-dim">@outstandingRate</td>
                                    </tr>
                                    <tr>
                                        <td>Targeted</td>
                                        <td>@summaryT.Targeted</td>
                                        <td>100</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div id="SummaryChart"></div>
                        </div>
                    </div>
                </div>
                <!-- 2. Ticker Outstanding Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "TickerOutstandingTab-2",
                        TableId = "TickerOutstandingData",
                        DataSource = Model.TickerReportOutstanding,
                        IsInitiallyHidden = true,
                        DefaultFallBackType = typeof(TickerReportOutstanding),
                        LastSyncDateColumnName = "MaxLastUpdateDate"
                    });
                }
                <!-- 3. Ticker Completed Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "TickerCompletedTab-3",
                        TableId = "TickerCompletedData",
                        DataSource = Model.TickerReportComplete,
                        DefaultFallBackType = typeof(TickerReportComplete),
                        LastSyncDateColumnName = "MaxLastUpdateDate",
                        IsInitiallyHidden = true
                    });
                }
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function()
    {
        LoadData();
        SummaryTab();
    });

    function LoadData()
    {
        //Summary
        let apexPieChart = null;

        var completed = parseInt("@summaryT.Completed");
        var outstanding = parseInt("@summaryT.Outstanding");

        var data = [completed, outstanding];
        var pieDataLabel = ["Completed", "Outstanding"];
        var colorsData = ["#067349", "#DC143C"];

        var dimension = new DimensionType(500);

        DrawPieChart(apexPieChart, "#SummaryChart", data, pieDataLabel, colorsData, dimension, onPieChartLabelClick, "#%");

        //DataTables
        $('#ModuleOverviewDataTable').DataTable();
        $('#ModuleOverviewDataTable2').DataTable();
    }

    function SummaryTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.HIDE);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#TickerSummaryTab-1", HideShow.SHOW);
        
        $("#ModuleReportSubTitle").text("Ticker Summary");
        $("#ModuleReportActiveReport").val("summary");
    }

    function OutstandingTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#TickerOutstandingTab-2", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("#TickerSummaryTab-1");

        $("#ModuleReportSubTitle").text("Outstanding Ticker Breakdown");
        $("#ModuleReportActiveReport").val("outstanding");
    }

    function CompletedTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#TickerCompletedTab-3", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("#TickerSummaryTab-1");

        $("#ModuleReportSubTitle").text("Completed Ticker Breakdown");
        $("#ModuleReportActiveReport").val("completed");
    }

    function onPieChartLabelClick(label)
    {
        if (label === 'Completed')
        {
            CompletedTab();
        } 
        else if (label === 'Outstanding')
        {
            OutstandingTab();
        }
    }

    function GoBackToTickerReportTab(destinationDiv)
    {
        SummaryTab();
    }

</script>