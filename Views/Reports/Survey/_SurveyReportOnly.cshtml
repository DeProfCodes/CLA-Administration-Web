@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.Models.APIResponses.Reports.Survey
@using CLA_Administration_Web.ViewModels.Reports.Survey
@model SurveyReportViewModel

@{
    //Summary
    var summary = Model.SurveySummary;

    var completedRate = Math.Round(((double)summary.Complete/ summary.Targeted) * 100, 2);
    var outstandingRate = Math.Round(((double)summary.Outstanding / summary.Targeted) * 100, 2);
    var optInRate = Math.Round(((double)summary.OptIn / summary.Targeted) * 100, 2);

    int index = 0;
}

<input id="ModuleReportId" value="@Model.SurveyId" hidden />
<input id="ModuleReportActiveReport" hidden />

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container">
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportResultTitle.cshtml",
                    new ModuleReportResultTitleViewModel
                    {
                        ReportTypeName = ReportsNamesType.Survey,
                        ReportTitle = Model.SurveySummary.SurveyTitle,
                        EffectiveFromDate = Model.SurveySummary.EffFrom,
                        EffectiveToDate = Model.SurveySummary.EffTo,
                        OnBackReportTabClickCallbackFunction = "GoBackToSurveyReportTab"
                    });
                }
                <!-- 1. Survey Summary Tab -->
                <div id="SurveySummaryTab-1" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 mt-5 d-flex">
                        <div class="w-50 mt-3">
                            <table class="table table-bordered mb-0 w-75 theme-border">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                        <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="report-piechart-color-crimson-dim">Outstanding</td>
                                        <td class="report-piechart-color-crimson-dim">@summary.Outstanding</td>
                                        <td class="report-piechart-color-crimson-dim">@outstandingRate</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-blue-dim">Opt In</td>
                                        <td class="report-piechart-color-blue-dim">@summary.OptIn</td>
                                        <td class="report-piechart-color-blue-dim">@optInRate</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-darkgreen-dim">Completed</td>
                                        <td class="report-piechart-color-darkgreen-dim">@summary.Complete</td>
                                        <td class="report-piechart-color-darkgreen-dim">@completedRate</td>
                                    </tr>
                                    <tr>
                                        <td>Targeted</td>
                                        <td>@summary.Targeted</td>
                                        <td>100</td>
                                    </tr>
                                    <tr>
                                        <td class="">Response Duration</td>
                                        <td class="">@summary.AverageDurationSeconds</td>
                                        <td class=""></td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-bordered table-stripped mb-0 w-75 mt-5 w-fit-content" id="SummarizedDetailsData">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Survey ID</th>
                                        <th scope="col" class="theme-bg text-white">User ID</th>
                                        <th scope="col" class="theme-bg text-white">Machine ID</th>
                                        <th scope="col" class="theme-bg text-white">Opt In</th>
                                        <th scope="col" class="theme-bg text-white">Is Survey Complete</th>
                                        <th scope="col" class="theme-bg text-white">Response Duration</th>
                                        <th scope="col" class="theme-bg text-white">View Response</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.SummarizedDetails)
                                    {
                                        var css = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                                        <tr>
                                            <td class="@css">@Model.SurveyId</td>
                                            <td class="@css">@item.UserId</td>
                                            <td class="@css">@item.MachineId</td>
                                            <td class="@css">@item.OptIn</td>
                                            <td class="@css">@item.IsComplete</td>
                                            <td class="@css">@item.DurationSeconds</td>
                                            <td class="@css"><button class="btn btn-sm btn-info" onclick="ViewResponseClick()">View</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div class="mx-auto w-fit-content" id="SummaryChart"></div>
                        </div>
                    </div>
                </div>
                <!-- 2. Survey Complete Opt Out Tab -->
                <div id="SurveyCompleteOptOutTab-2" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 mt-5 d-flex">
                        <div class="w-50 mt-3">
                            <table class="table table-bordered mb-0 w-75 theme-border">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="report-piechart-color-silver-dim">Complete</td>
                                        <td class="report-piechart-color-silver-dim">@Model.SurveyCompleteOptOut.Complete</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-blue-dim">Opt Out</td>
                                        <td class="report-piechart-color-blue-dim">@Model.SurveyCompleteOptOut.OptOut</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div class="mx-auto w-fit-content" id="CompleteAndOptOut"></div>
                        </div>
                    </div>
                </div>
                <!-- Survey Opt In No Response Tab -->
                <div id="SurveyOptInNoResponseTab" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 mt-5 d-flex">
                        <div class="w-50 mt-3">
                            <table class="table table-bordered mb-0 w-75 theme-border">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Event</th>
                                        <th scope="col" class="theme-bg text-white">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="report-piechart-color-silver-dim">No Response</td>
                                        <td class="report-piechart-color-silver-dim">@Model.SurveyOptInNoResponse.NoResponse</td>
                                    </tr>
                                    <tr>
                                        <td class="report-piechart-color-blue-dim">Partial Response</td>
                                        <td class="report-piechart-color-blue-dim">@Model.SurveyOptInNoResponse.PartialResponse</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="w-50">
                            <div class="mx-auto w-fit-content" id="OptInNoResponseChart"></div>
                        </div>
                    </div>
                </div>
                <!-- Survey Outstanding Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "SurveyOutstandingTab",
                        TableId = "SurveyOutstandingData",
                        DataSource = Model.Outstanding,
                        IsInitiallyHidden = true,
                        DefaultFallBackType = typeof(SurveyReportSummaryDetails),
                        LastSyncDateColumnName = "LastSyncDate"
                    });
                }
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        LoadData();
        SummaryTab();
    });

    function LoadData()
    {
        //Summary
        let apexPieChart1 = null;
        let apexPieChart2 = null;
        let apexPieChart3 = null;

        var completed = parseInt("@Model.SurveySummary.Complete");
        var outstanding = parseInt("@Model.SurveySummary.Outstanding");
        var optIn = parseInt("@Model.SurveySummary.OptIn");

        var data = [completed, outstanding, optIn];
        var pieDataLabel = ["Complete", "Outstanding", "Opt In"];
        var colorsData = [ReportColorsTypes.GREEN, ReportColorsTypes.RED, ReportColorsTypes.BLUE];

        var dimension = new DimensionType(500);

        DrawPieChart(apexPieChart1, "#SummaryChart", data, pieDataLabel, colorsData, dimension, onSummaryPieChartLabelClick, "#%");

        //Complete & Opt Out
        var complete = parseInt("@Model.SurveyCompleteOptOut.Complete");
        var optOut = parseInt("@Model.SurveyCompleteOptOut.OptOut");

        data = [complete, optOut];
        pieDataLabel = ["Complete", "Opt Out"];
        colorsData = [ReportColorsTypes.SILVER, ReportColorsTypes.BLUE];
        dimension = new DimensionType(500);

        DrawPieChart(apexPieChart2, "#CompleteAndOptOut", data, pieDataLabel, colorsData, dimension, onSurveyCompleteOptOutPieChartLabelClick, "#");

        //Opt In No Response
        var noResponse = parseInt("@Model.SurveyOptInNoResponse.NoResponse");
        var partialResponse = parseInt("@Model.SurveyOptInNoResponse.PartialResponse");

        data = [noResponse, partialResponse];
        pieDataLabel = ["No Response", "Partial Response"];
        colorsData = [ReportColorsTypes.SILVER, ReportColorsTypes.BLUE];
        dimension = new DimensionType(500);

        DrawPieChart(apexPieChart3, "#OptInNoResponseChart", data, pieDataLabel, colorsData, dimension, onSurveyOptInNoResponsePieChartLabelClick, "#%");

        $(document).ready(function ()
        {
            $('#SummarizedDetailsData').DataTable({
                dom: 'rtip',   // Removes the search box and length menu
                pageLength: 10 // Sets a default page length if desired
            });
        });
    }

    function SummaryTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.HIDE);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#SurveySummaryTab-1", HideShow.SHOW);

        $("#ModuleReportSubTitle").text("Survey Summary");
        $("#ModuleReportActiveReport").val("summary");
    }

    function OutstandingTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#SurveyOutstandingTab", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("SurveySummary");
        $("#ModuleReportSubTitle").text("Outstanding Responses Breakdown");
        $("#ModuleReportActiveReport").val("outstanding");
    }

    function CompleteAndOptOutTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#SurveyCompleteOptOutTab-2", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);

        $("#ModuleReportGoBackDiv").val("SurveySummary");
        $("#ModuleReportSubTitle").text("Survey Complete & Opt Out");
        $("#ModuleReportActiveReport").val("completeAndOptOut");
    }

    function OptInNoResponse()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#SurveyOptInNoResponseTab", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("SurveySummary");
        $("#ModuleReportSubTitle").text("Survey Opt In No Response");
        $("#ModuleReportActiveReport").val("optInNoResponse");
    }

    function OptInNoResponseClick()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);

        $("#ModuleReportSubTitle").text("");
        $("#ModuleReportGoBackDiv").val("OptInNoResponse");
    }

    function CompleteOptOutClick()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);

        $("#ModuleReportSubTitle").text("");
        $("#ModuleReportGoBackDiv").val("CompleteOptOut");
    }

    function ViewResponseClick()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);

        $("#ModuleReportSubTitle").text("");
        $("#ModuleReportGoBackDiv").val("SurveySummary");
    }

    function onSummaryPieChartLabelClick(label)
    {
        if (label === 'Complete')
        {
            CompleteAndOptOutTab();
        }
        else if (label === 'Outstanding')
        {
            OutstandingTab();
        }
        else if (label === "Opt In")
        {
            OptInNoResponse();
        }
    }

    function onSurveyCompleteOptOutPieChartLabelClick(label)
    {
        if (label === 'Complete')
        {
            CompleteOptOutClick()
        }
        else if (label === 'Opt Out')
        {
            CompleteOptOutClick()
        }
    }

    function onSurveyOptInNoResponsePieChartLabelClick(label)
    {
        if (label === 'No Response')
        {
            OptInNoResponseClick();
        }
        else if (label === 'Partial Response')
        {
            OptInNoResponseClick();
        }
    }

    function GoBackToSurveyReportTab(destinationDiv)
    {
        if (destinationDiv == "SurveySummary")
        {
            SummaryTab();
        }
        else if (destinationDiv == "OptInNoResponse")
        {
            OptInNoResponse();
        }
        else if (destinationDiv == "CompleteOptOut")
        {
            CompleteAndOptOutTab();
        }
    }


</script>