@model SurveyReportsRaw

<div class="card-body p-1 pb-0">
    <!-- Report Type -->
    <div class="row mt-1">
        <div class="btn-group w-auto overview-filter-btn-group mx-auto">
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-1" id="SummaryLink-1" onclick="NavigateToPopupReportTab(1)">Survey Summary</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-2" id="ResponseSummaryLink-2" onclick="NavigateToPopupReportTab(2)">Survey Outstanding</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-3" id="ResponseClikcLink-3" onclick="NavigateToPopupReportTab(3)">Opt In No Response</button>
            <button class="btn custom-btn-group report-tab-type popup-report-type-nav T-4" id="ResponseDismissLink-4" onclick="NavigateToPopupReportTab(4)">Survey Opt Out</button>
        </div>
    </div>
</div>

<div class="report-outter-container">
    <div class="card-body p-1">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container px-5">
                <!-- 1. Survey Summary Tab -->
                <div id="SurveySummaryTab-1" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Summary)
                    </div>
                </div>
                <!-- 2. Survey Outstanding Tab -->
                <div id="SurveyOutstandingTab-2" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.Outstanding)
                    </div>
                </div>
                <!-- 3. Survey Opt In No Response Tab -->
                <div id="SurveyOptInNoResponseTab-3" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.OptInNoResponse)
                    </div>
                </div>
                <!-- 4. Survey Opt out Tab -->
                <div id="SurveyOptOutTab-4" class="report-module-tabs-popup hidden">
                    <div class="report-raw-data">
                        @Html.Raw(Model.OptOut)
                    </div>
                </div>
               
                <!-- Navigation Buttons -->
                <div class="row fix-content-bottom">
                    <div class="col-12 ">
                        <div class="pagination-section flex-column flex-md-row  text-center align-content-center justify-content-center ">
                            <button class="btn section-nav-btns hidden" id="ReportPrevTabBtn" onclick="PreviousReportTab()">Back</button>
                            <button class="btn section-nav-btns ms-3" id="ReportNextTabBtn" onclick="NextReportTab()">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function()
    {
        NavigateToPopupReportTab(1);
    });

</script>