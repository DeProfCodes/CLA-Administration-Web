@model TroubleshootReportViewModel

@{
    var connectServer = ""; 
    var lastSyncLast3Days = "";
    var lastDBSync = "";
    var userMachine = "";
    var ipAddress = "";
    var syncVersion = "";
    var msdimVersion = "";
    var svcVersion = "";
    var activeConns = "";
    var lastPopup = "";
    var lastPopupDisplay = "";
    var lastSurvey = "";
    var lastSurveyDisplay = "";

    var network = "";
    var screenTime = "";
    var popupTime = "";
    var desktopTime = "";
    var ticker = "";
    var syncTime = "";
    var syncFrom = "";
    var syncTo = "";
    var allowTickerLaunch = false;
    var updateFuture = false;
    var passProtectScr = false;
    var allowUserChangeScre = false;
    var allowUserChangeDesk = false;
    var enableErrorLog = false;
    var aspectRatio = false;
    var impresionLog = false;
    var audio = false;
    var useMachineId = false;

    var surveyTargeting = "module-not-targeted";
    var popupTargeting = "module-not-targeted";
    var tickerTargeting = "module-not-targeted";
    var screensaverTargeting = "module-not-targeted";
    var desktopTargeting = "module-not-targeted";
    var lockscreenTargeting = "module-not-targeted";

    var usersGroups = "";

    var bgRedCss = "";
    var bgGreenCss = "";

    if (!Model.IsBlank)
    {
        var lastSyncDetails = Model.LastSyncDetails;

        if (lastSyncDetails != null)
        {
            connectServer = Model.ConnectedToLive ? "Connected to Live" : "Connected to Staging";
            lastSyncLast3Days = (lastSyncDetails.LastUpdateDT >= DateTime.Now.AddDays(-3) && lastSyncDetails.LastUpdateDT <= DateTime.Now) ? "Yes" : "No";
            lastDBSync = lastSyncDetails.LastUpdateDT?.ToString("yyyy/MM/dd HH:mm:ss") ?? "";
            userMachine = lastSyncDetails.MachineID;
            ipAddress = lastSyncDetails.IPAddress;
            syncVersion = lastSyncDetails.MSDIMSYNCVersion?.ToString("yyyy/MM/dd");
            msdimVersion = lastSyncDetails.MSDIMVersion?.ToString("yyyy/MM/dd");
            svcVersion = lastSyncDetails.MSDIMSVCVersion?.ToString("yyyy/MM/dd");
            activeConns = "1/100";
            lastPopup = $"({lastSyncDetails.LastSurveyID}) {lastSyncDetails.PopupTitle}";
            lastPopupDisplay = lastSyncDetails.LastSTMDT?.ToString("yyyy/MM/dd HH:mm:ss");
            lastSurvey = $"({lastSyncDetails.LastSurveyID}) {lastSyncDetails.SurveyTitle}";
            lastSurveyDisplay = lastSyncDetails.LastSurveyDT?.ToString("yyyy/MM/dd HH:mm:ss");

            bgRedCss = "bg-red";
            bgGreenCss = "bg-success";
        }

        var settings = Model.Settings;

        if (settings != null)
        {
            network = settings.Network;
            screenTime = settings.ScreensaverTimeout?.ToString() ?? "";
            popupTime = settings.PopUpTimeout?.ToString() ?? "";
            desktopTime = settings.DesktopTimeout?.ToString() ?? "";
            ticker = settings.TickerTimeout?.ToString() ?? "";
            syncTime = settings.SyncTimeout?.ToString() ?? "";
            syncFrom = settings.SyncTimeslotFrom;
            syncTo = settings.SyncTimeslotTo;
            allowTickerLaunch = settings.AllowTickerToLaunchAutomatically == 1;
            updateFuture = settings.UpdateFutureContent == 1;
            passProtectScr = settings.ScreenSaverIsSecure == 1;
            allowUserChangeScre = settings.PolicyControlledScreensaver == 1;
            allowUserChangeDesk = settings.DesktopIsSecure == 1;
            enableErrorLog = settings.ErrorLogging == 1;
            aspectRatio = settings.MaintainAspectRatio == 1;
            impresionLog = settings.ImpressionLogging == 1;
            audio = settings.UseAudio == "1";
            useMachineId = settings.UseMachineID == 1;
        }

        var targeting = Model.Targeting;

        if (targeting != null)
        {
            surveyTargeting = targeting.FirstOrDefault(x => x.Destination == "SURVEYS")?.CNT > 0 ? "module-targeted" : "module-not-targeted";
            popupTargeting = targeting.FirstOrDefault(x => x.Destination == "POPUPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
            tickerTargeting = targeting.FirstOrDefault(x => x.Destination == "TICKERS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
            screensaverTargeting = targeting.FirstOrDefault(x => x.Destination == "SEQUENCES")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
            desktopTargeting = targeting.FirstOrDefault(x => x.Destination == "DESKTOPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
            lockscreenTargeting = targeting.FirstOrDefault(x => x.Destination == "LOCKED DESKTOPS")?.CNT > 0 ? "module-targeted" : "module-not-targeted"; ;
        }

        var users = Model.UserGroups.Select(x => x.GroupID);
        if (users != null)
        {
            usersGroups = string.Join(Environment.NewLine, users);
        }
    }
}

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container d-flex" style="width:100%">
                <div class="w-50">
                    <div class="w-100 d-flex">
                        <div class="w-50 border border-1 border-light p-3 pe-0 m-1 mt-4 fs-12">
                            <p class="custom-p fw-bold fs-14">Last Sync Details</p>
                            <p class="mb-0 fw-bold fs-20 bg-silver text-danger px-2">@connectServer</p>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center">CLA Active In Last 3 Days?</p>
                                <input class="custom-input-text w-75p ms-2 h-25p @bgRedCss" type="text" id="ClaLast3Days" value="@lastSyncLast3Days" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">Last SYNC to DB</p>
                                <input class="custom-input-text w-150p ms-2 h-25p @bgRedCss" type="text" id="LastDBSync" value="@lastDBSync" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">Using Machine</p>
                                <input class="custom-input-text w-150p ms-2 h-25p" type="text" id="UsingMachine" value="@userMachine"/>
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">With IP Address</p>
                                <input class="custom-input-text w-150p ms-2 h-25p" type="text" id="WithIPAddress" value="@ipAddress" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">SYNC Version</p>
                                <input class="custom-input-text w-150p ms-2 h-25p @bgRedCss" type="text" id="SyncVersion" value="@syncVersion" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">MSDIM Version</p>
                                <input class="custom-input-text w-150p ms-2 h-25p @bgRedCss" type="text" id="MSDIMVersion" value="@msdimVersion" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center w-125p">SVC Version</p>
                                <input class="custom-input-text w-150p ms-2 h-25p @bgRedCss" type="text" id="SVCVersion" value="@svcVersion" />
                            </div>
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center">#Active Connections</p>
                                <input class="custom-input-text w-150p ms-2 h-25p @bgGreenCss" type="text" id="ActiveCOnnections" value="@activeConns" />
                            </div>
                        </div>
                        <div class="w-50 p-3 m-3 mt-4 border border-1 border-light">
                            <p class="custom-p fw-bold fs-14">Group Membership</p>
                            <textarea class="custom-input-textarea w-100" rows="5">@usersGroups</textarea>
                            <div>
                                <p class="custom-p fw-bold fs-14">Targeted For Today</p>
                                <div class="border border-1 border-light">
                                    <div class="d-flex mt-2">
                                        <div class="w-150p">
                                            <p class="custom-p text-center">Survey</p>
                                            <div class="targeting-circle @surveyTargeting mx-auto mt-1" id="SurveyTargeting"></div>
                                        </div>
                                        <div class="w-150p me-2">
                                            <p class="custom-p text-center">Popup</p>
                                            <div class="targeting-circle @popupTargeting mx-auto mt-1" id="PopupTargeting"></div>
                                        </div>
                                        <div class="w-150p me-2">
                                            <p class="custom-p text-center">Ticker</p>
                                            <div class="targeting-circle @tickerTargeting mx-auto mt-1" id="TickerTargeting"></div>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2 mb-2">
                                        <div class="w-150p">
                                            <p class="custom-p text-center">Screensaver</p>
                                            <div class="targeting-circle @screensaverTargeting mx-auto mt-1" id="ScreensaverTargeting"></div>
                                        </div>
                                        <div class="w-150p me-2">
                                            <p class="custom-p text-center">Desktop</p>
                                            <div class="targeting-circle @desktopTargeting mx-auto mt-1" id="DesktopTargeting"></div>
                                        </div>
                                        <div class="w-150p me-2">
                                            <p class="custom-p text-center">Lockscreen</p>
                                            <div class="targeting-circle @lockscreenTargeting mx-auto mt-1" id="LockscreenTargeting"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-100">
                        <div class="border border-1 border-light p-3 m-3 pe-0 mt-2 fs-12">
                            <p class="custom-p fw-bold fs-14">Effective Settings</p>
                            <div class="d-flex">
                                <div class="w-50 mt-2">
                                    <div class="d-flex">
                                        <p class="custom-p align-content-center">Network</p>
                                        <input class="custom-input-text w-75p ms-2 h-25p" type="text" id="Network" value="@network"/>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Screensaver Timeout (Seconds)</p>
                                        <input class="custom-input-text w-75p ms-2 h-25p" type="text" id="ScreensaverTimeoutSec" value="@screenTime" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Popup Timeout (Seconds)</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="PopupTimeoutSec" value="@popupTime" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Desktop Timeout (Seconds)</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="DesktopTimeout" value="@desktopTime" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Ticker Timeout (Seconds)</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="TickerTimeout" value="@ticker"/>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Sync Timeout (Seconds)</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="SyncTimeout" value="@syncTime" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Sync Timeslot From</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="SyncTimeslotFrom" value="@syncFrom" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center">Sync Timeslot To</p>
                                        <input class="custom-input-text w-100p ms-2 h-25p" type="text" id="SyncTimeslotTo" value="@syncTo" />
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Allow Ticker to Launch Automatically</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-1 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(allowTickerLaunch ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Update Future Content</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-1 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(updateFuture ? "checked" : "")>
                                        </div>
                                    </div>
                                </div>
                                <div class="w-50 mt-2">
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Password Protect Screensaver</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(passProtectScr ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Allow User To Change Screensaver</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(allowUserChangeScre ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Allow User To Override Desktop</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(allowUserChangeDesk ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Enable Error Logging</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(enableErrorLog ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Maintain Aspect Ratio</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(aspectRatio ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Enable Impression Logging</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(impresionLog ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Use Audio</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(audio ? "checked" : "")>
                                        </div>
                                    </div>
                                    <div class="d-flex mt-2">
                                        <p class="custom-p align-content-center" style="opacity:0.5">Use Machine ID</p>
                                        <div class="form-check form-switch w-fit-content mb-0 align-content-center ms-2 align-check">
                                            <input class="form-check-input" type="checkbox" id="TickersCampaign" disabled @(useMachineId ? "checked" : "")>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-50">
                    <div class="w-100">
                        <div class="w-100 p-3 m-1 mt-4 border border-1 border-light">
                            <p class="custom-p fw-bold fs-14">Active Popups (Current)</p>
                            <textarea class="custom-input-textarea w-100" rows="5"></textarea>
                        </div>
                    </div>
                    <div class="w-100">
                        <div class="w-100 p-3 m-1 mt-1 border border-1 border-light">
                            <p class="custom-p fw-bold fs-14">Last Popup Details</p>
                            <p class="custom-p align-content-center mt-2">Popup</p>
                            <input type="text" class="custom-input-text w-100" value="@lastPopup" />
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center">Displayed</p>
                                <input class="custom-input-text w-150p ms-2 h-25p" type="text" id="WithIPAddress" value="@lastPopupDisplay" />
                            </div>
                        </div>
                    </div>
                    <div class="w-100">
                        <div class="w-100 p-3 m-1 mt-4 border border-1 border-light">
                            <p class="custom-p fw-bold fs-14">Active Surveys (Current)</p>
                            <textarea class="custom-input-textarea w-100" rows="5"></textarea>
                        </div>
                    </div>
                    <div class="w-100">
                        <div class="w-100 p-3 m-1 mt-1 border border-1 border-light">
                            <p class="custom-p fw-bold fs-14">Last Survey Details</p>
                            <p class="custom-p align-content-center mt-2">Survey</p>
                            <input type="text" class="custom-input-text w-100" value="@lastSurvey" />
                            <div class="d-flex mt-2">
                                <p class="custom-p align-content-center">Displayed</p>
                                <input class="custom-input-text w-150p ms-2 h-25p" type="text" id="WithIPAddress" value="@lastSurveyDisplay" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>


</script>
