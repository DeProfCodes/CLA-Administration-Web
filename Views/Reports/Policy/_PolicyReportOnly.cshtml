@using CLA_Administration_Web.Helpers.Html
@using CLA_Administration_Web.Models.APIResponses.Reports.Policy
@using CLA_Administration_Web.ViewModels.Reports.Policy
@model PolicyReportViewModel

@{
    int index = 0;

    //User Summary
    var policySummaryUsers = Model.PolicySummary.SummaryUsers;
    var outstandingUserRate = ((double)policySummaryUsers.Outstanding / (double)(policySummaryUsers.Targeted)) * 100;

    var policySummaryMachines = Model.PolicySummary.SummaryMachines;
    var outstandingMachineRate = ((double)policySummaryMachines.Outstanding / (double)(policySummaryMachines.Targeted)) * 100;

    var effectiveFromDate = Model.PolicySummary.SummaryUsers?.EffectiveFrom != null ?
                                        Model.PolicySummary.SummaryUsers.EffectiveFrom :
                                        Model.PolicySummary.SummaryMachines.EffectiveFrom;

    var effectiveToDate = Model.PolicySummary.SummaryUsers?.EffectiveTo != null ?
                                        Model.PolicySummary.SummaryUsers.EffectiveTo :
                                        Model.PolicySummary.SummaryMachines.EffectiveTo;

}

<input id="ModuleReportId" value="@Model.PopupId" hidden />
<input id="ModuleReportActiveReport" hidden />

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container">
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportResultTitle.cshtml",
                    new ModuleReportResultTitleViewModel
                    {
                        ReportTypeName = ReportsNamesType.Policy,
                        ReportTitle = "",
                        EffectiveFromDate = effectiveFromDate ?? DateTime.Now,
                        EffectiveToDate = effectiveToDate ?? DateTime.Now,
                        OnBackReportTabClickCallbackFunction = "GoBackToPolicyReportTab"
                    });
                }
                <!-- 1. Policy Summary Tab -->
                <div id="PolicySummaryTab-1" class="report-module-tabs-module px-5 hidden">
                    <!-- Users Summary-->
                    <div class="report-raw-data ms-0 mt-1 mb-5 hidden" id="PolicyReportUserSummary">
                        <h3 class="custom-p fw-bold text-center">Users Summary</h3>
                        <div class="d-flex mt-3">
                            <div class="w-50 mt-3">
                                <table class="table table-bordered mb-0 w-75 theme-border">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="theme-bg text-white">Event</th>
                                            <th scope="col" class="theme-bg text-white">Count</th>
                                            <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="report-piechart-color-crimson-dim">Outstanding</td>
                                            <td class="report-piechart-color-crimson-dim">@policySummaryUsers.Outstanding</td>
                                            <td class="report-piechart-color-crimson-dim">@outstandingUserRate</td>
                                        </tr>
                                        <tr>
                                            <td class="report-piechart-color-green-dim">Completed</td>
                                            <td class="report-piechart-color-green-dim">@policySummaryUsers.Completed</td>
                                            <td class="report-piechart-color-green-dim">@(100-outstandingUserRate)</td>
                                        </tr>
                                        <tr>
                                            <td>Targeted</td>
                                            <td>@policySummaryUsers.Targeted</td>
                                            <td>100</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="w-50">
                                <div class="mx-auto w-fit-content" id="UsersSummaryChart"></div>
                            </div>
                        </div>
                        <div class="w-fit-content">
                            <h4 class="custom-p fw-bold text-center">Summarized Details - Users</h4>
                            <table class="table table-bordered table-stripped mb-0 w-75 mt-5 w-fit-content report-summarized-details-table" id="SummarizedUserDetailsData">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Summary Info</th>
                                        <th scope="col" class="theme-bg text-white">Last 30 Days Result</th>
                                        <th scope="col" class="theme-bg text-white">Since Popup Active Results</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PolicySummary.SummarizedDetailsUsers)
                                    {
                                        var css = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                                        <tr>
                                            <td class="@css">@item.SummaryInfo</td>
                                            <td class="@css">@item.Last30DaysResult</td>
                                            <td class="@css">@item.SincePopupActiveResult</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Machines Summary-->
                    <div class="report-raw-data ms-0 mt-1 mb-5 hidden" id="PolicyReportMachineSummary">
                        <h3 class="custom-p fw-bold text-center">Machines Summary</h3>
                        <div class="d-flex mt-3">
                            <div class="w-50 mt-3">
                                <table class="table table-bordered mb-0 w-75 theme-border">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="theme-bg text-white">Event</th>
                                            <th scope="col" class="theme-bg text-white">Count</th>
                                            <th scope="col" class="theme-bg text-white">Percentage (%)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="report-piechart-color-crimson-dim">Outstanding</td>
                                            <td class="report-piechart-color-crimson-dim">@policySummaryMachines.Outstanding</td>
                                            <td class="report-piechart-color-crimson-dim">@outstandingMachineRate</td>
                                        </tr>
                                        <tr>
                                            <td class="report-piechart-color-green-dim">Completed</td>
                                            <td class="report-piechart-color-green-dim">@policySummaryMachines.Completed</td>
                                            <td class="report-piechart-color-green-dim">@(100 - outstandingMachineRate)</td>
                                        </tr>
                                        <tr>
                                            <td>Targeted</td>
                                            <td>@policySummaryMachines.Targeted</td>
                                            <td>100</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="w-50">
                                <div class="mx-auto w-fit-content" id="MachinesSummaryChart"></div>
                            </div>
                        </div>
                        <div class="w-fit-content">
                            <h4 class="custom-p fw-bold text-center">Summarized Details - Machines</h4>
                            <table class="table table-bordered table-stripped mb-0 w-75 mt-5 w-fit-content report-summarized-details-table" id="SummarizedMachineDetailsData">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">Summary Info</th>
                                        <th scope="col" class="theme-bg text-white">Last 30 Days Result</th>
                                        <th scope="col" class="theme-bg text-white">Since Popup Active Results</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PolicySummary.SummarizedDetailsMachines)
                                    {
                                        var css = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
                                        <tr>
                                            <td class="@css">@item.SummaryInfo</td>
                                            <td class="@css">@item.Last30DaysResult</td>
                                            <td class="@css">@item.SincePopupActiveResult</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Policy Outstanding Tab -->
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportTable.cshtml",
                    new ReportDataTableViewInputsViewModel
                    {
                        ComponentId = "PolicyOutstandingTab",
                        TableId = "PolicyOutstandingData",
                        DataSource = Model.PolicyOutstanding.PolicyOutstandingSelected,
                        IsInitiallyHidden = true,
                        DefaultFallBackType = typeof(PolicyReportOutstanding),
                        LastSyncDateColumnName = "LastSyncDate"
                    });
                }
                <div id="PolicyCompleteTab-3" class="report-module-tabs-module px-5 hidden">
                    <div class="report-raw-data ms-0 mt-1 mb-5">
                        <h3 class="custom-p fw-bold">Response Summary</h3>
                        <div class="d-flex mt-3">
                            <div class="w-50 mt-3">
                                <table class="table table-bordered mb-0 w-75 theme-border">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="theme-bg text-white">Response</th>
                                            <th scope="col" class="theme-bg text-white">Responses</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="2" class="report-piechart-color-silver-dim text-center"><span class="fst-italic">No Data...</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="w-50">
                                <div class="mx-auto w-fit-content" id="CompleteResponseSummaryChart"></div>
                            </div>
                        </div>
                        <div class="w-fit-content mt-2">
                            <h4 class="custom-p fw-bold">Detailed Responses</h4>
                            <table class="table table-bordered table-stripped mb-0 w-75 mt-5 w-fit-content report-summarized-details-table" id="SummarizedUserDetailsData">
                                <thead>
                                    <tr>
                                        <th scope="col" class="theme-bg text-white">User ID</th>
                                        <th scope="col" class="theme-bg text-white">User Name</th>
                                        <th scope="col" class="theme-bg text-white">Machine ID</th>
                                        <th scope="col" class="theme-bg text-white">Machine Name</th>
                                        <th scope="col" class="theme-bg text-white">Response DT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="5" class="report-piechart-color-silver-dim text-center"><span class="fst-italic">No Data...</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>

<script>

    $(document).ready(function ()
    {
        LoadData();
        SummaryTab();
    });

    function LoadData()
    {
        //Summary
        let apexUserPieChart = null;
        let apexMachinePieChart = null;

        var userCompleted = parseInt("@policySummaryUsers.Completed");
        var userOutstanding = parseInt("@policySummaryUsers.Outstanding");
        
        var userData = [userCompleted, userOutstanding];

        var pieDataLabel = ["Completed", "Outstanding"];
        var colorsData = [ReportColorsTypes.GREEN, ReportColorsTypes.RED];

        var dimension = new DimensionType(500);

        DrawPieChart(apexUserPieChart, "#UsersSummaryChart", userData, pieDataLabel, colorsData, dimension, onUserSummaryPieChartLabelClick, "#%");

        var machineCompleted = parseInt("@policySummaryMachines.Completed");
        var machineOutstanding = parseInt("@policySummaryMachines.Outstanding");
        var machineData = [machineCompleted, machineOutstanding];

        DrawPieChart(apexMachinePieChart, "#MachinesSummaryChart", machineData, pieDataLabel, colorsData, dimension, onMachineSummaryPieChartLabelClick, "#%");

        var entityType = GetPolicyEntityType();
        
        if(entityType == "Users") HideShowElement("#PolicyReportUserSummary", HideShow.SHOW);
        if(entityType == "Machines") HideShowElement("#PolicyReportMachineSummary", HideShow.SHOW);
        
        if(entityType == "UsersAndMachines")
        {
            HideShowElement("#PolicyReportUserSummary", HideShow.SHOW);
            HideShowElement("#PolicyReportMachineSummary", HideShow.SHOW);
        }

        $('#SummarizedUserDetailsData').DataTable({
                dom: 'rtip',   
                pageLength: 10
        });
        $('#SummarizedMachineDetailsData').DataTable({
                dom: 'rtip',   
                pageLength: 10
        });
    }

    function SummaryTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.HIDE);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#PolicySummaryTab-1", HideShow.SHOW);

        $("#ModuleReportSubTitle").text("Policy Response Summary");
        $("#ModuleReportActiveReport").val("summary");
    }

    function OutstandingTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#PolicyOutstandingTab", HideShow.SHOW);
        HideShowElement("#ReportStatusLegend", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("PolicySummary");
        $("#ModuleReportSubTitle").text("Outstanding Responses Breakdown");
        $("#ModuleReportActiveReport").val("outstanding");
    }

    function CompleteTab()
    {
        HideShowElementVisibity("#BackBtn", HideShow.SHOW);
        HideShowElement(".report-module-tabs-module", HideShow.HIDE);
        HideShowElement("#ReportStatusLegend", HideShow.HIDE);
        HideShowElement("#PolicyCompleteTab-3", HideShow.SHOW);

        $("#ModuleReportGoBackDiv").val("PolicySummary");
        $("#ModuleReportSubTitle").text("Completed Response Breakdown");
        $("#ModuleReportActiveReport").val("complete");
    }

    function onUserSummaryPieChartLabelClick(label)
    {
        if (label === 'Completed')
        {
            CompleteTab();
        }
        else if (label === 'Outstanding')
        {
            OutstandingTab();
        }
    }

    function onMachineSummaryPieChartLabelClick(label)
    {
        if (label === 'Completed')
        {
            CompleteTab();
        }
        else if (label === 'Outstanding')
        {
            OutstandingTab();
        }
    }
    
    function GoBackToPolicyReportTab(destinationDiv)
    {
        if (destinationDiv == "PolicySummary")
        {
            SummaryTab();
        }
    }

    function GetPolicyEntityType()
    {
        var activeRadioId = GetIdOfSelectedRadioInGroup("PolicyReportExtraOptions");

        var policyReportEntityType = "";

        if(activeRadioId == "UserOption") policyReportEntityType = "Users";
        if(activeRadioId == "MachineOption") policyReportEntityType = "Machines";
        if(activeRadioId == "UserMachineOption") policyReportEntityType = "UsersAndMachines";

        return policyReportEntityType;
    }


</script>