@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.ViewModels.Reports

@{
    var labels = new List<string> { "Click", "Dismiss", "Autohide", "Snooze", "Show" };
    var colors = new List<string> { "blue", "orange", "crimson", "slate", "silver" };
    var data = new List<int> { 107, 55, 23, 12, 17 };
    var total = data.Sum(x => x);
}


<div class="container-fluid">

    @{
        <!-- Breadcrumb Component -->
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ReportBreadcrumb.cshtml", new ReportBreadcrumbViewModel
            {
                ReportCurrentPage = ReportsPages.PopupReport,
                HasLinkedModulePage = true,
                LinkedModulePage = ModulesPages.PopupOverview
            });

        <!-- Report Filter Component -->
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportFilter.cshtml", new ModuleReportFilterViewModel
            {
                ModuleName = ModuleNamesType.Popup
            });
    }

    <!-- Card for Popup Report Body -->
    <div class="card mb-4 mt-2 overview-filters-card theme-txt-clr report-body-container">
        <div class="card-body p-3 pb-0">
            <!-- Report Type -->
            <div class="row mt-3">
                <div class="btn-group w-auto overview-filter-btn-group mx-auto">
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="SummaryLink">Popup Summary</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type btn-group-active" id="ResponseSummaryLink">Response Summary</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="ResponseClikcLink">Response (Click)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="ResponseDismissLink">Response (Dismiss)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="ResponseAutoHideLink">Response (Autohide)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="ResponseSnoozeLink">Response (Snooze)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="ResponseShowLink">Response (Show)</button>
                    <button class="btn custom-btn-group report-tab-type popup-report-type" id="OutstandingLink">Outstanding</button>
                </div>
            </div>
        </div>

        <div class="report-outter-container">
            <div class="card-body">
                <div class="row flex-sm-nowrap">
                    <div class="flex-wrap report-body-container px-5">

                        <!-- Response Summary Tab -->
                        <div id="ResponseSummary-Tab-2">
                            <h5 class="fw-bold text-center">2. Popup Question Summary</h5>
                            <div class="row">
                                <div class="w-50">
                                    <p class="custom-p fs-16 fw-bold">(54) WPS Status Popup</p>
                                    <p class="custom-p mt-1">Effective from <span class="fw-bold">2020/02/14</span> to <span class="fw-bold">2024/08/23</span></p>
                                    <table class="table table-bordered mb-0 w-400p mt-3">
                                        <thead>
                                            <tr>
                                                <th scope="col">Event</th>
                                                <th scope="col">Count</th>
                                                <th scope="col">Percentage (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < data.Count; i++)
                                            {
                                                var bgColor = $"report-piechart-color-{colors[i]}-dim";
                                                var percent = Math.Round(((data[i] / (double)total) * 100.0), 2);
                                                <tr>
                                                    <td class="@bgColor">@labels[i]</td>
                                                    <td class="@bgColor">@data[i]</td>
                                                    <td class="@bgColor w-150p">@percent</td>
                                                </tr>
                                            }
                                            <tr>
                                                <td>Total</td>
                                                <td>@total</td>
                                                <td>100</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="w-50 mt-5">
                                    <div id="PopupReportSummaryChart">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Navigation Buttons -->
                        <div class="row fix-content-bottom">
                            <div class="col-12 ">
                                <div class="pagination-section mt-4  flex-column flex-md-row  text-center align-content-center justify-content-center ">
                                    <button class="btn section-nav-btns" id="ReportPrevTabBtn">Back</button>
                                    <button class="btn section-nav-btns ms-3" id="ReportNextTabBtn">Next</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


<script>

    var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(labels));
    var data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(data));
    var colors = ["#4169E1", "#FF8C00", "#B22222", "#2F4F4F", "#C0C0C0"];

    DrawPieChart("#PopupReportSummaryChart", data, labels, colors);

</script>