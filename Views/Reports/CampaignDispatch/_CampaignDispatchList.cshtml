<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>


<script>

    $(document).ready(function ()
    {
        ShowEnabledModulesReports();
    });

    function ShowEnabledModulesReports()
    {
        if ("@Model.Filters.LockscreenReport" == "True")
        {
            HideShowElement("#LockscreenData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("LockscreenCampaignData"), 100);
        }
        if ("@Model.Filters.DesktopReport" == "True")
        {
            HideShowElement("#DesktopData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("DesktopCampaignData"), 100);
        }
        if ("@Model.Filters.ScreensaverReport" == "True")
        {
            HideShowElement("#ScreensaverData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("ScreensaverCampaignData"), 100);
        }
        if ("@Model.Filters.PopupReport" == "True")
        {
            HideShowElement("#PopupData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("PopupCampaignData"), 100);
        }
        if ("@Model.Filters.SurveyReport" == "True")
        {
            HideShowElement("#SurveyData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("SurveyCampaignData"), 100);
        }
        if ("@Model.Filters.TickerReport" == "True")
        {
            HideShowElement("#TickerData", HideShow.SHOW);
            //setTimeout(() => MakeSimpleDataTable("TickerCampaignData"), 100);
        }
    }

    function ToggleHiddenRow(rowId)
    {
        var id = `#${rowId}`;

        var icon = `${id}-icon`;

        if ($(id).hasClass("hidden"))
        {
            HideShowElement(id, HideShow.SHOW);
            $(icon).removeClass("bi bi-plus-circle-fill");
            $(icon).addClass("bi bi-dash-circle-fill");
        }
        else
        {
            HideShowElement(id, HideShow.HIDE);
            $(icon).addClass("bi bi-plus-circle-fill");
            $(icon).removeClass("bi bi-dash-circle-fill");
        }

        // Redraw DataTables to account for changes
        //$.fn.dataTable.tables({ visible: true }).DataTable().columns.adjust().draw();
    }

</script>