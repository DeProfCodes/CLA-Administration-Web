@using CLA_Administration_Web.ViewModels.Reports.CampaignDispatch
@model CampaignDispatchViewModel

@{
    int index = 0;

    var groupedTickers = Model.Tickers
        .GroupBy(t => t.TickerTickerId)
        .Select(g => new
        {
            TickerId = g.Key,
            Environments = g.GroupBy(t => t.Environment).ToList()
        })
        .ToList();

    var groupedScreensavers = Model.Screensaver
        .GroupBy(s => s.ScreenSequenceHeaderId)
        .Select(g => new
        {
            ScreensaverId = g.Key,
            Environments = g.GroupBy(s => s.Environment).ToList()
        })
        .ToList();

    var groupedDesktops = Model.Desktops
        .GroupBy(d => d.DesktopHeaderId)
        .Select(g => new
        {
            DesktopId = g.Key,
            Environments = g.GroupBy(d => d.Environment).ToList()
        })
        .ToList();

    var groupedLockscreens = Model.LockedDesktops
        .GroupBy(ld => ld.LockedDesktopHeaderId)
        .Select(g => new
        {
            LockedDesktopId = g.Key,
            Environments = g.GroupBy(ld => ld.Environment).ToList()
        })
        .ToList();

    var groupedPopups = Model.Popups
        .GroupBy(p => p.StmStmId)
        .Select(g => new
        {
            StmStmId = g.Key,
            Environments = g.GroupBy(p => p.Environment).ToList()
        })
        .ToList();

    var groupedSurveys = Model.Surveys
        .GroupBy(s => s.SurveySurveyId)
        .Select(g => new
        {
            SurveySurveyId = g.Key,
            Environments = g.GroupBy(s => s.Environment).ToList()
        })
        .ToList();
}

<div class="report-outter-container">
    <div class="card-body p-0">
        <div class="row flex-sm-nowrap">
            <div class="flex-wrap report-body-container">
                @{
                    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ModuleReportResultTitle.cshtml",
                    new ModuleReportResultTitleViewModel
                    {
                        ReportTypeName = ReportsNamesType.CampaignDispatch,
                        ReportTitle = "Campaign Dispatch Listing Report",
                        EffectiveFromDate = Model.Filters.EffectiveFrom,
                        EffectiveToDate = Model.Filters.EffectiveTo,
                        OnBackReportTabClickCallbackFunction = "NaN"
                    });
                }
                <div id="ScreensaverData" class="report-module-tabs-module mb-4 hidden">
                    <h4 class="bg-silver p-2 text-center fw-bold">Screensavers</h4>
                    <table id="ScreensaverCampaignData" class="table table-striped table-bordered table-hover theme-border align-middle campain-table-type fs-12">
