                            <tr>
                                <th class="theme-bg text-white" style="width:10%">Screensaver Description</th>
                                <th class="theme-bg text-white" style="width:10%">Screen Advert Description</th>
                                <th class="theme-bg text-white" style="width:7%">Effective From</th>
                                <th class="theme-bg text-white" style="width:7%">Effective To</th>
                                <th class="theme-bg text-white" style="width:10%">Timeslot From</th>
                                <th class="theme-bg text-white" style="width:10%">Timeslot To</th>
                                <th class="theme-bg text-white" style="width:10%">Environment</th>
                                <th class="theme-bg text-white" style="width:13%">Targeted</th>
                                <th class="theme-bg text-white" style="width:13%">User Last Modified</th>
                                <th class="theme-bg text-white" style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var screensaverGroup in groupedScreensavers)
                            {
                                foreach (var envGroup in screensaverGroup.Environments)
                                {
                                    var firstItem = envGroup.First();
                                    var css = (index++ % 2 == 0) ? "report-piechart-color-silver-dim" : "";
