                                    var collapseIconId = $"{collapseId}-icon";

                                    <tr>
                                        <td class="@css truncate-text">@firstItem.ScreensaverDescription</td>
                                        <td class="@css truncate-text">@firstItem.ScreenAdvertDescription</td>
                                        <td class="@css">@firstItem.ScreenEffFrom?.ToString("d/M/yyyy hh:mm:ss tt")</td>
                                        <td class="@css">@firstItem.ScreenEffTo?.ToString("d/M/yyyy hh:mm:ss tt")</td>
                                        <td class="@css">@firstItem.ScreenTimeslotFrom</td>
                                        <td class="@css">@firstItem.ScreenTimeslotTo</td>
                                        <td class="@css">@firstItem.Environment</td>
                                        <td class="@css">
                                            <a onclick="ToggleHiddenRow('@collapseId')">
                                                <i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon theme-txt-clr fs-18" id="@collapseIconId"></i>
                                            </a>
                                        </td>
                                        <td class="@css">@firstItem.ScreenUserLastModified</td>
                                        <td class="@css"></td>
                                    </tr>

                                    @foreach (var item in envGroup)
                                    {
                                        <tr class="hidden" id="@collapseId">
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                            <td class="@css">@item.Targeted</td>
                                            <td class="@css"></td>
                                            <td class="@css"></td>
                                        </tr>
                                    }
                                }
                            }
