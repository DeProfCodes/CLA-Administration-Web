
<div class="container-fluid">

    <!-- Breadcrumb Component -->
    @{       
        await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Reports/ReportBreadcrumb.cshtml", new ReportBreadcrumbViewModel
        {
            ReportCurrentPage = ReportsPages.CampaignDispatchReport,
            HasLinkedModulePage = false,
        });
    }
    <!-- Card for Filters -->
    <div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
        <div class="card-body pt-0 pb-0">
            <div class="row fs-12 mt-1">
                <p class="custom-p text-center hidden">Report Parameters</p>
                <div class="row col-12 d-flex flex-wrap module-overview-filters">
                    <div class="w-auto ms-auto mb-1">
                        <div class="row mb-0 mt-1">
                            @{
                                await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/DateRangePicker.cshtml",
                                new DateTimeRangePicker
                                {
                                    ShowDatesTitle = true,
                                    ShowFullTitles = true,
                                    TitlesBold = true,
                                    VerticalAlign = true,
                                    WidthCss = "w-225p",
                                    ExternalCssControl = "",
                                    OnChangeFunction = "X"
                                });
                            }
                        </div>
                    </div>
                    <div class="w-auto mb-1 d-flex ">
                        <div class="mt-1 theme-txt-clr">
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="LockscreensCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="LockscreensCampaign">Lockscreens</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="DesktopCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="DesktopCampaign">Desktop</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="ScreensaverCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="ScreensaverCampaign">Screensaver</label>
                            </div>
                        </div>
                        <div class="mt-1 theme-txt-clr ms-3">
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="PopupCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="PopupCampaign">Popups</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="SurveyCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="SurveyCampaign">Surveys</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="checkbox" id="TickersCampaign">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="TickersCampaign">Tickers</label>
                            </div>
                        </div>
                    </div>
                    <div class="w-auto ms-3 me-auto mb-1">
                        <div class="mt-1">
                            <select class="form-select-sm" style="appearance:menulist" id="CampaignViewType">
                                <option value="manual">View Manual Only</option>
                                <option value="automated">View Automated Only</option>
                                <option value="all">View All</option>
                            </select>
                        </div>
                        <div class="d-flex mt-1">
                            <button class="btn custom-btn-default btn-sm px-3" onclick="LoadCampaignReports()">Generate Report</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card for Campaign Dispatch Report Body -->
    <div class="card mb-1 mt-1 overview-filters-card theme-txt-clr app-card-main-scaling report-data-area" id="report-data-area">
        <div id="ReportModuleData">

        </div>   
    </div>
</div>

<script>

    function LoadCampaignReports()
    {
        var payload = {
            LockscreenReport: IsCheckboxChecked("LockscreensCampaign"),
            DesktopReport: IsCheckboxChecked("DesktopCampaign"),
            ScreensaverReport: IsCheckboxChecked("ScreensaverCampaign"),
            PopupReport: IsCheckboxChecked("PopupCampaign"),
            SurveyReport: IsCheckboxChecked("SurveyCampaign"),
            TickerReport: IsCheckboxChecked("TickersCampaign"),
            StartDate: FormatDate($('#DatePickerStartDate').val(), "YYYY/MM/DD"),
            EndDate: FormatDate($('#DatePickerEndDate').val(), "YYYY/MM/DD"),
            ViewType: $('#CampaignViewType').val()
        };

        var noneSelected = !payload.LockscreenReport && !payload.DesktopReport && !payload.ScreensaverReport && !payload.PopupReport && !payload.SurveyReport && !payload.TickerReport;

        if (noneSelected)
        {
            swal("Campaign Report Error", "Please select at least one module to generate report for.", "error");
        }
        else
        {
            ReportDataLoader("CampaignDispatch");

            var url = GetPageUrl("@ReportsPages.CampaignDispatchListReport") + '?' + $.param(payload);

            LoadPartialViewWithLoader(url, "#ReportModuleData", "#SecondaryLoader");
        }
    }


</script>