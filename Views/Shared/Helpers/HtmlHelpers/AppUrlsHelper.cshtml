        if (page == '@ModulesPages.PopupDetails') title = "Popup Details";
        if (page == '@ModulesPages.PopupAddNew') title = (id == null) ? "Add New Popup" : "Edit Popup";
        //
        if (page == '@ModulesPages.SurveyOverview') title = "Surveys Overview";
        if (page == '@ModulesPages.SurveyDetails') title = "Surveys Details";
        if (page == '@ModulesPages.SurveyQuestionsOverview') title = "Survey Questions Overview";
        if (page == '@ModulesPages.SurveyQuestionDetails') title = "Survey Questions Details";
        if (page == '@ModulesPages.SurveyAddNew') title = (id == null) ? "Add New Survey" : "Edit Survey";
        if (page == '@ModulesPages.AddNewSurveyQuestion') title = "Add New Survey Question"
        //
        if (page == '@ModulesPages.TickerOverview') title = "Tickers Overview";
        if (page == '@ModulesPages.TickerDetails') title = "Ticker Details";
        if (page == '@ModulesPages.TickerAddNew') title = (id == null) ? "Add New Ticker" : "Edit Ticker";
        //
        if (page == '@ModulesPages.RSSCategoryOverview') title = "RSS Overview";
        if (page == '@ModulesPages.RSSCategoryDetails') title = "RSS Category Details";
        if (page == '@ModulesPages.RSSFeedOverview') title = "RSS Feed Overview";
        if (page == '@ModulesPages.RSSFeedDetails') title = "RSS Feed Details";
        if (page == '@ModulesPages.RSSAddNewCategory') title = (id == null) ? "Add New RSS Category" : "Edit RSS Category";
        if (page == '@ModulesPages.RSSAddNewFeed') title = (id == null) ? "Add New RSS Feed" : "Edit RSS Feed";

        // Settings Section
        if (page == '@SettingsPages.StagingUsers') title = "Manage Staging Users";
        if (page == '@SettingsPages.SetupExclusions') title = "Manage Setup Exclusions";
        if (page == '@SettingsPages.AdminAccess') title = "Admin Access";
        if (page == '@SettingsPages.TargetGroups') title = "Manage Targeting Groups";
        if (page == '@SettingsPages.CustomUserSettings') title = "Custom User Settings";
        if (page == '@SettingsPages.CustomUserSettingsDetails') title = "Custom User Settings Details";
        if (page == '@SettingsPages.ActiveConnections') title = "Manage Active Connections";
        if (page == '@SettingsPages.SkinsOfflineImages') title = "Manage Skins & Offline Images";
        if (page == '@SettingsPages.DesktopInformation') title = "Desktop Information";
        if (page == '@SettingsPages.DefaultFonts') title = "Default Fonts";
        if (page == '@SettingsPages.DefaultFontsDetails') title = "Default Fonts Details";

        // Reports Section
        if (page == '@ReportsPages.SurveyReport') title = "Survey Report";
        if (page == '@ReportsPages.PopupReport') title = "Popup Report";
        if (page == '@ReportsPages.TickerReport') title = "Ticker Report";
        if (page == '@ReportsPages.PolicyReport') title = "Policy Report";
        if (page == '@ReportsPages.ActiveUsersReport') title = "Active Users Report";
        if (page == '@ReportsPages.ActiveMachinesReport') title = "Active Machines Report";
        if (page == '@ReportsPages.CampaignDispatchReport') title = "Campaign Dispatch Listing Report";
        if (page == '@ReportsPages.TroubleshootReport') title = "Troubleshoot Report";

        // Support Section
        if (page == '@SupportPages.AboutUs') title = "About CLA";
        if (page == '@SupportPages.Tutorials') title = "CLA Tutorials";
        if (page == '@SupportPages.RemoteAssistance') title = "Remote Assistance";
        if (page == '@SupportPages.ContactUs') title = "Contact Support";

         // Account Section
        if (page == '@AccountPages.AccountOverview') title = "Account Overview";
        if (page == '@AccountPages.SecuritySettings') title = "Security Settings";

        // Admin Section
        if (page == '@AdminPages.UploadFiles') title = "Upload Files";
        if (page == '@AdminPages.ApplicationParameters') title = "Application Parameters";
        if (page == '@AdminPages.Licensing') title = "Licensing";
        if (page == '@AdminPages.AutoReminders') title = "Auto Reminders";
