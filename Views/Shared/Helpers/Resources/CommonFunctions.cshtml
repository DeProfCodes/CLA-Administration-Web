
@{

}

<script>

    function GetModuleName(moduleType)
    {
        if (moduleType == '@ModuleNamesType.Popup') return "Popup";
        if (moduleType == '@ModuleNamesType.Survey') return "Survey";
        if (moduleType == '@ModuleNamesType.Ticker') return "Ticker";
        if (moduleType == '@ModuleNamesType.RSS') return "RSS";
        if (moduleType == '@ModuleNamesType.LockedDesktop') return "Locked Desktop";
        if (moduleType == '@ModuleNamesType.Desktop') return "Desktop";
        if (moduleType == '@ModuleNamesType.Screensaver') return "Screensaver";
        if (moduleType == '@ModuleNamesType.ContentLibrary') return "Content Library";

        return "";
    }

    function GetReportNameType(reportType)
    {
        if (reportType == '@ReportsNamesType.Popup') return "@ReportsNamesType.Popup.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.Survey') return "@ReportsNamesType.Survey.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.Ticker') return "@ReportsNamesType.Ticker.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.Policy') return "@ReportsNamesType.Policy.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.ActiveUsers') return "@ReportsNamesType.ActiveUsers.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.ActiveMachines') return "@ReportsNamesType.ActiveMachines.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.CampaignDispatch') return "@ReportsNamesType.CampaignDispatch.GetDisplayDescription()";
        if (reportType == '@ReportsNamesType.Troubleshoot') return "@ReportsNamesType.Troubleshoot.GetDisplayDescription()";

        return "";
    }


</script>