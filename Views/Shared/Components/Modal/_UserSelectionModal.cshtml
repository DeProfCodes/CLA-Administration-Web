@model CLA_Administration_Web.ViewModels.Shared.ModalViewModel
@using CLA_Administration_Web.ViewModels.Targeting


<div class="modal fade" id="UsersModal" tabindex="-1" aria-labelledby="UsersModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="UsersModalLabel">@Model.ModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeUsersModal()"></button>
            </div>
            <div class="modal-body">
              

                    <!-- Search Field -->
                    <div class="mb-3">
                        <input type="text" id="custom-searchInput" class="form-control" placeholder="Search..." onkeyup="customFilterTree()">
                    </div>

                    <!-- Tree Structure -->
                    <div class="custom-tree" id="custom-directoryTree">
                        <ul>
                            @foreach (var entity in Model.TargetedEntities)
                            {
                                @Html.Raw(RenderTreeNode(entity))
                            }
                        </ul>
                    </div>
                 
            </div>
            <div class="modal-footer">
                <button type="button" class="btn custom-btn btn-secondary" data-bs-dismiss="modal" onclick="closeUsersModal()">Cancel</button>
                <button type="button" class="custom-btn custom-btn-default" id="saveButton">Save Selection</button>
            </div>
        </div>
    </div>
</div>


@functions {
    string RenderTreeNode(TargetedEntityTree node)
    {
        var html = $@"
        <li class='custom-folder'>
            <input type='checkbox' id='toggle-{node.Id}' class='custom-toggle-checkbox'>
            <label for='toggle-{node.Id}' class='custom-toggle-icon'>+</label>
            <span><i class='bi bi-folder'></i> {node.EntityName}</span>";

        if (node._children != null && node._children.Any())
        {
            html += "<ul class='custom-tree-content'>";
            foreach (var child in node._children)
            {
                if (child._children != null && child._children.Any())
                {
                    html += RenderTreeNode(child);
                }
                else
                {
                    html += $"<li class='custom-file' onclick='customSelectValue(this)'>{child.EntityName}</li>";
                }
            }
            html += "</ul>";
        }

        html += "</li>";
        return html;
    }
}

<script>

    function saveSelections() {
        const { lastModifiedField, callbackFunction, inputFieldId } = window.selectedFields;

        const selectedUsers = [];

        document.querySelectorAll('.custom-file.active').forEach(item => {
            const selectedItem = item.textContent.trim();
            selectedUsers.push(selectedItem);
        });

        if (lastModifiedField) {
            document.getElementById(lastModifiedField).value = selectedUsers.join(', ');
        }

        if (callbackFunction && typeof window[callbackFunction] === 'function') {
            window[callbackFunction](selectedUsers);
        }

        closeUsersModal();
    }

  
    document.getElementById('saveButton').addEventListener('click', saveSelections);

    function customFilterTree() {
        const searchInput = document.getElementById('custom-searchInput');
        const filter = searchInput.value.toLowerCase();
        const treeItems = document.querySelectorAll('.custom-file, .custom-folder label');

        treeItems.forEach((item) => {
            const text = item.textContent || item.innerText;
            if (text.toLowerCase().includes(filter)) {
                item.closest('li').style.display = '';
            } else {
                item.closest('li').style.display = 'none';
            }
        });
    }


    document.querySelector('#UsersModal').addEventListener('click', (e) => {
        e.stopPropagation(); 
    });




</script>

