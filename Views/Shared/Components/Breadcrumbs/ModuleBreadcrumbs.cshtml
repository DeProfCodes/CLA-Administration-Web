@model CLA_Administration_Web.ViewModels.Modules.ModuleBreadcrumbViewModel
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages

@{
    var pageType = Model.ActionButtonPage;
    var moduleName = pageType.GetDisplayShortName();
    var navPageId = $"{pageType.GetDisplayName()}Link";
}


<div class="row mb-2">
    <div class="w-auto">
        <h2 class="theme-txt-clr breadcrumb-title">@Model.ModulePageName</h2>
        @if (!Model.IsAllModulesBreadcrumb && !Model.IsDetailsPage)
        {
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item">@Model.ModuleName</span> /
                <span class="breadcrumb-item">@Model.ModuleSubPage</span>
            </p>
        }
        else if (Model.IsDetailsPage)
        {
            var overviewBtnId = $"{Model.ModulePreviewPage.GetDisplayName()}Link";
            <p class="breadcrumb-nav-body">
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', null, '@ModulesPages.AllModules', 'AllModulesLink', true)">Modules</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', '@moduleName', '@Model.ModulePreviewPage', '@overviewBtnId')">@Model.ModuleName</span> /
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Modules', '@moduleName', '@Model.ModulePreviewPage', '@overviewBtnId')">Overview</span> /
                <span class="breadcrumb-item">@Model.ModuleSubPage</span> /
                <span class="breadcrumb-item">@Model.ModuleDetailsId</span>
            </p>
        }
        else
        {
            <p>
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
                <span class="breadcrumb-item">Modules</span> 
            </p>
        }
    </div>
    @if (Model.HasActionButton)
    {
        var iconCss = Model.IsAddNewIcon ? "bi bi-plus-circle-fill" : "ri-menu-search-fill";

        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenBreadcrumbActionButton()"><i class="@iconCss custom-btn-icons breadcrumb-btn-icon"></i> @Model.ActionButtonText</button>
        </div>
    }
</div>


<script>

    function OpenBreadcrumbActionButton(page)
    {
        OpenPageWithAnimations('Modules', '@moduleName', '@pageType', '@navPageId');
    }

</script>