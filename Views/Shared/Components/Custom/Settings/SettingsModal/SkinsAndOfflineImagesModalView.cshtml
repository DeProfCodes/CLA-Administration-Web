@using CLA_Administration_Web.ViewModels.Settings.SkinAndOfflineImage;
@using Newtonsoft.Json
@model SkinsAndOfflineModel;
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames
@using CLA_Administration_Web.Helpers.Constants



@{
    var treeParents = !string.IsNullOrEmpty(Model.CategoryName) ? $"{Model.CategoryName}  " : "";
    //var pageTitle = Model.AddOrEdit == AddOrEditType.Add ? "Add Content Library Category" : $"Edit Content Library Category: {Model.CategoryId}";
}

<div class="card">
    <div class="card-body">
        <h5 class="fw-bold text-center mt-3 mb-4">Edit Skins and Offline Image Details</h5>
        <div class="table-responsive">
            <table class="table custom-table align-start">
                <tbody>
                    <!-- Parent Category -->
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <tr>
                            <td class="text-end w-50 custom-p"><strong>Category Name:</strong></td>
                            <td>
                                <span class="fst-italic theme-txt-clr">@treeParents</span>
                               
                            </td>
                        </tr>
                    }

                    <!-- New Category Name -->
                    <tr>
                        <td class="text-end  custom-p"><strong>New Category Name:</strong></td>
                        <td>
                            <input class="form-control" style=" width:65%;" type="text" id="NewContentLibCategoryName" value="@Model.CategoryName" />
                            <p class="text-danger fs-6 fst-italic mt-1" id="NewContentLibCategoryNameError"></p>
                        </td>
                    </tr>

                    <!-- Category Description -->
                    <tr>
                        <td class="text-end  custom-p"><strong>Category Description:</strong></td>
                        <td>
                            <input class="form-control" type="text" style=" width:65%;" id="NewContentLibCategoryDescription" value="@Model.Description" />
                            <p class="text-danger fs-6 fst-italic mt-1" id="NewContentLibCategoryDescriptionError"></p>
                        </td>
                    </tr>

                    <!-- Default -->
                    <tr>
                        <td class="text-end  custom-p"><strong>Default?</strong></td>
                        <td>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="Default" @(Model.IsDefault == "Yes" ? "checked" : "") />
                                <label class="form-check-label" for="Default">Set as Default</label>
                            </div>
                        </td>
                    </tr>

                    <!-- User Last Modified -->
                    <tr>
                        <td class="text-end  custom-p"><strong>User Last Modified:</strong></td>
                        <td class="fw-bold">@Model.UserLastModified</td>
                    </tr>

                    <!-- Machine Last Modified -->
                    <tr>
                        <td class="text-end  custom-p"><strong>Machine Last Modified:</strong></td>
                        <td class="fw-bold">@Model.MachineLastModified</td>
                    </tr>

                    <!-- Select Item (if applicable) -->
                    <tr>
                        <td class="text-end  custom-p"><strong>Select Item:</strong></td>
                        <td>
                            @{
                                await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/FileUploader.cshtml",
                                new FileUploaderModel { ComponentId = "SkinsAndOfllineImage", InputId = "SkinsAndOfllineImageUploadInput", ShowPreviewButton = true, InitialHidden = false, WidthPx = "396px", OnFileUploadCallback = null });
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>

<style>

    .custom-table tr {
        border-bottom: none !important;
    }

    .custom-table td,
    .custom-table th {
        border: none !important;
    }


</style>


<script>


    function SaveImage() {
        const module = document.getElementById("Module").value;
        const fileInput = document.getElementById("SkinsAndOfllineImageUploadInput").files[0];

        if (!fileInput) {
            swal("Validation Error", "Please upload an image.", "error");
            return;
        }

        // Validate the image
        ValidateImage(fileInput, module)
            .then(() => {

                SaveImageToServer(fileInput)
                    .then(() => {
                        swal("Success", "New Skin and Offline Image is saved successfully.", "success");
                    })
                    .catch((err) => {
                        swal("Error", `Failed to save the image: ${err}`, "error");
                    });
            })
            .catch(errMessage => {
                swal("Validation Error", errMessage, "error");
            });
    }


    function SaveImageToServer(file) {
        return new Promise((resolve, reject) => {

            setTimeout(() => {
                const isSuccess = true;
                if (isSuccess) {
                    resolve();
                } else {
                    reject("Server error occurred");
                }
            }, 1000);
        });
    }

    function ValidateImage(file, module) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();

            reader.onload = function (e) {
                const image = new Image();
                image.src = e.target.result;

                image.onload = function () {
                    const width = image.width;
                    const height = image.height;
                    const fileType = file.type.split("/")[1].toUpperCase();

                    const validationRules = {
                        "@ModuleNamesType.Popup": { formats: ["JPG", "PNG"], width: null, height: null },
                        "@ModuleNamesType.Screensaver": { formats: ["BMP"], width: [314, 414], height: [188, 288] },
                        "Survey": { formats: ["BMP"], width: [485], height: [600] },
                        "Ticker": { formats: ["BMP"], width: [80], height: [40] },
                        "Ticker": { formats: ["BMP"], width: [80], height: [80] }
                    };

                    const rules = validationRules[module];


                    if (!rules) {
                        reject(`Invalid module type: ${module}. Please select a valid module.`);
                        return;
                    }


                    const validFormats = rules.formats.map(format => format.toUpperCase());

                    if (!validFormats.includes(fileType)) {
                        reject(`Invalid file type. Allowed formats: ${validFormats.join(", ")}`);
                        return;
                    }

                    if (rules.width && (!Array.isArray(rules.width) || !rules.width.includes(width))) {
                        reject(`Invalid width (${width}px). Expected: ${rules.width.join(", ")}px`);
                        return;
                    }

                    if (rules.height && (!Array.isArray(rules.height) || !rules.height.includes(height))) {
                        reject(`Invalid height (${height}px). Expected: ${rules.height.join(", ")}px`);
                        return;
                    }

                    resolve();
                };

                image.onerror = function () {
                    reject("The uploaded file is not a valid image.");
                };
            };

            reader.onerror = function () {
                reject("An error occurred while reading the file.");
            };

            reader.readAsDataURL(file);
        });
    }



</script>