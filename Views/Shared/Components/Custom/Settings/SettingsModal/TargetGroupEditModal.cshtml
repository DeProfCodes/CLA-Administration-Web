@model CLA_Administration_Web.ViewModels.Targeting.TargetingExposureViewModel



@{
    string entityType = ViewBag.EntityType as string;


}

@if (entityType == "Groups" && Model.TargetedGroups != null && Model.TargetedGroups.Any())
{
    var group = Model.TargetedGroups.FirstOrDefault();

        <div class="mb-3">
            <label for="GroupId" class="form-label">Group ID: @group.GroupId</label>
            <input type="hidden" class="form-control" id="GroupId" name="GroupId" value="@group.GroupId" readonly>
        </div>

        <div class="mb-3">
            <label for="DomainName" class="form-label">Domain Name</label>
            <input type="text" class="form-control" id="DomainName" name="DomainName" value="@group.DomainName" required>
        </div>

        <div class="mb-3">
            <label for="DisplayName" class="form-label">Display Name</label>
            <input type="text" class="form-control" id="DisplayName" name="DisplayName" value="@group.DisplayName" required>
        </div>

}

@if (entityType == "User" && Model.TargetedUsers != null && Model.TargetedUsers.Any())
{
    var user = Model.TargetedUsers.FirstOrDefault();

        <div class="mb-3">
         
            <input type="hidden" class="form-control" id="UserId" name="Id" value="@user.Id" readonly>
        </div>

        <div class="mb-3">
            <label for="DomainName" class="form-label">Domain Name</label>
        <select class="form-control" id="ReportModuleSelect">
            <option value="0">Please select Domain Name</option>

            <option value="Corporate-Vocie">Corporate-Vocie</option>
            <option value="Corporate-Vocie">Test Domian</option>
            <option value="Corporate-Vocie">Admin</option>
            <option value="Corporate-Vocie">NTHDIM</option>

        </select>
        </div>

        <div class="mb-3">
            <label for="NTUsername" class="form-label">NT Username</label>
            <input type="text" class="form-control" id="NTUsername" name="NTUsername" value="@user.NTUsername" required >
        </div>

        <div class="mb-3">
            <label for="DisplayName" class="form-label">First Name</label>
            <input type="text" class="form-control" id="DisplayName" name="DisplayName" value="@user.DisplayName" required>
        </div>

        <div class="mb-3">
            <label for="LastSyncDT" class="form-label">User Last Modified</label>
            <input type="text" class="form-control" id="LastSyncDT" name="LastSyncDT" value="@user.LastSyncDT" disabled>
        </div>

        <div class="mb-3">
            <label for="Status" class="form-label">Status</label>
            <input type="text" class="form-control" id="Status" name="Status" value="Active">
        </div>

}


@if (entityType == "Machine" && Model.TargetedMachines != null && Model.TargetedMachines.Any())
{
    var machine = Model.TargetedMachines.FirstOrDefault();

   
        <div class="mb-3">
         
            <input type="hidden" class="form-control" id="MachineId" name="machineId" value="@machine.machineId" readonly>
        </div>

        <div class="mb-3">
            <label for="DomainName" class="form-label">Domain Name</label>
             <select class="form-control" id="ReportModuleSelect">
                    <option value="0">Please select Domain Name</option>

                    <option value="Corporate-Vocie">Corporate-Vocie</option>
                    <option value="Corporate-Vocie">Test Domian</option>
                    <option value="Corporate-Vocie">Admin</option>
                    <option value="Corporate-Vocie">NTHDIM</option>

                </select>
        </div>

        <div class="mb-3">
            <label for="NTUsername" class="form-label">Machine Name</label>
        <select class="form-control" id="ReportModuleSelect">
            <option value="0">Please select Domain Name</option>

            <option value="Corporate-Vocie">Corporate-Vocie</option>
            <option value="Corporate-Vocie">Test Domian</option>
            <option value="Corporate-Vocie">Admin</option>
            <option value="Corporate-Vocie">NTHDIM</option>

        </select>
        </div>

        <div class="mb-3">
            <label for="DisplayName" class="form-label">Machine Description</label>
        <input type="text" class="form-control" id="MachineDescription" name="MachineDescription" value="@machine.DisplayName" required>
        </div>

        <div class="mb-3">
            <label for="LastSyncDT" class="form-label">User Last Modified</label>
        <input type="text" class="form-control" id="UserLastModified" name="UserLastModified" value="@machine.NTUsername" disabled>
        </div>


    <div class="mb-3">
        <label for="LastSyncDT" class="form-label">Machine Last Modified</label>
        <input type="text" class="form-control" id="LastSyncDT" name="LastSyncDT" value="@machine.LastSyncDT" disabled>
    </div>

}


@if (entityType == "IPRanges" && Model.TargetedIPRanges != null && Model.TargetedIPRanges.Any())
{
    var ipRange = Model.TargetedIPRanges.FirstOrDefault();

    
        <div class="mb-3">
      
            <input type="hidden" class="form-control" id="RangeId" name="RangeId" value="@ipRange.RangeId" readonly>
        </div>

        <div class="mb-3">
            <label for="StartIP" class="form-label">Start IP</label>
            <input type="text" class="form-control" id="StartIP" name="StartIP" value="@ipRange.StartIP" required>
        </div>

        <div class="mb-3">
            <label for="EndIP" class="form-label">End IP</label>
            <input type="text" class="form-control" id="EndIP" name="EndIP" value="@ipRange.EndIP" required>
        </div>

        <div class="mb-3">
            <label for="Description" class="form-label">Description</label>
            <input type="text" class="form-control" id="Description" name="Description" value="@ipRange.Description" required>
        </div>

      
}



