@model dynamic

@{
    string entityType = ViewBag.EntityType as string;
}

@if (entityType == "User")
{
    var user = (SetupExclusionsUsersViewModel)Model;
    <div>
        <div class="mb-3">
          
            <input type="hidden" class="form-control" id="UserId" name="Id" value="@user.Id" readonly>
        </div>

        <div class="mb-3">
            <label for="Domain" class="form-label">Domain</label>
            <input type="text" class="form-control" id="Domain" name="Domain" value="@user.Domain">
        </div>

        <div class="mb-3">
            <label for="NTUserName" class="form-label">NT Username</label>
            <input type="text" class="form-control" id="NTUserName" name="NTUserName" value="@user.Username" disabled >
        </div>

        <div class="mb-3">
            <label for="Firstname" class="form-label">Firstname</label>
            <input type="text" class="form-control" id="Firstname" name="Firstname" value="@user.Firstname" disabled>
        </div>

        <div class="mb-3">
            <label for="Surname" class="form-label">Surname</label>
            <input type="text" class="form-control" id="Surname" name="Surname" value="@user.Lastname" disabled>
        </div>

        
    </div>

}

@if (entityType == "Machine")
{
    var machine = (SetupExclusionMachinesViewModel)Model;
    <div>
        <div class="mb-3">
         
            <input type="hidden" class="form-control" id="MachineId" name="Id" value="@machine.Id" readonly>
        </div>
        <div class="mb-3">
            <label for="MachineName" class="form-label">Domain</label>
            <input type="text" class="form-control" id="MachineName" name="MachineName" value="@machine.Domain">
        </div>
        <div class="mb-3">
            <label for="MachineName" class="form-label">Machine Name</label>
            <input type="text" class="form-control" id="MachineName" name="MachineName" value="@machine.MachineName" disabled>
        </div>
        <div class="mb-3">
            <label for="MachineDescription" class="form-label">Machine Description</label>
            <input type="text" class="form-control" id="MachineDescription" name="MachineDescription" value="@machine.MachineDescription">
        </div>
       
    </div>

}


