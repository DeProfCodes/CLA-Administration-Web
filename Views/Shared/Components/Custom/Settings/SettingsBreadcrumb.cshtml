@model SettingsBreadcrumbViewModel

@{
    var pageLink = Model.SettingsCurrentPage;
    var pageName = pageLink.GetDisplayDescription();
}

<input type="text" id="BreadcrumbActionButtonCallBackFunction" value="@Model.BreadcrumbButtonCallbackFunction" hidden />

<div class="row mb-2">
    <div class="w-auto">
        <h2 class="theme-txt-clr breadcrumb-title">@pageName</h2>
        <p class="breadcrumb-nav-body">
            <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Dashboard', null, '@DashboardPages.Dashboard', 'DashboardSubLink')">Dashboard</span> /
            <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Settings', null, '@SettingsPages.AllSettings', 'AllSettingsLink', true)">Settings</span> /
            @if(Model.HasAddNewButton)
            {
                <span class="breadcrumb-item">@pageName</span>
            }
            else
            {
                <span class="breadcrumb-item-nav" onclick="OpenPageWithAnimations('Settings', null, '@pageLink', 'StagingUsersLink');">@pageName</span> 
                <span> / </span>
                <span class="breadcrumb-item">@Model.BreadcrumbButtonName</span>
            }
        </p>
    </div>
    @if (Model.HasAddNewButton)
    {
        <div class="w-auto ms-auto" id="BreadcrumbBtnContainer">
            <button class="custom-btn custom-btn-default breadcrumb-btn" onclick="OpenBreadcrumbActionButton()" id="BreadcrumSettingsBtn">
                <i class="bi bi-plus-circle-fill custom-btn-icons breadcrumb-btn-icon" id="BreadcrumSettingsBtnIcon"></i>
                <span id="BreadcrumSettingsBtnText">@Model.BreadcrumbButtonName</span>
            </button>
        </div>
    }
</div>

<script>

    function OpenBreadcrumbActionButton()
    {
        var callbackFunction = $("#BreadcrumbActionButtonCallBackFunction").val();
        if (callbackFunction != null)
        {
            if (typeof window[callbackFunction] === 'function')
            {
                window[callbackFunction]();
            }
        }
    }

</script>