
<div id="VideoPreviewModal" class="modal">
    <span class="close text-danger" onclick="CloseVideoModal()">&times;</span>
    <video controls class="modal-content" id="VideoPreviewer"></video>
    <div id="caption">
        <button class="btn btn-primary" onclick="OpenVideoInNewWindow()">Open New Window</button>
    </div>
</div>

<script>

    function OpenVideoPreviewModal(videoSrc)
    {
        $("#VideoPreviewModal").fadeIn();
        $("#VideoPreviewer").attr("src", videoSrc);
    }

    function CloseVideoModal()
    {
        $("#VideoPreviewModal").fadeOut();
        var modalVideo = document.getElementById("VideoPreviewer");
        modalVideo.pause();
    }

    function OpenVideoInNewWindow()
    {
        var audio = document.getElementById('VideoPreviewer');
        var url = audio.getAttribute('src');
        window.open(url);

        CloseVideoModal();
    }

</script>
