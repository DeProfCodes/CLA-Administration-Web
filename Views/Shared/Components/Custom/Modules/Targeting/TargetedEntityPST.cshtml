@model CLA_Administration_Web.ViewModels.Targeting.TargetedEntityViewModel

@using CLA_Administration_Web.Helpers.Enums.AppPages
@using Newtonsoft.Json

<div class="d-flex text-center" id="TargetingTablesContainer">
    <div id="TargetingTreesSelectContainer">
        <div id="TargetedEntityTable" class="mt-3"></div>
        <div id="TargetedEntityTable2" class="mt-1"></div>
    </div>
    <div id="AddRemoveButtons" class="h-fit-content mx-2 d-grid">
        <button class="btn btn-success btn-sm w-100p targetings-btn-lrg">Add </button>
        <button class="btn btn-danger btn-sm w-100p mt-2 targetings-btn-lrg"> Remove </button>
        <button class="btn btn-success btn-sm w-100p targetings-btn-sm hidden"> > </button>
        <button class="btn btn-danger btn-sm w-100p mt-2 targetings-btn-sm hidden"> < </button>
    </div>
    <div id="TargetingTreeSelectedContainer">
        <div id="TargetedEntityTable3" class="mt-3"></div>
    </div>
</div>


<link href="https://unpkg.com/tabulator-tables@4.1.1/dist/css/semantic-ui/tabulator_semantic-ui.min.css" rel="stylesheet">
<script src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js" type="text/javascript"></script>

<script>

    $(document).ready(function ()
    {
        if('@Model.IsReadonly' == "True")
        {
            $(".targetings-btn-lrg").attr("disabled", true);
            $(".targetings-btn-sm").attr("disabled", true);
        }
    });

    var tableDataNested2 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TargetedEntities));
    var tableDataNested3 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TargetedAccepted));
    var tableDataNested4 = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TargetedGroups));

    var table = new Tabulator("#TargetedEntityTable",
        {
            layout: "fitColumns",
            data: tableDataNested2,
            dataTree: true,
            rowHeader: false,
            dataTreeStartExpanded: function (row, level)
            {
                return (level == 0 || level == 1);
            },
            maxHeight: "300px",
            minHeight: "250px", 
            columns: [
                {
                    title: "", field: "EntityName", responsive: 0, headerFilter: "input", headerFilterPlaceholder: "Search...", frozen: true
                },
            ],
        });

    var table2 = new Tabulator("#TargetedEntityTable2",
        {
            layout: "fitColumns",
            data: tableDataNested3,
            dataTree: true,
            rowHeader: false,
            dataTreeStartExpanded: function (row, level)
            {
                return (level == 0 || level == 1);
            },
            maxHeight: "300px",
            minHeight: "250px",
            columns: [
                {
                    title: "", field: "EntityName", responsive: 0
                },
            ],
        });

    var table3 = new Tabulator("#TargetedEntityTable3",
        {
            layout: "fitColumns",
            data: tableDataNested4,
            dataTree: true,
            rowHeader: false,
            dataTreeStartExpanded: function (row, level)
            {
                return (level == 0 || level == 1);
            },
            maxHeight: "530px",
            minHeight: "530px",
            columns: [
                {
                    title: "", field: "EntityName", responsive: 0
                },
            ],
        });

    function OpenContentLibraryCategory(categoryId)
    {
        OpenPage('@ModulesPages.ContentLibraryCategoryDetails', categoryId);
    }

    function OpenContentsOverview(categoryId)
    {
        OpenPage('@ModulesPages.ContentLibraryContent', categoryId);
    }

    function OpenNewContentLibraryCategory(categoryId)
    {
        OpenPage('@ModulesPages.AddNewContentLibraryCategory', categoryId);
    }

</script>