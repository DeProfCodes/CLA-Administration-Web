


<div class="row time-picker d-flex">
    <div class="d-flex">
        <div class="col-md-4 align-content-center">
            <p class="custom-p">Start Time</p>
        </div>
        <div id="timeRange"></div>
        <div class="col-md-8 d-flex">
            <i class="fas fa-clock calendar-icon-date-box" onclick="$('#StartTime').click()" style="margin-right: -25px; margin-top: 5px;"></i>
            <input type="text" class="custom-input-text" id="startTime" readonly onclick="openStartTimePicker()" hidden/>
            <select class="custom-input-text" id="TimePickerStartTime" style="width: 100px;padding-left: 30px;" onchange="ValidateEndTime()">
               
            </select>
        </div>
    </div>
    <div class="d-flex">
        <div class="col-md-4 align-content-center">
            <p class="custom-p">End Time</p>
        </div>
        <div class="col-md-8 d-flex">
            <i class="fas fa-clock calendar-icon-date-box" onclick="$('#EndTime').click()" style="margin-right: -25px; margin-top: 5px;"></i>
            <input type="text" class="custom-input-text" id="endTime" readonly onclick="openEndTimePicker()" hidden/>
            <select class="custom-input-text" id="TimePickerEndTime" style="width: 100px;padding-left: 30px;">
               
            </select>
        </div>
    </div>
</div>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/timepicker/jquery.timepicker.min.js"></script>
<script src="https://kit.fontawesome.com/a076d05399.js"></script>

<script>
    
    $(document).ready(function ()
    {
        initializeTimePickers();

        SetDefaultStartTime();
    });

    function SetDefaultStartTime()
    {
        $('#startTime').val("07:00");
        $('#endTime').val("16:30");
    }

    function initializeTimePickers()
    {
        // Start time picker initialization
        $('#startTime').timepicker({
            timeFormat: 'HH:mm',
            interval: 15,
            dropdown: true,
            scrollbar: true
        });

        // End time picker initialization
        $('#endTime').timepicker({
            timeFormat: 'HH:mm',
            interval: 15,
            dropdown: true,
            scrollbar: true
        });
    }

    // Function to open start time picker
    function openStartTimePicker()
    {
        $('#startTime').timepicker('show');
    }

    // Function to open end time picker
    function openEndTimePicker()
    {
        $('#endTime').timepicker('show');
    }

    GenerateTimeOptions("TimePickerStartTime");
    GenerateTimeOptions("TimePickerEndTime");

    function ValidateEndTime()
    {
        const startTime = document.getElementById("TimePickerStartTime").value;
        const endTimeSelect = document.getElementById("TimePickerEndTime");

        // Disable end time options that are earlier than start time
        for (let i = 0; i < endTimeSelect.options.length; i++)
        {
            if (endTimeSelect.options[i].value <= startTime)
            {
                endTimeSelect.options[i].disabled = true;
            } else
            {
                endTimeSelect.options[i].disabled = false;
            }
        }

        // If the selected end time is earlier than the start time, reset it
        if (endTimeSelect.value <= startTime)
        {
            endTimeSelect.value = startTime;
        }
    }

    window.onload = function ()
    {
        ValidateEndTime();
    };
    

</script>