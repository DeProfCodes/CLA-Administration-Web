

<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/timepicker/jquery.timepicker.min.css" />


<div class="row date-picker d-flex w-fit-content">
    <div class="d-flex">
        <div class="col-md-4 align-content-center">
            <p class="custom-p">Start Date</p>
        </div>
        <div id="dateRange"></div>
        <div class="col-md-8 d-flex">
            <i class="fas fa-calendar-alt calendar-icon-date-box" onclick="OpenDatePicker()"></i>
            <input type="text" class="custom-input-text" id="DatePickerStartDate" readonly onclick="OpenDatePicker()" />
        </div>
    </div>
    <div class="d-flex">
        <div class="col-md-4 align-content-center">
            <p class="custom-p">End Date</p>
        </div>
        <div class="col-md-8 d-flex">
            <i class="fas fa-calendar-alt calendar-icon-date-box" onclick="OpenDatePicker()"></i>
            <input type="text" class="custom-input-text" id="DatePickerEndDate" readonly onclick="OpenDatePicker()" />
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

<script>
    
    $(document).ready(function ()
    {
        InitializeDatePicker();
        SetInitialDatesToday();
    });

    function SetInitialDatesToday()
    {
        var today = FormatDate(TodayDate(), "DD-MMM-YYYY");

        $("#DatePickerStartDate").val(today);
        $("#DatePickerEndDate").val(today);
    }

    function InitializeDatePicker()
    {
        $('#dateRange').daterangepicker({
            opens: 'right',
            autoApply: true,
            locale: {
                format: 'YYYY-MM-DD'
            }
        }, function (start, end)
        {
            $('#DatePickerStartDate').val(start.format('DD MMM YYYY'));
            $('#DatePickerEndDate').val(end.format('DD MMM YYYY'));
        });
    }

    function OpenDatePicker()
    {
        $('#dateRange').click();
    }

</script>