@model CLA_Administration_Web.ViewModels.Modules.Components.Form.FileUploaderModel

@{
    var inputId = Model.InputId;
    var showHideInitial = Model.InitialHidden ? "hidden" : "";
    var width = !string.IsNullOrEmpty(Model.WidthPx) ? $"width:{Model.WidthPx}" : "";
    var css = !string.IsNullOrEmpty(Model.WidthCss) ? Model.WidthCss : "";
}

<div id="ContentUploadComponent" class="@showHideInitial">
    <p class="mb-0 custom-p fst-italic w-fit-content">
        <span id="ModuleContentUploadFileName">No file selected</span>
        @if (Model.ShowPreviewButton)
        {
            <button class="btn btn-success content-preview-btn custom-btn-sm ms-3 hidden" id="ModuleContentPreviewUpload" onclick="PreviewContent()">Preview</button>
        }
    </p>
    <div class="@css mt-2 p-0" id="UploadFileContainer" style="width">
        <i class="bi bi-cloud-arrow-up-fill"></i>
        <p class="mb-0 text-silver fs-12" style="margin-top:-5px">Drag & Drop file here</p>
        <p class="mb-0 text-silver fs-12">or</p>
        <input type="file" id="@inputId" hidden>
        <button class="btn btn-upload" onclick="document.getElementById('ContentUploadInput').click();">Browse</button>
    </div>
</div>

<script>

    let uploadSection = document.getElementById('UploadFileContainer');

    let fileInput = document.getElementById('@inputId');
    let fileNameDisplay = document.getElementById('ModuleContentUploadFileName');
    
    let UploadFileUrl = '';
    let UploadFileType = '';

    uploadSection.addEventListener('dragover', (e) =>
    {
        e.preventDefault();
        uploadSection.classList.add('dragging');
    });

    uploadSection.addEventListener('dragleave', () =>
    {
        uploadSection.classList.remove('dragging');
    });

    uploadSection.addEventListener('drop', (e) =>
    {
        e.preventDefault();
        uploadSection.classList.remove('dragging');
        const files = e.dataTransfer.files;
        handleFiles(files);
    });

    fileInput.addEventListener('change', (e) =>
    {
        const files = e.target.files;
        handleFiles(files);
    });

    function handleFiles(files)
    {
        if (files.length > 0)
        {
            $("#ModuleContentUploadFileName").text(files[0].name);
            HideShowElement("#ModuleContentPreviewUpload", HideShow.SHOW);

            var imagePath = URL.createObjectURL(files[0]);
            
            UploadFileUrl = imagePath;
            UploadFileType = files[0].type;
        }
        else
        {
            $("#ModuleContentUploadFileName").text("No file selected");
            HideShowElement("#ModuleContentPreviewUpload", HideShow.HIDE);
        }
    }

    function PreviewContent()
    {
        if (UploadFileType == null || UploadFileType.length == 0|| UploadFileUrl == null || UploadFileUrl.length == 0)
        {
            swal("File Preiview Error", "Please upload a file first before previewing");
            return;
        }
        var contentType = 0;

        if (UploadFileType.includes("image")) contentType = ContentTypes.IMAGE;
        if (UploadFileType.includes("audio")) contentType = ContentTypes.AUDIO;
        if (UploadFileType.includes("video")) contentType = ContentTypes.VIDEO;
        if (UploadFileType.includes("document")) contentType = ContentTypes.DOCUMENT;

        PreviewContentType(contentType, UploadFileUrl)
    }

    function ClearFileUpload()
    {
        UploadFileUrl = "";
        UploadFileType = "";
        $("#ModuleContentUploadFileName").text("No file selected");
        HideShowElement("#ModuleContentPreviewUpload", HideShow.HIDE);
    }

</script>