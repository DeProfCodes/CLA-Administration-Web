@model CLA_Administration_Web.ViewModels.Modules.ContentLibrary.ContentLibraryContentsViewModel
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

<div class="table-responsive theme-border p-1" id="SurveyQuestionsOverviewTableContainer" >
    <h3 class="w-100 text-center theme-txt-clr overview-table-caption mt-3 mb-3">
        <span id="SurveyQuesitonsOverviewTableCaption" >Available Content For @DateTime.Now.ToString("MMMM")</span>
    </h3>
    <table id="ModuleOverviewDataTable" class="table table-striped table-bordered table-hover align-middle" style="font-size:12px;">
        <thead>
            <tr>
                <th class="text-center">Select</th>
                <th class="text-center">CategoryName</th>
                <th class="text-center">Advert Description</th>
                @if (Model.ModuleName != ModuleNamesType.Desktop)
                {
                    <th class="text-center">Duration</th>
                }
                <th class="text-center">Content Type</th>
                <th class="text-center">Preview</th>
                <th class="text-center">Effective From</th>
                <th class="text-center">Effective To</th>
                <th class="text-center">Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var content in Model.ContentLibraryContents)
            {
                var checkBoxId = $"{content.ContentId}TableRowSelect";
                <tr>
                    <td class="text-center"><i class="bi bi-grip-vertical me-2" style="cursor:pointer" id="ReTableRowOrderIcon"></i><input type="checkbox" id="@checkBoxId" /></td>
                    <td class="text-center module-dt-header-text">@content.CategoryName</td>
                    <td><p class="text-center module-dt-header-text">@content.AdvertDescription</p></td>
                    @if (Model.ModuleName != ModuleNamesType.Desktop)
                    {
                        <td><p class="text-center">@content.Duration</p></td>
                    }
                    <td><p class="text-center">@content.ContentType</p></td>
                    <td><p class="text-center"><button class="btn btn-sm btn-info custom-btn-sm" onclick="PreviewImage()">Open</button></td>
                    <td><p class="text-center">@content.EffectiveFrom</p></td>
                    <td><p class="text-center">@content.EffectiveTo</p></td>
                    <td><span class="@content.Status.CssClass">@content.Status.StatusType.GetDisplayName()</span></td>
                    <td class="text-center">
                        <button class="btn btn-success btn-sm custom-btn-sm">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Modules/ContentPreviewers/AllContentPreviewer.cshtml");
}

<script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.js"></script>
<script>

    $(document).ready(function()
    {
        $('#ModuleOverviewDataTable').DataTable();
    });

</script>
