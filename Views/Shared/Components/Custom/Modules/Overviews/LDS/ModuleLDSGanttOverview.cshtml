<!-- Modules Data Table Component for PSTR Modules : Popups, Surveys, Tickers, RSS -->
@using CLACommonFunctionsLibrary_NET.Helpers.Enums
@using CLA_Administration_Web.Helpers.Enums.AppPages
@using CLA_Administration_Web.Helpers.Enums.Shared.PageNames

@model CLA_Administration_Web.ViewModels.Modules.GanttChartDataViewModel

@{
    var moduleName = Model.ModuleName.GetDisplayName();
    var forUserTitle = Model.FilterTitle.User.ToLower() == "all" ? "All Users" : Model.FilterTitle.User;
}

<h3 class="w-100 text-center theme-txt-clr overview-table-caption" id="ModuleOverviewTableCaption">
    <span>Showing @Model.FilterTitle.Status.ToUpper() (@Model.GanttData.Count)</span>
    <span class="fw-bold text-upper">@Model.FilterTitle.StagingLiveFilter</span> @moduleName for
    <span class="fst-italic">@forUserTitle</span> from
    <span class="text-decoration-underline">@Model.FilterTitle.StartDate</span> to
    <span class="text-decoration-underline">@Model.FilterTitle.EndDate</span>
</h3>
<div id="GanttChartLegend" class="d-flex w-fit-content mx-auto">
    <p class="mb-0 me-3 fw-bold" style="font-size:12px;">Legend</p>
    <div class="d-flex">
        <div class="gantt-color-block" style="background:#ff3131"></div>
        <span class="gantt-color-block-text">0 - 5 Days</span>
    </div>
    <span class="gantt-legend-separator">|</span>
    <div class="d-flex">
        <div class="gantt-color-block" style="background:#ffff00"></div>
        <span class="gantt-color-block-text">6 - 10 Days</span>
    </div>
    <span class="gantt-legend-separator">|</span>
    <div class="d-flex">
        <div class="gantt-color-block" style="background:#ffa500"></div>
        <span class="gantt-color-block-text">11 - 15 Days</span>
    </div>
    <span class="gantt-legend-separator">|</span>
    <div class="d-flex">
        <div class="gantt-color-block" style="background:#1a9df1"></div>
        <span class="gantt-color-block-text">16 - 20 Days</span>
    </div>
    <span class="gantt-legend-separator">|</span>
    <div class="d-flex">
        <div class="gantt-color-block" style="background:#16a637"></div>
        <span class="gantt-color-block-text">21 - 30 Days</span>
    </div>
</div>
<div id="ModuleGanttChart">

</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<script>

    
    CreateGanttChart(
        "#ModuleGanttChart",
        @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.GanttData)), 
        '@Model.GanttChartHeight'
    );

</script>