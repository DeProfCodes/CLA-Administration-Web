@model ModuleReportFilterViewModel

@{
    var moduleName = Model.ReportName.GetDisplayName(); 
}


<!-- Card for Filters -->
<input id="ModuleReportId" value="" hidden />

<div class="card mb-4 mt-2 overview-filters-card app-card-main-scaling">
    <div class="card-body pt-0 pb-0">
        <div class="row fs-12 mt-1">
            <p class="custom-p text-center hidden">Filter @moduleName Reports Types</p>
            <div class="row col-12 d-flex flex-wrap module-overview-filters">
                <div class="w-fit-content me-auto ms-4">
                    <p class="theme-txt-clr fw-bold text-center mb-0">Status</p>
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Active</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-success slider-large" type="checkbox" id="ModuleReportFilterActive" checked>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Inactive</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-warning slider-large" type="checkbox" id="ModuleReportFilterInActive" checked>
                            </div>
                        </div>
                    </div> 
                    <div class="d-flex">
                        <div class="align-content-center report-filter-module-status-titles">
                            <p class="custom-p">Show Not Installed</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input form-check-input-danger slider-large" type="checkbox" id="ModuleReportFilterNotInstalled" checked>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-auto mx-auto mb-1">
                    <div class="row mb-0 mt-1">
                        @{
                            await Html.RenderPartialAsync("~/Views/Shared/Components/Custom/Form/DateRangePicker.cshtml", 
                            new DateTimeRangePicker 
                            { 
                                ShowDatesTitle = true,
                                ShowFullTitles = false,
                                TitlesBold = true,
                                VerticalAlign = false,
                                WidthCss = "w-225p",
                                ExternalCssControl = "report-filter-datepicker",
                                OnChangeFunction = "ChangeFilterDates"
                            });
                        }
                    </div>
                    <div class="row mt-2">
                        <p class="custom-p w-fit-content fw-bold align-content-center">@moduleName</p>
                        <select class="custom-input-text w-350p" id="ReportModuleSelect" onchange="ChangeModuleId()">
                            <option value="0">Please select @moduleName</option>
                        </select>
                    </div>
                </div>
                <div class="w-auto mx-auto mb-1">
                    <div class="d-flex mt-1">
                        <div class="align-content-center">
                            <p class="custom-p fw-bold">Show Raw Data Only</p>
                        </div>
                        <div class="report-filter-module-status-sliders">
                            <div class="form-check form-switch w-fit-content mb-0">
                                <input class="form-check-input slider-large" type="checkbox" id="ReportModuleShowRawDataOnly" onchange="ModuleRawDataClicked()">
                            </div>
                        </div>
                    </div>
                    @if (Model.ReportName == ReportsNamesType.Survey)
                    {
                        <div class="d-flex mt-1">
                            <div class="align-content-center">
                                <p class="custom-p fw-bold">Transponsed</p>
                            </div>
                            <div class="report-filter-module-status-sliders">
                                <div class="form-check form-switch w-fit-content mb-0">
                                    <input class="form-check-input slider-large" type="checkbox" id="SurveyTransponsed" onchange="SurveyTransponseClick()">
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.ReportName == ReportsNamesType.Policy)
                    {
                        <div class="d-flex mt-1 theme-txt-clr">
                            <div class="form-check form-switch w-fit-content mb-0 align-content-center">
                                <input class="form-check-input" type="radio" name="PolicyReportExtraOptions" id="UserOption" checked>
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="UserOption">Users</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 ms-2 align-content-center">
                                <input class="form-check-input" type="radio" name="PolicyReportExtraOptions" id="MachineOption">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="MachineOption">Machines</label>
                            </div>
                            <div class="form-check form-switch w-fit-content mb-0 ms-2 align-content-center">
                                <input class="form-check-input" type="radio" name="PolicyReportExtraOptions" id="UserMachineOption">
                                <label class="form-check-label ms-2 cursor-pointer fw-bold" for="UserMachineOption">Both</label>
                            </div>
                        </div>
                    }
                    <div class="d-flex mt-1">
                        <button class="btn custom-btn-default btn-sm ms-2 px-3" onclick="GenerateReportOnly()">Generate Report</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function ()
    {
        //PreloadDatesFilterDates();
    });

    function GenerateReportOnly()
    {
        var moduleId = $("#ReportModuleSelect").val();
        if (moduleId > 0)
        {
            ReloadFilteredReport("@Model.ReportName", ReportDataTypes.REPORT_ONLY, moduleId);
        }
        else
        {
            var reportName = "@Model.ReportName.GetDisplayName()";
            swal("Error", `Please select ${reportName}.`, "error");
        }
    }

    function PreloadDatesFilterDates()
    {
        var startDate = "2020/01/01";
        var endDate = "2024/11/30";
        var reportType = "@Model.ReportName";

        var url = '@AppPagesUrl.Reports.ReportModulesListing' + `?reportType=${reportType}&startDate=${startDate}&endDate=${endDate}`;
        var payload = { startDate: startDate, endDate: endDate }

        ShowLoader("Secondary", "Loading Available @moduleName IDs");

        PerformAction(url, "GET", payload, FinishLoadingModuleListing);
    }

    function ChangeFilterDates()
    {
        var startDate = $('#DatePickerStartDate').val();
        var endDate = $('#DatePickerEndDate').val();
        var reportType = "@Model.ReportName";

        var url = '@AppPagesUrl.Reports.ReportModulesListing' + `?reportType=${reportType}&startDate=${startDate}&endDate=${endDate}`;
        var payload = { startDate: startDate, endDate: endDate }

        ShowLoader("Secondary", "Loading Available @moduleName IDs");

        PerformAction(url, "GET", payload, FinishLoadingModuleListing);
    }

    function FinishLoadingModuleListing(success, response)
    {
        if (success)
        {
            $('#ReportModuleSelect').empty();

            $.each(response, function (index, item)
            {
                $('#ReportModuleSelect').append($('<option>', {
                    value: item.moduleId,
                    text: item.title
                }));
            });
        }
        HideLoader("Secondary");
    }

    function ChangeModuleId()
    {
        var moduleId = $("#ReportModuleSelect").val();
        $("#ModuleReportId").val(moduleId);
    }
    
    function SurveyTransponseClick()
    {
        if (IsCheckboxChecked("SurveyTransponsed"))
            CheckOrUncheckInput("ReportModuleShowRawDataOnly", false);
    }

    function ModuleRawDataClicked()
    {
        if (IsCheckboxChecked("ReportModuleShowRawDataOnly"))
            CheckOrUncheckInput("SurveyTransponsed", false);
    }


</script>