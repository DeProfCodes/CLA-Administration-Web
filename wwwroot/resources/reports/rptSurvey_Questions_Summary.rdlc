                                                <ChartDataPointValues>
                                                  <Y>=iif(Sum(Fields!Response_Weighting.Value) &gt; 0,Sum(Fields!Response_Weighting.Value),"")</Y>
                                                </ChartDataPointValues>
                                                <ChartDataLabel>
                                                  <Style />
                                                  <Label>=iif(Fields!Is_Survey_Complete.Value = "1", iif(Parameters!User_ID.Value="0",Round(Sum(Fields!Response_Weighting.Value)/Sum(Fields!Response_Weighting.Value, "Question_Position")*100) &amp; "%", ""),"")</Label>
                                                  <Visible>true</Visible>
                                                </ChartDataLabel>
                                                <ToolTip>=iif(Fields!Is_Survey_Complete.Value = "1",Fields!Response.Value &amp; ": " &amp; Round(Sum(Fields!Response_Weighting.Value)/Sum(Fields!Response_Weighting.Value, "Question_Position")*100) &amp; "%","")</ToolTip>
